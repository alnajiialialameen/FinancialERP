            }
        });

        $('.myTbody').on('click', '.delete', function () {
            var currentRow = $(this).closest("tr");

            var accTrreId = currentRow.find('.id').text();

            $.each(rptList, function (index, obj) {
                if (obj.accTrreId === accTrreId) {
                    rptList.splice(index, 1); // Remove 1 element at the found index
                    return false; // Stop the loop
                }
            });

            $(this).closest("tr").remove();
        });

        $('#tbx').on('click', '.btnAddRecipient', function () {
            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var TransactionId = data['transactionId'];
            $('#recipientTransactionId').text(TransactionId);

            var Note = data['note'];
            $('#recipientStatement').val(Note);
            $('#tblRecipient').addClass('hide');

            select2list("#recipientBank", "/Transactions/getTransactionBanks/" + TransactionId, "اختار البنك");
            select2list("#recipientName", "/Shared/getAllRecipient", "  اسم المستلم ");

            // Get old data
            $.get('/Transactions/getTransactionRecipients/' + TransactionId, {}, function (response) {
                if (response && response.length > 0) {
                    $('#tblRecipient').removeClass('hide');

                    $('#tblRecipientBody').empty(); // Clear previous rows if needed

                    response.forEach(function (item) {
                        var obj = JSON.stringify(item).replace(/"/g, '&quot;');

                        var row = `
                                                            <tr>
                                                                <td>${item.Id}</td>
                                                                <td>${item.RecipientName}</td>
                                                                <td>${item.BankName}</td>
                                                                <td>${item.AccountNumber}</td>
                                                                <td>${formatNumber(item.Amount)}</td>
                                                                <td>
                                                                    <button class="text-success printBankLetter"
                                                                    onClick="printBankLetterForRe(
                                                                        ${item.Id},${item.TransactionId}, ${item.BankAccountId},${item.AccountNumber}
                                                                    )">
                                                                    <i class="fa fa-print"></i>
                                                                    </button>
                                                                </td>
                                                            </tr>
                                                        `;

                        $('#tblRecipientBody').append(row);
                    });
                }
            });


            $('#add-recipients-modal').modal('show');
        });

        $('.btnSaveRecipient').on('click', function () {
            var amount = recipientAmountObj.getNumber();
