@section content{
    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <div class="grad"></div>
        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>
                سندات القيد
            </h1>
            <ol class="breadcrumb">
                <li><a href="#"><i class="fa fa-home"></i> النظام المحاسبي</a></li>
                <li class="active">  سندات القيد</li>
            </ol>
        </section>

        <section class="content">
            <div class="row">
                <div class="col-xs-12">
                    <div class="box">
                        <!-- /.box-header -->
                        <div class="box-body">
                            <button class="btn btn-primary" style="float:left" data-toggle="modal" data-target="#add-modal"> إضافة قيد</button>
                            <div class="container">
                                <table id="tbx" class="table table-bordered table-sm table-hover" style="width:100%">
                                </table>
                            </div><!-- /.box-body -->
                        </div><!-- /.box -->
                    </div><!-- /.col -->
                </div><!-- /.row -->
            </div>
        </section>

    </div><!-- /.content-wrapper -->

    <div class="example-modal">
        <div class="modal fade in" id="add-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:80% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة قيد جديد</h4>
                    </div>
                    <div class="modal-body">
                        <!-- Input addon -->

                        <form id="add-form">
                            <div class="row">
                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <label for="addAccName">اسم الحساب</label>
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="fa fa-book"></i>
                                            </div>
                                            <select class="form-control list addAccName" name="addAccName" id="addAccName" style="width:100%"></select>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <div class="flex">
                                            <label for="debitAmount">المبلغ المدين</label>
                                            <strong id="AmountCurrencyDecimalText" class="AmountCurrencyDecimalText"></strong>
                                        </div>
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="fa  fa-book"></i>
                                            </div>
                                            <input class="form-control debitAmount" type="text" name="debitAmount" id="debitAmount" placeholder="المبلغ مدين" autocomplete="off" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <div class="flex"><label for="creditAmount">المبلغ الدائن</label><strong id="AmountCurrencyDecimalTextCr" class="AmountCurrencyDecimalTextCr"></strong></div>
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="fa  fa-book"></i>
                                            </div>
                                            <input class="form-control creditAmount" type="text" name="creditAmount" id="creditAmount" placeholder="المبلغ" autocomplete="off" />
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-lg-12">
                                    <button type="submit" class="btn btn-info btn-block" onclick="addToTable()">ترحيل</button>
                                </div>
                            </div>

                        </form>

                        <br />

                        <div class="row">
                            <div class="col-lg-12">
                                <table id="example1" class="table table-bordered table-striped virtualTable">
                                    <thead>
                                        <tr>
                                            <th style="text-align:center ;width:150px;">#</th>
                                            <th style="text-align:center ;width:750px;">اسم الحساب</th>
                                            <th style="text-align:center ;width:750px;">مدين</th>
                                            <th style="text-align:center ;width:750px;">دائن</th>
                                            <th style="text-align:center;"><i class="fa fa-cogs"></i></th>
                                        </tr>
                                    </thead>
                                    <tbody class="myTbody"></tbody>
                                    <tfoot class="myTFoot" style="background-color: #000000; color: #ffffff; text-align: center;"></tfoot>
                                </table>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12 ">
                                <div class="pull-left">
                                    <button type="button" class="btn btn-default " data-dismiss="modal">رجوع</button>
                                    <button type="submit" id="btnSave" class="btn btn-primary">مراجعة القيد</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>

    <div class="example-modal">
        <div class="modal fade in" id="add-statement-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:60% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة عملية جديدة</h4>
                    </div>
                    <div class="modal-body">
                        <form id="add-statement-form">
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="transactionDate"> تاريخ القيد</label>
                                        <div class="input-group">
                                            <span class="input-group-addon">
                                                <i class="fa fa-calendar-alt"></i>
                                            </span>
                                            <input type="text" class="form-control calendar transactionDate" id="transactionDate" name="transactionDate" placeholder="تاريخ القيد" autocomplete="off">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="addCurrencyType">العملة</label>
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="fa fa-money-bill-alt"></i>
                                            </div>
                                            <select class="form-control list addCurrencyType" name="addCurrencyType" id="addCurrencyType" style="width:100%"></select>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="documentType">نوع السند</label>
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="fa fa-key"></i>
                                            </div>
                                            @*<select class="form-control list documentType" name="documentType" id="documentType" style="width:100%"></select>*@
                                            <select class="form-control list documentType" name="documentType" id="documentType" style="width:100%"></select>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="recipient">اسم المستلم</label>
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="fa fa-user"></i>
                                            </div>
                                            @*<input type="text" class="form-control recipient" name="recipient" id="recipient" placeholder="اسم المستلم" style="width:100%" />*@
                                            <select class="form-control list recipient" name="recipient" id="recipient" style="width:100%"></select>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label for="statement">البيان</label>
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="fa fa-book"></i>
                                            </div>
                                            <textarea class="form-control statement" id="statement" name="statement"> @ViewBag.Note </textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <button type="submit" class="btn btn-success btnCreate" style="width: 100%;">حفظ</button>
                            </div>
                        </form>
                        <hr />
                        <div class="row">
                            <table class="table table-bordered table-striped table-hover">
                                <thead style="background-color:#808080">
                                    <tr class="text-center">
                                        <td>مدين</td>
                                        <td>دائن</td>
                                        <td>الحساب</td>
                                    </tr>
                                </thead>
                                <tbody class="presntTBody"></tbody>
                            </table>
                        </div>

                    </div><!-- /.modal-content -->
                </div><!-- /.modal-dialog -->
            </div><!-- /.modal -->
        </div>
    </div>


    @*Add Recipients Modal*@
    <div class="example-modal">
        <div class="modal fade in" id="add-recipients-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:60% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <label id="recipientTransactionId" class="recipientTransactionId hide">44444</label>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة مستلمين</h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label for="recipientBank">اسم البنك</label>
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <i class="fa fa-key"></i>
                                        </div>
                                        @*<select class="form-control list documentType" name="documentType" id="documentType" style="width:100%"></select>*@
                                        <select class="form-control list recipientBank" name="recipientBank" id="recipientBank" style="width:100%"></select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label for="recipientName">اسم المستلم</label>
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <i class="fa fa-user"></i>
                                        </div>
                                        @*<input type="text" class="form-control recipient" name="recipient" id="recipient" placeholder="اسم المستلم" style="width:100%" />*@
                                        <select class="form-control list recipientName" name="recipientName" id="recipientName" style="width:100%"></select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label for="recipientAmount">المبلغ</label>
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <i class="fa fa-user"></i>
                                        </div>
                                        @*<input type="text" class="form-control recipient" name="recipient" id="recipient" placeholder="اسم المستلم" style="width:100%" />*@
                                        <input type="text" class="form-control list recipientAmount" name="recipientAmount" id="recipientAmount" placeholder="المبلغ" style="width:100%" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label for="recipientStatement">البيان</label>
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <i class="fa fa-book"></i>
                                        </div>
                                        <textarea class="form-control recipientStatement" id="recipientStatement" name="recipientStatement" disabled></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <button type="button" class="btn btn-success btnSaveRecipient">حفظ</button>
                        </div>

                        <div class="row">
                            <table class="table table-bordered tblRecipient hide" id="tblRecipient">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>اسم المستلم</th>
                                        <th>اسم البنك</th>
                                        <th>رقم الحساب</th>
                                        <th>المبلغ</th>
                                        <th>#</th>
                                    </tr>
                                </thead>
                                <tbody id="tblRecipientBody"></tbody>
                            </table>
                        </div>
                    </div><!-- /.modal-content -->
                </div><!-- /.modal-dialog -->
            </div><!-- /.modal -->
        </div>
    </div>

    @*Add AddedTax Modal*@
    <div class="example-modal">
        <div class="modal fade in" id="addedTax-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:60% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <label id="recipientTransactionId" class="recipientTransactionId hide">44444</label>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة ضريبة القيمة المضافة</h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label for="recipientBank">ادخل القيمة</label>
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <i class="fa fa-key"></i>
                                        </div>
                                        <input type="number" class="form-control" id="addTaxVal" value="17" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label for="recipientBank">القيمة الفعلية(%)</label>
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <i class="fa fa-key"></i>
                                        </div>
                                        <label type="text" class="form-control" id="addTaxValDisplay"></label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <button type="button" class="btn btn-success btnSaveAddedTax" onclick="Add17Tax()">حفظ</button>
                        </div>

                    </div><!-- /.modal-content -->
                </div><!-- /.modal-dialog -->
            </div><!-- /.modal -->
        </div>
    </div>

    @*Add taxConfirmation Modal*@
    <div class="example-modal">
        <div class="modal fade in" id="taxConfirmation-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:40% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <label id="taxConfirmationTransId" class="taxConfirmationTransId hide">44444</label>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة ضريبة ال1% </h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <h2 class="text-center">
                                سيتم خصم 1% من اصل المبلغ!
                            </h2>
                        </div>

                        <div class="modal-footer d-flex" style="width: 100%;">
                            <button type="button" class="btn btn-success" onclick="AddOneTax()">تأكيد</button>
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">إلغاء</button>
                        </div>

                    </div><!-- /.modal-content -->
                </div><!-- /.modal-dialog -->
            </div><!-- /.modal -->
        </div>
    </div>

}
}

@section scripts{
    <script>
        var myId = 0;
        var dataTable;
        var creditAmountObj;
        var debitAmountObj;
        var recipientAmountObj;

        $(document).ready(function () {
            function loadData() {
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    "columnDefs": [
                        {
                            "targets": 0,
                            "className": "text-center",
                        },
                    ],
                    ajax: {
                        url: '/Shared/LoadData',
                        dataSrc: ''
                    },
                    columns: [
                        {
                            "title": "",
                            "data": "transactionId",
                            "orderable": false,
                            "render": function (data) {
                                return '<a class="btn btn-info btnDetails" data-toggle="modal" data-target="#details-modal"><i class="fa fa-info"></i></a>';
                            }
                        },
                        {
                            "title": "# ",
                            "data": "transactionId"
                        },
                        {
                            "title": "البيان",
                            "data": "note"
                        },
                        {
                            "title": "نوع القيد",
                            "data": "documentType"
                        },
                        {
                            "title": "اجمالي المبلغ",
                            "data": "total",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": "العملة",
                            "data": "currency"
                        },
                        {
                            "title": "سعر الصرف",
                            "data": "exchangeRate",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": "تاريخ القيد",
                            "data": "transactionDateStr"
                        },
                        {
                            "title": "<i class='fa fa-cog'></i>",
                            "data": null,
                            "width": "10%",
                            "orderable": false,
                            "render": function (data) {
                                if (data.hasAddedTax == false || data.hasAddedTax == null) {
                                    //return '<a href="#" class="btn btn-success addedTax" onclick="Add17Tax(' + data.transactionId + ')">إضافة 17%</a>';
                                    return '<a href="#" class="btn btn-success addedTax" onclick="OpenAdd17TaxModal(' + data.transactionId + ')">القيمة المضافة</a>';
                                } else {
                                    return '<a href="#" class="btn btn-danger addedTax" onclick="delete17Tax(' + data.transactionId + ')">الغاء القيمة المضافة</a>';
                                }
                            }
                        },
                        {
                            "title": "<i class='fa fa-cog'></i>",
                            "data": null,
                            "width": "10%",
                            "orderable": false,
                            "render": function (data) {
                                if (data.hasTax == false | data.hasTax == null) {
                                    return '<a href="#" class="btn btn-success addedTax" onclick="OpenAddTaxModal(' + data.transactionId + ')">إضافة 1%</a>';
                                    //return '<a href="#" class="btn btn-success addedTax" onclick="AddOneTax(' + data.transactionId + ')">إضافة 1%</a>';
                                } else {
                                    return '<a href="#" class="btn btn-danger addedTax" onclick="deleteOneTax(' + data.transactionId + ')">الغاء 1%</a>';
                                }
                            }
                        },
                        {
                            "title": "<i class='fa fa-cog'></i>",
                            "data": null,
                            "width": "10%",
                            "orderable": false,
                            "render": function (data) {
                                return `
                                <div class="btn-group">
                                    <button type="button" class="btn btn-default" data-toggle="dropdown">
                                        <i class="fa fa-ellipsis-v"></i>
                                    </button>
                                    <div class="dropdown-menu btn-threePoint">
                                    <a href="#" class="btnBankLetter" onclick="printBankLetter(${data.transactionId})">خطاب البنك</a><br />
                                        ${data.documentType == 'سند دفع'
                                        ? `<a href="#" class="btnPrintCheck" onclick="printchecs(${data.transactionId})">طباعة الشيك</a><br />`
                                        : ''
                                    }
                                        <a href="#" class="btnEdit">تعديل</a><br />
                                        <a href="#" class="btnAddRecipient">إضافة مستلمين</a><br />
                                        <a href="#" class="printSanad" onclick="printSanad(${data.transactionId})">طباعة أورنيك 17</a><br />
                                        <a href="#" class="printSanad" onclick="DeleteTransaction(${data.transactionId})">الغاء الحركة</a><br />
                                        <a href="#" class="btnPost">ترحيل</a><br />
                                    </div>
                                </div>
                            `;
                            }

                        },
                    ]
                });

            }
            loadData();

            creditAmountObj = CustomAutoNumeric('#creditAmount');
            debitAmountObj = CustomAutoNumeric('#debitAmount');
            recipientAmountObj = CustomAutoNumeric('#recipientAmount');

            select2list("#addAccName", "/Shared/getAccTrees", "اسم الحساب");
            select2listNew("#recipient", "/Shared/getAllRecipient", "اسم المستلم");
            select2list("#addCurrencyType", "/Shared/getCurrency", "العملة");
            select2list("#documentType", "/Shared/getDocumentTypes", "نوع السند");

        });

        //-------------------------------------------------Start Validator ------------------------------------------------------------------------------------------------------------

        $('#add-form').bootstrapValidator({
            onSuccess: function (e) {
                //save();
                e.preventDefault();

            },
            submitButtons: 'button[type="submit"]',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok success-feedback-icons',
                invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                validating: 'fa fa-refresh fa-spin success-feedback-icons'
            },
            fields: {
                addAccName: {
                    validators: {
                        notEmpty: {
                            message: 'يجب الا يكون حقل اسم الحساب  فارغ'
                        }
                    }
                },
                creditAmount: {
                    validators: {
                        callback: {
                            message: 'ادخل رقم بحيث لا يحتوي على اكثر من خانتين عشريتين',
                            callback: function (value, validator) {
                                // إزالة الفواصل بين الآلاف
                                let sanitizedValue = value.replace(/,/g, '');
                                // regexp: /^[0-9]*\.?[0-9]*$/;
                                return /^\d+(\.\d{1,2})?$/.test(sanitizedValue);
                            }
                        }
                    }
                },
                debitAmount: {
                    validators: {
                        callback: {
                            message: 'ادخل رقم بحيث لا يحتوي على اكثر من خانتين عشريتين',
                            callback: function (value, validator) {
                                // إزالة الفواصل بين الآلاف
                                let sanitizedValue = value.replace(/,/g, '');
                                // regexp: /^[0-9]*\.?[0-9]*$/;
                                return /^\d+(\.\d{1,2})?$/.test(sanitizedValue);
                            }
                        }
                    }
                },
            }
        });
        $('#add-statement-form').bootstrapValidator({
            onSuccess: function (e) {
                e.preventDefault();
                saveNew();
                // Reset the form after saving the data
                $('#add-statement-form').bootstrapValidator('resetForm', true); // Reset the form's validation
                $('#add-statement-form')[0].reset(); // Clear the form fields

                // Reset the form after saving the data
                $('#add-form').bootstrapValidator('resetForm', true); // Reset the form's validation
                $('#add-form')[0].reset(); // Clear the form fields
            },
            submitButtons: 'button[type="submit"]',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok success-feedback-icons',
                invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                validating: 'fa fa-refresh fa-spin success-feedback-icons'
            },
            fields: {
                transactionDate: {
                    validators: {
                        notEmpty: {
                            message: 'يجب الا يكون حقل اسم تاريخ القيد  فارغ'
                        }
                    }
                },
                statement: {
                    validators: {
                        notEmpty: {
                            message: 'يجب الا يكون حقل البيان  فارغ'
                        }
                    }
                },
            }
        });

        //-------------------------------------------------End Validator ------------------------------------------------------------------------------------------------------------

        var rptList = [];

        function addToTable() {
            //هنا لازم ندخل اسم الحساب
            var addAccName = $('#select2-addAccName-container').text();
            var addAccNameId = $('.addAccName').val();
            var addBalanceAccName = $('#select2-addBalanceId-container').text();

            var creditAmount = creditAmountObj.getNumber();
            var debitAmount = debitAmountObj.getNumber();

            var IsCreditText = '';

            if (creditAmount > 0) {
                IsCreditText = "دائن";
            } else {
                IsCreditText = "مدين";
            }

            var isFound = false;

            if (addAccName.trim() != "" & addAccNameId != null & creditAmount >= 0 & debitAmount >= 0) {
                $('.myTbody tr').each(function () {
                    var id = $(this).find('td:eq(0)').text();
                    var creditAmountOld = $(this).find('td:eq(1)').text();
                    var debitAmountOld = $(this).find('td:eq(2)').text();

                    if (id == addAccNameId && (debitAmount == debitAmountOld || creditAmount == creditAmountOld)) {
                        //break here if found
                        isFound = true;

                        return false;
                    }
                });

                if (!isFound) {
                    var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                        + "<td class='id'>" + addAccNameId + "</td>"
                        + "<td class='name'>" + addAccName + "</td>"
                        + "<td class='debitAmount'>" + debitAmount + "</td>"
                        + "<td class='creditAmount'>" + creditAmount + "</td>"
                        // + "<td class='creditAmount'>" + addBalanceAccName + "</td>"
                        + "<td class='transDetailId hidden'>" + 0 + "</td>"
                        + '<td class="btnDelete"> <button id="delete" class="btn btn-warning transfer delete">حذف<i class=" transfer-fa fa  fa-trash"></i></button>' + "</td>"
                        + "</tr>";

                    $('.myTbody').append(rows);
                    $('.addAccName').val('');
                    $('.amount').val('');
                    $('.list').text(null).trigger('change');
                    $('.list').val(null).trigger('change');
                    $('.debitAmount').val('');
                    $('.creditAmount').val('');
                    isFound = false;

                    if (creditAmount > 0) {
                        rptList.push({
                            "addAccName": addAccName,
                            "accTrreId": addAccNameId,
                            "amount": 0,
                            "credit": parseFloat(parseFloat(creditAmount).toFixed(2)),
                            "debit": 0,
                            "isCredit": "true",
                            "documentTypeId": 8,
                        });
                    } else {
                        rptList.push({
                            "addAccName": addAccName,
                            "accTrreId": addAccNameId,
                            "Amount": 0,
                            "credit": 0,
                            "debit": parseFloat(parseFloat(debitAmount).toFixed(2)),
                            "IsCredit": "false",
                            "documentTypeId": 8,
                        });
                    }

                    var totalCreditAmount = 0;
                    var totalDebitAmount = 0;

                    $.each(rptList, function (index, value) {
                        totalDebitAmount += value.debit;
                        totalCreditAmount += value.credit;

                    });

                    var balance = parseFloat(parseFloat(totalCreditAmount).toFixed(2)) - parseFloat(parseFloat(totalDebitAmount).toFixed(2));
                    var tblFooter = '<tr>' +
                        '<td colspan="1">الاجمالي</td>' +
                        '<td colspan="2">' + parseFloat(parseFloat(totalDebitAmount).toFixed(2)) + '</td>' +
                        '<td colspan="2">' + parseFloat(parseFloat(totalCreditAmount).toFixed(2)) + '</td>' +
                        '</tr>' +
                        '<tr>' +
                        '<td colspan="2">الصافي</td>' +
                        '<td colspan="3">' + balance + '</td>' +
                        '</tr>';

                    $('.myTFoot').empty();
                    $('.myTFoot').append(tblFooter);
                }
                else {
                    toastr["error"]("هذاالحساب موجود في القائمة", "خطأ");
                }

                $(".AmountCurrencyDecimalText").text('');
                $(".AmountCurrencyDecimalTextCr").text('');
            } else {
                toastr["error"]("الرجاء ادخال جميع البيانات", "خطأ");
            }

            creditAmountObj.set(0);
            debitAmountObj.set(0);

        }

        $('#btnSave').click(function () {

            var transactionId = $('#TransactionId').text();
            var statement = $('#Note').val();
            var currencyId = $('#addCurrencyType').val();
            var transactionDate = moment($('#transactionDate').val(), "DD/MM/YYYY").format("MM/DD/yyyy");

            var totalDebitAmount = 0;
            var totalCreditAmount = 0;

            $.each(rptList, function (index, value) {
                totalDebitAmount = totalDebitAmount + parseFloat(parseFloat(value.debit).toFixed(2));
                totalCreditAmount = totalCreditAmount + parseFloat(parseFloat(value.credit).toFixed(2));

            });

            totalDebitAmount = parseFloat(parseFloat(totalDebitAmount).toFixed(2));
            totalCreditAmount = parseFloat(parseFloat(totalCreditAmount).toFixed(2));

            if (totalDebitAmount == 0 || totalCreditAmount == 0) {
                toastr["error"]("يجب ادخال القيم اولا", "خطأ");
            }
            else if (totalDebitAmount == totalCreditAmount) {
                $('.presntTBody').empty();
                rptList.forEach(function (row) {
                    var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                        + "<td class='id'>" + row['debit'] + "</td>"
                        + "<td class='name'>" + row['credit'] + "</td>"
                        + "<td class='Amount'>" + row['addAccName'] + "</td>"
                        + '</tr>';

                    $('.presntTBody').append(rows);
                    $('#add-statement-modal').modal('show');
                });
            } else {
                toastr["error"]("الرجاء مساواة الطرفين ", "خطأ");
            }
        });

        $('#btnCreate').click(function () {
            var transactionId = $('#TransactionId').text();
            var statement = $('#Note').val();
            var currencyId = $('#addCurrencyType').val();
            var transactionDate = moment($('#transactionDate').val(), "DD/MM/YYYY").format("MM/DD/yyyy");

            if (statement != null & transactionDate != null) {
                //هنا اضفنا حقل البيان والتاريخ لي مصفوفة موجودة مسبقا بها بيانات
                rptList = rptList.map(v => Object.assign(v, { "transactionId": transactionId, "note": statement, "transactionDate": transactionDate, "currencyId": currencyId }));

                $.ajax({
                    //url: "/Transactions/Update",
                    url: "",
                    type: "POST",
                    data: JSON.stringify(rptList),
                    contentType: "application/json charset=utf-8",
                    dataType: "json",
                    error: function (response) {
                        toastr[response.Status](response.Message, response.Title);
                    },
                    success: function (response) {
                        if (response.Status == "warning") {
                            toastr[response.Status](response.Message, response.Title);
                        } else {
                            toastr[response.Status](response.Message, response.Title);
                            //$('.list').val(null).trigger('change');
                            $('#add-modal').modal("hide");
                            $('#add-statement-modal').modal("hide");
                            $(".presntTBody").empty();
                            window.location.reload();
                        }
                    }
                });

            } else {
                toastr["error"]("الرجاء ادخال جميع البيانات", "خطأ");
            }
        });

        function saveNew() {
            var statement = $('#statement').val();
            var currencyId = $('#addCurrencyType').val();
            var recipientId = $('#recipient').val();
            var recipient = $('#recipient option:selected').text();

            if (recipient.includes(" - ")) {
                recipient = recipient.split(" - ")[0];
            } else {
                recipient = recipient; // لو مافي شرطة، نحتفظ بالنص كما هو
            }
            var transactionDate = $('#transactionDate').val();
            // var transactionDate = moment($('#transactionDate').val()).format("MM/DD/YYYY");

            var documentTypeId = $('#documentType').val();

            if (statement != null & transactionDate != null) {
                //هنا اضفنا حقل البيان والتاريخ لي مصفوفة موجودة مسبقا بها بيانات
                rptList = rptList.map(v => Object.assign(v, {
                    'documentTypeId': documentTypeId,
                    "recipient": recipient,
                    "note": statement,
                    "transactionDate": transactionDate,
                    "currencyId": currencyId,
                    "recipientId": recipientId
                }));

                $.ajax({
                    url: "/Shared/Create",
                    type: "POST",
                    data: JSON.stringify(rptList),
                    contentType: "application/json charset=utf-8",
                    dataType: "json",
                    error: function (response) {
                        toastr[response.Status](response.Message, response.Title);
                    },
                    success: function (response) {
                        if (response.Status == "warning") {
                            toastr[response.Status](response.Message, response.Title);
                        } else {
                            toastr[response.Status](response.Message, response.Title);
                            //$('.list').val(null).trigger('change');
                            $('#add-modal').modal("hide");
                            $('#add-statement-modal').modal("hide");
                            $(".presntTBody").empty();
                            $(".myTbody").empty();
                            $('.myTFoot').empty();
                            $('#tbx').DataTable().ajax.reload();
                            rptList = [];
                        }
                    }
                });

            } else {
                toastr["error"]("الرجاء ادخال جميع البيانات", "خطأ");
            }
        }

        $('#creditAmount').keyup(function () {
            var creditAmount = $(this).val();

            if (creditAmount != null & creditAmount > 0) {
                debitAmountObj.set(0);
                // $('#debitAmount').val(0);
            }
        });

        $('#debitAmount').keyup(function () {
            var debitAmount = $(this).val();

            if (debitAmount != null & debitAmount > 0) {
                creditAmountObj.set(0);
