@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

@section content{
    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <div class="grad"></div>

        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>
                سندات القبض
            </h1>
            <ol class="breadcrumb">
                <li><a href="#"><i class="fa fa-home"></i> النظام المالي </a></li>
                <li class="active"> سندات القبض</li>
            </ol>
        </section>

        <section class="content">
            <div class="row">
                <div class="col-xs-12">
                    <div class="box">
                        <div class="box-header">
                            <button type="button" class="btn btn-primary pull-left btn-add" data-toggle="modal" data-target="#add-modal"><i class="fa fa-plus-square">  </i> سند جديد </button>
                        </div><!-- /.box-header -->
                        <div class="box-body">
                            <div class="container" style="margin-top:30px;">
                                @*<table id="tbx" class="table table-bordered table-sm table-hover" style="width:100%"></table>*@
                                <table id="tbx" class="table table-bordered table-hover"></table>
                            </div><!-- /.box-body -->
                        </div><!-- /.box-body -->
                    </div><!-- /.box -->
                </div><!-- /.col -->
            </div><!-- /.row -->
        </section>

    </div><!-- /.content-wrapper -->

    <div class="example-modal">
        <div class="modal fade in" id="add-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:90% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة مستند قبض جديد</h4>
                    </div>
                    <div class="modal-body">
                        <form id="add-form">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="col-lg-3 hidden">
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <label for="ed-name">رقم السند</label>
                                                    <div class="input-group">
                                                        <input type="text" class="form-control  receiptNumber disabled" id="receiptNumber" name="receiptNumber" placeholder="رقم السند" autocomplete="off">
                                                    </div>
                                                </div>
                                            </div>
                                            <hr />
                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <label for="refNumber"> رقم المرجع</label>
                                                    <div class="input-group">
                                                        <input type="text" class="form-control refNumber" id="refNumber" name="refNumber" placeholder="رقم المرحع" autocomplete="off">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <label for="ed-name"> اسم المرجع</label>
                                                    <div class="input-group">
                                                        <input type="text" class="form-control refName" id="refName" name="refName" placeholder="اسم المرجع " autocomplete="off">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-6">
                                        <div class="row hidden">
                                            <div class="col-lg-6">
                                                <input type="radio" name="isCash" value="1" checked />
                                                <label>
                                                    شيك
                                                </label>
                                            </div>
                                            <div class="col-lg-6">
                                                <input type="radio" name="isCash" value="2" />
                                                <label>
                                                    نقدا
                                                </label>
                                            </div>
                                        </div>
                                        <hr />
                                        <div class="row">
                                            <div class="row">
                                                <div class="col-lg-6">
                                                    <label id="fundLabelTitle">الحساب</label>
                                                    <select class="form-control list debitAccTreeId fund" name="debitAccTreeId" id="debitAccTreeId" style="width:100%"></select>
                                                </div>
                                                <div class="col-lg-6">
                                                    <label id="currencyLabelTitle">العملة</label>
                                                    <select class="form-control list currency" name="currency" id="currency" style="width:100%"></select>
                                                </div>
                                            </div>
                                            <br />
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    <label>البيان</label>
                                                    <input class="form-control debitStatment" id="debitStatment" name="debitStatment" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-6">
                                        <div class="row hidden">
                                            <div class="col-lg-6">
                                                <input type="checkbox" name="susppend" id="susppend" />
                                                <label>
                                                    معلق
                                                </label>
                                            </div>

                                            <div class="col-lg-6">
                                                <input type="checkbox" name="posted" id="posted" />
                                                <label>
                                                    مرحل
                                                </label>
                                            </div>
                                        </div>
                                        <hr />

                                        <div class="row" style="margin-right: 10px;">
                                            @*<div class="row">
                                                    <div class="col-lg-12">
                                                        <label>اسم المستلم</label>
                                                        <input class="form-control recipient" id="recipient" name="recipient" />
                                                    </div>
                                                </div>*@
                                            <div class="col-lg-12">
                                                <label for="balanceId">بند الموازنة</label>
                                                <select class="form-control list balanceId fund" name="balanceId" id="balanceId" style="width:100%"></select>
                                            </div>
                                        </div>
                                        <br />
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <label>تاريخ السند</label>
                                                <input class="form-control calendar receiptDate" id="receiptDate" name="receiptDate" />
                                            </div>
                                            <div class="col-lg-6">
                                                <label> اسم المستلم </label>
                                                <input class="form-control recipient" id="recipient" name="recipient" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <hr />
                            <div class="row">
                                <div class="col-lg-4">
                                    <label for="debitAmount">الدائن</label>
                                    <input type="text" class="form-control creditAmount credit-input" id="creditAmount" name="creditAmount" placeholder="المبلغ الدائن" autocomplete="off" />
                                </div>
                                <div class="col-lg-4">
                                    <label for="debitAccTreeId">الحساب</label>
                                    <select class="form-control list creditAccTreeId credit-input" id="creditAccTreeId" style="width:100%" name="creditAccTreeId"></select>
                                </div>
                                <div class="col-lg-4">
                                    <label for="creditNote">محلوظات</label>
                                    <input class="form-control creditNote credit-input" id="creditNote" name="creditNote" />
                                </div>
                            </div>

                            <br />
                            <div class="row">
                                <div class="col-lg-12">
                                    <button type="button" class="btn btn-primary btn-block" onclick="addToTable()"> إضافة <i class="fa fa-arrow-alt-circle-down"></i></button>
                                </div>
                            </div>
                            <hr />
                            <table id="tbl" class="dataTable table table-striped table-hover" style="width:100%">
                                <thead>
                                    <tr>
                                        <th> دائن </th>
                                        <th>الحساب</th>
                                        <th>البيان</th>
                                    </tr>
                                </thead>
                                <tbody id="tbod"></tbody>
                            </table>

                            <div class="row">
                                <div class="col-lg-12">
                                    <button type="submit" class="btn btn-success btn-block" id="btnSave">حفظ</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>

    <div class="example-modal">
        <div class="modal fade in" id="details-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:60% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> عرض تفاصيل القيد</h4>
                    </div>
                    <div class="modal-body">
                        <div class="row" style="margin:0px;">
                            <div class="col-lg-3 text-right">
                                <label>التاريخ :</label><label class="tarnsDate"></label>
                            </div>
                            <div class="col-lg-9 text-left">
                                <label> البيان :</label><label class="tarnsStatement"></label>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <table class="table table-bordered table-striped table-hover">
                                <thead style="background-color:#808080">
                                    <tr class="text-center">
                                        <td>#</td>
                                        <td>الحساب</td>
                                        <td>مدين</td>
                                        <td>دائن</td>
                                    </tr>
                                </thead>
                                <tbody class="detailsTBody"></tbody>
                            </table>
                        </div>

                    </div><!-- /.modal-content -->
                </div><!-- /.modal-dialog -->
            </div><!-- /.modal -->
        </div>
    </div>

}

@section scripts{
    <script>
        $(document).ready(function () {

            function loadData() {
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    ajax: {
                        url: '/CatchReceipts/LoadData',
                        dataSrc: ''
                    },
                    columns: [
                         {
                             "title": "",
                             "data": "TransactionId",
                             "orderable": false,
                             "render": function (data) {
                                 return '<a class="btn btn-info btnDetails" data-toggle="modal" data-target="#details-modal"><i class="fa fa-info"></i></a>';
                             }
                         },
                        {
                            "title": "# ",
                            "data": "TransactionId"
                        },
                        {
                            "title": "البيان",
                            "data": "Note"
                        },
                        {
                            "title": "نوع القيد",
                            "data": "DocumentType"
                        },
                        {
                            "title": "المبلغ الاجمالي",
                            "data": "TotalAmount"
                        },
                        {
                            "title": "العملة",
                            "data": "Currency"
                        },
                        {
                            "title": "سعر الصرف",
                            "data": "ExchangeRate"
                        },
                        {
                            "title": "تاريخ القيد",
                            "data": "TransactionDate"
                        },
                        {
                            "title": "<i class='fa fa-cog'></i>",
                            "data": null,
                            "width": "10%",
                            "orderable": false,
                            "render": function (data) {
                                return '<div class="btn-group">'
                                            + '<button type="button" class="btn btn-default" data-toggle="dropdown">  <i class="fa fa-ellipsis-v"></i> </button> <div class="dropdown-menu btn-threePoint">'
                                            //+ '<a href="#" class="btnEdit"> تعديل</a>  <br />'
                                            + '<a href="#" class="btnPost">ترحيل</a>  <br />'
                                    + '</div> </div>'
                                ;
                            }
                        },
                    ]
                });
            }
            loadData();

            function select2list(selector, url, placeholder) {
                $(selector).select2({
                    language: { inputTooShort: function () { return 'enter 1 letter at less'; } },
                    ajax: {
                        url: url,
                        dataType: 'json',
                        delay: 100,
                        data: function (params) {
                            return {
                                q: params.term,
                                page: params.page
                            };
                        },
                        processResults: function (data, params) {
                            params.page = params.page || 1;
                            return {
                                results: data,
                                pagination: {
                                    more: ((data.total_count) > (params.page * 20))
                                }
                            };
                        },
                        cache: true
                    },
                    placeholder: placeholder,
                    minimumInputLength: 1,
                });

            };
            select2list(".debitAccTreeId", "/Reciepts/GetBankAccount", "   الحساب ");
            select2list(".creditAccTreeId", "/Reciepts/GetSubAccount", "   الحساب ");
            select2list(".balanceId", "/Transactions/getBalanceIds", "   الحساب ");
            select2list(".currency", "/CurrencyTypes/GetCurrencyType", "  العملة ");
        });

        //When button Add Clicked... Data send to the next table
        function addToTable(){

            var accTreeId = $('.creditAccTreeId').val();
            var accTree = $('#select2-creditAccTreeId-container').text();
            var amount = $('.creditAmount').val();
            var note = $('#creditNote').val();


            if (accTreeId != null & amount != null) {
                var row = '<tr><td class="tb-creditAmount">' + amount +
                    '</td><td class=" tb-creditAccTreeId hidden" >' + accTreeId +
                    '</td><td class="tb-creditccTree" >' + accTree +
                    '</td><td class="tb-creditNote">' + note + '</td></tr>';

                $('#tbod').append(row);
                $('.credit-input').val('');
                //$('.det').text('');
                $('.credit-input').val(null).trigger('change');
            } else {
                toastr.error('يجب ملء جميع الحقول', 'خطأ');
            }
        };

        //Validation Form Before Save Data
        $('#add-form').bootstrapValidator({
            onSuccess: function (e) {
                save();
                e.preventDefault();

            },
            submitButtons: 'button[type="submit"]',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok success-feedback-icons',
                invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                validating: 'fa fa-refresh fa-spin success-feedback-icons'
            },
            fields: {

                currency: {
                    validators: {
                        notEmpty: {
                            message: 'يجب الا يكون حقل اسم العملة  فارغ'
                        }
                    }
                },

                creditAmount: {
                    validators: {
                        callback: {
                            message: 'ادخل رقم بحيث لا يحتوي على اكثر من خانتين عشريتين',
                            callback: function (value, validator) {
                                // Check if the value is a number or a decimal
                                return /^\d+(\.\d{1,2})?$/.test(value);
                            }
                        }
                    }
                },

            }
        });

        //prevent key enter
        $('#add-form').on('keypress', function (e) {
            // Check if the key pressed is Enter (key code 13)
            if (e.which === 13) {
                // Prevent the default form submission
                e.preventDefault();
            }
        });

        //Save Function
        function save() {
            var data = [];
            RefNumber = $('#refNumber').text();
            RefName = $('#refName').text();
            IsCash = $("input[name= 'isCash']:checked").val(); currency
            BankFundId = $("select[name= 'fund']").val();
            CurrencyTypeId = $("select[name= 'currency']").val();
            ReceiptNot = $("input[name= 'statment']").val();
            Recipient = $("input[name= 'recipient']").val();
            ReceiptDate = $("input[name= 'receiptDate']").val();
            balanceId = $(".balanceId").val();
            transactionDate = $(".receiptDate").val();
            Recipient = $("#recipient").val();
            //transactionDate = moment(transactionDate).format('MM-DD-YYYY');


            data.push({
                DebitAccTreeId: $("select[name= 'debitAccTreeId']").val(),
                //CreditAmount: $("select[name= 'fund']").val(),
                DebitNote: $("input[name= 'debitStatment']").val(),
                Currency: CurrencyTypeId,
                BalanceAccTreeId: balanceId,
                TransactionDate: transactionDate,
                Recipient: Recipient,
                //DebitAccTreeId: 0,
                DebitAmount: 0,
            });

            $("#tbod tr").each(function (index) {
                CreditAccTreeId = $(this).find('.tb-creditAccTreeId').text();
                CreditAmount = $(this).find('.tb-creditAmount').text();
                CreditNote = $(this).find('.tb-creditNote').text();
                //---->Form validation goes here

                data.push({
                    CreditAccTreeId: CreditAccTreeId,
                    CreditAmount: CreditAmount,
                    CreditNote: CreditNote,
                    Recipient: Recipient,
                    //CreditAccTreeId: 0,
                    //CreditNote: $("input[name= 'creditStatment']").val(),
                    Currency: CurrencyTypeId,
                    BalanceAccTreeId: balanceId,
                    TransactionDate: transactionDate,
                });

            });

            console.clear();
            console.log(data);
            console.log(balanceId);

            $.ajax({
                url: "/CatchReceipts/Create",
                type: "POST",
                data: JSON.stringify(data),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    if (response.Status == "warning") {
                        toastr[response.Status](response.Message, response.Title);
                    } else {
                        toastr[response.Status](response.Message, response.Title);
                        //$('.list').val(null).trigger('change');
                        //$('#add-form').bootstrapValidator("resetForm", true);
                        //$("table tbody tr").empty();
                        window.location.reload();
                    }
                }
            });
        }

        //Go to Print View
        function printchecs(id) {
            window.open("/PrintChecs/Index/" + id, "_blank");
            //window.location.href = "/PrintChecs/Index";
        }
        //Go to Print View
        function printSanad(id) {
            window.open("/Reciepts/printOrnik17/" + id, "_blank");
            //window.location.href = "/PrintChecs/Index";
        }


        /*----------------------------------------------------------------------------------------------------------*/

        //addedTax الضريبة المضافة
        $('#tbx').on('click', '.addedTax', function () {
            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var TransactionId = data['TransactionId'];

            console.clear();
            console.log(TransactionId);

            $.post('/Transactions/AddingAddedTax', { "Id": TransactionId }, function (response) {
                toastr[response.Status](response.Message, response.Title);
                $('#tbx').DataTable().ajax.reload();
            });
        });

        //posting الترحيل
        $('#tbx').on('click', '.btnPost', function () {
            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var TransactionId = data['TransactionId'];

            console.clear();
            console.log(TransactionId);

            $.post('/Transactions/Posting', { "Id": TransactionId }, function (response) {
                toastr[response.Status](response.Message, response.Title);
                $('#tbx').DataTable().ajax.reload();
            });
        });

        $('#tbx').on('click', '.btnDetails', function () {
            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var TransactionId = data['TransactionId'];
            var TransactionDate = data['TransactionDate'];
            var Note = data['Note'];

            $('.tarnsDate').text(TransactionDate);
            $('.tarnsStatement').text(Note);

            $.post('/Transactions/getTransDetailsData', { "Id": TransactionId }, function (response) {
                $('.detailsTBody').empty();
                $.each(response, function (key, value) {
                    var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                                    + "<td class='id'>" + value.id + "</td>"
                                    + "<td class='accName'>" + value.accName + "</td>"
                                    + "<td class='accName'>" + value.debit + "</td>"
                                    + "<td class='credit'>" + value.credit + "</td>"
                                + "</tr>";
                    $('.detailsTBody').append(rows);
                });
            });
        });

        //Editing التعديل
        $('#tbx').on('click', '.btnEdit', function () {

            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var Id = data['TransactionId'];
            window.open('/Transactions/Edit/' + Id, '_blank');
        });

    </script>
}