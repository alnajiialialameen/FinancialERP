@model  IEnumerable<Purchases.Models.ViewModel.BalanceVM>
@{
    ViewBag.Title = "PrintInvoice";
    Layout = "~/Views/Shared/_LayoutPrint.cshtml";
}

<style>
    .p-r{
        padding-right: 40px !important;
    }
</style>
<section class="invoiceCupps">
    <div class="invoice-Cupps-header">
        <div class="image-L">
            <img src="~/Temp/Image/WhiteLogo.png" height="100" />
        </div>

        <div class="text-center text-word">
            <h6>شركة مطارات السودان المحدودة</h6>
            <h6>الادارة العامة للشؤون المالية والمحاسبية</h6>
            <h6>إدارة الحسابات</h6>

        </div>

        <div class="image-R">
            <img src="~/Temp/Image/WhiteLogo.png" class="image-L" height="100" />
        </div>
    </div>
    <br />
    <div class="invoice-Body">
        <div class="wrapper">
            <div class="row">
                <div class="col-md-12 justify-content-center text-center">
                    <h2><u>@ViewBag.CurrentFinancialCycle  مراقبة الصرف العام المالي</u></h2>
                    <h2><u>@ViewBag.AccName</u></h2>
                </div>

                @{
                    if (@ViewBag.DateFrom != null && @ViewBag.DateTo != null)
                    {
                        <div class="text-center">
                            <h3>في الفترة من @ViewBag.DateFrom و حتي @ViewBag.DateTo</h3>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="text-center">
        <div style="display:flex; justify-content:space-between; padding: 5px;">
            <span>@DateTime.Now</span>تاريخ الطباعة
        </div>

        <table class="table table-bordered table-striped">
            <thead class="bg-dark">
                <tr class="text-center">
                    <td>الصرف الفعلي</td>
                    <td colspan="3">البند</td>
                    <td>#</td>
                </tr>
            </thead>
            <tbody>
                @{
                    int counter = 1;
                    foreach (var item1 in Model)
                    {
                        foreach (var item in item1.details)
                        {
                                <tr>
                                    <td class="text-right amount">@item.actualExchange</td>
                                    <td colspan="3" class="p-r text-right">@item.accTreeName</td>
                                    <td class="text-center"> @counter</td>
                                </tr>
                            counter = counter + 1;
                        }
                    }

                    <tr class="text-center" style="background-color:#d3caca">
                        <td class="amount">@Model.Sum(s => s.details.Sum(a=> a.actualExchange))</td>
                        <td colspan="4">الاجمالي</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="number-Word invoice-footer">
        <div class="number-Word"> @ViewBag.txtSumOfBous </div>

        <div class="chief ">
            <div class="Manager">
                <span>        التوقيع</span><br /><br />
                <span>-------------------------------</span>
            </div>
        </div>
    </div>

</section>
