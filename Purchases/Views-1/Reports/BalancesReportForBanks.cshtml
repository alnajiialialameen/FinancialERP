@{
    ViewBag.Title = "TaxReport";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<h2>TaxReport</h2>

@section content
{
    <div class="content-wrapper">
        <div class="grad"></div>
        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>
                المصروفات حسب البنك
            </h1>
            <ol class="breadcrumb">
                <li><a href="#"><i class="fa fa-home"></i> النظام المحاسبي</a></li>
                <li class="active">المصروفات حسب البنك</li>
            </ol>
        </section>

        <section class="content">
            <div class="row">
                <div class="col-lg-4">
                    <div class="form-group">
                        <label for="transactionDate"> من تاريخ</label>
                        <div class="input-group">
                            <span class="input-group-addon">
                                <i class="fa fa-calendar-alt"></i>
                            </span>
                            <input type="text" class="form-control  calendar DateFrom" id="DateFrom" name="DateFrom" placeholder="تاريخ القيد" autocomplete="off">
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="form-group">
                        <label for="transactionDate"> الي تاريخ</label>
                        <div class="input-group">
                            <span class="input-group-addon">
                                <i class="fa fa-calendar-alt"></i>
                            </span>
                            <input type="text" class="form-control  calendar DateTo" id="DateTo" name="DateTo" placeholder="حتي تاريخ" autocomplete="off">
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="form-group">
                        <label for="name">اسم البنك</label>
                        <div class="input-group">
                            <div class="input-group-addon">
                                <i class="fa fa-book"></i>
                            </div>
                            <select class="form-control list addAccName" name="addAccName" id="addAccName" style="width:100%"></select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class=" col-md-3">
                    <button id="btnsearch" onclick="Search()" class="btn btn-primary btn-sm form-control">بحث</button>
                </div>

                <div class=" col-md-3">
                    <button id="btnall" onclick="PrintData()" class="btn form-control btn-info btn-sm">طباعة التقرير </button>
                </div>
            </div>

            <div class="row" style="margin: 30px;">
                <table id="tbl" class="dataTable table table-striped table-hover" style="width:100%">
                    <tbody id="tbod"></tbody>
                </table>
            </div>
        </section>
    </div>
}

@section scripts{

    <script>
        var myId = 0;

        $(document).ready(function () {
            select2list("#addAccName", "/Shared/getAllBanks", "اسم البنك");
        });

        function PrintData() {
            var Id = $('.addAccName').val();
            var DateFrom = $('#DateFrom').val();
            var DateTo = $('#DateTo').val();

            if (Id === "") {
                Swal.fire({
                    icon: "error",
                    title: "خطاء",
                    text: "الرجاء اختيار اسم الحساب",
                });
                return;
            }

            var url = "/Reports/BalancePositionForBanks?dateFrom=" + DateFrom + "&dateTo=" + DateTo + "&&ParentId=" + Id;

            window.open(url, '_blank').focus();
        }
    
        function Search() {
            var DateFrom = $('#DateFrom').val();
            var DateTo = $('#DateTo').val();
            var Id = $('.addAccName').val();

            if (Id === "") {
                Swal.fire({
                    icon: "error",
                    title: "خطاء",
                    text: "الرجاء اختيار اسم الحساب",
                });
                return;
            }

            var dataTable = $('#tbl').DataTable({
                destroy: true,
                "language": {
                    "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                    "search": "بحث"
                },
                ajax: {
                    url: "/Reports/BalancePositionForBanksSearch?dateFrom=" + DateFrom + "&dateTo=" + DateTo + "&&ParentId=" + Id,
                    dataSrc: ''
                },
                columns: [
                    {
                        "title": "# ",
                        "data": "Id"
                    },
                    {
                        "title": "اسم الحساب",
                        "data": "accTreeName"
                    },
                    {
                        "title": "التصديق الكلي",
                        "data": "credint",
                        "render": function (data, type, row) {
                            return formatNumber(data.toString());
                        }
                    },
                    {
                        "title": "اجمالي المنصرف",
                        "data": "actualExchange",
                        "render": function (data, type, row) {
                            return formatNumber(data.toString());
                        }
                    },
                    //{
                    //    "title": "التفاصيل",
                    //    "data": "actualExchange",
                    //    "render": function (data, type, row) {
                    //        return formatNumber(data.toString());
                    //    }
                    //},

                    {
                        "title": "<i class='fa fa-cog'></i>",
                        "data": null,
                        "width": "10%",
                        "orderable": false,
                        "render": function (data) {
                            return `<a href="#" class="addedTax" onclick="printLedgerByDates(${data.Id})">التفاصيل</a><br />`;
                        }
                    },
                ]
            });
        }


        function printLedgerByDates(Id) {
            var accId = $('.addAccName').val();
            var DateFrom = $('#DateFrom').val();
            var DateTo = $('#DateTo').val();

            window.open(`/Reports/printLedgerByDates?Id=${Id}&bankId=${accId}&DateFrom=${DateFrom}&DateTo=${DateTo}`, '_blank');
        }

    </script>
}