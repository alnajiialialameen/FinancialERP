@{
    ViewBag.Title = "Bank Letter";
    Layout = "~/Views/Shared/_LayoutPrint.cshtml";
}

<style>
    *, .h3, h4 {
        font-family: ui-serif;
    }

    .p-r {
        padding-right: 40px !important;
    }
</style>

<section class="invoiceCupps">
    <div class="invoice-Cupps-header">
        <div class="text-left text-word">
            <p>Sudan Airports Company Ltd.</p>
            <p>Administration of Financial & Accounting</p>
            @*<p>Accounts Department</p>
                <p>Tel: 0123-456-789</p>
                <p>Fax : 0977-839-998</p>*@
        </div>

        <div class="text-center">
            <img src="~/Temp/Image/WhiteLogo.png" height="150" />
        </div>

        <div class="text-right text-word">
            <p>شركة مطارات السودان المحدودة</p>
            <p>الادارة العامة للشؤون المالية والمحاسبية</p>
            @*<p>إدارة الحسابات</p>
                <p>تـلـ: 0123-456-789</p>
                <p>فاكس : 0977-839-998</p>*@

        </div>


    </div>

    <div class="invoice-Body" dir="rtl">

        <div class="wrapper">
            <div class="row">
                <div style="display: flex; justify-content: space-between; margin: 0px 15px;">
                    <div class="text-right">
                        @*<h4> التاريخ : @ViewBag.TransactionDate</h4>*@
                        <h4> التاريخ : @DateTime.Now.ToString("yyyy-MM-dd")</h4>
                    </div>
                    <div class="text-left">
                        <h4> م [@ViewBag.Id]</h4>

                    </div>
                </div>
                <div class="col-md-12 justify-content-center text-right">
                    <h4> السيد مدير / @ViewBag.BankLabel</h4>
                </div>
                <br />
                <div class="col-md-12 justify-content-center text-center">
                    <h4> السلام عليكم ورحمة الله وبركاته</h4>
                </div>
                <br />
                <div class="col-md-12 justify-content-center text-center">
                    <h4><u>الموضوع/ تحويل مالي</u></h4>
                </div>
            </div>

            <br />

            <div class="row">
                <div class="col-md-12 justify-content-center text-right">
                    <h4>
                        بالاشارة للموضوع اعلاه نرجو كريم تفضلكم بتحويل مبلغ وقدره <span class="amount">@ViewBag.TotlaAmount</span> جنيه (@ViewBag.TotalAmountTxt)
                        من حساب شركة مطارات السودان المحدودة طرفكم <span class="h3">@ViewBag.SendBank </span>
                    </h4>
                    <br />
                    <h4>
                        وتحويله الي <span class="h3">@ViewBag.RecipientDetails</span>
                    </h4>
                </div>
            </div>
        </div>
    </div>

    <br />

    <div class="number-Word invoice-footer">
        <br /> <br /><br />
        <div class="row">
            <div class="col-md-12 justify-content-center text-center">
                <p> ... ولكم خالص الشكر و التقدير </p>
            </div>
        </div>
        <br /><br /><br /><br />
        <div style="display: flex; justify-content: space-between">
            <div class="text-right">
                <span>---------------</span>
                <span>توقيع ثاني</span>
                @*<p>@Session["FullName"].ToString()</p>*@
                <p>@ViewBag.SecondSignature</p>
            </div>

            <div class="text-right">
                <span>---------------</span>
                <span>توقيع اول</span>
                @*<p>بلقيس محجوب محمد</p>*@
                <p>@ViewBag.FirstSignature</p>
            </div>
        </div>
    </div>

</section>
