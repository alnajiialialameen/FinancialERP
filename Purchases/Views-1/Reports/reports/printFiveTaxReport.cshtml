@model  IEnumerable<Purchases.Models.ViewModal.TransactionViewMode>
@{
    ViewBag.Title = "PrintInvoice";
    Layout = "~/Views/Shared/_LayoutPrint.cshtml";
}

<section class="invoiceFinal">

    <div class="invoice-header">

        <div class="image-L">
            <img src="~/Temp/Image/WhiteLogo.png" height="100" />
        </div>

        <div class="text-center text-word">
            <h7>شركة مطارات السودان المحدودة</h7>
            <h6>الادارة العامة للشؤون المالية والمحاسبية</h6>
            <h6>مطار بورتسودان الدولي</h6>
        </div>

        <div>
            <img src="~/Temp/Image/WhiteLogo.png" class="image-R" height="100" />
        </div>

    </div>

    <br />
    <div class="invoice-Body">
        
        <div class="wrapper">
            <div class="row">
                <div class="col-md-12 justify-content-center text-center">
                        <h2><u>%كشف ضريبة ال 5</u></h2>
                    <br>
                </div>

            </div>
        </div>
    </div>

    <div class="text-center">
        <div style="display:flex; justify-content:space-between; padding: 5px;">
            <span>@DateTime.Now</span>تاريخ الطباعة
        </div>
       
        <table class="table table-bordered">
            <thead>
                <tr class="text-center">
                    @*<td> الصــافي </td>*@
                    <td> %ضريبة ال 5</td>
                    <td> اجمالي المبلغ  </td>
                    <td colspan="2">البيان</td>
                    <td>#</td>
                </tr>
            </thead>
            <tbody>
                @{
                    int counter = 0;
                    foreach (var item in Model)
                    {
                        <tr>
                            @*<td class="numberFormat text-center">@item.total</td>*@
                            <td class="numberFormat text-center">@item.tax</td>
                            <td class="numberFormat text-center">@item.amount</td>
                            <td colspan="2">@item.note</td>
                            <td class="text-center">@Convert.ToInt32(item.id)</td>
                        </tr>
                        counter = counter + 1;
                    }
                }
                <tr class="text-center" style="background-color:#d3caca">
                    <td colspan="3"> @ViewBag.sumOfTax </td>
                    <td colspan="3"> : المجموع </td>
                </tr>
            </tbody>
        </table>        
    </div>
    
    <div class="number-Word invoice-footer">
        <div class="number-Word"> @ViewBag.txtSumOfBous </div>

        <div class="chief ">
            @*<div class="Dept">
                <span>  رئيس القسـم </span><br /><br />
                <span>-------------------------------</span>
            </div>*@

            <div class="Manager">
                <span>        التوقيع</span><br /><br />
                <span>-------------------------------</span>
            </div>
        </div>        
    </div>

</section>

<script src="~/Temp/plugins/jquery/jquery.min.js"></script>
<script src="~/Temp/dist/js/jquery.table2excel.min.js"></script>

@section scripts{

    <script>

           window.addEventListener("load", window.print());
           $('.numberFormat').each(function () {
               var item = $(this).text();

               var N = round(item, 2);

               var num = Number(N).toLocaleString();
               
               $(this).text(num);
           });



           function round(value, exp) {
               if (typeof exp === 'undefined' || +exp === 0)
                   return Math.round(value);

               value = +value;
               exp = +exp;

               if (isNaN(value) || !(typeof exp === 'number' && exp % 1 === 0))
                   return NaN;

               // Shift
               value = value.toString().split('e');
               value = Math.round(+(value[0] + 'e' + (value[1] ? (+value[1] + exp) : exp)));

               // Shift back
               value = value.toString().split('e');
               return +(value[0] + 'e' + (value[1] ? (+value[1] - exp) : -exp));
           }

           $(function () {
               $("#btnExport").click(function () {
                   $("#tblCustomers").table2excel({
                       filename: "Table.xls"
                   });
               });
           });
    </script>

}