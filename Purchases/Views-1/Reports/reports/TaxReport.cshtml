@{
    ViewBag.Title = "TaxReport";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<h2>TaxReport</h2>

@section content
{
<div class="content-wrapper">
    <div class="grad"></div>
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>
            ضريبة ال 1%  
        </h1>
        <ol class="breadcrumb">
            <li><a href="#"><i class="fa fa-home"></i> النظام المحاسبي</a></li>
            <li class="active">    ضريبة ال 1%  </li>
        </ol>
    </section>

    <section class="content">
        <div class="row">
            <div class="col-lg-4">
                <div class="form-group">
                    <label for="transactionDate"> من تاريخ</label>
                    <div class="input-group">
                        <span class="input-group-addon">
                            <i class="fa fa-calendar-alt"></i>
                        </span>
                        <input type="text" class="form-control  calendar DateFrom" id="DateFrom" name="DateFrom" placeholder="من تاريخ " autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="form-group">
                    <label for="transactionDate"> الي تاريخ</label>
                    <div class="input-group">
                        <span class="input-group-addon">
                            <i class="fa fa-calendar-alt"></i>
                        </span>
                        <input type="text" class="form-control  calendar DateTo" id="DateTo" name="DateTo" placeholder=" الى تاريخ " autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="form-group">
                    <label for="transactionDate">اختار البنك</label>
                    <div class="input-group">
                        <span class="input-group-addon">
                            <i class="fa fa-calendar-alt"></i>
                        </span>
                        <select class="form-control bankId" id="bankId" name="bankId"></select>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class=" col-md-3">
                <button id="btnsearch" onclick="Search()" class="btn btn-primary btn-sm form-control">بحث</button>
            </div>
            <div class=" col-md-3">
                <button id="btnall" onclick="PrintData()" class="btn form-control btn-info btn-sm">طباعة التقرير</button>
            </div>
            <div class=" col-md-3">
                <button id="btnall" onclick="PrintDataAuth()" class="btn form-control btn-info btn-sm">طباعة تقرير ديوان الضرائب</button>
            </div>
        </div>
        <div class="row" style="margin: 10px;">
            <table id="tbl" class="dataTable table table-striped table-hover" style="width:100%">
                @*<tbody id="tbod"></tbody>*@
            </table>
        </div>
    </section>
    </div>
}

@section scripts{

    <script>
        var myId = 0;
        $(function () {
            select2list(".bankId", "/Shared/getAllBanks", "  اسم الحساب ");
        });

        function PrintData() {
            var DateFrom = $('#DateFrom').val();
            var DateTo = $('#DateTo').val();
            var bankId = $('#bankId').val();

            var url = "/Reports/printTaxReportInRange?dateFrom=" + DateFrom + "&dateTo=" + DateTo + "&bankId=" + bankId;
            window.open(url, '_blank').focus();
        }

        function Search() {
            var DateFrom = $('#DateFrom').val();
            var DateTo = $('#DateTo').val();
            var bankId = $('#bankId').val();
            var url = "/Reports/GetTaxInDateRangeForSearch?dateFrom=" + DateFrom + "&dateTo=" + DateTo + "&bankId=" + bankId;;

            $('#tbl').DataTable({
                destroy: true,
                "language": {
                    "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                    "search": "بحث"
                },
                ajax: {
                    url: url,
                    dataSrc: ''
                },
                columns: [
                    {
                        "title": "",
                        "data": "id",
                        "orderable": false,
                        "render": function (data) {
                            return '<a class="btn btn-info btnDetails" data-toggle="modal" data-target="#details-modal"><i class="fa fa-info"></i></a>';
                        }
                    },
                    {
                        "title": "# ",
                        "data": "id"
                    },
                    {
                        "title": "البيان",
                        "data": "note"
                    },
                    //{
                    //    "title": "اجمالي المبلغ",
                    //    "data": "amount"
                    //},
                    {
                        "title": "مبلغ الضريبة ",
                        "data": "tax"
                    },
                    //{
                    //    "title": "تاريخ العملية",
                    //    "data": "transactionDateStr"
                    //},
                ]
            });
        }

        function PrintDataAuth() {
            var DateFrom = $('#DateFrom').val();
            var DateTo = $('#DateTo').val();
            var bankId = $('#bankId').val();

            var url = "/Reports/printTaxAuthorityReport?dateFrom=" + DateFrom + "&dateTo=" + DateTo + "&bankId=" + bankId;;
            window.open(url, '_blank').focus();
