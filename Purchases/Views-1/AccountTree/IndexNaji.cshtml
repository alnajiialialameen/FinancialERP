}


@section content{


  <!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
    <div class="grad"></div>

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>
            البنود الحسابية <i class="fas fa-folder"></i>
        </h1>
        <ol class="breadcrumb">
            <li><a href="#"><i class="fa fa-home"></i> الشجرة الحسابية </a></li>
            <li class="active">  البنود الحسابية</li>
        </ol>

    </section>


    <section class="content">
        <div class="row">
            <div class="col-xs-12">
                <div class="box">
                    <div class="box-header">
                        <button type="button" id="btnAddNode" class="btn btn-primary pull-left btn-add" data-toggle="modal" data-target="#add-modal"><i class="fa fa-plus-square">  </i> اضافة بند جديد </button>
                    </div><!-- /.box-header -->
                    <div class="box-body">
                        @*<table id="tbx" class="table table-bordered table-hover"></table>*@

                        
                            <div class="container" style="margin-top:30px;">
                             
                                 
                                <div style="margin-right: 40px;">
                                    <img src="~/Temp/Image/Tree4.png"height="50" />
                                </div>
                                <div id="Refresh-Tree">
                                 
                                  
                                    @Html.Partial("_Tree")
                                </div>
                                <div>





                                </div>
                       



                        <table id="dataTable" class="table table-bordered table-sm table-hover" style="width:100%">
                            <thead>
                                <tr>
                                    <th>الرقم </th>
                                    <th>البند</th>
                                    <th>تحت بند</th>
                                    <th> بندود</th>
                                    <th>العمليات</th>

                                </tr>
                            </thead>

                        </table>


                       
                        
                       













                    </div><!-- /.box-body -->
                </div><!-- /.box -->
            </div><!-- /.col -->
        </div><!-- /.row -->
    </section>


</div><!-- /.content-wrapper -->



<!---///////////////////////////////////////////////////////////////////////////Start Add Model//////////////////////////////////////////////////////////////////////////////-->

<div class="example-modal">
    <div class="modal fade in" id="add-modal">
        <div class="modal-dialog" style="width:80% !important">
            <div class="modal-content">
                <div class="modal-header .no-border">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title"> إضافة بند جديد</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <form method="post" id="add-form">
                                <div class="box .no-border">
                                    <!-- /.box-header -->
                                    <div class="box-body">
                                        <!-- Input addon -->
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div class="box .no-border">
                                                    <!-- /.box-header -->
                                                    <div class="box-body">
                                                        <!-- Input addon -->
                                                        <div class="row">

                                                            <div class="col-lg-12">
                                                                <div class="col-lg-6">
                                                                    <div class="form-group">
                                                                        <label for="name">  اسم البند</label>
                                                                        <div class="input-group">
                                                                            <div class="input-group-addon">
                                                                                <i class="fa  fa-book"></i>
                                                                            </div>
                                                                            <input class="form-control name" name="addAccName" id="addAccName" placeholder="اسم البند" autocomplete="off" />
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-6">
                                                                    <div class="form-group">
                                                                        <label for="structureCount"> تحت بند؟</label>
                                                                        <div class="input-group">
                                                                            <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                                            @*<select type="text" class="form-control structureCount" id="addAccParent" name="addAccParent" placeholder=" ادخل البند الذي تحتة  " autocomplete="off"></select>*@
                                                                            <select type="text" id="addAccParent" name="addAccParent" class="form-control" placeholder="تحت بتد " style="width:100%"></select>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>


                                                            <div class="col-lg-12 ">
                                                                <div class="pull-left">
                                                                    <button type="button" class="btn btn-default " data-dismiss="modal">رجوع</button>
                                                                    <button type="submit" id="btnSave" class="btn btn-primary save">حفظ</button>
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <!-- /.box-body -->
                                                </div>


                                            </div>
                                        </div>

                                    </div>
                                    <!-- /.box-body -->
                                </div>

                            </form>
                        </div>
                    </div><!-- /.row (main row) -->

                </div>
                @*<div class="modal-footer">

                    </div>*@
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal -->
</div>

<!---///////////////////////////////////////////////////////////////////////////End Add Model//////////////////////////////////////////////////////////////////////////////-->




<!-- Edit Modal -->
<div class="example-modal">
    <div class="modal fade in" id="edit-modal">
        <div class="modal-dialog" style="width:80% !important">
            <div class="modal-content">
                <div class="modal-header .no-border">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">تعديل اسم الادارة </h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <form method="post" id="edit-form">
                                <div class="box .no-border">
                                    <!-- /.box-header -->
                                    <div class="box-body">
                                        <!-- Input addon -->
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div class="col-lg-6">
                                                    <div class="form-group">
                                                        <label for="ed-name">  اسم البند</label>
                                                        <div class="input-group">
                                                            <span class="input-group-addon"><i class="fa fa-home"></i></span>
                                                            <input id="edId" class="ed-id hidden" name="edId" />
                                                            <input id="edAccCode" class="ed-id hidden" name="edAccCode" />
                                                            
                                                            
                                                            <input type="text" class="form-control  ed-name" id="edAccName" name="edAccName" placeholder="اسم الادارة  " autocomplete="off">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6">
                                                    <div class="form-group">
                                                        <label for="edstructureCount">  تحت بند</label>
                                                        <div class="input-group">
                                                            <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                            <select type="text" class="form-control edstructureCount" id="edAccParent" name="edAccParent" placeholder="    تحت بند  " autocomplete="off"></select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-12 ">
                                                    <div class="pull-left">
                                                        <button type="button" class="btn btn-default " data-dismiss="modal">رجوع</button>
                                                        <button type="submit" class="btn btn-primary save">حفظ</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                    <!-- /.box-body -->
                                </div>

                            </form>
                        </div>
                    </div><!-- /.row (main row) -->

                </div>
                @*<div class="modal-footer">

                    </div>*@
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal -->
</div>


















}






















@section scripts{

<script>


    $('#html').jstree();



    var dataTable;
    $(document).ready(function () {

        dataTable = $("#dataTable").DataTable({

            "processing": true,
            // "serverSide": true,
            "ajax": {
                "url": "/AccountTree/GetAllItem",
                "type": "GET",
                "datatype": "json",

            },
            "columns": [






                { "data": "Id", "autowidth": true },
                { "data": "AccName", "autowidth": true },
                  { "data": "AccParentName", "autowidth": true },
                    { "data": "GetParentNameList", "autowidth": true },

                        {


                            "data": "Id", "width": "50px", "render": function (data) {
                                return '<button class="btn btn-success transfer btn-dataTable" onclick="getData(' + data
                                    + ')">تعديل</button> <button class="btn btn-danger transfer btn-dataTable" onclick="Delete(' + data + ')">حذف</button> '

                            }
                        },


            ], "language":
                          {
                              "sProcessing": "جارٍ التحميل...",
                              "sLengthMenu": "أظهر _MENU_ مدخلات",
                              "sZeroRecords": "لم يعثر على أية سجلات",
                              "sInfo": "إظهار _START_ إلى _END_ من أصل _TOTAL_ مدخل",
                              "sInfoEmpty": "يعرض 0 إلى 0 من أصل 0 سجل",
                              "sInfoFiltered": "(منتقاة من مجموع _MAX_ مُدخل)",
                              "sInfoPostFix": "",
                              "sSearch": "ابحث:",
                              "sUrl": "",
                              "oPaginate": {
                                  "sFirst": "الأول",
                                  "sPrevious": "السابق",
                                  "sNext": "التالي",
                                  "sLast": "الأخير",
                              }
                          }
        });



        function select2list(selector, url, placeholder) {
            $(selector).select2({
                language: { inputTooShort: function () { return 'enter 1 letter at less'; } },
                ajax: {
                    url: url,
                    dataType: 'json',
                    delay: 100,
                    data: function (params) {
                        return {
                            q: params.term,
                            page: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data,
                            pagination: {
                                more: ((data.total_count) > (params.page * 20))
                            }
                        };
                    },
                    cache: true
                },
                placeholder: placeholder,
                minimumInputLength: 1,
            });

        };
        select2list("#addAccParent", "/AccountTree/LoadTreeAdd", "  البند ");
    });




        $("#btnAddNode").click(function () {

            fillTreeName();
            

        });



















           //-------------------------------------------------Start Add------------------------------------------------------------------------------------------------------------

            $('#add-form').bootstrapValidator({
                onSuccess: function (e) {
                    save();
                    e.preventDefault();

                },
                submitButtons: 'button[type="submit"]',
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok success-feedback-icons',
                    invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                    validating: 'fa fa-refresh fa-spin success-feedback-icons'
                },
                fields: {
                    addAccName: {
                        validators: {
                            notEmpty: {
                                message: 'يجب الا يكون حقل اسم الادراة  فارغ'
                            }
                        }
                    }

                }
            });


            function save() {

                //var f = $("#addAccParent").val();
                //alert(f);

                var ob = {
                    "AccName": $('#addAccName').val(),
                    "AccParent": $('#addAccParent').val()
                };
                $.ajax({
                    url: "@Url.Action("Create", "AccountTree")",
                    type: "POST",
                data: JSON.stringify(ob),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    toastr[response.Status](response.Message, response.Title);

                    $('#add-form').bootstrapValidator('resetForm', true);
                    $('#add-modal').modal('hide');
                    dataTable.ajax.reload();
                    Refresh();
                }
            });
            };










                //-------------------------------------------------End Add------------------------------------------------------------------------------------------------------------


          //-----------------------------------------------------------------Start Edit---------------------------------------------------------------

    //Open Edit Modal

    function getData(id) {
        fillTreeNameUpdate();

        $("#edit-modal").modal('show');

        $.ajax({
            type: "GET",
            url: "/AccountTree/GetDataForUpdate/" + id,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response != null) {

                    
                  
                    $('#edId').val(response.Id);
                    $('#edAccName').val(response.AccName);
                    $('#edAccCode').val(response.AccCode);
                    $('#edAccParent').val(response.AccParent);
                    
                    $("#edAccParent").attr("disabled", "disabled");
                    //alert(response.AccParent);

                } else {
                    alert("Something went wrong");
                }
            },
            failure: function (response) {
                //alert(response.responseText);
            },
            error: function (response) {
                //alert(response.responseText);
            }
        });

    }



                //Validation And Save Edit Data
                $('#edit-form').bootstrapValidator({
                    onSuccess: function (e) {
                        edit();
                        e.preventDefault();

                    },
                    submitButtons: 'button[type="submit"]',
                    feedbackIcons: {
                        valid: 'glyphicon glyphicon-ok success-feedback-icons',
                        invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                        validating: 'fa fa-refresh fa-spin success-feedback-icons'
                    },
                    fields: {
                    edAccName: {
                            validators: {
                                notEmpty: {
                                    message: 'يجب الا يكون حقل اسم الادارة  فارغ'
                                }
                            }
                        }

                    }
                });

                function edit() {


                    var ob = {
                        "Id": $('#edId').val(),
                        "AccCode": $('#edAccCode').val(),
                        "AccName": $('#edAccName').val(),
                        "AccParent": $('#edAccParent').val(),
                        //"StructureCount": $('#edstructureCount').val()
                    };
                    $.ajax({
                        url: "@Url.Action("Edit", "AccountTree")",
                        type: "POST",
                        data: JSON.stringify(ob),
                        contentType: "application/json charset=utf-8",
                        dataType: "json",
                        error: function (response) {
                            //toastr[response.Status](response.Message, response.Title);
                        },
                        success: function (response) {
                            toastr[response.Status](response.Message, response.Title);

                            //Refresh(0);
                            // location.reload();
                            dataTable.ajax.reload();
                            Refresh();
                            $('#edit-form').bootstrapValidator('resetForm', true);
                            $('#edit-modal').modal('hide');
                            // dataTable.ajax.reload();


                        }
                    });
                };






                function Refresh(id) {

                    $("#AjaxLoader").show()

                    $.get("/AccountTree/GetTreeParial", { id: id }, function (nn) {

                        $("#Refresh-Tree").html(nn);
                        //$("#myModal").modal('show');
                        //$("#AjaxLoader").hide()
                        //$('#html').jstree();
                    })
                }






                function fillTreeName() {

                    $('#addAccParent').empty();
                

                    $.ajax({
                        url: "/AccountTree/LoadTree",
                        type: "GET",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        success: function (result) {
                            if (result) {

                                var x;
                                var html = "";
                                $.each(result, function (key, item) {
                                    html += "<option value='" + item.Id + "'>" + item.AccName + "</option>";
                                });
                                $('#addAccParent').append(html);
                                //$('#DName2').append(html);

                            }
                        },
                        error: function (errormessage) {
                            alert(errormessage.responseText);
                        }

                    });



                  
                };

                
                function fillTreeNameUpdate() {

                    $( document ).ready(function() {


                    $('#edAccParent').empty();
                    $.ajax({
                        url: "/AccountTree/LoadTreeUpdate",
                        type: "GET",
                        contentType: "application/json;charset=utf-8",
                        dataType: "json",
                        success: function (result) {
                            if (result) {

                                var x;
                                var html = "";
                                $.each(result, function (key, item) {
                                    html += "<option value='" + item.Id + "'>" + item.AccName + "</option>";
                                });
                                $('#edAccParent').append(html);
                                //$('#DName2').append(html);

                            }
                        },
                        error: function (errormessage) {
                            alert(errormessage.responseText);
                        }

                    });
                    });
                };

                //function select2list(selector, url, placeholder) {
                //    $(selector).select2({
                //        language: { inputTooShort: function () { return 'enter 1 letter at less'; } },
                //        ajax: {
                //            url: url,
                //            dataType: 'json',
                //            delay: 100,
                //            data: function (params) {
                //                return {
                //                    q: params.term,
                //                    page: params.page
                //                };
                //            },
                //            processResults: function (data, params) {
                //                params.page = params.page || 1;
                //                return {
                //                    results: data,
                //                    pagination: {
                //                        more: ((data.total_count) > (params.page * 20))
                //                    }
                //                };
                //            },
                //            cache: true
                //        },
                //        placeholder: placeholder,
                //        minimumInputLength: 1,
                //    });

                //};
                //select2list("#edAccParent", "/AccountTree/LoadTreeUpdate", "  البند ");
          ///=========================================Cusrom Tree====================================================================


                function Delete(id) {


                    swal({
                        title: "هل انت متاكد ",
                        text: " OK تقوم بحذف العنصر! عند الضعط علي",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true,
                    })
                     .then((willDelete) => {
                         if (willDelete) {
                             $.get("/AccountTree/Delete", { id: id }, function (res) {
                                 if (res) {

                                     if (res.message != null && res.message === "Used") {
                                      //   toastr[response.Status](response.MessageText, response.Title);
                                         toastr.error("لايمكن حذف هذا العنصر ", "تعذر الحذف");
                                     }

                                     if (res.message != null && res.message === "Delete") {
                                         toastr.success("تم الحذف البند ", "الحذف");
                                         Refresh();
                                        /// toastr[response.Status](response.MessageText, response.Title);
                                     }
                                     dataTable.ajax.reload();
                                 }
                             });
                         }
                     });

                }
   



                $('.select2').select2({
                   
                })
  












   









               






</script>


}










