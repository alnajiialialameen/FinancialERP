            loadData();

            function select2list(selector, url, placeholder) {
                $(selector).select2({
                    language: { inputTooShort: function () { return 'أدخل حرف واحد علي الاقل'; } },
                    ajax: {
                        url: url,
                        dataType: 'json',
                        delay: 100,
                        data: function (params) {
                            return {
                                q: params.term,
                                page: params.page
                            };
                        },
                        processResults: function (data, params) {
                            params.page = params.page || 1;
                            return {
                                results: data,
                                pagination: {
                                    more: ((data.total_count) > (params.page * 20))
                                }
                            };
                        },
                        cache: true
                    },
                    placeholder: placeholder,
                    minimumInputLength: 1,
                });
            };

            select2list(".currency", "/BankAccounts/GetCurrencyType", "عملة الحساب البنكي");
            select2list(".account-type", "/BankAccounts/GetBankAccountType", "نوع الحساب البنكي");

            $('#addForm').bootstrapValidator({
                onSuccess: function (e) {
                    save();
                    e.preventDefault();

                },
                submitButtons: 'button[type="submit"]',
                excluded: [':disabled'],
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok success-feedback-icons',
                    invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                    validating: 'fa fa-refresh fa-spin success-feedback-icons'
                },
                fields: {
                    name: {
                        validators: {
                            notEmpty: {
                                message: 'يجب الا يكون حقل اسم الحساب  فارغ'
                            }
                        }
                    },
                    number: {
                        validators: {
                            notEmpty: {
                                message: 'يجب ادخال رقم الحساب'
                            }
                        }
                    },
                    'account-type': {
                        validators: {
                            notEmpty: {
                                message: 'يجب ادخال نوع الحساب'
                            }
                        }
                    },
                    currency: {
                        validators: {
                            notEmpty: {
                                message: 'يجب تحديد نوع العملة لهذا الحساب'
                            }
                        }
                    },
                    'open-date': {
                        validators: {
                            notEmpty: {
                                message: 'يجب تحديد تاريخ فتح الحساب'
                            }
                        }
                    },
                    //iban: {
