@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

@section content{

    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <div class="grad"></div>

        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>
                دليل االبنوك
            </h1>
            <ol class="breadcrumb">
                <li><a href="#"><i class="fa fa-home"></i>النظام المحاسبي </a></li>
                <li class="active"> دليل البنوك</li>
            </ol>
        </section>
        <div class="content" style="display: flex; margin-right: 10px;">
            <div class="col-lg-3">
                <table id="tbx" class="table-bordered table-striped table-hover">
                </table>
            </div>

            <div class="col-lg-9">
                <form method="post" id="addForm">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="box .no-border">
                                <!-- /.box-header -->
                                <div class="box-body">
                                    <!-- Input addon -->
                                    <div class="row">

                                        <div class="col-lg-12">
                                            <div class="col-lg-6">
                                                <div class="form-group">
                                                    <label for="name"> الحساب البنكي</label>
                                                    <div class="input-group">
                                                        <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                        <input type="text" class="form-control name" disabled name="name" id="name" placeholder=" اسم الحساب البنكي" autocomplete="off" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-6">
                                                <div class="form-group">
                                                    <label for="number">رقم الحساب البنكي</label>
                                                    <div class="input-group">
                                                        <div class="input-group-addon">
                                                            <i class="fa  fa-sort-numeric-down"></i>
                                                        </div>
                                                        <input type="number" class="form-control number" name="number" id="number" placeholder=" رقم الحساب البنكي" autocomplete="off" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-6">
                                                <div class="form-group">
                                                    <label for="account-type">نوع الحساب</label>
                                                    <div class="input-group">
                                                        <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                        <select class="form-control account-type" id="account-type" name="account-type" style="width:100%"></select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-6">
                                                <div class="form-group">
                                                    <label for="currency"> العملة</label>
                                                    <div class="input-group">
                                                        <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                        <select class="form-control currency" id="currency" name="currency" style="width:100%"></select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-6">
                                                <div class="form-group">
                                                    <label for="open-date">تاريخ فتح الحساب</label>
                                                    <div class="input-group">
                                                        <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                        <input type="text" class="form-control calendar open-date" id="open-date" name="open-date" placeholder="تاريخ فتح الحساب البنكي" autocomplete="off">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-6">
                                                <div class="form-group">
                                                    <label for="iban">الرقم الدولي(IBAN)</label>
                                                    <div class="input-group">
                                                        <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                        <input type="text" class="form-control iban" id="iban" name="iban" placeholder="الرقم الدولي" autocomplete="off">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-6">
                                                <div class="form-group">
                                                    <label for="bankLabel">اسم البنك(البنك/الفرع)</label>
                                                    <div class="input-group">
                                                        <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                        <input type="text" class="form-control bankLabel" id="bankLabel" name="bankLabel" placeholder="اسم البنك-الفرع" autocomplete="off">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-6">
                                                <div class="form-group">
                                                    <label for="firstSignature">اسم الموظف(توقع اول)</label>
                                                    <div class="input-group">
                                                        <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                        <input type="text" class="form-control firstSignature" id="firstSignature" name="firstSignature" placeholder="اسم الموظف(توقع اول)" autocomplete="off">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-6">
                                                <div class="form-group">
                                                    <label for="secondSignature">اسم الموظف(توقع ثاني)</label>
                                                    <div class="input-group">
                                                        <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                        <input type="text" class="form-control secondSignature" id="secondSignature" name="secondSignature" placeholder="اسم الموظف(توقع ثاني)" autocomplete="off">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-12 ">
                                            <div class="pull-left">
                                                <label class="hidden" id="AccountSubId">AccountSubId</label>
                                                <label class="hidden" id="AccId"></label>
                                                <label class="hidden" id="Id"></label>
                                                <button type="reset" class="btn btn-default " data-dismiss="modal">الغاء</button>
                                                <button type="submit" class="btn btn-primary btnSave hide">حفظ</button>
                                                <a href="#" target="_blank" class="btn btn-warning btnGetBankTransactions hide">كل العمليات</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- /.box-body -->
                            </div>
                        </div>
                    </div>
                </form>


                <div class="row">
                    <table id="bankTransTbl"></table>
                </div>
            </div>
        </div>

    </div>
}

