        function saveNew() {
            var statement = $('#statement').val();
            var currencyId = $('#addCurrencyType').val();
            var recipient = $('#recipient').val();

            if (recipient.includes(" - ")) {
                recipient = recipient.split(" - ")[0];
            } else {
                recipient = recipient; // لو مافي شرطة، نحتفظ بالنص كما هو
            }
            var transactionDate = $('#transactionDate').val();
            // var transactionDate = moment($('#transactionDate').val()).format("MM/DD/YYYY");

            var documentTypeId = $('#documentType').val();
            console.log(transactionDate);

            if (statement != null & transactionDate != null) {
                //هنا اضفنا حقل البيان والتاريخ لي مصفوفة موجودة مسبقا بها بيانات
                rptList = rptList.map(v => Object.assign(v, {
                    'documentTypeId': documentTypeId,
                    "recipient": recipient,
                    "note": statement,
                    "transactionDate": transactionDate,
                    "currencyId": currencyId
                }));

                //console.clear();
                console.log(rptList);

                $.ajax({
                    url: "/Shared/Create",
                    type: "POST",
                    data: JSON.stringify(rptList),
                    contentType: "application/json charset=utf-8",
                    dataType: "json",
                    error: function (response) {
                        toastr[response.Status](response.Message, response.Title);
                    },
                    success: function (response) {
                        if (response.Status == "warning") {
                            toastr[response.Status](response.Message, response.Title);
                        } else {
                            toastr[response.Status](response.Message, response.Title);
                            //$('.list').val(null).trigger('change');
                            $('#add-modal').modal("hide");
                            $('#add-statement-modal').modal("hide");
                            $(".presntTBody").empty();
                            $(".myTbody").empty();
                            $('.myTFoot').empty();
                            $('#tbx').DataTable().ajax.reload();
                            rptList = [];
                        }
                    }
                });

            } else {
                toastr["error"]("الرجاء ادخال جميع البيانات", "خطأ");
            }
        }

