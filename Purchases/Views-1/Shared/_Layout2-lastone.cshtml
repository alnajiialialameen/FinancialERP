    <div class="example-modal">
        <div class="modal fade in" data-backdrop="static" id="changepassword-modal">
            <div class="modal-dialog" style="width:50% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> تعديل كلمة المرور</h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-12">
                                <form method="post" id="edit-form">
                                    <div class="box .no-border">
                                        <!-- /.box-header -->
                                        <div class="box-body">
                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <label for="ed-password"> كلمة المرور القديمة  </label>
                                                    <div class="input-group">
                                                        <span class="input-group-addon"><i class="fa fa-key"></i></span>
                                                        <input type="password" class="form-control oldPassword" autocomplete="off" id="oldPassword" name="oldPassword" placeholder="كلمة المرور القديمة ">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <label for="ed-password"> كلمة المرور الجديدة  </label>
                                                    <div class="input-group">
                                                        <span class="input-group-addon"><i class="fa fa-key"></i></span>
                                                        <input type="password" class="form-control newPassword" autocomplete="off" id="newPassword" name="newPassword" placeholder="كلمة المرور الجديدة ">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <label for="ed-password"> تاكيد كلمة المرور الجديدة  </label>
                                                    <div class="input-group">
                                                        <span class="input-group-addon"><i class="fa fa-key"></i></span>
                                                        <input type="password" class="form-control reNewPassword" autocomplete="off" id="reNewPassword" name="reNewPassword" placeholder="تاكيد كلمة المرور الجديدة ">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-12 ">
                                                <div class="d-flex justify-content-between">
                                                    <button type="button" class="btn btn-default" data-dismiss="modal">رجوع</button>
                                                    <button type="button" class="btn btn-warning btnResetPassword" value="btnResetPassword">تعديل</button>
                                                </div>
                                            </div>

                                        </div>
                                        <!-- /.box-body -->
                                    </div>

                                </form>
                            </div>
                        </div><!-- /.row (main row) -->

                    </div>
                    @*<div class="modal-footer">

                        </div>*@
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>

