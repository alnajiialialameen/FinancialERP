    <style type="text/css">
        .displaying {
            display: none;
        }

        fieldset {
            border: solid 1px #808080 !important;
            padding: 10px;
            border-radius: 5px;
            margin-top:20px;
        }

        .trans {
            border: solid 1px #808080 !important;
            border-radius: 5px;
            width: 100%;
            padding: 5px;
            margin-top:15px;
        }

        .trans-edit {
            border: solid 1px #00ff21 !important;
            border-radius: 5px;
            width: 100%;
            padding: 5px;
            margin-top:15px;
        }

        .legend {
            position: absolute;
            top: 15px;
            right:45px;
            background-color: white;
            padding: 0 10px;
            transform: scale3d(1.2, 1.2, 1.2);
        }
        
        .buttons{
            display: flex !important;
            flex-direction: row;
            justify-content:space-between;
        }

        .float{
	        position:fixed;
	        width:40px;
	        height:40px;
	        bottom:50px;
	        left:100px;
	        border-radius:50px;
	        text-align:center;
	        box-shadow: 7px 2px 3px #7e7b7b; 
        }

       .one{
	        background-color:#ff6a00;
	        color:#FFF;
            margin-left:210px;
        }

       .two{
            margin-left:70px;
	        background-color:#0094ff;
	        color:#FFF;
        }

        .third{
            margin-left:140px;
	        background-color:#0C9;
	        color:#FFF;
        }

        .exit{
            float:right;
            bottom:120px;
	        background-color:red;
	        color:#FFF;
        }

        .my-float{
	        margin-top:10px;
        }

        /*a:hover{
            color: #FFF;
        }*/
        .d-flex-between{
            display: flex;
            justify-content: space-between;
            align-items: center;
            align-content: center;
            padding: 5px 20px;
        }
        .border{
            padding: 5px;
            border: 1px solid grey;
            border-radius: 4px;
        }
           .bg{
            color: #fff;
            padding: 5px;
            font-size: 16px;
            border-radius: 4px;
        }
        .bg.bg-success{
            background-color: #2db03e;
        }
        .bg.bg-warning{
            background-color: #d4a904;
        }
    </style>

    <style>
        .main-header .sidebar-toggle:before {
            /*content: "\f0c9";*/
            content: none;
        }
        /* Tooltip container */
        .tooltip {
            position: relative;
            display: inline-block;
            border-bottom: 1px dotted black; /* If you want dots under the hoverable text */
        }

        /* Tooltip text */
        .tooltip .tooltiptext {
            visibility: hidden;
            width: 120px;
            background-color: black;
            color: #fff;
            text-align: center;
            padding: 5px 0;
            border-radius: 6px;
            /* Position the tooltip text - see examples below! */
            position: absolute;
            z-index: 1;
            content:"eeeeeeeeeeeeeee",
        }

        /* Show the tooltip text when you mouse over the tooltip container */
        .tooltip:hover .tooltiptext {
            visibility: visible;
        }

        .AmountCurrencyDecimalText1, .AmountCurrencyDecimalTextCr1, .edAmountCurrencyDecimalText1{
