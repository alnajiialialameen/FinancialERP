    @RenderSection("scripts", required: false)

    <script>

        $('.btnResetPassword').click(function () {
            var OldPassword = $('#oldPassword').val();
            var NewPassword = $('#newPassword').val();
            var ConfirmPassword = $('#reNewPassword').val();

            var obj = {
                "OldPassword": OldPassword,
                "NewPassword": NewPassword,
                "ConfirmPassword": ConfirmPassword,
            }

            if (NewPassword === ConfirmPassword) {
                $.post('/Account/ChangePassword', { data: obj }, function (response) {

                    toastr[response.Status](response.Message, response.Title);
                });
            } else {
                toastr['error']('يجب تطابق كلمة المرور الجديدة وتاكيد كلمة المرور الجديدة', 'خطأ');
            }
        });

        // الدالة دي بغرض توحيد الدوال حذفت من جميع الشاشات و بقت هنا فقط
        function select2list(selector, url, placeholder) {
            $(selector).select2({
                language: {
                    inputTooShort: function () { return 'ادخل حرف واحد علي الاقل'; },
                    noResults: function () { return 'لا توجد نتائج مطابقة، يمكنك إدخال قيمة جديدة'; } // رسالة في حالة عدم وجود نتائج
                },
                ajax: {
                    url: url,
                    dataType: 'json',
                    delay: 100,
                    data: function (params) {
                        return {
                            q: params.term,
                            page: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data,
                            pagination: {
                                more: ((data.total_count) > (params.page * 20))
                            }
                        };
                    },
                    cache: false
                },
                placeholder: placeholder,
                minimumInputLength: 1,
            });
        };

        // دي حقت اسم المستلم بتقبل انه يدخل قيمة جديدة اذا ما موجودة في البيانات الراجعة - مستخدمة في اسم المستلم
        function select2listNew(selector, url, placeholder) {
            $(selector).select2({
                tags: true, // السماح بإضافة قيم جديدة
                language: {
                    inputTooShort: function () { return 'ادخل حرف واحد على الأقل'; },
                    noResults: function () { return 'لا توجد نتائج مطابقة، يمكنك إدخال قيمة جديدة'; } // رسالة في حالة عدم وجود نتائج
                },
                ajax: {
                    url: url,
                    dataType: 'json',
                    delay: 100,
                    data: function (params) {
                        return {
                            q: params.term,
                            page: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        // تحويل البيانات إلى تنسيق { id: ..., text: ... } المطلوب بواسطة Select2
                        var transformedData = data.map(function (item) {
                            //return { id: item.text, text: item.text }; // هنا نقوم باستخدام `text` كـ `id` أيضًا
                            //return { id: item.id??0, text: item.text };
                            return { id: item.id != null && item.id != 0 ? item.id : item.text, text: item.text };
                        });

                        // إرجاع البيانات مع التحكم في التحميل المتدرج
                        return {
                            results: transformedData,
                            pagination: {
                                more: (data.length >= 20) // استخدم شرط مناسب للتحكم في التحميل المتدرج
                            }
                        };
                    },
                    cache: true
                },
                placeholder: placeholder,
                minimumInputLength: 1,
                createTag: function (params) { // للسماح بإدخال القيم الجديدة
                    return {
                        id: params.term,
                        text: params.term,
                        newTag: true // تحديد العنصر كقيمة جديدة
                    };
                }
            });
        }

        select2listNew(".recipient", "/Shared/getAllRecipient", "  اسم المستلم ");

        // عرض التفاصيل
        $('#tbx').on('click', '.btnDetails', function () {
            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var IsDeleted = data['IsDeleted'];
            var TransactionId = data['transactionId'];
            var TransactionDate = data['transactionDateStr'];
            var Note = data['note'];

            $('.tarnsDate').text(TransactionDate);
            $('.tarnsStatement').text(Note);

            if (!IsDeleted) {
                $.get('/Transactions/getDetailData', { "Id": TransactionId }, function (response) {
                    $('.detailsTBody').empty();
                    var sumOfDebit = 0;
                    var sumOfCredit = 0;
                    $.each(response, function (key, value) {
                        var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                            + "<td class='id'>" + value.id + "</td>"
                            + "<td class='accName'>" + value.accName + "</td>"
                            + "<td class='accName'>" + formatNumber(value.debit.toString()) + "</td>"
                            + "<td class='credit'>" + formatNumber(value.credit.toString()) + "</td>"
                            + "</tr>";
                        $('.detailsTBody').append(rows);

                        sumOfCredit = sumOfCredit + value.credit;
                        sumOfDebit = sumOfDebit + value.debit;

                    });

                    var balance = sumOfDebit.toFixed(2) - sumOfCredit.toFixed(2);

                    $('#tdDebitAmount').text(formatNumber(sumOfDebit.toString()));
                    $('#tdCreditAmount').text(formatNumber(sumOfCredit.toString()));
                    $('#tdBalance').text(formatNumber(balance.toString()));

                });
            }
            else {
                $.get('/DeleteTransactions/getDeletedDetailData', { "Id": TransactionId }, function (response) {
                    $('.detailsTBody').empty();
                    var sumOfDebit = 0;
                    var sumOfCredit = 0;
                    $.each(response, function (key, value) {
                        var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                            + "<td class='id'>" + value.id + "</td>"
                            + "<td class='accName'>" + value.accName + "</td>"
                            + "<td class='accName'>" + formatNumber(value.debit.toString()) + "</td>"
                            + "<td class='credit'>" + formatNumber(value.credit.toString()) + "</td>"
                            + "</tr>";
                        $('.detailsTBody').append(rows);

                        sumOfCredit = sumOfCredit + value.credit;
                        sumOfDebit = sumOfDebit + value.debit;

                    });

                    var balance = sumOfDebit.toFixed(2) - sumOfCredit.toFixed(2);

                    $('#tdDebitAmount').text(formatNumber(sumOfDebit.toString()));
                    $('#tdCreditAmount').text(formatNumber(sumOfCredit.toString()));
                    $('#tdBalance').text(formatNumber(balance.toString()));

                });
            }
        });

        //posting الترحيل
        $('#tbx').on('click', '.btnPost', function () {
            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var TransactionId = data['transactionId'];

            $.post('/Transactions/Posting', { "Id": TransactionId }, function (response) {
                toastr[response.Status](response.Message, response.Title);
                $('#tbx').DataTable().ajax.reload();
            });
        });

        //Editing التعديل
        $('#tbx').on('click', '.btnEdit', function () {
            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var Id = data['transactionId'];

            const win = window.open('/Transactions/Edit/' + Id, '_blank', 'noopener,noreferrer');
            win.focus(); // دي بتخلي المتصفح يديها أولوية

            //window.open('/Transactions/Edit/' + Id, '_blank');
        });

        //Go to Print View
        function printSanad(id) {
            window.open("/Reports/printOrnik17/" + id, "_blank");
        }
    </script>

    <script>
        function CustomAutoNumeric(inputId) {
            return new AutoNumeric(inputId, {
                digitGroupSeparator: ',', // الفاصلة بين الآلاف
                decimalCharacter: '.',    // النقطة كعلامة عشرية
                decimalPlaces: 2,          // عدد المنازل العشرية
                defaultValue: "0.00"      // القيمة الافتراضية
            });
        }

        // ضبط التاريخ علي صيغة معينة
        $('.calendar').datepicker({
            todayBtn: "linked",
            language: "it",
            autoclose: true,
            todayHighlight: true,
            format: 'dd/mm/yyyy'
        });

        function formatNumber(num) {
            //if (num === null) {
            //    return '0';
            //}

            if (num === null || num === undefined || isNaN(num)) {
                return '0';
            }

            // تمت اضفاته مؤخرا وشغالة تمام
            num = num.toString(); // ✅ حول القيمة لنص

            // معالجة الجزء الصحيح والجزء العشري
            var parts = num.split('.');
            var integerPart = parts[0];
            var decimalPart = parts[1] || '';

            // إذا كان هناك جزء صحيح، أضف له الفواصل
            integerPart = integerPart.replace(/\D/g, '').replace(/\B(?=(\d{3})+(?!\d))/g, ",");

            // إذا كان هناك جزء عشري، أضف له الفواصل
            if (decimalPart) {
                // var roundedDecimal = parseFloat(decimalPart).toFixed(2); // تقريب إلى خانتين عشريتين
                var roundedDecimal = (parseFloat('0.' + decimalPart).toFixed(2)).split('.')[1];
                // roundedDecimal = roundedDecimal.replace(/\D/g, '').replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                roundedDecimal = roundedDecimal.replace(/\D/g, '').replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                return integerPart + '.' + roundedDecimal;
            }

            return integerPart;
        }

    </script>
</body>

</html>
