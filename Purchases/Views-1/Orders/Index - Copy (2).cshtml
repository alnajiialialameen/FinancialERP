        function select2listParameter(selector, url, placeholder, parameter) {
            $(selector).select2({
                language: { inputTooShort: function () { return 'enter 1 letter at less'; } },
                ajax: {
                    url: url,
                    dataType: 'json',
                    delay: 100,
                    data: function (params) {
                        return {
                            fk: parseInt(parameter),
                            //fk: parseInt($('.' + parameter + '').val()),
                            q: params.term,
                            page: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data,
                            pagination: {
                                more: ((data.total_count) > (params.page * 20))
                            }
                        };
                    },
                    cache: true
                },
                placeholder: placeholder,
                minimumInputLength: 1,
            });

        };


