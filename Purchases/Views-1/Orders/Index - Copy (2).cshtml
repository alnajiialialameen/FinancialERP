        //عرض بيانات الطلب
        function choiseInvoice(orderid, supplier) {
            $('#invoicechoosed-tbl-body').empty();
            $('#invoicechoosed-supplier').val(supplier);
            var url = "/Orders/GetOrderDetail?orderid=" + orderid;
            $.get(url, function (data) {
                //var item = '';
                var k = 1;
                $.each(data, function (i, item) {
                    var rows = '<tr>' +
                                        '<td class="hidden"><input class="report-name invoicechoosed-orderDetailId" value="' + item.OrderDetailId + '" /> </td>' +
                                        '<td class="hidden"><input class="report-name invoicechoosed-itemDetailId" value="' + item.ItemDetailId + '" /></td>' +
                                        '<td><span class="report-name"> ' + item.ItemDetial + ' </span></td>' +
                                        '<td><span class="report-name"> ' + item.RequierCount + ' </span></td>' +
                                        '<td><input type="number" class="form-control invoicechoosed-itemprice" name="invoicechooseditemprice" id="invoicechoosed-itemprice" autocomplete="off"/></td>' +
                                        '<td class="report-name invoicechoosed-totalitemprice" id="invoicechoosed-totalitemprice"> </td>' +
                                    '</tr>';
                    $('#invoicechoosed-tbl-body').append(rows);

                });
                
            });
            //$('#invoice-orderId').val(id);
            
            $('#invoicechoosed-modal').modal('show');
        }

        
       
        //ضرب سعر الوحدة في الكمية
        $("#invoicechoosed-tbl-body").on('keyup', '.invoicechoosed-itemprice', function () {
            

            var currentRow = $(this).closest("tr");
            
            var count = currentRow.find("td:eq(3)").text();

            //اجمالي سعر الوحدة
            currentRow.find("td:eq(5)").text($(this).val() * count);

            //اجمالي الفاتورة وتالضريبة والاجمالي بعد الضريبة
           var x =  $('.invoicechoosed-totalitemprice').map(function () {
                if ($(this).text() != '') {
                    return $(this).text();
                }
                else {
                    return 0;
                }
            }).get();
           var vat = $('#vattype').val();
           var  sum = 0;
           x.forEach(function(num){sum+=parseFloat(num) || 0;});
           $('#invoicetotal').text(sum);
           $('#invoicevat').text(sum * vat/100);
           $('#invoicetotalvat').text(sum + (sum * vat/100));

        });



