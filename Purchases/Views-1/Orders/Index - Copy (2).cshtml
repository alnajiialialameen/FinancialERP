@section scripts{



    <script>
    var dataTable;
    $(function () {


            $('.calendar').datepicker({
                todayBtn: "linked",
                language: "it",
                autoclose: true,
                todayHighlight: true,
                dateFormat: 'dd/mm/yy'
            });

            function loadData() {
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    ajax: {
                        url: '/Orders/LoadData',
                        dataSrc: ''
                    },
                    columns: [
                        {
                            "title": "# ",
                            "data": "Id"
                        },
                        {
                            "title": " الادارة   ",
                            "data": "Department"
                        },
                        {
                            "title": " الموضوع ",
                            "data": "Description"
                        },
                        {
                            "title": " تاريخ الطلب ",
                            "data": "OrderDate",
                        },
                        {
                            "title": "<i class='fa fa-cog'></i>",
                            "data": null,
                            "width": "10%",
                            "orderable": false,
                            "render": function (data) {
                                return '<div class="btn-group">' +
                                            '<button type="button" class="btn btn-default" data-toggle="dropdown">  <i class="fa fa-ellipsis-v"></i> </button> <div class="dropdown-menu btn-threePoint">' +
                                            '<a class="dropdown-item" href="#" onclick="getInvoiceOrder(' + data.Id + ')">الفواتير</a> <br />' +
                                            '<a class="dropdown-item" href="#" onclick="viewOrderImage(' + data.Id + ')">عرض صورة الطلب</a> <br />' +
                                            '<a class="dropdown-item" href="#" onclick="finiacalRequest(' + data.Id + ')"> المطالبة  </a> <br />' +
                                      '</div></div>'

                            },

                        }


                    ]

                });

            }
            loadData();


            function select2list(selector, url, placeholder) {
                $(selector).select2({
                    language: { inputTooShort: function () { return 'enter 1 letter at less'; } },
                    ajax: {
                        url: url,
                        dataType: 'json',
                        delay: 100,
                        data: function (params) {
                            return {
                                q: params.term,
                                page: params.page
                            };
                        },
                        processResults: function (data, params) {
                            params.page = params.page || 1;
                            return {
                                results: data,
                                pagination: {
                                    more: ((data.total_count) > (params.page * 20))
                                }
                            };
                        },
                        cache: true
                    },
                    placeholder: placeholder,
                    minimumInputLength: 1,
                });

            };
            select2list(".department", "/ConsumeHrApi/GetDepartment", "  الادارة ");
            select2list(".supplier", "/Orders/GetSupplier", "  المورد ");
            select2list(".currencytype", "/CurrencyTypes/GetCurrencyType", "  نوع العملة ");
            select2list(".vattype", "/Vats/GetVat", "   نوع الضريبة ");
            
            var newOption = new Option("جنية", 1, true, true);
            $('.currencytype').append(newOption).trigger('change');
            var newOption = new Option("مشتريات", @ViewBag.Vat, true, true);
            $('.vattype').append(newOption).trigger('change');

           




         
           

            function save() {
                

                var ItemId = $('.item').map(function () {
                    if ($(this).val() != null) {
                        return $(this).val();
                    }
                    else {
                        return 0;
                    }
                }).get();

                var ItemDetailId = $('.itemDetail').map(function () {
                    if ($(this).val() != null) {
                        return $(this).val();
                    }
                    else {
                        return 0;
                    }
                }).get();


                var RequierCount = $('.requierCount').map(function () {
                    if ($(this).val() != null) {
                        return $(this).val();
                    }
                    else {
                        return 0;
                    }
                }).get();


               // if (window.FormData !== undefined) {
                //debugger;
                var fileUpload = $("#orderfile").get(0);
                    var files = fileUpload.files;

                    // Create FormData object
                    var fileData = new FormData();

                    // Looping over all files and add it to FormData object
                    for (var i = 0; i < files.length; i++) {
                        fileData.append(files[i].name, files[i]);
                    }
                    
                    // Adding one more key to FormData object
                    fileData.append("DepartmentId", $('#department').val());
                    fileData.append("DepartmentName", $('#department').text());
                    fileData.append("Description", $('#description').val());
                    fileData.append("OrderDate", $('#orderdate').val() , "MM/DD/YYYY").format("DD/MM/YYYY"));
                    //fileData.append("SuggestPrice", $('#suggestprice').val());
                    fileData.append("ItemId", ItemId);
                    fileData.append("ItemDetailId", ItemDetailId);
                    fileData.append("RequierCount", RequierCount);
                    


                $.ajax({
                    url: "@Url.Action("Create", "Orders")",
                    type: "POST",
                    contentType: false, // Not to set any content header
                    processData: false,
                    data: fileData,//JSON.stringify(ob),
                //contentType: "application/json charset=utf-8",
                //dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                    $('#add-modal').modal('hide');
                    dataTable.ajax.reload();
                    $('.list').val(null).trigger('change');
                    $('.passenger-tbl-body').empty();
                    $('#add-form').bootstrapValidator("resetForm", true);

                }
            });

            }




        function threeRow() {
