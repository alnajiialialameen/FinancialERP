        //تكملة بيانات الفاتورة
        function invoiceChoosed() {
            var supplierid = $('#invoicechoosed-supplier').val();
            var orderid = $('#invoice-orderId').val();
            var ob = {
                "Id": $('#invoice-orderId').val(),
                "VatType" : $('#vattype').val(),
                "CurrencyType" : $('#currencytype').val(),
                "OrderDetailId": $('.invoicechoosed-orderDetailId').map(function () {
                    if ($(this).val() != null) {
                        return $(this).val();
                    }
                    else {
                        return 0;
                    }
                }).get(),

                "ItemDetailId": $('.invoicechoosed-itemDetailId').map(function () {
                    if ($(this).val() != null) {
                        return $(this).val();
                    }
                    else {
                        return 0;
                    }
                }).get(),

                "ItemPrice": $('.invoicechoosed-itemprice').map(function () {
                    if ($(this).val() != null) {
                        return $(this).val();
                    }
                    else {
                        return 0;
                    }
                }).get(),

            };
            $.ajax({
                url: "/Orders/InvoiceChoosed?orderid="+orderid + "&supplierid=" + supplierid,
                type: "POST",
            data: JSON.stringify(ob),
            contentType: "application/json charset=utf-8",
            dataType: "json",
            error: function (response) {
                //toastr[response.Status](response.Message, response.Title);
            },
            success: function (response) {
                toastr[response.Status](response.Message, response.Title);

                $('#invoicechoosed-modal').bootstrapValidator('resetForm', true);
                $('#invoicechoosed-modal').modal('hide');
                dataTable.ajax.reload();
            }
        });

