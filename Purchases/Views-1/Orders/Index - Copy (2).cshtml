        function addNewInvoice() {
            // Checking whether FormData is available in browser
            if (window.FormData !== undefined) {

                var fileUpload = $("#NewInvoiceFile").get(0);
                var files = fileUpload.files;

                // Create FormData object
                var fileData = new FormData();

                // Looping over all files and add it to FormData object
                for (var i = 0; i < files.length; i++) {
                    fileData.append(files[i].name, files[i]);
                }

                // Adding one more key to FormData object
                fileData.append("zxc", 'Manas');
             
                var OrderId = $('#invoice-orderId').val();
                var SupplierId = $('#NewInvoiceSupplier').val();

                
            
                $.ajax({
                    url: '/Orders/CreateNewInvoice?OrderId=' + OrderId + '&SupplierId=' + SupplierId,
                    type: "POST",
                    contentType: false, // Not to set any content header
                    processData: false, // Not to process data
                    data: fileData,
                    success: function (response) {
                        toastr[response.Status](response.Message, response.Title);
                        $('#addNewInvoice-form').bootstrapValidator('resetForm', true);
                        $('.list').val(null).trigger('change');
                        $('#addNewInvoice-modal').modal('hide');
                        getInvoiceOrder(OrderId);
                    },
                    error: function (err) {
                        alert(err.statusText);
                    }
                });
                
            } else {
                alert("FormData is not supported.");
            }
        };




        function getInvoiceOrder(id) {
            $('#tbody-order-invoice').empty();

            var url = "/Orders/GetInvoiceOrder?orderid=" + id;
            $.get(url, function (data) {
                //var item = '';
                var k = 1;
                $.each(data, function (i, item) {
                var rows =       '<tr>'+
                                    '<td class="hidden"><span class="report-name"> ' + item.SupplierId + ' </span></td>' +
                                    '<td><span class="report-name"> ' + item.Supplier + ' </span></td>' +
                                    '<td><a onclick="openpdf(' + item.OrderId + ' , ' + item.SupplierId + ')" class="btn btn-default" style="margin-right: 2%;"><i class="fa fa-print"></i></a></td>' +
                                    '<td><input type="radio" name="r3" id="id'+item.Id+'"   class="flat-red  zxc invoicechoosed"></td>' +

                                    '<td></td>' +
                                '</tr>';
                    $('#tbody-order-invoice').append(rows);
                    if (item.IsChoosed == 1) {
                        $('#id' + item.Id).prop('checked', true);
                        $('#id' + item.Id).val("true");

                        //$("#"+ item.Id).attr('checked', 'checked');
                    } else {
                        $('#id' + item.Id).val("false");

                    }


                });
            });
            $('#invoice-orderId').val(id);
            $('#invoice-modal').modal('show');

        };




       

       
