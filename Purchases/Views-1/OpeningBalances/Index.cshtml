@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

@section content{
    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <div class="grad"></div>

        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>
                الارصدة الافتتاحية
            </h1>
            <ol class="breadcrumb">
                <li><a href="#"><i class="fa fa-home"></i> النظام المالي </a></li>
                <li class="active">  الارصدة الافتتاحية</li>
            </ol>
        </section>

        <section class="content">
            <div class="row">
                <div class="col-xs-12">
                    <div class="box">
                        <div class="box-header">
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="name">اسم البنك</label>
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <i class="fa fa-book"></i>
                                        </div>
                                        <select class="form-control list accBankId" name="accBankId" id="accBankId" style="width:100%"></select>
                                    </div>
                                </div>
                            </div>
                            @*<button type="button" class="btn btn-primary pull-left btn-add" data-toggle="modal" data-target="#add-modal"><i class="fa fa-plus-square">  </i>  جديد </button>*@
                            <button type="button" id="btn-search" class="btn btn-primary pull-left btn-search"><i class="fa fa-search">  </i>  بحث </button>
                        </div><!-- /.box-header -->
                        <div class="box-body">
                            <div class="container" style="margin-top:30px;">
                                <table id="tbx" class="table table-bordered table-hover"></table>
                            </div>
                        </div><!-- /.box-body -->
                    </div><!-- /.box -->
                </div><!-- /.col -->
            </div><!-- /.row -->
        </section>


    </div><!-- /.content-wrapper -->

    <div class="example-modal">
        <div class="modal fade in" id="add-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:90% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة ارصدة افتتاحية</h4>
                    </div>
                    <div class="modal-body">
                        <form id="add-form">
                            <div class="row">
                                <div class="col-lg-4">
                                    <label>اسم الحساب</label>
                                    <select class="form-control list acc-tree" id="acc-tree" style="width:100%" name="accTree"></select>
                                </div>
                                <div class="col-lg-2">
                                    <label>مدين</label>
                                    <input type="number" class="form-control debit" id="debit" name="debit" placeholder="مدين" autocomplete="off" />
                                </div>
                                <div class="col-lg-2">
                                    <label>دائن</label>
                                    <input type="number" class="form-control credit" id="credit" name="credit" placeholder="دائن" autocomplete="off" />
                                </div>
                                <div class="col-lg-4">
                                    <label>الوصف</label>
                                    <input class="form-control note" id="note" name="note" placeholder="الوصف" autocomplete="off" />
                                </div>
                            </div>

                            <br />

                            <div class="row">
                                <div class="col-lg-12">
                                    <a class="btn btn-primary btn-block" onclick="addToTable();"> إضافة <i class="fa fa-arrow-alt-circle-down"></i></a>
                                </div>
                            </div>
                            <hr />
                            <table id="tbl" class="add-table table table-striped table-hover" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>مدين</th>
                                        <th>دائن</th>
                                        <th>اسم الحساب</th>
                                        <th>الوصف</th>
                                        <th><i class="fa fa-cogs"></i></th>
                                    </tr>
                                </thead>
                                <tbody id="tbody"></tbody>
                                <tfoot id="tfoot">
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>

                            <div class="row">
                                <div class="col-lg-12">
                                    <button type="submit" class="btn btn-success btn-block" id="btnSave">حفظ</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>





    <div class="example-modal">
        <div class="modal fade in" id="openingBalances-details-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:60% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title">عرض تفاصيل الحساب <span id="AccPrentName"></span> </h4>

                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <table id="tblOpeningBalancesDetails" class="table table-bordered table-striped table-hover">
                               
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>اسم الحساب</th>
                                        <th>دائن</th>
                                        <th>مدين</th>
                                        <th>الفرق</th>
                                    </tr>
                                </thead>    
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}

@section scripts{

    <script>
        $(document).ready(function () {

            select2list("#acc-tree", "/Shared/getAccTrees", "الحساب");
            select2list("#accBankId", "/Shared/getAllBanks", "اسم البنك");

            loadData();

        });

        //When button Add Clicked... Data send to the next table
        $('#btnAdd').on('click', function () {
            var accTreeId = $('.accTreeId').val();
            var accTreeName = $('.accTreeId').text();
            var amount = $('.amount').val();
            var currencyTypeId = $('.currencyTypeId').val();
            var currencyTypeName = $('.currencyTypeId').text();
            var statement = $('.statement').val();

            if (accTreeId != null & amount != null & currencyTypeId != null & statement != null) {
                var row = '<tr><td>' + accTreeName + '</td><td>' + amount + '</td><td>' + currencyTypeName + '</td><td>' + statement + '</td></tr>';

                $('#tbod').append(row);
                $('.det').val('');
                $('.det').text('');
                $('.list').val(null).trigger('change');
            } else {
                toastr.error('يجب ملء جميع الحقول', 'خطأ');
            }
        });

        //Validation Form Before Save Data
        $('#add-form').bootstrapValidator({
            onSuccess: function (e) {
                save();
                e.preventDefault();

            },
            submitButtons: 'button[type="submit"]',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok success-feedback-icons',
                invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                validating: 'fa fa-refresh fa-spin success-feedback-icons'
            },
            fields: {
                fund: {
                    validators: {
                        notEmpty: {
                            message: 'يجب الا يكون حقل اسم الصندوق فارغ  '
                        }
                    }
                },

                currency: {
                    validators: {
                        notEmpty: {
                            message: 'يجب الا يكون حقل اسم العملة  فارغ'
                        }
                    }
                },

                recipient: {
                    validators: {
                        notEmpty: {
                            message: 'يجب الا يكون حقل اسم المستلم  فارغ'
                        }
                    }
                },

                statment: {
                    validators: {
                        notEmpty: {
                            message: 'يجب الا يكون حقل البيان  فارغ'
                        }
                    }
                },

                receiptDate: {
                    validators: {
                        notEmpty: {
                            message: 'يجب الا يكون حقل تاريخ السند فارغ'
                        }
                    }
                },

            }
        });

        function addToTable() {

            //هنا لازم ندخل اسم الحساب
            var AccTreeId = $('#acc-tree').val();
            var AccTreeName = $('#select2-acc-tree-container').text();
            var Debit = $('#debit').val();
            var Credit = $('#credit').val();
            var Note = $('#note').val();


            if (AccTreeId != null & Debit.trim() != null & Credit.trim() != null) {
                var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                    + "<td class='accTreeVal hidden'>" + AccTreeId + "</td>"
                    + "<td class='name'>" + AccTreeName + "</td>"
                    + "<td class='debitVal'>" + Debit + "</td>"
                    + "<td class='creditVal'>" + Credit + "</td>"
                    + "<td class='noteVal'>" + Note + "</td>"
                    + '<td  class="" ><button class="btn btn-warning transfer removeRow ">حذف<i class=" transfer-fa fa  fa-edit"></i></button>' + "</td>"
                    + "</tr>";
                $('#tbody').append(rows);
                $('input').val('');
                $('.list').text(null).trigger('change');
                $('.list').val(null).trigger('change');
            } else {
                toastr["error"]("يجب ادخال كل الحقول", "خطأ");
            }

        }

        //remove row from add table
        $('.add-table').on('click', '.removeRow', function () {
            $(this).closest('tr').remove();
        });


        //Save Function
        function save() {

            var data = [];
            //AccTreeId = $("select[name= 'accTree']").val();
            //Debit = $("input[name= 'cebit']").val();
            //Credit = $("input[name= 'credit']").val();
            //Note = $("input[name= 'note']").val();



            $(".add-table tbody tr").each(function (index) {
                AccTreeId = $(this).find('.accTreeVal').text();
                Debit = $(this).find('.debitVal').text();
                Credit = $(this).find('.creditVal').text();
                Note = $(this).find('.noteVal').text();

                //---->Form validation goes here
                data.push({
                    AccTreeId: AccTreeId,
                    Debit: Debit,
                    Credit: Credit,
                    Note: Note,
                });
            });

            $.ajax({
                url: "/OpeningBalances/Create",
                type: "POST",
                data: JSON.stringify(data),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    if (response.Status == "warning") {
                        toastr[response.Status](response.Message, response.Title);
                    } else {
                        toastr[response.Status](response.Message, response.Title);
                        $('.list').val(null).trigger('change');
                        //$('#add-form').bootstrapValidator("resetForm", true);
                        //$("table tbody tr").empty();
                        window.location.reload();
                    }
                }
            });
        }

        function SetOpenBalance(data) {
            console.clear();
            console.log(data);

            $.ajax({
                url: "/OpeningBalances/Create",   // رابط الأكشن
                type: "POST",                     // نوع الطلب (POST أفضل من GET)
                data: { data: data },             // البيانات اللي هتبعتها
                dataType: "json",                 // متوقع يرجع JSON
                success: function (response) {
                    if (response.success) {
                        // لو السيرفر رجّع نجاح
                        toastr.success("تم الحفظ بنجاح");
                    } else {
                        toastr.warning(response.message || "لم يتم الحفظ");
                    }
                },
                error: function (xhr, status, error) {
                    toastr.error("حصل خطأ: " + error);
                }
            });
        }

        $('#btn-search').on('click', function () {
            var bankId = $("#accBankId").val();
            console.clear();
            console.log(bankId);

            if ($.fn.DataTable.isDataTable('#tbx')) {
                $('#tbx').DataTable().ajax.url('/OpeningBalances/LoadData?bankId=' + bankId).load();
            } else {
                loadData(bankId);
            }
        });


        function loadData(bankId) {
            if ($.fn.DataTable.isDataTable('#tbx')) {
                $('#tbx').DataTable().clear().destroy();
            }

            dataTable = $('#tbx').DataTable({
                "language": {
                    "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                    "search": "بحث"
                },
                ajax: {
                    url: '/OpeningBalances/LoadData?bankId=' + bankId,
                    dataSrc: ''
                },
                columns: [
                    {
                        "title": "",
                        "data": "AccPrentId",
                        "orderable": false,
                        "render": function (data) {
                            return '<a class="btn btn-info btnOpeningBalancesDetails" href="#"><i class="fa fa-info"></i></a>';
                        }
                    },
                    {
                        "title": "# ",
                        "data": "AccPrentId"
                    },
                    {
                        "title": "اسم الحساب",
                        "data": "AccPrentName"
                    },
                    {
                        "title": "دائن",
                        "data": "Credit",
                        "render": function (data, type, row) {
                            return formatNumber(data.toString());
                        }
                    },
                    {
                        "title": "مدين",
                        "data": "Debit",
                        "render": function (data, type, row) {
                            return formatNumber(data.toString());
                        }
                    },
                    {
                        "title": "الفرق",
                        "data": "Diff",
                        "render": function (data, type, row) {
                            return formatNumber(data.toString());
                        }
                    },
                    {
                        "title": "السنة المالية",
                        "data": "FinancialCycle"
                    },
                    {
                        "title": "<i class='fa fa-cog'></i>",
                        "data": null,
                        "width": "10%",
                        "orderable": false,
                        "render": function (data) {
                            return `<div class="btn-group">
                                                 <button type="button" class="btn btn-default" data-toggle="dropdown">
                                                       <i class="fa fa-ellipsis-v"></i>
                                                    </button>
                                                    <div class="dropdown-menu btn-threePoint">
                                                       <button type="button" class="btn-default dropdown-item" onclick='SetOpenBalance(${JSON.stringify(data)})'>
                                                          <i class="fa fa-plus"></i> تنفيذ
                                                      </button>
                                                    </div>
                                                </div>`;
                        }
                    }

                ]
            });
        }

        $('#tbx').on('click', '.btnOpeningBalancesDetails', function () {
            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var AccPrentId = data['AccPrentId'];
            var AccPrentName = data['AccPrentName'];
            var children = data['Children']; 
            AccPrentName = ' / '  + AccPrentName;
            $('#AccPrentName').text(AccPrentName);

            // حفظ الـ Id للمودال (اختياري)
            //$('#openingBalances-details-modal').data('AccPrentId', AccPrentId);

            // عرض التفاصيل داخل جدول المودال
            var tbody = $('#tblOpeningBalancesDetails tbody');
            tbody.empty();

            if (children && children.length > 0) {
                $.each(children, function (i, child) {
                    var row = `
                <tr>
                    <td>${child.AccTreeId}</td>
                    <td>${child.AccTreeName}</td>
                    <td>${formatNumber(child.Credit.toString())}</td>
                    <td>${formatNumber(child.Debit.toString())}</td>
                    <td>${formatNumber(child.Diff.toString())}</td>
                </tr>`;
                    tbody.append(row);
                });
            } else {
                tbody.append('<tr><td colspan="6" class="text-center text-muted">لا توجد تفاصيل لهذا الحساب</td></tr>');
            }

            // فتح المودال
            $('#openingBalances-details-modal').modal('show');
        });

    </script>
}




