@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

@section content{
    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <div class="grad"></div>

        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>
                بنـــود الموازنة

            </h1>
            <ol class="breadcrumb">
                <li><a href="#"><i class="fa fa-home"></i> النظام المالي </a></li>
                <li class="active"> البنـــــود</li>
            </ol>

        </section>
        <section class="content">
            <div class="row">
                <div class="col-xs-12">
                    <div class="box">
                        <div class="box-header">
                            <button type="button" id="btnAdd" class="btn btn-primary pull-left btn-add"><i class="fa fa-plus-square">  </i> بند جديد </button>
                        </div><!-- /.box-header -->
                        <div class="box-body">
                            <table id="tbx" class="table table-bordered table-hover"></table>
                        </div><!-- /.box-body -->
                    </div><!-- /.box -->
                </div><!-- /.col -->
            </div><!-- /.row -->
        </section>

    </div><!-- /.content-wrapper -->

    <div class="example-modal">
        <div class="modal fade in" id="add-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:80%">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة فصل جديد</h4>
                    </div>
                    <div class="modal-body">
                        <div class="save-btn hidden">
                            <a class="btn btn-primary" onclick="saveData()" style="position: fixed;  left: 44px; top: 50%; padding: 10px 25px;"> حفظ</a>
                        </div>
                        <div class="row row-choise">
                            <div class="choise">
                                <input type="radio" name="accNameChoise" class="accNameChoise" value="1" title="" />الاصول
                            </div>

                            <div class="choise">
                                <input type="radio" name="accNameChoise" class="accNameChoise" value="2" title="" />الخصوم
                            </div>

                            <div class="choise">
                                <input type="radio" name="accNameChoise" class="accNameChoise" value="3" title="" />الايرادات
                            </div>

                            <div class="choise">
                                <input type="radio" name="accNameChoise" class="accNameChoise" value="4" title="" />المصروفات
                            </div>

                        </div>
                        <div class="row" style="margin-left:100px">

                            <table id="tbl" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>اسم البند</th>
                                        <th>الاعتماد</th>
                                    </tr>
                                </thead>
                                <tbody class="tbl-body"></tbody>
                            </table>

                        </div><!-- /.row (main row) -->
                    </div>

                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>

    <div class="example-modal">
        <div class="modal fade in" id="edit-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:80%">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> تعديل الموازنة(<label class="accParentName"></label>)</h4>
                    </div>
                    <div class="modal-body">
                        <div class="save-btn">
                            <a class="btn btn-warning" onclick="updateData()" style="position: fixed;  left: 44px; top: 50%; padding: 10px 25px;"> تعديل</a>
                        </div>

                        <div class="row" style="margin-left:100px">
                            <table id="tbl" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>اسم البند</th>
                                        <th>الاعتماد</th>
                                        <th>الصرف/الايراد الفعلي</th>
                                        <th class="hidden">balanceId</th>
                                    </tr>
                                </thead>
                                <tbody class="editTbl-body"></tbody>
                            </table>
                        </div><!-- /.row (main row) -->
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>


    <style>
        /* Important part */
        .modal-dialog {
            overflow-y: initial !important;
        }

        .modal-body {
            height: 80vh;
            overflow-y: auto;
        }

        .row-choise {
            display: flex;
            justify-content: space-between;
        }
    </style>
}

@section scripts{

    <script>
        var type = 0;
        $(function () {
            function loadData() {
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    ajax: {
                        url: '/Balances/LoadData',
                        dataSrc: ''
                    },
                    "columnDefs": [
                     {
                         "targets": 8,
                         "visible": false
                     }
                    ],
                    columns: [
                        {
                            "title": "# ",
                            "data": "Id"
                        },
                        {
                            "title": "العام ",
                            "data": "Year"
                        },
                        {
                            "title": "البــند  ",
                            "data": "Name"
                        },
                        {
                            "title": " الاعتماد ",
                            "data": "Credint",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": "الصرف / الايراد الفعلي  ",
                            "data": "ActualExchange",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": "الانحراف النسبي  ",
                            "data": "RelativeDeviation",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": "نسبة الانحراف  ",
                            "data": "DeviationRatio"
                        },
                        {
                            "title": "<i class='fa fa-cog'></i>",
                            "data": null,
                            "orderable": false,
                            "render": function (data) {
                                return '<div class="btn-opreation">'
                                           + '<button class="btn btn-success" onClick="editMe(' + data.rootParentId + ')"><i class=" transfer-fa fa  fa-edit">  </i> تعديل </button>'
                                       + '</div> ';
                            }
                        },
                        {
                            "title": "rootParentId",
                            "data": "rootParentId",
                        }
                    ]
                });
            }
            loadData();

            function addNew() {
                type = $('input[name="accNameChoise"]:checked').val();

                console.log(type);

                $.ajax({
                    url: "/Balances/getSubaccountForAddUpdate?type=" + type,
                    type: "GET",
                    //data: JSON.stringify(ob),
                    contentType: "application/json charset=utf-8",
                    dataType: "json",
                    error: function (response) {
                        //toastr[response.Status](response.Message, response.Title);
                    },
                    success: function (result) {
                        if (result) {
                            var x;
                            var html = "";
                            $.each(result, function (key, item) {
                                html += "<tr id='row' style='font-size: 16px;text-align:center;'>"
                               + "<td class='accId'>" + item.Id + "</td>"
                               + "<td class='name'>" + item.Name + "</td>"
                               + "<td class='credint' contenteditable='true'>" + item.Credint + "</td>"
                               + "<td class='BalanceId hidden'>" + item.BalanceId + "</td>"
                               + "</tr>";
                            });
                            $('.tbl-body').empty();
                            $('.tbl-body').append(html);
                        }
                    }
                });
            }

            $('.accNameChoise').on('change', function () {
                addNew();
                $('.save-btn').removeClass('hidden');
            });

            $('#add-form').bootstrapValidator({
                onSuccess: function (e) {
                    save();
                    e.preventDefault();

                },
                submitButtons: 'button[type="submit"]',
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok success-feedback-icons',
                    invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                    validating: 'fa fa-refresh fa-spin success-feedback-icons'
                },
                fields: {
                    Name: {
                        validators: {
                            notEmpty: {
                                message: 'يجب الا يكون حقل البنـــود  فارغ'
                            }
                        }
                    }

                }
            });

            $('#AddLastLevel').bootstrapValidator({
                onSuccess: function (e) {
                    SaveAccountTreeLastLevel();
                    e.preventDefault();

                },
                submitButtons: 'button[type="submit"]',
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok success-feedback-icons',
                    invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                    validating: 'fa fa-refresh fa-spin success-feedback-icons'
                },
                fields: {
                    AccountTreeIdLastLevel: {
                        validators: {
                            notEmpty: {
                                message: 'يجب الا يكون حقل القيد  فارغ'
                            }
                        }
                    }
                    ,
                    Credint: {
                        validators: {
                            notEmpty: {
                                message: 'يجب الا يكون حقل الاعتماد  فارغ'
                            }
                        }
                    }

                }
            });

            select2list(".AccountTreeId", "/Balances/GetAccountTree", "الفصول");
            select2list(".FinanceCycleId", "/Balances/GetFinanceCycle", "العــــام");
            select2list(".EdAccountTreeId", "/Balances/GetAccountTree", "الفصول");
            select2list(".EdFinanceCycleId", "/Balances/GetFinanceCycle", "العــــام");
            select2list(".EdAccountTreeIdLevelOne", "/Balances/GetAccountTreeLevelOne", "البنـــود");
            select2list(".AccountTreeIdLastLevel", "/Balances/GetAccountTreeLastLevel", "القيود");
        });

        $('#btnAdd').click(function () {
            $('.tbl-body').empty();
            $('#add-modal').modal('show');
            type = 0;
        });


        function saveData() {
            var obj = [];

            $('.tbl-body tr').each(function () {
                accId = $(this).find('.accId').text();
                credint = $(this).find('.credint').text();
                BalanceId = $(this).find('.BalanceId').text();

                obj.push({
                    "AccountTreeId": accId,
                    "Credint": credint,
                    "ActualExchange": "0",
                    "RelativeDeviation": "0",
                    "DeviationRatio": "0",
                    "Retainer": "0",
                    "IsActive": 1,
                    "Id": BalanceId
                });
            });

            console.clear();
            console.log(obj);

            $.ajax({
                url: "/Balances/CreateOUpdate",
                type: "POST",
                data: JSON.stringify(obj),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    console.log(response);
                    toastr[response.Status](response.Message, response.Title);
                    //$('.Name').val(null);
                    $('#add-modal').modal('hide');
                    dataTable.ajax.reload();
                }
            });

        }

        function updateData() {
            var obj = [];

            $('.editTbl-body tr').each(function () {
                accId = $(this).find('.accId').text();
                credint = $(this).find('.credint').text();
                BalanceId = $(this).find('.BalanceId').text();

                obj.push({
                    "AccountTreeId": accId,
                    "Credint": credint,
                    "ActualExchange": "0",
                    "RelativeDeviation": "0",
                    "DeviationRatio": "0",
                    "Retainer": "0",
                    "IsActive": 1,
                    "Id": BalanceId
                });
            });

            console.clear();
            console.log(obj);

            $.ajax({
                url: "/Balances/CreateOUpdate",
                type: "POST",
                data: JSON.stringify(obj),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    console.log(response);
                    toastr[response.Status](response.Message, response.Title);
                    //$('.Name').val(null);
                    $('#edit-modal').modal('hide');
                    dataTable.ajax.reload();
                }
            });

        }

        //open edit modal
        function editMe(Id) {
            type = Id;
            console.clear();
            console.log(type);
            $('.editTbl-body').empty();

            $.ajax({
                url: "/Balances/getSubaccountForAddUpdate?type=" + type,
                type: "GET",
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (result) {
                    if (result) {
                        var x;
                        var html = "";
                        var accParentName = "";
                        $.each(result, function (key, item) {
                            accParentName = item.AccParentName;
                            html += "<tr id='row' style='font-size: 16px;text-align:center;'>"
                           + "<td class='accId'>" + item.Id + "</td>"
                           + "<td class='name'>" + item.Name + "</td>"
                           + "<td class='credint' contenteditable='true' style='background-color:#0c5969; color: white'>" + item.Credint + "</td>"
                           + "<td class='actualExchange'>" + formatNumber(item.ActualExchange.toString()) + "</td>"
                           + "<td class='BalanceId hidden'>" + item.BalanceId + "</td>"
                           + "</tr>";
                        });

                        $('.accParentName').text(accParentName);
                        $('.editTbl-body').empty();
                        $('.editTbl-body').append(html);
                        $('#edit-modal').modal('show');
                    }
                }
            });
        }
    </script>
}