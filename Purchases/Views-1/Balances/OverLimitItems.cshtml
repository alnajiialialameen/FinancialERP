@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

@section content{
    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <div class="grad"></div>

        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>
                بنـــود الموازنة المتجاوزة
            </h1>
            <ol class="breadcrumb">
                <li><a href="#"><i class="fa fa-home"></i> النظام المالي </a></li>
                <li class="active"> الموازنة</li>
            </ol>

        </section>
        <section class="content">
            <div class="row">
                <div class="col-xs-12">
                    <div class="box">
                        <div class="box-body">
                            <table id="tbx" class="table table-bordered table-hover"></table>
                        </div><!-- /.box-body -->
                    </div><!-- /.box -->
                </div><!-- /.col -->
            </div><!-- /.row -->
        </section>

    </div><!-- /.content-wrapper -->

    <div class="example-modal">
        <div class="modal fade in" id="add-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:80%">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة فصل جديد</h4>
                    </div>
                    <div class="modal-body">
                        <div class="save-btn hidden">
                            <a class="btn btn-primary" onclick="saveData()" style="position: fixed;  left: 44px; top: 50%; padding: 10px 25px;"> حفظ</a>
                        </div>
                        <div class="row row-choise">
                            <div class="hidden">
                                <input type="radio" name="accNameChoise" class="accNameChoise" value="-1" title="" />Default
                            </div>

                            <div class="choise">
                                <input type="radio" name="accNameChoise" class="accNameChoise" value="3" title="" />الايرادات
                            </div>

                            <div class="choise">
                                <input type="radio" name="accNameChoise" class="accNameChoise" value="4" title="" />المصروفات
                            </div>

                        </div>
                        <div class="row" style="margin-left:100px">

                            <table id="tbl" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>اسم البند</th>
                                        <th>الاعتماد</th>
                                    </tr>
                                </thead>
                                <tbody class="tbl-body"></tbody>
                            </table>

                        </div><!-- /.row (main row) -->
                    </div>

                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>
    <div class="modal fade" id="edit-modal" data-backdrop="static" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <!-- HEADER -->
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">
                        تعديل الموازنة
                    </h4>
                </div>

                <!-- BODY -->
                <div class="modal-body">
                    <input type="hidden" id="BalanceId">

                    <div class="row">

                        <div class="col-6">
                            <label>اسم البند</label>
                            <input id="accName" class="form-control" disabled />
                        </div>

                        <div class="col-6">
                            <label>التصديق قبل التعديل</label>
                            <input id="oldCredient" class="form-control" disabled />
                        </div>

                        <div class="col-12">
                            <label>المبلغ المصدق</label>
                            <input id="Credient" class="form-control"/>
                        </div>

                    </div>
                </div>

                <!-- FOOTER -->
                <div class="modal-footer">
                    <button class="btn btn-default" data-dismiss="modal">إلغاء</button>
                    <button class="btn btn-warning" onclick="updateData()">تعديل</button>
                </div>

            </div>
        </div>
    </div>
    <style>
        /* Important part */
        .modal-dialog {
            overflow-y: initial !important;
        }

        .modal-body {
/*            height: 80vh;*/
            overflow-y: auto;
        }

        .row-choise {
            display: flex;
            justify-content: space-between;
        }
    </style>
}

@section scripts{

    <script>
        var type = 0;
        $(function () {
            function loadData() {
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    ajax: {
                        url: '/Balances/LoadOverLimitItemsData',
                        dataSrc: ''
                    },
                    "columnDefs": [
                        {
                            "targets": 6,
                            "visible": false
                        }
                    ],
                    columns: [
                        {
                            "title": "# ",
                            "data": "Id"
                        },
                        {
                            "title": "العام ",
                            "data": "year"
                        },
                        {
                            "title": "البــند  ",
                            "data": "accTreeName"
                        },
                        {
                            "title": " الاعتماد ",
                            "data": "credint",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": "الصرف / الايراد الفعلي  ",
                            "data": "actualExchange",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": "الانحراف النسبي  ",
                            "data": "relativeDeviation",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": "rootParentId",
                            "data": "rootParentId",
                        }
                    ]
                });
            }
            loadData();

            function addNew() {
                type = $('input[name="accNameChoise"]:checked').val();

                console.log(type);

                $.ajax({
                    url: "/Balances/getSubaccountForAddUpdate?type=" + type,
                    type: "GET",
                    //data: JSON.stringify(ob),
                    contentType: "application/json charset=utf-8",
                    dataType: "json",
                    error: function (response) {
                        //toastr[response.Status](response.Message, response.Title);
                    },
                    success: function (result) {
                        if (result) {
                            var x;
                            var html = "";
                            $.each(result, function (key, item) {
                                html += `<tr style='font-size:16px;text-align:center;' data-accid="${item.accTreeId}">
                                                                           <td class='mainAccId'>
                                                                               ${type == 3 ? item.accTreeId.toString() :
                                        `<button type="button" class="btn btn-info btnDetails"
                                                                                            onclick='ShowDetails(${JSON.stringify(item.details)})'>
                                                                                            <i class="fa fa-arrow-down"></i>
                                                                                        </button>`
                                    }
                                                                            </td>
                                                                           <td>${item.accTreeName}</td>
                                                                           <td  class="mainCredint" oninput="formatCell(this)" contenteditable='${type == 3 ? true : false}'>${formatNumber(item.credint.toString())}</td>
                                                                           <td class="hidden mainBalanceId">${item.balanceId}</td>
                                                                       </tr>`;
                            });
                            $('.tbl-body').empty();
                            $('.tbl-body').append(html);
                        }
                    }
                });
            }

            $('.accNameChoise').on('change', function () {
                addNew();
                $('.save-btn').removeClass('hidden');
            });

            $('#add-form').bootstrapValidator({
                onSuccess: function (e) {
                    save();
                    e.preventDefault();

                },
                submitButtons: 'button[type="submit"]',
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok success-feedback-icons',
                    invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                    validating: 'fa fa-refresh fa-spin success-feedback-icons'
                },
                fields: {
                    Name: {
                        validators: {
                            notEmpty: {
                                message: 'يجب الا يكون حقل البنـــود  فارغ'
                            }
                        }
                    }

                }
            });

            $('#AddLastLevel').bootstrapValidator({
                onSuccess: function (e) {
                    SaveAccountTreeLastLevel();
                    e.preventDefault();

                },
                submitButtons: 'button[type="submit"]',
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok success-feedback-icons',
                    invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                    validating: 'fa fa-refresh fa-spin success-feedback-icons'
                },
                fields: {
                    AccountTreeIdLastLevel: {
                        validators: {
                            notEmpty: {
                                message: 'يجب الا يكون حقل القيد  فارغ'
                            }
                        }
                    }
                    ,
                    Credint: {
                        validators: {
                            notEmpty: {
                                message: 'يجب الا يكون حقل الاعتماد  فارغ'
                            }
                        }
                    }

                }
            });

            select2list(".AccountTreeId", "/Balances/GetAccountTree", "الفصول");
            select2list(".FinanceCycleId", "/Balances/GetFinanceCycle", "العــــام");
            select2list(".EdAccountTreeId", "/Balances/GetAccountTree", "الفصول");
            select2list(".EdFinanceCycleId", "/Balances/GetFinanceCycle", "العــــام");
            select2list(".EdAccountTreeIdLevelOne", "/Balances/GetAccountTreeLevelOne", "البنـــود");
            select2list(".AccountTreeIdLastLevel", "/Balances/GetAccountTreeLastLevel", "القيود");
        });

        function ShowDetails(details) {
            type = $('input[name="accNameChoise"]:checked').val();

            var btn = event.currentTarget;
            var tr = $(btn).closest("tr");

            // toggle
            if (tr.next().hasClass("subTableRow")) {
                tr.next().remove();
                return;
            }

            var rows = "";
            $.each(details, function (index, item) {
                rows += `
                                                        <tr style="font-size:16px;text-align:center;">
                                                            <td class="accId">${item.accTreeId}</td>
                                                            <td class="name">${item.accTreeName}</td>
                                                            <td class="credint" contenteditable='true' oninput="formatCell(this)">${formatNumber(item.credint.toString())}</td>
                                                            <td class="hidden BalanceId">${item.balanceId}</td>
                                                        </tr>
                                                    `;
            });

            var subTable = `
                                                <tr class="subTableRow">
                                                    <td colspan="4">
                                                        <table class="table table-bordered" style="margin:0">
                                                            <thead>
                                                                <tr style="background:#f5f5f5">
                                                                    <th>#</th>
                                                                    <th>إسم الحساب</th>
                                                                    <th>الاعتماد</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody class="tblDetailsBody">
                                                                ${rows}
                                                            </tbody>
                                                        </table>
                                                    </td>
                                                </tr>
                                            `;

            tr.after(subTable);
        }

        $('#btnAdd').click(function () {
            $('.tbl-body').empty();
            $('#add-modal').modal('show');
            type = 0;
        });

        function saveData() {
            var obj = [];

            type = $('input[name="accNameChoise"]:checked').val();
            debugger;
            if (type != "3") {
                $('.tblDetailsBody tr').each(function () {
                    accId = $(this).find('.accId').text();
                    //credint = $(this).find('.credint').text();
                    credint = $(this).find('.credint').text().replace(/,/g, '');
                    BalanceId = $(this).find('.BalanceId').text();

                    obj.push({
                        "AccountTreeId": accId,
                        "Credint": credint,
                        "ActualExchange": "0",
                        "RelativeDeviation": "0",
                        "DeviationRatio": "0",
                        "Retainer": "0",
                        "IsActive": 1,
                        "Id": BalanceId
                    });
                });
            }
            else {
                $('.tbl-body tr').each(function () {
                    //accId = $(this).find('.mainAccId').text();
                    accId = $(this).data('accid'); // الحل الصحيح
                    //credint = $(this).find('.mainCredint').text();
                    credint = $(this).find('.mainCredint').text().replace(/,/g, '');
                    BalanceId = $(this).find('.mainBalanceId').text();

                    obj.push({
                        "AccountTreeId": accId,
                        "Credint": credint,
                        "ActualExchange": "0",
                        "RelativeDeviation": "0",
                        "DeviationRatio": "0",
                        "Retainer": "0",
                        "IsActive": 1,
                        "Id": BalanceId
                    });
                });
            }

            console.clear();
            console.log(obj);

            $.ajax({
                url: "/Balances/CreateOUpdate",
                type: "POST",
                data: JSON.stringify(obj),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    console.log(response);
                    toastr[response.Status](response.Message, response.Title);
                    //$('.Name').val(null);
                    $('#add-modal').modal('hide');
                    dataTable.ajax.reload();
                    $('input[name="accNameChoise"][value="-1"]').prop('checked', true);
                }
            });

        }

        function updateData() {
            var Id = $('#BalanceId').text();
            var Credint = $('#Credient').val().replace(/,/g, '');

            console.clear();
            console.log(Id);

            $.ajax({
                url: `/Balances/Update/${Id}?Credint=${Credint}`,
                type: "POST",
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    console.log(response);
                    toastr[response.Status](response.Message, response.Title);
                    //$('.Name').val(null);
                    $('#edit-modal').modal('hide');
                    dataTable.ajax.reload();
                }
            });

        }

        //open edit modal
        function editMe111(Id) {
            type = Id;
            console.clear();
            console.log(type);
            $('.editTbl-body').empty();

            $.ajax({
                url: "/Balances/getSubaccountForAddUpdate?type=" + type,
                type: "GET",
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (result) {
                    if (result) {
                        var x;
                        var html = "";
                        var accParentName = "";
                        $.each(result, function (key, item) {
                            accParentName = item.AccParentName;
                            html += "<tr id='row' style='font-size: 16px;text-align:center;'>"
                                + "<td class='accId'>" + item.Id + "</td>"
                                + "<td class='name'>" + item.Name + "</td>"
                                + "<td class='credint' contenteditable='true' style='background-color:#0c5969; color: white'>" + item.Credint + "</td>"
                                + "<td class='actualExchange'>" + formatNumber(item.ActualExchange) + "</td>"
                                + "<td class='BalanceId hidden'>" + item.BalanceId + "</td>"
                                + "</tr>";
                        });

                        $('.accParentName').text(accParentName);
                        $('.editTbl-body').empty();
                        $('.editTbl-body').append(html);
                        $('#edit-modal').modal('show');
                    }
                }
            });
        }

        //open edit modal
        function editMe(Id, accName, oldCredient) {
            $('.editTbl-body').empty();

            $('#BalanceId').text(Id);
            $('#accName').val(accName);
            var oldCredient1 = formatNumber(oldCredient.toString());
            console.log(oldCredient1);
            $('#oldCredient').val(oldCredient1);


            $('.editTbl-body').empty();
            //$('.editTbl-body').append(html);
            $('#edit-modal').modal('show');
        }

        function formatInput(el)
        {
            let value = el.value.replace(/,/g, '').replace(/\D/g, '');

            if (value === '') {
                el.innerText = '';
                return;
            }

            let formatted = formatNumber(value.toString());
            el.innerText = formatted;

            // وضع المؤشر في نهاية النص
            let range = document.createRange();
            let sel = window.getSelection();
            range.selectNodeContents(el);
            range.collapse(false);
            sel.removeAllRanges();
            sel.addRange(range);
        }

        function formatCell(el) {

            let value = el.innerText.replace(/,/g, '').replace(/\D/g, '');

            if (value === '') {
                el.innerText = '';
                return;
            }

            let formatted = formatNumber(value.toString());
            el.innerText = formatted;

            // وضع المؤشر في نهاية النص
            let range = document.createRange();
            let sel = window.getSelection();
            range.selectNodeContents(el);
            range.collapse(false);
            sel.removeAllRanges();
            sel.addRange(range);
        }

    </script>
}