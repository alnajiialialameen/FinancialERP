@section scripts{

    <script>

     $(function () {


         function loadData() {
             dataTable = $('#tbx').DataTable({
                 "language": {
                     "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                     "search": "بحث"
                 },
                 ajax: {
                     url: '/Balances/LoadData',
                     dataSrc: ''
                 },
                 columns: [
                     {
                         "title": "# ",
                         "data": "Id"
                     },
                     {
                         "title": "العام ",
                         "data": "Year"
                     },
                     {
                         "title": "البــند  ",
                         "data": "Name"
                     },
                 {
                         "title": " الاعتماد ",
                         "data": "Credint"
         },
                     {
                         "title": "الصرف الفعلي  ",
                         "data": "ActualExchange"
                     },
                   
                     {
                         "title": "الانحراف النسبي  ",
                         "data": "RelativeDeviation"
                     },
                     {
                         "title": "نسبة الانحراف  ",
                         "data": "DeviationRatio"
                     },
                    

                     {
                         "title": "عدد البنود  ",
                         "data": null,
                         "render": function (data) {
                             return '<input readonly class="btn btn-info transfer btn-number-in openHousingModal" value=" ' + data.Count + ' "/>'
                         }
                     },
                     {
                         "title": "<i class='fa fa-cog'></i>",
                         "data": null,
                         "width": "25%",
                         "orderable": false,
                         "render": function (data) {
                             return  '<div class="btn-opreation">'
                                          + '<button class="btn btn-success transfer openEditModal">تعديل <i class=" transfer-fa fa  fa-edit"></i></button> '
                                                                           + '<button class="btn btn-success transfer openAditModal">  إضافة بند فرعي <i class=" transfer-fa fa  fa-edit"></i></button> '

                                 + '</div> '

                             ;

                         }
                     }


                 ]

             });

         }
         loadData();



         

         $('#add-form').bootstrapValidator({
             onSuccess: function (e) {
                 save();
                 e.preventDefault();

             },
             submitButtons: 'button[type="submit"]',
             feedbackIcons: {
                 valid: 'glyphicon glyphicon-ok success-feedback-icons',
                 invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                 validating: 'fa fa-refresh fa-spin success-feedback-icons'
             },
             fields: {
                 Name: {
                     validators: {
                         notEmpty: {
                             message: 'يجب الا يكون حقل البنـــود  فارغ'
                         }
                     }
                 }

             }
         });


         $('#AddLastLevel').bootstrapValidator({
             onSuccess: function (e) {
                 SaveAccountTreeLastLevel();
                 e.preventDefault();

             },
             submitButtons: 'button[type="submit"]',
             feedbackIcons: {
                 valid: 'glyphicon glyphicon-ok success-feedback-icons',
                 invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                 validating: 'fa fa-refresh fa-spin success-feedback-icons'
             },
             fields: {
                 AccountTreeIdLastLevel: {
                     validators: {
                         notEmpty: {
                             message: 'يجب الا يكون حقل القيد  فارغ'
                         }
                     }
                 }
                 ,
                 Credint: {
                     validators: {
                         notEmpty: {
                             message: 'يجب الا يكون حقل الاعتماد  فارغ'
                         }
                     }
                 }

             }
         });




         //functin for select2 pluging
         function select2list(selector, url, placeholder) {
             $(selector).select2({
                 language: { inputTooShort: function () { return 'enter 1 letter at less'; } },
                 ajax: {
                     url: url,
                     dataType: 'json',
                     delay: 100,
                     data: function (params) {
                         return {
                             q: params.term,
                             page: params.page
                         };
                     },
                     processResults: function (data, params) {
                         params.page = params.page || 1;
                         return {
                             results: data,
                             pagination: {
                                 more: ((data.total_count) > (params.page * 20))
                             }
                         };
                     },
                     cache: true
                 },
                 placeholder: placeholder,
                 minimumInputLength: 1,
             });

         };

         select2list(".AccountTreeId", "/Balances/GetAccountTree", "الفصول");
         select2list(".FinanceCycleId", "/Balances/GetFinanceCycle", "العــــام");
         select2list(".EdAccountTreeId", "/Balances/GetAccountTree", "الفصول");
         select2list(".EdFinanceCycleId", "/Balances/GetFinanceCycle", "العــــام");
         select2list(".EdAccountTreeIdLevelOne", "/Balances/GetAccountTreeLevelOne", "البنـــود");
         
         select2list(".AccountTreeIdLastLevel", "/Balances/GetAccountTreeLastLevel", "القيود");

         
         //$('#adit-form-housing').bootstrapValidator({
         //    onSuccess: function (e) {
         //        saveHousing();
         //        e.preventDefault();

         //    },
         //    submitButtons: 'button[type="submit"]',
         //    feedbackIcons: {
         //        valid: 'glyphicon glyphicon-ok success-feedback-icons',
         //        invalid: 'glyphicon glyphicon-remove error-feedback-icons',
         //        validating: 'fa fa-refresh fa-spin success-feedback-icons'
         //    },
         //    fields: {
         //        name: {
         //            validators: {
         //                notEmpty: {
         //                    message: 'يجب الا يكون حقل المحلية  فارغ'
         //                }
         //            }
         //        }

         //    }
         //});
     });




     function save() {


         var ob = {
             "FinanceCycleId": $('select[name="FinanceCycleId"]').val(),
             "AccountTreeId": $('select[name="AccountTreeId"]').val(),
             "Credint": $('input[name="Credint"]').val()

            // "AccountTreeId": $('#Name').val()
         };
         $.ajax({
             url: "@Url.Action("Save", "Balances")",
             type: "POST",
             data: JSON.stringify(ob),
             contentType: "application/json charset=utf-8",
             dataType: "json",
             error: function (response) {
                 //toastr[response.Status](response.Message, response.Title);
             },
             success: function (response) {
                 toastr[response.Status](response.Message, response.Title);
                 //$('.Name').val(null);
                 $('#add-modal').modal('hide');
                 dataTable.ajax.reload();

             }
         });

     }

        function saveAccountTreeLevelOne() {


         var ob = {
             "AccountTreeId": $('select[name="EdAccountTreeIdLevelOne"]').val(),
             "Id": $('#ad-id').val()
         };
         $.ajax({
             url: "@Url.Action("saveAccountTreeLevelOne", "Balances")",
             type: "POST",
         data: JSON.stringify(ob),
         contentType: "application/json charset=utf-8",
         dataType: "json",
         error: function (response) {
             //toastr[response.Status](response.Message, response.Title);
         },
         success: function (response) {
             toastr[response.Status](response.Message, response.Title);
             $('.name').val(null);
             $('#add-modal-item-detail').modal('hide');
             dataTable.ajax.reload();

         }
     });

        }




        //show add last level
        //Open Adit Modal item detail
        $("#tbx2").on('click', '.AdLastLevel', function () {
            // get the current row
            $('#ad-name').val(null);
            var currentRow = $(this).closest("tr");

            $('#IdLastLevel').val(currentRow.find("td:eq(0)").text());
            // $('#ad-name').val(currentRow.find("td:eq(1)").text()); // get current row 1st TD value
            $('#AdLastLevel').modal('show');

        });
        //save last level

        function SaveAccountTreeLastLevel() {


            var ob = {
                "AccountTreeId": $('select[name="AccountTreeIdLastLevel"]').val(),
                "Id": $('#IdLastLevel').val(),
                "Credint": $('#Credint').val(),
            };
            $.ajax({
                url: "@Url.Action("SaveAccountTreeLastLevel", "Balances")",
                type: "POST",
            data: JSON.stringify(ob),
            contentType: "application/json charset=utf-8",
            dataType: "json",
            error: function (response) {
                //toastr[response.Status](response.Message, response.Title);
            },
            success: function (response) {
                toastr[response.Status](response.Message, response.Title);
                $('.name').val(null);
                $('#add-modal-item-detail').modal('hide');
                dataTable.ajax.reload();

            }
        });

        }


         //End Document Ready


         ///////////////////////////////////////////////////////////////////////

         //Open Edit Modal
         $("#tbx").on('click', '.openEditModal', function () {
