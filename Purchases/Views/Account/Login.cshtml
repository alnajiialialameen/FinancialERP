@{
    Layout = "";
}
<html>
<head>
    <title>Login</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap_rtl.css" rel="stylesheet" />
    <link href="~/Content/bootstrapValidator.min.css" rel="stylesheet" />
    <link href="~/Content/AdminLTE.min.css" rel="stylesheet" />
    <link href="~/Content/stylee.css" rel="stylesheet" />
    <link href="~/Content/all.css" rel="stylesheet" />

    <link rel="icon" type="image/png" href="~/Content/img/Logo.png" />
</head>
<body>

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-4 col-md-offset-4  login-content">
                <h1 class="text-center login-title">  النظام المحاسبي - Financial ERP SYSTEM</h1>
                <div class="account-wall">

                    <img class="profile-img" src="~/Content/img/Logo.png" alt="">

                    <div class="row">
                        <form id="login-form" method="post" action="@Url.Action("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl })">
                            @Html.AntiForgeryToken()
                            <span style="font-weight:bold"> @Html.ValidationSummary(true, "", new { @class = "text-center" })</span>
                            <div class="col-lg-12">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label for="passenger">  اسم المستخدم</label>
                                        <div class="input-group">
                                            <span class="input-group-addon "><i class="fa fa-user"></i></span>
                                            <input type="text" class="form-control login-input username" id="username" name="UserName" placeholder="   اسم المستخدم" autocomplete="off">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label for="passenger">  كلمة المرور </label>
                                        <div class="input-group">
                                            <span class="input-group-addon "><i class="fa fa-key"></i></span>
                                            <input type="password" class="form-control login-input password" id="password" name="Password" placeholder="  كلمة االمرور " autocomplete="off">
                                            <span class="input-group-addon toggle-password" style="cursor: pointer;">
                                                <i class="fa fa-eye" id="toggleIcon"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <button class="btn btn-primary btn-block login-btn" style="font-weight:bold; margin: 14px 0 30px;"> تسجيل دخول @*<i class="fa fa-yandex"></i>*@</button>
                                    </div>
                                </div>
                                <div class="col-lg-12 text-center login-footer">
                                    <strong>  Copyright &copy; @DateTime.Now.Year <a href="#">SoftWare Team </a></strong>
                                </div>
                            </div>
                        </form>

                    </div>


                </div>
            </div>
        </div>
    </div>


    <script src="~/Scripts/jquery-2.1.4.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/bootstrapValidator.min.js"></script>
    <script src="~/Scripts/all.js"></script>
    @Scripts.Render("~/bundles/jqueryval")



    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('username').focus();
        });
        $(function () {



        });


        // عند الضغط على الأيقونة، يتم التبديل بين نوع الحقل
        document.querySelector('.toggle-password').addEventListener('click', function () {
            const passwordInput = document.getElementById('password');
            const toggleIcon = document.getElementById('toggleIcon');
            const isPassword = passwordInput.type === 'password';

            passwordInput.type = isPassword ? 'text' : 'password';
            toggleIcon.classList.toggle('fa-eye');
            toggleIcon.classList.toggle('fa-eye-slash');
        });
    </script>

</body>
</html>


