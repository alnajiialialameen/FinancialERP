@model Purchases.Models.RegisterViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section content{
    <style>
        #user-modal .modal-dialog {
            max-width: 70%;
        }

        @@media (max-width: 768px) {
            #user-modal .modal-dialog {
                max-width: 95%;
                margin: 1rem auto;
            }
        }

        .input-group .select2-container {
            flex: 1 1 auto;
            width: 1% !important;
        }

        .input-group .select2-container .select2-selection--single {
            height: 38px;
            border-radius: 0 6px 6px 0;
        }

        .input-group .select2-container .select2-selection__rendered {
            line-height: 36px;
            text-align: right;
        }

        .input-group .select2-container .select2-selection__arrow {
            height: 36px;
        }
    </style>

    <!-- Add User Button -->
    <div class="d-flex justify-content-end my-3">
        <button type="button"
                class="btn btn-primary btn-add"
                id="btnAddUser">
            <i class="bi bi-plus-square"></i>
            مستخدم جديد
        </button>
    </div>

    <!-- Users Table -->
    <div class="table-responsive">
        <table id="tbx" class="table table-bordered table-hover"></table>
    </div>


    <!-- Add / Edit User Modal -->
    <div class="modal fade"
         id="user-modal"
         tabindex="-1"
         aria-labelledby="userModalTitle"
         aria-hidden="true"
         data-bs-backdrop="static">

        <div class="modal-dialog  modal-dialog-scrollable modal-xl" style="max-width:90%;">
            <div class="modal-content">

                <!-- Header -->
                <div class="d-flex flex-row justify-content-between p-4">
                    <h5 class="modal-title" id="userModalTitle">
                        إضافة مستخدم
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="إغلاق">
                    </button>
                </div>

                <!-- Body -->
                <div class="modal-body">

                    <form id="userForm" method="post" novalidate>

                        <input type="hidden" id="userId" />

                        <div class="row g-3">

                            <!-- Full Name -->
                            <div class="col-12 col-md-6">
                                <label for="user-name" class="form-label">
                                    الاسم الكامل
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-person"></i>
                                    </span>

                                    <input type="text"
                                           class="form-control"
                                           id="user-name"
                                           name="username"
                                           placeholder="الاسم الكامل"
                                           required />

                                    <div class="invalid-feedback">
                                        يجب ألا يكون حقل الاسم فارغاً.
                                    </div>
                                </div>
                            </div>

                            <!-- Phone -->
                            <div class="col-12 col-md-6">
                                <label for="name" class="form-label">
                                    رقم الهاتف
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-telephone"></i>
                                    </span>

                                    <input type="tel"
                                           class="form-control"
                                           id="name"
                                           name="name"
                                           maxlength="10"
                                           placeholder="رقم الهاتف"
                                           required />

                                    <div class="invalid-feedback">
                                        يجب إدخال رقم الهاتف.
                                    </div>
                                </div>
                            </div>

                            <!-- Role -->
                            <div class="col-12 col-md-6">
                                <label for="role" class="form-label">
                                    الصلاحية
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-shield-lock"></i>
                                    </span>

                                    <select class="form-select role list"
                                            id="role"
                                            name="role"
                                            required>
                                        <option value="">اختر الصلاحية</option>
                                    </select>

                                    <div class="invalid-feedback">
                                        يجب اختيار الصلاحية.
                                    </div>
                                </div>
                            </div>

                            <!-- Password -->
                            <div class="col-12 col-md-6">
                                <label for="password" class="form-label">
                                    كلمة المرور
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-key"></i>
                                    </span>

                                    <input type="text"
                                           class="form-control password"
                                           id="password"
                                           value="123456"
                                           disabled />
                                </div>

                                <small class="text-muted">
                                    كلمة المرور الافتراضية للمستخدم الجديد.
                                </small>
                            </div>

                            <!-- Airport -->
                            <div class="col-12 col-md-6">
                                <label for="airportName" class="form-label">
                                    المطار
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-airplane"></i>
                                    </span>

                                    <select class="form-select airportName list"
                                            id="airportName"
                                            name="airportName">
                                        <option value="">اختر المطار</option>
                                    </select>
                                </div>
                            </div>

                        </div>

                    </form>

                </div>

                <!-- Footer -->
                <div class="modal-footer d-flex justify-content-between">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        رجوع
                    </button>

                    <button type="submit"
                            form="userForm"
                            class="btn btn-primary"
                            id="btnSaveUser">
                        <i class="bi bi-check-circle"></i>
                        حفظ
                    </button>

                </div>

            </div>
        </div>
    </div>
}


@section scripts {
    <script>

            var dataTable;
           //$(function () {
            $(document).ready(function () {
                loadData();

                select2list(".role", "/Account/getAllRoles", " صلاحية المستخدم ", "#user-modal");
                select2listNew(".airportName", "/Account/getAirports", "المطار الذي يعمل به", "#user-modal");
                select2list(".edairportName", "/Account/getAirports", "المطار الذي يعمل به", "#user-modal");
            });
            function loadData() {
                    dataTable = $('#tbx').DataTable({
                        "language": {
                            "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                            "search": "بحث"
                        },
                        ajax: {
                            url: '/Account/LoadData',
                            dataSrc: ''
                        },
                        columnDefs: [
                            {
                                targets: [0, 6],
                                className: 'd-none'
                                //visible: false,
                                //searchable: false
                            },
                            {
                                targets: 7,
                                orderable: false,
                                searchable: false
                            }
                        ],
                        columns: [
                            {
                                "title": "# ",
                                "data": "Id"
                            },
                            {
                                "title": "الاسم بالكامل",
                                "data": "Name"
                            },
                            {
                                "title": "اسم المستخدم",
                                "data": "UserName"
                            },
                            {
                                "title": "رقم الهاتف",
                                "data": "Phone"
                            },
                            {
                                "title": "الصلاحية",
                                "data": "Role"
                            },
                            {
                                "title": "مكان العمل",
                                "data": "CompanyInfoName"
                            },
                            {
                                "title": "مكان العمل",
                                "data": "CompanyInfoId"
                            },
                            {
                                "title": "<i class='fa fa-cog'></i>",
                                "data": null,
                                "orderable": false,
                                "render": function (data) {
                                    return '<div class="btn-opreation">'
                                        + '<button class="btn btn-warning transfer resetPassword">Reset Password <i class="bi bi-arrow-clockwise"> </i></button>'
                                        + '<button class="btn btn-success transfer openEditModal" style="margin-right:4px">تعديل <i class="bi bi-pencil-square"></i></button> '
                                        + '</div> ';

                                }
                            }
                        ]

                    });

                }

        document.addEventListener('DOMContentLoaded', function () { 

            const modalElement = document.getElementById('user-modal');
            const userModal = bootstrap.Modal.getOrCreateInstance(modalElement);

            const form = document.getElementById('userForm');

            const modalTitle = document.getElementById('userModalTitle');
            const saveButton = document.getElementById('btnSaveUser');

            // ---------------------------------------- Open Add Modal ----------------------------------------
            $('#btnAddUser').on('click', function () {

                form.reset();
                form.classList.remove('was-validated');

                $('#userId').val('');

                // Reset Select2 if used
                $('#role, #airportName').val(null).trigger('change');

                modalTitle.textContent = 'إضافة مستخدم';

                saveButton.innerHTML =
                    '<i class="bi bi-check-circle"></i> حفظ';

                saveButton.className = 'btn btn-primary';

                userModal.show();
            });

            // ----------------------------------------  Open Edit Modal  ---------------------------------------
            $('#tbx').on('click', '.openEditModal', function () {

                const currentRow = $(this).closest('tr');
                const rowData = dataTable.row(currentRow).data();
                const userId = rowData.Id;

                //const userId = currentRow.find('td:eq(0)').text().trim();

                const userName = currentRow.find('td:eq(1)').text().trim();

                const phone = currentRow.find('td:eq(2)').text().trim();

                const role = currentRow.find('td:eq(4)').text().trim();

                const airportName = currentRow.find('td:eq(5)').text().trim();

                const airportId = currentRow.find('td:eq(6)').text().trim();

                form.reset();
                form.classList.remove('was-validated');

                $('#userId').val(userId);

                $('#user-name').val(userName);
                $('#name').val(phone);

                // Set Role Option
                setSelectOption('#role', role, role);

                // Set Airport Option
                setSelectOption('#airportName', airportName, airportId);

                modalTitle.textContent = 'تعديل مستخدم';

                saveButton.innerHTML =
                    '<i class="bi bi-pencil-square"></i> تعديل';

                saveButton.className = 'btn btn-warning';

                userModal.show();
            });

            // ---------------------------------------- Set Select Option ----------------------------------------
            function setSelectOption(selector, text, value) {

                const select = $(selector);

                if (!value) {
                    select.val(null).trigger('change');
                    return;
                }

                if (select.find('option').filter(function () {
                    return this.value == value;
                }).length === 0) {

                    select.append(new Option(text, value, true, true));
                }

                select.val(value).trigger('change');
            }

            // ---------------------------------------- Form Submit / Validation // ----------------------------------------

            form.addEventListener('submit', function (event) {

                event.preventDefault();
                event.stopPropagation();

                form.classList.add('was-validated');

                if (!form.checkValidity()) {
                    return;
                }

                const userId = $('#userId').val();

                if (userId) {
                    edit(userId);
                }
                else {
                    create();
                }

            });

            // ---------------------------------------- Create User ----------------------------------------
            function create() {
                const ob = {
                    UserName: $('#user-name').val(),
                    Phone: $('#name').val(),
                    AirportName: $('#airportName option:selected').text(),
                    CompanyInfoId: parseInt($('#airportName').val()),
                    Role: $('#role option:selected').text()
                };

                console.clear();
                console.log(ob);

                $.ajax({
                    url: "@Url.Action("Create", "Account")",
                    type: "POST",
                    data: JSON.stringify(ob),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",

                    success: function (response) {

                        toastr[response.Status](
                            response.Message,
                            response.Title
                        );

                        if (response.Status === 'success') {

                            userModal.hide();

                            dataTable.ajax.reload();

                            form.reset();
                            form.classList.remove('was-validated');

                            $('#role, #airportName').val(null).trigger('change');
                        }
                    },

                    error: function (response) {
                        console.error(response);
                    }
                });
            }

            // ---------------------------------------- Edit User ---------------------------------------
            function edit(id) {

                const ob = {
                    UserName: $('#user-name').val(),
                    Phone: $('#name').val(),
                    Id: id,
                    CompanyInfoId: parseInt($('#airportName').val()),
                    Role: $('#role option:selected').text()
                };

                $.ajax({
                    url: "@Url.Action("Edit", "Account")",
                    type: "POST",
                    data: JSON.stringify(ob),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",

                    success: function (response) {

                        toastr[response.Status](
                            response.Message,
                            response.Title
                        );

                        if (response.Status === 'success') {

                            userModal.hide();

                            dataTable.ajax.reload();

                            form.reset();
                            form.classList.remove('was-validated');

                            $('#role, #airportName').val(null).trigger('change');
                        }
                    },

                    error: function (response) {
                        console.error(response);
                    }
                });
                }

            $('#tbx').on('click', '.resetPassword', function () {

                const currentRow = $(this).closest('tr');
                const rowData = dataTable.row(currentRow).data();
                const employeeid = rowData.Id;
                //const employeeid = currentRow.find('td:eq(0)').text().trim();

                Swal.fire({
                    title: 'إعادة تعيين كلمة المرور',
                    text: 'سيتم تعديل كلمة المرور إلى الافتراضية (123456)',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#245571',
                    cancelButtonColor: '#f4f4f4',
                    confirmButtonText: 'موافق',
                    cancelButtonText: 'رجوع'
                }).then((result) => {

                    if (result.isConfirmed) {
                        confirmresetPassword(employeeid);
                    }

                });
            });
        });

        //called from sweet alert
        function confirmresetPassword(employeeid)
        {
            var ob = {
                "Id": employeeid,
            };

            $.ajax({
                    url: "@Url.Action("ResetPassword", "Account")",
                    type: "POST",
                    data: JSON.stringify(ob),
                    contentType: "application/json charset=utf-8",
                    dataType: "json",
                error: function (response) {
                    console.log('erooooor')
                        //toastr[response.Status](response.Message, response.Title);
                    },
                success: function (response) {
                    console.log('success')
                        toastr[response.Status](response.Message, response.Title);
                        ////$('.ed-name').val(null);
                        //$('#edit-modal').modal('hide');
                        //dataTable.ajax.reload();
                        //$('.list').val(null).trigger('change');
                        //$('#edit-form').bootstrapValidator("resetForm", true);
                    }
                });
            }
    </script>
}