@using Purchases.Models;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section content{
        <!-- Content Header -->
        <section class="d-flex flex-row justify-content-between align-items-center my-3">
            <h3>الملف الشخصي</h3>

            <ol class="breadcrumb">
                <li>
                    <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                        <i class="bi bi-house-fill"></i>
                        النظام المحاسبي >
                    </a>
                </li>
                
                <li class="active">الملف الشخصي</li>
            </ol>
        </section>

        <!-- Main Content -->
        <section class="content">
            <div class="container-fluid">

                <!-- Top Section -->
                <div class="row g-3">

                    <!-- Financial Year -->
                    <div class="col-12 col-lg-3">
                        <div class="border rounded p-3 h-100">

                            <div class="d-flex flex-row justify-content-between ">
                                <label class="fs-6">العام المالي الحالي:</label>
                                <span class="badge bg-success">
                                    @ViewBag.CurrentYear
                                </span>
                            </div>

                            <hr />

                            <div class="d-flex flex-row justify-content-between ">
                                <label class="fs-6">أنت تعمل العام المالي:</label>
                                <span class="badge bg-warning text-dark"
                                      id="UserCurrentYear">
                                    @ViewBag.UserCurrentYear
                                </span>
                            </div>

                            <hr />

                            <div class="d-flex flex-row justify-content-between ">
                                <label class="fs-6">طلب تغيير العام المالي</label>

                                <button type="button"
                                        class="btn btn-info btn-sm btn-changeFinancialCycleId"
                                        data-bs-toggle="modal"
                                        data-bs-target="#changeFinancialCycleId-modal">
                                    تغيير
                                </button>
                            </div>

                        </div>
                    </div>

                    <!-- Currency -->
                    <div class="col-12 col-lg-5">
                        <div class="border rounded p-3 h-100">

                            <div class="d-flex flex-row justify-content-between mb-4">
                                <label class="fs-6">العملة المحلية</label>

                                <span class="badge bg-success">
                                    @ViewBag.LocalCurrency
                                </span>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered table-striped table-hover text-center align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>#</th>
                                            <th>العملة</th>
                                            <th>الشهر</th>
                                            <th>السنة</th>
                                            <th>سعر الصرف</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @{
                                            Entities db = new Entities();

                                            foreach (var item in db.CurrencyDetails
                                                .Where(x => x.IsActive == true)
                                                .Take(10)
                                                .ToList())
                                            {
                                                <tr>
                                                    <td>@item.Id</td>
                                                    <td>@item.CurrencyType.Name</td>
                                                    <td>@item.Month</td>
                                                    <td>@item.Year</td>
                                                    <td>@item.ExchangeRate</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="text-center mt-3">
                                <a href="@Url.Action("Index", "CurrencyDetails")"
                                   target="_blank"
                                   class="btn btn-info">
                                    عرض الكل
                                </a>
                            </div>

                        </div>
                    </div>

                    <!-- User Profile -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="border rounded p-3 h-100">

                            <div class="text-center mb-3">
                                <img src="~/Content/img/user3.jpg"
                                     alt="الصورة الشخصية"
                                     class="rounded-circle border"
                                     style="width:80px; height:80px; object-fit:cover;" />
                            </div>

                            <div class="d-flex flex-row justify-content-between border rounded p-2 mb-2">
                                <label class="fw-bold">الاسم</label>
                                <span>@ViewBag.FullName</span>
                            </div>

                            <div class="d-flex flex-row justify-content-between border rounded p-2 mb-2">
                                <label class="fw-bold">الدور</label>
                                <span>@ViewBag.Role</span>
                            </div>

                            <div class="d-flex flex-row justify-content-between border rounded p-2 mb-2">
                                <label class="fw-bold">اسم المستخدم</label>
                                <span>@ViewBag.UserName</span>
                            </div>

                            <div class="d-flex flex-row justify-content-between border rounded p-2 mb-2">
                                <label class="fw-bold">الإيميل</label>
                                <span class="text-break">@ViewBag.Email</span>
                            </div>

                            <div class="d-flex flex-row justify-content-between border rounded p-2 mb-3">
                                <label class="fw-bold">رقم الهاتف</label>
                                <span>@ViewBag.PhoneNumber</span>
                            </div>

                            <button type="button"
                                    class="btn btn-primary w-100 btn-md btn-add"
                                    data-bs-toggle="modal"
                                    data-bs-target="#changepassword-modal">
                                تغيير كلمة المرور
                            </button>

                        </div>
                    </div>

                </div>

                <hr class="my-4" />

                <!-- Financial Operations Charts -->
                <div class="row g-3">

                    <div class="col-12">
                        <h2 class="text-center text-primary fs-4 mb-3">
                            العمليات المالية التي نفذتها خلال هذا العام
                        </h2>
                    </div>

                    <div class="col-12 col-lg-8">
                        <div class="border rounded p-3">
                            <canvas id="lienerChart"></canvas>
                        </div>
                    </div>

                    <div class="col-12 col-lg-4">
                        <div class="border rounded p-3">
                            <canvas id="CircleChart"></canvas>
                        </div>
                    </div>

                </div>

            </div>
        </section>


    <!-- Change Financial Year Modal -->
    <div class="modal fade"
         id="changeFinancialCycleId-modal"
         tabindex="-1"
         aria-labelledby="changeFinancialCycleIdLabel"
         aria-hidden="true"
         data-bs-backdrop="static">

        <div class="modal-dialog modal-dialog-top">
            <div class="modal-content">

                <div class="d-flex flex-row justify-content-between p-4" >
                    <h5 class="modal-title" id="changeFinancialCycleIdLabel">
                        اختيار العام المالي
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="إغلاق">
                    </button>
                </div>

                <div class="modal-body">

                    <label for="SelectFinanceCycleId" class="form-label">
                        العام المالي
                    </label>

                    <select id="SelectFinanceCycleId" class="form-select">
                        <option value="-1">-- اختر العام المالي --</option>

                        @{
                            foreach (var item in db.FinancialCycles.ToList())
                            {
                                <option value="@item.Id">@item.Year</option>
                            }
                        }
                    </select>

                </div>

                <div class="modal-footer d-flex justify-content-between">
                    <button type="button"
                            id="btnUpdateFinancialCycleId"
                            class="btn btn-success">
                        تعديل
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        إلغاء
                    </button>
                </div>

            </div>
        </div>
    </div>
  
}

@section scripts{
    <script>

        $(document).ready(function () {
            getLinePointChartData();
            getDoctTypeChartData();
        });

        function getLinePointChartData() {
            $.get("/Account/GetChartData", { type: "" }, function (response) {
                console.clear();
                console.log(response); // Log the response to check its structure

                const ctx = document.getElementById('lienerChart').getContext('2d');

                const config = {
                    type: 'line', // Line chart
                    data: {
                        labels: response.labels, // The labels from your server (e.g., months)
                        datasets: response.datasets // The datasets (transaction counts)
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            title: {
                                display: true,
                                text: 'العمليات المحاسبية التي نفذتها حسب الشهر' // Chart title
                            }
                        },
                        scales: {
                            x: {
                                display: true,
                                title: {
                                    display: true,
                                    text: 'الشهور' // X-axis label
                                }
                            },
                            y: {
                                display: true,
                                title: {
                                    display: true,
                                    text: 'العمليات' // Y-axis label
                                }
                            }
                        }
                    }
                };

                // Create and render the chart
                new Chart(ctx, config);
            });
        }

        // Function to generate random colors
        function getRandomColor() {
            const letters = '0123456789ABCDEF';
            let color = '#';
            for (let i = 0; i < 6; i++) {
                color += letters[Math.floor(Math.random() * 16)];
            }
            return color;
        }

        function getDoctTypeChartData() {
            $.get("/Account/GetDoctTypeChartData", { type: "" }, function (response) {
                console.clear();
                console.log(response); // Log the response to check its structure
                const backgroundColors = response.datasets[0].data.map(() => getRandomColor());

                const ctx = document.getElementById('CircleChart').getContext('2d');

                const config = {
                    type: 'pie', // Line chart
                    data: response,
                    options: {
                        responsive: true,
                        plugins: {
                            title: {
                                display: true,
                                text: 'العمليات المحاسبية التي نفذتها حسب نوع القيد' // Chart title
                            },
                            legend: {
                                position: 'top',
                            },
                        },
                        //scales: {
                        //    x: {
                        //        display: true,
                        //        title: {
                        //            display: true,
                        //            text: 'الشهور' // X-axis label
                        //        }
                        //    },
                        //    y: {
                        //        display: true,
                        //        title: {
                        //            display: true,
                        //            text: 'العمليات' // Y-axis label
                        //        }
                        //    }
                        //}
                    }
                };

                // Create and render the chart
                new Chart(ctx, config);
            });
        }

        $('#btnUpdateFinancialCycleId').on('click', function () {
            var Id = $('#SelectFinanceCycleId').val();
            var UserCurrentYear = $('#SelectFinanceCycleId option:selected').text();
            console.clear();
            console.log(UserCurrentYear);
            $.post("/Account/UpdateUserYear", { Id: Id }, function (response) {
                toastr[response.Status](response.Message, response.Title);
                $('#changeFinancialCycleId-modal').modal('hide');
                $('#UserCurrentYear').text(UserCurrentYear);
            });
        });
    </script>
}