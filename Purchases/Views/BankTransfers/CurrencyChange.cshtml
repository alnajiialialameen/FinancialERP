@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section content{

    <!-- Content Header -->
    <section class="d-flex flex-row justify-content-between align-items-center my-3">
        <h3>
            تبديل العملات
        </h3>

        <ol class="breadcrumb">
            <li>
                <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-house-fill"></i>
                    النظام المحاسبي >
                </a>
            </li>
            <li class="breadcrumb-item active">
                تبديل العملات
            </li>
        </ol>
    </section>

    <!-- Content -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">

                        <div class="card-header">
                            <button type="button"
                                    class="btn btn-primary float-start btn-add"
                                    data-bs-toggle="modal"
                                    data-bs-target="#add-modal">
                                <i class="bi bi-plus-square"></i>
                                تبديل العملات
                            </button>
                        </div>

                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="tbx"
                                       class="table table-bordered table-striped table-hover w-100">
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- Add Modal -->
    <div class="modal fade"
         id="add-modal"
         tabindex="-1"
         aria-labelledby="addModalTitle"
         aria-hidden="true"
         data-bs-backdrop="static">

        <div class="modal-dialog  modal-dialog-scrollable modal-xl ">
            <div class="modal-content">

                <div class="border-0 d-flex justify-content-between align-items-center m-3">
                    <h5 class="modal-title" id="addModalTitle">
                        تبديل العملات
                    </h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <form method="post" id="add-form">

                        <div class="row">

                            <div class="col-12 col-md-6">
                                <div class="form-group mb-3">
                                    <label for="fromAccTreeId" class="form-label">
                                        البنك المستلم
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-bank"></i>
                                        </span>

                                        <select class="form-select fromAccTreeId"
                                                name="fromAccTreeId"
                                                id="fromAccTreeId"
                                                style="width:100%">
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-group mb-3">
                                    <label for="toAccTreeId" class="form-label">
                                        البنك المرسل
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-bank"></i>
                                        </span>

                                        <select class="form-select toAccTreeId"
                                                name="toAccTreeId"
                                                id="toAccTreeId"
                                                style="width:100%">
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-3">
                                <div class="form-group mb-3">
                                    <div class="d-flex gap-2">
                                        <label for="amount" class="form-label">
                                            المبلغ
                                        </label>
                                        <strong id="AmountCurrencyDecimalText"
                                                class="AmountCurrencyDecimalText"></strong>
                                    </div>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-cash"></i>
                                        </span>

                                        <input type="text"
                                               class="form-control amount"
                                               name="amount"
                                               id="amount"
                                               autocomplete="off"
                                               placeholder="المبلغ" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-3">
                                <div class="form-group mb-3">
                                    <label for="transactionDate" class="form-label">
                                        تاريخ التحويل
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-calendar"></i>
                                        </span>

                                        <input type="date"
                                               class="form-control calendar transactionDate"
                                               id="transactionDate"
                                               name="transactionDate"
                                               placeholder="تاريخ التحويل"
                                               autocomplete="off">
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-3">
                                <div class="form-group mb-3">
                                    <label for="exchangeRate" class="form-label">
                                        سعر الصرف
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-arrow-left-right"></i>
                                        </span>

                                        <input class="form-control exchangeRate"
                                               name="exchangeRate"
                                               id="exchangeRate"
                                               autocomplete="off"
                                               placeholder="سعر الصرف" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-3">
                                <div class="form-group mb-3">
                                    <label for="note" class="form-label">
                                        البيان
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-card-text"></i>
                                        </span>

                                        <input class="form-control note"
                                               name="note"
                                               id="note"
                                               autocomplete="off"
                                               placeholder="البيان" />
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                رجوع
                            </button>

                            <button type="submit"
                                    class="btn btn-primary save">
                                حفظ
                            </button>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade"
         id="edit-modal"
         tabindex="-1"
         aria-labelledby="editModalTitle"
         aria-hidden="true"
         data-bs-backdrop="static">

        <div class="modal-dialog  modal-dialog-scrollable modal-xl ">
            <div class="modal-content">

                <div class="border-0 d-flex justify-content-between align-items-center m-3">
                    <h5 class="modal-title" id="editModalTitle">
                        تعديل تبديل العملات
                    </h5>

                    <h4 class="TransactionId d-none">TransactionId</h4>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <form method="post" id="edit-form">

                        <div class="row">

                            <div class="col-12 col-md-6">
                                <div class="form-group mb-3">
                                    <label for="ed-fromAccTreeId" class="form-label">
                                        البنك المستلم
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-bank"></i>
                                        </span>

                                        <select class="form-select ed-fromAccTreeId"
                                                name="edfromAccTreeId"
                                                id="ed-fromAccTreeId"
                                                style="width:100%">
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-group mb-3">
                                    <label for="ed-toAccTreeId" class="form-label">
                                        البنك المرسل
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-bank"></i>
                                        </span>

                                        <select class="form-select ed-toAccTreeId"
                                                name="edtoAccTreeId"
                                                id="ed-toAccTreeId"
                                                style="width:100%">
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-3">
                                <div class="form-group mb-3">
                                    <div class="d-flex gap-2">
                                        <label for="ed-amount" class="form-label">
                                            المبلغ
                                        </label>

                                        <strong id="edAmountCurrencyDecimalText"
                                                class="edAmountCurrencyDecimalText"></strong>
                                    </div>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-cash"></i>
                                        </span>

                                        <input type="text"
                                               class="form-control ed-amount"
                                               name="edamount"
                                               id="ed-amount"
                                               autocomplete="off"
                                               placeholder="المبلغ" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-3">
                                <div class="form-group mb-3">
                                    <label for="ed-transactionDate" class="form-label">
                                        تاريخ التحويل
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-calendar"></i>
                                        </span>

                                        <input type="text"
                                               class="form-control calendar ed-transactionDate"
                                               id="ed-transactionDate"
                                               name="edtransactionDate"
                                               placeholder="تاريخ التحويل"
                                               autocomplete="off">
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-3">
                                <div class="form-group mb-3">
                                    <label for="ed-exchangeRate" class="form-label">
                                        سعر الصرف
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-arrow-left-right"></i>
                                        </span>

                                        <input class="form-control ed-exchangeRate"
                                               name="exchangeRate"
                                               id="ed-exchangeRate"
                                               autocomplete="off"
                                               placeholder="سعر الصرف" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-3">
                                <div class="form-group mb-3">
                                    <label for="ed-note" class="form-label">
                                        البيان
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-card-text"></i>
                                        </span>

                                        <input class="form-control ed-note"
                                               name="ednote"
                                               id="ed-note"
                                               autocomplete="off"
                                               placeholder="البيان" />
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                رجوع
                            </button>

                            <button type="submit"
                                    class="btn btn-warning update">
                                تعديل
                            </button>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>


}

@section scripts{

    <script>
        var dataTable;
        var AmountObj;
        var EditAmountObj;

        $(function () {
            function loadData() {
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    ajax: {
                        url: '/BankTransfers/LoadDataCurrencyChange',
                        dataSrc: ''
                    },
                    order: [[5, 'desc']],
                    columns: [
                        //{
                        //    "title": "",
                        //    "data": "transactionId",
                        //    "orderable": false,
                        //    "render": function (data) {
                        //        return '<a class="btn btn-info btnDetails" data-toggle="modal" data-target="#details-modal"><i class="fa fa-info"></i></a>';
                        //    }
                        //},
                        {
                            "title": "# ",
                            "data": "Id",
                            "orderable": false,
                        },
                        {
                            "title": "من (البنك المرسل)",
                            "data": "FromAccTree"
                        },
                        {
                            "title": "الي (البنك المستلم)",
                            "data": "ToAccTree"
                        },
                        {
                            "title": " المبلغ ",
                            "data": "Amount",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": " البيان ",
                            "data": "Note"
                        },
                        {
                            "title": " سعر الصرف ",
                            "data": "ExchangeRate",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": " التاريخ ",
                            "data": "Date",
                            "orderable": true,
                        },
                        {
                            "title": "<i class='fa fa-cog'></i>",
                            "data": null,
                            "width": "10%",
                            "orderable": false,
                            "render": function (data) {
                                return '<div class="btn-group mx-1">'
                                    + '<a href="#" class="btnnEdit btn btn-success mx-1"> <i class="bi bi-pencil-square"></i></a>  <br />'
                                    + '<a href="#" class="btnPost btn btn-danger"><i class="bi bi-lock"></i></a>  <br />'
                                    + '</div>'
                                    ;
                            }
                        }
                    ]
                });

            }
            loadData();

            AmountObj = CustomAutoNumeric('#amount');
            EditAmountObj = CustomAutoNumeric('#ed-amount');

            ExchangeRateObj = CustomAutoNumeric('#exchangeRate');
            EditExchangeRateObj = CustomAutoNumeric('#ed-exchangeRate');

            select2list(".fromAccTreeId", "/Shared/getAllBanks", "  اسم الحساب ", "#add-modal");
            select2list(".toAccTreeId", "/Shared/getAllBanks", "  اسم الحساب ", "#add-modal");
            select2list(".currency", "/Shared/getCurrency", "  العملة  ", "#add-modal");

            select2list(".ed-fromAccTreeId", "/Shared/getAllBanks", "  اسم الحساب ", "#edit-modal");
            select2list(".ed-toAccTreeId", "/Shared/getAllBanks", "  اسم الحساب ", "#edit-modal");
        });


        function save() {

            //var transactionDate = moment($('#transactionDate').val(), "DD/MM/YYYY").format("DD-MM-YYYY");
            var ob = {
                "FromAccTreeId": $('#fromAccTreeId').val(),
                "ToAccTreeId": $('#toAccTreeId').val(),
                "Amount": AmountObj.getNumber(),
                "ExchangeRate": ExchangeRateObj.getNumber(),
                "TransactionDate": $('#transactionDate').val(),
                "Note": $('#note').val()
            }
            console.clear();
            console.log(ob);

            $.ajax({
                url: "/BankTransfers/CreateCurrencyChange",
                type: "POST",
                data: JSON.stringify(ob),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                    $('#add-modal').modal('hide');
                    dataTable.ajax.reload();
                }
            });
        };

        function update() {

            var ob = {
                "Id": $('.TransactionId').text(),
                "FromAccTreeId": $('#ed-fromAccTreeId').val(),
                "ToAccTreeId": $('#ed-toAccTreeId').val(),
                "Amount": EditAmountObj.getNumber(),
                "ExchangeRate": EditExchangeRateObj.getNumber(),
                "TransactionDate": $('#ed-transactionDate').val(),
                "Note": $('#ed-note').val()
            }

            console.clear();
            console.log(ob);

            $.ajax({
                url: "/BankTransfers/UpdateCurrencyChange",
                type: "POST",
                data: JSON.stringify(ob),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                    $('#edit-modal').modal('hide');
                    dataTable.ajax.reload();
                }
            });
        };

        $('#add-form').on('submit', function (e) {
            e.preventDefault();
            save();
            this.reset();
        });

        $('#edit-form').on('submit', function (e) {
            e.preventDefault();
            update();
            this.reset();
        });


        //posting الترحيل
        $('#tbx').on('click', '.btnPost', function () {
            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var TransactionId = data['Id'];

            $.post('/Transactions/Posting', { "Id": TransactionId }, function (response) {
                toastr[response.Status](response.Message, response.Title);
                $('#tbx').DataTable().ajax.reload();
            });
        });

        //Editing التعديل
        $('#tbx').on('click', '.btnnEdit', function () {

            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var Id = data['Id'];
            var FromAccTree = data['FromAccTree'];
            var ToAccTree = data['ToAccTree'];
            var Amount = data['Amount'];
            var Date = data['Date'];
            var Note = data['Note'];
            var ExchangeRate = data['ExchangeRate'];

            $('.TransactionId').text(Id);
            $('#ed-fromAccTree').val(FromAccTree);
            $('#ed-toAccTree').val(ToAccTree);

            EditAmountObj.set(Amount);

            const formattedDate = moment(Date, 'YYYY/M/D').format('MM/DD/YYYY');
            $('#ed-transactionDate').val(formattedDate);

            $('#ed-note').val(Note);
            $('#ed-exchangeRate').val(ExchangeRate);

            $('#edit-modal').modal('show');
        });

        //هنا مفترض نطبع سند التحويل
        function printSanad(Id) {
            window.open('/BankTransfers/PrintData/' + Id, '_blank');
        }
    </script>
}