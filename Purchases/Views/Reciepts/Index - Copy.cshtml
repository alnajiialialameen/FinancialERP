                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة مستند قبض جديد</h4>
                    </div>
                    <div class="modal-body">
                        <form id="add-form">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="col-lg-3">
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <label for="ed-name">رقم السند</label>
                                                    <div class="input-group">
                                                        <input type="text" class="form-control  receiptNumber disabled" id="receiptNumber" name="receiptNumber" placeholder="رقم السند" autocomplete="off">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <label for="ed-name"> رقم المرجع</label>
                                                    <div class="input-group">
                                                        <input type="text" class="form-control refNumber" id="refNumber" name="refNumber" placeholder="رقم المرحع" autocomplete="off">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <label for="ed-name"> اسم المرجع</label>
                                                    <div class="input-group">
                                                        <input type="text" class="form-control refName" id="refName" name="refName" placeholder="اسم المرجع " autocomplete="off">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-6">
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <input type="radio" name="isCash" value="1" />
