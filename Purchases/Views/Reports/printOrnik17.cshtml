@using Purchases.Models.ViewModel;
@model IEnumerable<TransactionVM>
@{
    ViewBag.Title = "PrintInvoice";
    Layout = "~/Views/Shared/_LayoutPrint.cshtml";
}
<style>
    body {
        direction: rtl;
        font-size: 22px;
        font-weight: 300;
        margin: 0px 20px;
        padding: 0px 20px
    }

    .header {
        width: 100%;
        height: 180px;
    }

    .header .left-side {
        width: 40%;
        height: 160px;
        float: left;
        text-align: center;
        border: 2px solid #333;
        background-color: transparent;
        border-radius: 4px;
        display: flex;
        justify-content: space-between;
        flex-direction: column;
    }

    .header .right-side {
        width: 55%;
        height: 160px;
        line-height: 29px;
        float: right;
        text-align: right;
        background-color: transparent;
        border-radius: 4px;
        display: block;
    }

    .flex {
        display: flex;
        justify-content: space-between;
        margin: 10px 30px;
    }

    thead, tbody {
        border: solid 2px #333;
    }

    @@media print {
        body {
            font-size: 18px;
        }

        .table-container {
            page-break-after: auto;
        }
    }
</style>

<div class="header">
    <div class="left-side">
        <div>
            <label>@Session["AirportName"].ToString()</label>
        </div>

        <div>
            <strong>تاريخ العملية:</strong>
            <label>@ViewBag.TransactionDate</label>
        </div>
    </div>

    <div class="right-side">
        <div class="row">
            <strong>الوحدة:</strong>
            <label for="">الادارة المالية</label>
        </div>
        <div class="row">
            <strong>رقم العملية:</strong>
            <label for="">@ViewBag.transactionId</label>
        </div>
        <div class="row">
            <strong>المدفوع له:</strong>
            <label for="">@ViewBag.recipient</label>
        </div>
        <div class="row">
            <strong>السنة المالية:</strong>
            <label for="">@ViewBag.CurrentYear</label>
        </div>
        <div class="row">
            <strong>بالخصم علي البند:</strong>
            <label for="BalanceName">@ViewBag.BalanceName</label>
        </div>
    </div>

    @{
        if (ViewBag.BalanceName == "حساب مذكورين")
        {
            <div class="row pull-right">
                <strong>البيان:</strong>
                <label for="note">@ViewBag.Note</label>
            </div>
        }
    }
</div>

<div class="container">
    <div class="row">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <td class="text-center">عدد </td>
                    <td class="text-center" colspan="5">الـــــبــــــيـــــان</td>
                    <td class="text-center">المبلغ</td>
                    <td class="text-center">ضريبة 1%</td>
                    <td class="text-center">الصافي</td>
                    <td class="text-center">ملاحظات</td>
                </tr>
            </thead>
            <tbody>
                @{
                    int counter = 1;
                    string BalanceName = ViewBag.BalanceName;
                    foreach (var item in Model)
                    {
                        if (counter == 1 && BalanceName != "حساب مذكورين")
                        {
                            <tr>
                                <td></td>
                                <td class="text-right" colspan="5">@item.note</td>
                                <td class="amount">@item.amount</td>
                                <td class="amount">@item.tax</td>
                                <td class="amount">@item.total</td>
                                <td></td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td></td>
                                <td class="text-right" colspan="5">@item.accName</td>
                                <td class="amount">@item.amount</td>
                                <td class="amount">@item.tax</td>
                                <td class="amount">@item.total</td>
                                <td></td>
                            </tr>
                        }
                        counter++;
                    }
                }
            <tr>
                <td colspan="6">جملة المبلغ :@ViewBag.AmountText</td>
                <td colspan="6"><strong> جملة المبلغ :</strong> <strong class="amount">@ViewBag.totalAmount</strong></td>
            </tr>
                <tr>
                    <td colspan="6">تمت المراجعة بواسطة<br/>------------------------------------</td>
                    <td colspan="6"></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="container">
    <div class="row">
        <p>
            أشهد بان المبلغ مستحق الدفع وأنه صحيح فيما يتعلق بالتضريب والجمع وفئات الدفع والقيام بالخدمات المطلوبة علي الوجه الاكمل وعليه فاني اطلب دفع المذكور أعلاه
        </p>
        <label for="">توقيع ثاني:....................</label>
        <p>الموظف المسؤول عن مراجعة الحساب</p>
    </div>

    <div class="row center">
        <p>تصدق بالدفع</p>
    </div>
    <div class="flex">
        <p> توقيع أول :................... </p>
        <p>دفع بشيك نمرة :<strong>@ViewBag.CheckNo</strong></p>
    </div>
</div>