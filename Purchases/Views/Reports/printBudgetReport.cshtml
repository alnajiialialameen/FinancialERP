}



@section scripts{

    <script>
    var myId = 0;
    var dataTable;

    $(document).ready(function () {
        function select2list(selector, url, placeholder) {
            $(selector).select2({
                language: { inputTooShort: function () { return 'ادخل حرف واحد علي الاقل'; } },
                ajax: {
                    url: url,
                    dataType: 'json',
                    delay: 100,
                    data: function (params) {
                        return {
                            q: params.term,
                            page: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data,
                            pagination: {
                                more: ((data.total_count) > (params.page * 20))
                            }
                        };
                    },
                    cache: true
                },
                placeholder: placeholder,
                minimumInputLength: 1,
            });

        };
        select2list("#addAccName", "/Transactions/getAccTrees", "اسم الحساب");
    });

    function Search() {
        //do somthing here
    }



    function PrintData() {
        //var Id = $('.addAccName').val();
        //var DateFrom = $('.DateFrom').val();
        //var DateTo = $('.DateTo').val();

        var DateFrom = $('#DateFrom').val();
        var DateTo = $('#DateTo').val();

        if (DateFrom === "" || DateTo === "") {
            Swal.fire({
                icon: "error",
                title: "خطاء ",
                text: "الرجاء اختيار التاريخين بشكل صحيح",

            });
            return;
        }

        DateFrom = moment(DateFrom, "DD/MM/YYYY").format("MM/DD/yyyy");
        DateTo = moment(DateTo, "DD/MM/YYYY").format("MM/DD/yyyy");


        var url = "/Reports/printTaxReport?dateFrom=" + DateFrom + "&dateTo=" + DateTo;
        window.open(url, '_blank').focus();
    }

    </script>
}