@{
    ViewBag.Title = "TaxReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section content
{
    <div class="content-wrapper">
        <!-- Content Header -->

        <section class="d-flex flex-row justify-content-between align-items-center my-3">
            <h3>
                تقارير الحسابات الختامية
            </h3>

            <ol class="breadcrumb">
                <li>
                    <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                        <i class="bi bi-house-fill"></i>
                        النظام المحاسبي >
                    </a>
                </li>
                <li class="breadcrumb-item active">
                    تقارير الحسابات الختامية
                </li>
            </ol>
        </section>


        <!-- Main Content -->
        <section class="content">
            <div class="container-fluid">

                <hr />

                <label class="d-none" id="financeCycleId">
                    @ViewBag.financeCycleId
                </label>

                <!-- Trial Balance -->
                <fieldset class="border rounded p-3 mb-4">

                    <legend class="float-none w-auto px-3 fs-5">
                        ميزان المراجعة
                    </legend>

                    <div class="row g-3">

                        <div class="col-md-4">
                            <button type="button"
                                    id="btnPrintTrailBalance"
                                    onclick="printTrailBalance()"
                                    class="btn btn-primary w-100">
                                ميزان المراجعة بالأرصدة
                            </button>
                        </div>

                        <div class="col-md-4">
                            <button type="button"
                                    id="btnPrintTrailBalanceSummation"
                                    onclick="printTrailBalanceSummation()"
                                    class="btn btn-success w-100">
                                ميزان المراجعة بالمجاميع
                            </button>
                        </div>

                        <div class="col-md-4">
                            <button type="button"
                                    id="btnPrintTrailBalanceExplanation"
                                    onclick="printTrailBalanceExplanation()"
                                    class="btn btn-info w-100">
                                ميزان المراجعة الإيضاح
                            </button>
                        </div>

                    </div>
                </fieldset>

                <!-- Financial Statements -->
                <fieldset class="border rounded p-3 mb-4">

                    <legend class="float-none w-auto px-3 fs-5">
                        القوائم المالية
                    </legend>

                    <div class="row g-3">

                        <div class="col-md-4">
                            <button type="button"
                                    id="btnPrintTrailBalanceIncomeStatement"
                                    onclick="printTrailBalanceIncomeStatement()"
                                    class="btn btn-danger w-100">
                                قائمة الدخل
                            </button>
                        </div>

                    </div>
                </fieldset>

            </div>
        </section>
    </div>
}

@section scripts{

    <script>
        var myId = 0;

        $(document).ready(function () {
            select2list("#addAccName", "/Shared/getAllBanks", "اسم البنك");
        });

        // ميزان المراجعة بالارصدة
        function printTrailBalance() {
            var financeCycleId = $('#financeCycleId').text();

            if (financeCycleId === "") {
                Swal.fire({
                    icon: "error",
                    title: "خطاء",
                    text: "الرجاء اختيار اسم الحساب",
                });
                return;
            }

            var url = "/Reports/printTrailBalance?financeCycleId=" + financeCycleId;

            window.open(url, '_blank').focus();
        }

        // ميزان المراجعة بالمجاميع
        function printTrailBalanceSummation() {
            var financeCycleId = $('#financeCycleId').text();

            if (financeCycleId === "") {
                Swal.fire({
                    icon: "error",
                    title: "خطاء",
                    text: "الرجاء اختيار اسم الحساب",
                });
                return;
            }

            var url = "/Reports/printTrailBalanceSummation?financeCycleId=" + financeCycleId;

            window.open(url, '_blank').focus();
        }

        // ايضاح ميزان المراجعة
        function printTrailBalanceExplanation() {
            var financeCycleId = $('#financeCycleId').text();

            if (financeCycleId === "") {
                Swal.fire({
                    icon: "error",
                    title: "خطاء",
                    text: "الرجاء اختيار اسم الحساب",
                });
                return;
            }

            var url = "/Reports/printTrailBalanceExplanation?financeCycleId=" + financeCycleId;

            window.open(url, '_blank').focus();
        }

        // قائمة الدخل
        function printTrailBalanceIncomeStatement() {
            var financeCycleId = $('#financeCycleId').text();

            if (financeCycleId === "") {
                Swal.fire({
                    icon: "error",
                    title: "خطاء",
                    text: "الرجاء اختيار اسم الحساب",
                });
                return;
            }

            var url = "/Reports/printTrailBalanceIncomeStatement?financeCycleId=" + financeCycleId;

            window.open(url, '_blank').focus();
        }

    </script>
}