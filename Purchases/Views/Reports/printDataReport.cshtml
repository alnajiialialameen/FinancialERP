@{
    ViewBag.Title = "TaxReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>TaxReport</h2>

@section content
{
    <!-- Content Header -->

    <section class="d-flex flex-row justify-content-between align-items-center my-3">
        <h3>
            تقرير قيود اليومية
        </h3>

        <ol class="breadcrumb">
            <li>
                <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-house-fill"></i>
                    النظام المحاسبي >
                </a>
            </li>
            <li class="breadcrumb-item active">
                تقرير قيود اليومية
            </li>
        </ol>
    </section>



    <!-- Main Content -->
    <section class="content">
        <div class="container-fluid">

            <div class="row">
                <!-- Date From -->
                <div class="col-lg-4 col-md-6">
                    <div class="mb-3">
                        <label for="DateFrom" class="form-label">
                            من تاريخ
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-calendar-alt"></i>
                            </span>
                            <input type="date"
                                   class="form-control calendar DateFrom"
                                   id="DateFrom"
                                   name="DateFrom"
                                   placeholder="تاريخ القيد"
                                   autocomplete="off">
                        </div>
                    </div>
                </div>

                <!-- Date To -->
                <div class="col-lg-4 col-md-6">
                    <div class="mb-3">
                        <label for="DateTo" class="form-label">
                            إلى تاريخ
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-calendar-alt"></i>
                            </span>
                            <input type="date"
                                   class="form-control calendar DateTo"
                                   id="DateTo"
                                   name="DateTo"
                                   placeholder="حتى تاريخ"
                                   autocomplete="off">
                        </div>
                    </div>
                </div>

                <!-- Account Name -->
                <div class="col-lg-4 col-md-6">
                    <div class="mb-3">
                        <label for="bankId" class="form-label">
                            اسم الحساب
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-book"></i>
                            </span>
                            <select class="form-select list addAccName"
                                    name="bankId"
                                    id="bankId"
                                    style="width:100%">
                            </select>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Actions -->
            <div class="row g-2 mb-3">
                <div class="col-lg-3 col-md-6">
                    <button type="button"
                            id="btnsearch"
                            onclick="Search()"
                            class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-search"></i>
                        بحث
                    </button>
                </div>

                <div class="col-lg-3 col-md-6">
                    <button type="button"
                            id="btnall"
                            onclick="PrintData()"
                            class="btn btn-info btn-sm w-100">
                        <i class="bi bi-printer"></i>
                        طباعة التقرير
                    </button>
                </div>
            </div>

            <!-- Data Table -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="table-responsive">
                        <table id="tbx"
                               class="dataTable table table-striped table-hover w-100">
                            <tbody id="tbod"></tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </section>

}



@section scripts{

    <script>
        var myId = 0;
        var dataTable;

        $(document).ready(function () {
             const today = new Date();
             const selectedYear = @ViewBag.Year;

             const dateValue = `${selectedYear}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

             $('#DateFrom').val(dateValue);
             $('#DateTo').val(dateValue);

            select2list("#bankId", "/Shared/getAccTreesAll", "اسم الحساب");
        });

        function PrintData() {
            debugger;
            var DateFrom = $('#DateFrom').val();
            var DateTo = $('#DateTo').val();
            var bankId = $('.bankId').val();

            //if (DateFrom === "" || DateTo === "") {
            //    Swal.fire({
            //        icon: "error",
            //        title: "خطاء ",
            //        text: "الرجاء اختيار التاريخين بشكل صحيح",
            //    });
            //    return;
            //}

            var url = "/Reports/printDataInDateRange?bankId=" + bankId + "&dateFrom=" + DateFrom + "&dateTo=" + DateTo;
            window.open(url, '_blank');
        }

        function Search() {
            var DateFrom = $('#DateFrom').val();
            var DateTo = $('#DateTo').val();
            var bankId = $('.bankId').val();

            dataTable = $('#tbl').DataTable({
                destroy: true,
                "language": {
                    "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                    "search": "بحث"
                },
                ajax: {
                    url: "/Reports/GetDataInDateRangeForSearch?bankId=" + bankId + "&dateFrom=" + DateFrom + "&dateTo=" + DateTo,
                    dataSrc: ''
                },
                columns: [
                    {
                        "title": "# ",
                        "data": "transactionId"
                    },
                    {
                        "title": "البيان",
                        "data": "note"
                    },
                    {
                        "title": "المبلغ",
                        "data": "amount",
                        "render": function (data) {
                            return formatNumber(data.toString());
                        }
                    },
                    {
                        "title": "تاريخ العملية",
                        "data": "transactionDateStr"
                    },
                ]
            });
        }

    </script>
}