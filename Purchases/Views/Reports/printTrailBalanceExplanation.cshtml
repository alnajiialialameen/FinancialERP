@using Purchases.Models.ViewModel;
@using System.Collections.Generic;
@model  IEnumerable<BalanceVM>
@{
    ViewBag.Title = "PrintInvoice";
    Layout = "~/Views/Shared/_LayoutPrint.cshtml";
}

<style>
    .p-r {
        padding-right: 40px !important;
    }
</style>

<section class="invoiceCupps">
    <div class="invoice-Cupps-header">
        <div class="text-left text-word">
            <p>Sudan Airports Company Ltd.</p>
            <p>Administration of Financial & Accounting</p>
            <p>Accounts Department</p>
            <p>Tel: 0123-456-789</p>
            <p>Fax : 0977-839-998</p>
        </div>

        <div class="text-center">
            <img src="~/Temp/Image/WhiteLogo.png" height="150" />
        </div>

        <div class="text-right text-word">
            <p>شركة مطارات السودان المحدودة</p>
            <p>الادارة العامة للشؤون المالية والمحاسبية</p>
            <p>إدارة الحسابات</p>
            <p>تـلـ: 0123-456-789</p>
            <p>فاكس : 0977-839-998</p>
        </div>
    </div>

    <div class="invoice-Body">
        <div class="wrapper">
            <div class="row">
                <div class="col-md-12 justify-content-center text-center">
                    <h2><u>@ViewBag.CurrentFinancialCycle  ايضاح مـيـزان الـمـراجــعــة للعام </u></h2>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center">
        <div style="display:flex; justify-content:space-between; padding: 5px;">
            <span>@DateTime.Now</span>تاريخ الطباعة
        </div>

      
        <table class="table table-bordered table-striped">
            <thead class="bg-dark">
                <tr class="text-center bg-dark" style="font-weight: bolder; font-size: x-large;">
                    <td>لــــه</td>
                    <td>مــنــه</td>
                    <td colspan="3">الــبـنـد</td>
                    <td>#</td>
                </tr>
            </thead>
            <tbody>
                @{
                    int counter = 1;
                    @functions {
                                // دالة لتجميع جميع العناصر من المستوى الأخير
                                IEnumerable<BalanceVM> GetLeafNodes(IEnumerable<BalanceVM> nodes)
                                {
                                    foreach (var node in nodes)
                                    {
                                        if (node.details == null || !node.details.Any())
                                        {
                                            yield return node;
                                        }
                                        else
                                        {
                                            foreach (var child in GetLeafNodes(node.details))
                                            {
                                                yield return child;
                                            }
                                        }
                                    }
                                }
                            }

                    var leafNodes = GetLeafNodes(Model);

                    foreach (var item1 in leafNodes.Where(q=> q.sumOfCredit > 0 || q.sumOfDebit > 0))
                    {
                        <tr class="text-center">
                            <td class="amount">@Math.Abs((decimal)item1.sumOfCredit)</td>
                            <td class="amount">@Math.Abs((decimal)item1.sumOfDebit)</td>
                            <td colspan="3">@item1.accTreeName</td>
                            <td class="text-center">@counter</td>
                        </tr>

                        counter++;
                    }

                    <tr>
                        <td class="amount" style="font-weight: bolder;">
                            @Math.Abs(leafNodes.Sum(s => Math.Abs((decimal?)s.sumOfCredit ?? 0)))
                        </td>
                        <td class="amount" style="font-weight: bolder;">
                            @Math.Abs(leafNodes.Sum(s => Math.Abs((decimal?)s.sumOfDebit ?? 0)))
                        </td>
                        <td colspan="4" style="font-weight: bolder;">الاجمالي</td>
                    </tr>
                }
            </tbody>
        </table>



    </div>

    <div class="number-Word invoice-footer">
        <div class="number-Word">@ViewBag.txtSumOfBous</div>
        <div class="chief ">
            <div class="Manager">
                <span>التوقيع</span><br /><br />
                <span>-------------------------------</span>
            </div>
        </div>
    </div>

</section>
