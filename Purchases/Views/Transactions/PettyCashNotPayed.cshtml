@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section content{

    <section class="d-flex flex-row justify-content-between align-items-center my-3">
        <h3>
            النثريات بالعمليات
        </h3>

        <ol class="breadcrumb">
            <li>
                <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-house-fill"></i>
                    النظام المحاسبي >
                </a>
            </li>
            <li class="breadcrumb-item active">
                النثريات بالعمليات
            </li>
        </ol>
    </section>
    
    <section class="content py-3">
        <div class="container-fluid">

            <div class="card shadow-sm">
                <div class="card-body">

                    <div class="row mb-3">
                        <div class="col-12">
                            <a class="btn btn-primary mb-2"
                               href="@Url.Action("PettyCashNotPayedByPerson", "Transactions")">
                                النثريات بالأشخاص
                            </a>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table id="tbx"
                               class="table table-bordered table-sm table-hover align-middle w-100">
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </section>
  
}

