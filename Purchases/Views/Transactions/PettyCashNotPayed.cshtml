            function loadData() {
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    "columnDefs": [
                        {
                            "targets": 0,
                            "className": "text-center",
                        },
                    ],
                    ajax: {
                        url: '/Shared/loadPettyCashNotPayedData',
                        dataSrc: ''
                    },
                    columns: [
                        {
                            "title": "",
                            "data": "transactionId",
                            "orderable": false,
                            "render": function (data) {
                                return '<a class="btn btn-info btnDetails" ><i class="bi bi-info fs-3"></i></a>';
                            }
                        },
                        {
                            "title": "# ",
                            "data": "transactionId"
                        },
                        {
                            "title": "البيان",
                            "data": "note"
                        },
                        {
                            "title": "نوع القيد",
                            "data": "documentType"
                        },
                        {
                            "title": "اجمالي المبلغ",
                            "data": "total",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": "العملة",
                            "data": "currency"
                        },
                        {
                            "title": "سعر الصرف",
                            "data": "exchangeRate",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": "تاريخ القيد",
                            "data": "transactionDateStr"
                        },
                        {
                            "title": "<i class='bi bi-gear-fill'></i>",
                            "data": null,
                            "width": "10%",
                            "orderable": false,
                            "render": function (data) {
                                return `<a class="btn btn-success btnRemovePettuCash" href="RemovePettyCash/${data.transactionId}">إزالة النثرية</a>`;
                            }

                        },
                    ]
                });
            }

            loadData();
        });

