@using Purchases.Models.ViewModel;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section content{

    <section class="d-flex flex-row justify-content-between align-items-center my-3">
        <h3>
            إزالة النثريات
        </h3>

        <ol class="breadcrumb">
            <li>
                <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-house-fill"></i>
                    النظام المحاسبي >
                </a>
            </li>
            <li class="breadcrumb-item active">
                إزالة النثريات
            </li>
        </ol>
    </section>


    <section class="content py-3">
        <div class="container-fluid">

            <div class="card shadow-sm">
                <div class="card-body">

                    <!-- Header -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <label id="TransactionId" class="d-none">@ViewBag.TransactionId</label>

                            <a class="btn btn-primary"
                               href="@Url.Action("PettyCashNotPayed", "Transactions")">
                                <i class="bi bi-arrow-right-circle me-1"></i>
                                النثريات بالعمليات
                            </a>
                        </div>
                    </div>

                    <div class="row g-4">

                        <!-- Petty Cash Details -->
                        <div class="col-12 col-md-4">

                            <div class="card border-0 bg-body-tertiary">
                                <div class="card-body">

                                    <h4 class="mb-4">تفاصيل النثرية</h4>

                                    <div class="mb-3">
                                        <label class="form-label" for="displayTransactionDate">التاريخ</label>
                                        <input class="form-control"
                                               id="displayTransactionDate"
                                               disabled
                                               value="@ViewBag.TransactionDate" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" for="displayRecipient">اسم المستلم</label>
                                        <input class="form-control"
                                               id="displayRecipient"
                                               disabled
                                               value="@ViewBag.Recipient" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" for="displayTotalAmount">إجمالي المبلغ</label>
                                        <input class="form-control"
                                               id="displayTotalAmount"
                                               disabled
                                               value="@ViewBag.TotalAmount" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" for="displayCurrencyType">العملة</label>
                                        <input class="form-control"
                                               id="displayCurrencyType"
                                               disabled
                                               value="@ViewBag.CurrencyType" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" for="displayExchangeRate">سعر الصرف</label>
                                        <input class="form-control"
                                               id="displayExchangeRate"
                                               disabled
                                               value="@ViewBag.ExchangeRate" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" for="displayNote">البيان</label>
                                        <textarea class="form-control"
                                                  id="displayNote"
                                                  disabled
                                                  rows="4">@ViewBag.Note</textarea>
                                    </div>

                                    <hr class="my-4" />

                                    <!-- Transaction Details -->
                                    <h4 class="mb-3">تفاصيل القيد</h4>

                                    <div class="table-responsive">
                                        <table class="table table-bordered table-striped table-sm detials align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>#</th>
                                                    <th>الحساب</th>
                                                    <th>مدين</th>
                                                    <th>دائن</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in ViewBag.TransactionDetails as List<TransactionVM>)
                                                {
                                                    <tr>
                                                        <td>@item.accTrreId</td>
                                                        <td>@item.accName</td>
                                                        <td>@item.debit</td>
                                                        <td>@item.credit</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <label id="DebitAccName" class="hide1 d-none">@ViewBag.DebitAccName</label>
                                    <label id="DebitAccId" class="hide1 d-none">@ViewBag.DebitAccId</label>

                                </div>
                            </div>
                        </div>

                        <!-- Add Petty Cash -->
                        <div class="col-12 col-md-8">

                            <div class="card border-0">
                                <div class="card-body">

                                    <h4 class="mb-4">إزالة النثرية</h4>

                                    <div class="row g-3">

                                        <!-- Account Name -->
                                        <div class="col-12 col-lg-6">
                                            <div class="mb-3">
                                                <label for="addAccName" class="form-label">اسم الحساب</label>

                                                <div class="input-group">
                                                    <span class="input-group-text">
                                                        <i class="bi bi-book"></i>
                                                    </span>

                                                    <select class="form-select list addAccName"
                                                            name="addAccName"
                                                            id="addAccName"
                                                            style="width:100%">
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Amount -->
                                        <div class="col-12 col-lg-6">
                                            <div class="mb-3">

                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <label for="amount" class="form-label mb-0">المبلغ</label>
                                                    <strong id="AmountCurrencyDecimalText"
                                                            class="AmountCurrencyDecimalText"></strong>
                                                </div>

                                                <div class="input-group">
                                                    <span class="input-group-text">
                                                        <i class="bi bi-cash"></i>
                                                    </span>

                                                    <input class="form-control amount"
                                                           type="text"
                                                           name="amount"
                                                           id="amount"
                                                           placeholder="المبلغ"
                                                           autocomplete="off" />
                                                </div>

                                            </div>
                                        </div>

                                    </div>

                                    <hr class="my-3" />

                                    <!-- Add To Table -->
                                    <div class="row g-3">

                                        <div class="col-12">
                                            <button type="button"
                                                    class="btn btn-info w-100"
                                                    onclick="addToTable()">
                                                <i class="bi bi-plus-circle me-1"></i>
                                                ترحيل
                                            </button>
                                        </div>

                                        <!-- Transactions Table -->
                                        <div class="col-12">
                                            <div class="table-responsive">

                                                <table id="example1"
                                                       class="table table-bordered table-striped table-hover virtualTable align-middle">

                                                    <thead class="table-light">
                                                        <tr>
                                                            <th class="text-center text-nowrap" style="width:150px;">#</th>
                                                            <th class="text-center text-nowrap" style="width:750px;">اسم الحساب</th>
                                                            <th class="text-center text-nowrap" style="width:750px;">مدين</th>
                                                            <th class="text-center text-nowrap" style="width:750px;">دائن</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody class="myTbody"></tbody>

                                                    <tfoot class="myTFoot table-dark text-center"></tfoot>

                                                </table>

                                            </div>
                                        </div>

                                        <!-- Save -->
                                        <div class="col-12">
                                            <button type="button"
                                                    class="btn btn-success w-100"
                                                    id="btnSave">
                                                <i class="bi bi-save me-1"></i>
                                                حفظ
                                            </button>
                                        </div>

                                    </div>

                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>

        </div>
    </section>


    <div class="example-modal">

        <div class="modal fade"
             id="add-statement-modal"
             tabindex="-1"
             aria-labelledby="add-statement-modal-label"
             aria-hidden="true"
             data-bs-backdrop="static">

            <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" style="max-width:80%;">
                <div class="modal-content">

                    <!-- Modal Header -->
                    <div class="border-0 d-flex justify-content-between align-items-center">
                        <h5 class="modal-title" id="add-statement-modal-label">
                            إضافة عملية جديدة
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body">

                        <form id="add-statement-form">

                            <div class="row g-3">

                                <!-- Currency -->
                                <div class="col-12 col-lg-6">
                                    <div class="mb-3">
                                        <label for="addCurrencyType" class="form-label">العملة</label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-cash"></i>
                                            </span>

                                            <select class="form-select list addCurrencyType"
                                                    name="addCurrencyType"
                                                    id="addCurrencyType"
                                                    style="width:100%">
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <!-- Recipient -->
                                <div class="col-12 col-lg-6">
                                    <div class="mb-3">
                                        <label for="recipient" class="form-label">اسم المستلم</label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-person"></i>
                                            </span>

                                            <select class="form-select list recipient"
                                                    name="recipient"
                                                    id="recipient"
                                                    style="width:100%">
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <!-- Statement -->
                                <div class="col-12">
                                    <div class="mb-3">
                                        <label for="statement" class="form-label">البيان</label>

                                        <div class="input-group">
                                            <span class="input-group-text align-items-start pt-2">
                                                <i class="bi bi-book"></i>
                                            </span>

                                            <textarea class="form-control statement"
                                                      id="statement"
                                                      name="statement"
                                                      rows="3"
                                                      required></textarea>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <!-- Save -->
                            <div class="d-grid mt-3">
                                <button type="submit"
                                        class="btn btn-success btnCreate"
                                        onclick="saveData()">
                                    <i class="bi bi-save me-1"></i>
                                    حفظ
                                </button>
                            </div>

                        </form>

                        <hr class="my-4" />

                        <!-- Statement Details -->
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover align-middle">

                                <thead class="table-secondary">
                                    <tr class="text-center">
                                        <th>مدين</th>
                                        <th>دائن</th>
                                        <th>الحساب</th>
                                    </tr>
                                </thead>

                                <tbody class="presntTBody"></tbody>

                            </table>
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>
    

}


@section scripts{
    <script>
        var myId = 0;
        var dataTable;
        var creditAmountObj;
        var rptList = [];

        $(document).ready(function () {

            creditAmountObj = CustomAutoNumeric('#amount');

            select2list("#addAccName", "/Shared/GetAccTreesInBalanceAndBanks", "اسم الحساب");
            select2list("#addCurrencyType", "/Shared/getCurrency", "العملة", "#add-statement-modal");

            select2listNew(".recipient", "/Shared/getAllRecipient", "  اسم المستلم ", "#add-statement-modal");

        });


        $('#btnSave').click(function () {
            debugger;
            var totalDebitAmount = 0;
            var totalCreditAmount = 0;

            $.each(rptList, function (index, value) {
                totalDebitAmount = totalDebitAmount + parseFloat(parseFloat(value.debit).toFixed(2));
                totalCreditAmount = totalCreditAmount + parseFloat(parseFloat(value.credit).toFixed(2));

            });

            totalDebitAmount = parseFloat(parseFloat(totalDebitAmount).toFixed(2));
            totalCreditAmount = parseFloat(parseFloat(totalCreditAmount).toFixed(2));

            if (totalDebitAmount == 0 || totalCreditAmount == 0) {
                toastr["error"]("يجب ادخال القيم اولا", "خطأ");
            }
            else if (totalDebitAmount == totalCreditAmount) {
                $('.presntTBody').empty();
                rptList.forEach(function (row) {
                    var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                        + "<td class='id'>" + row['debit'] + "</td>"
                        + "<td class='name'>" + row['credit'] + "</td>"
                        + "<td class='Amount'>" + row['addAccName'] + "</td>"
                        + '</tr>';

                    $('.presntTBody').append(rows);
                    $('#add-statement-modal').modal('show');
                });
            } else {
                toastr["error"]("الرجاء مساواة الطرفين ", "خطأ");
            }
        });

        function addToTable() {
            //هنا لازم ندخل اسم الحساب
            var addAccName = $('#select2-addAccName-container').text();
            var addAccNameId = $('.addAccName').val();
            var addBalanceAccName = $('#select2-addBalanceId-container').text();

            var totalAmount = $('.displayTotalAmount').val();
            var creditAmount = creditAmountObj.getNumber();

            var IsCreditText = '';

            var isFound = false;

            var isFound = rptList.some(function (item) {
                return item.accTrreId == addAccNameId;
            });

            if (addAccName.trim() != "" & addAccNameId != null  & creditAmount >= 0) {
                var isFound = rptList.some(function (item) {
                    return item.accTrreId == addAccNameId;
                });
                if (isFound) {
                    toastr["error"]("هذا الحساب موجود في القائمة", "خطأ");
                    return;
                }

                // حساب إجمالي المبالغ الموجودة في الجدول
                var currentTotal = 0;

                $.each(rptList, function (index, value) {
                    currentTotal += parseFloat(value.credit || 0);
                    currentTotal += parseFloat(value.debit || 0);
                });

                // المبلغ الكلي المسموح
                var maxTotal = parseFloat(totalAmount);

                // المبلغ الجديد
                var newAmount = parseFloat(creditAmount);

                // التحقق
                if ((currentTotal + newAmount) > maxTotal) {
                    toastr["error"]("إجمالي مبالغ الجدول لا يمكن أن يتجاوز " + maxTotal, "خطأ");
                    return;
                }

                if (!isFound) {
                    if (creditAmount > 0) {
                        rptList.push({
                            "addAccName": addAccName,
                            "accTrreId": parseInt(addAccNameId),
                            "debit": parseFloat(parseFloat(creditAmount).toFixed(2)),
                            "credit": 0,
                            "isCredit": "false",
                            "documentTypeId": 7,
                        });
                    } else {
                        rptList.push({
                            "addAccName": addAccName,
                            "accTrreId": parseInt(addAccNameId),
                            "credit": 0,
                            "debit": parseFloat(parseFloat(creditAmount).toFixed(2)),
                            "IsCredit": "false",
                            "documentTypeId": 7,
                        });
                    }

                    var totalCreditAmount = 0;
                    var totalDebitAmount = 0;

                    $.each(rptList, function (index, value) {
                        totalDebitAmount += value.debit;
                        totalCreditAmount += value.credit;
                    });


                    // إضافة بند الدائن التلقائي
                    var fixedCreditAccountName = $('#DebitAccName').text(); // ضع هنا اسم البند
                    var fixedCreditAccountId = $('#DebitAccId').text(); // ضع هنا رقم الحساب

                    // حذف البند القديم إذا كان موجود حتى لا يتكرر
                    rptList = rptList.filter(x => x.accTrreId != fixedCreditAccountId);

                    // إضافة الدائن بقيمة إجمالي المدين
                    rptList.push({
                        "addAccName": fixedCreditAccountName,
                        "accTrreId": parseInt(fixedCreditAccountId),
                        "credit": parseFloat(parseFloat(totalDebitAmount).toFixed(2)),
                        "debit": 0,
                        "isCredit": "false",
                        "documentTypeId": 7,
                    });

                    var totalCreditAmount = 0;
                    var totalDebitAmount = 0;

                    $.each(rptList, function (index, value) {
                        totalDebitAmount += parseFloat(value.debit || 0);
                        totalCreditAmount += parseFloat(value.credit || 0);
                    });

                    drawTable();
                    $('.addAccName').val('');
                    $('.amount').val('');
                    $('.list').text(null).trigger('change');
                    $('.list').val(null).trigger('change');
                    isFound = false;

                    var balance = parseFloat(parseFloat(totalCreditAmount).toFixed(2)) - parseFloat(parseFloat(totalDebitAmount).toFixed(2));
                    var tblFooter = '<tr>' +
                        '<td colspan="2">الاجمالي</td>' +
                        '<td colspan="1">' + parseFloat(parseFloat(totalDebitAmount).toFixed(2)) + '</td>' +
                        '<td colspan="1">' + parseFloat(parseFloat(totalCreditAmount).toFixed(2)) + '</td>' +
                        '</tr>' +
                        '<tr>' +
                        '<td colspan="2">الصافي</td>' +
                        '<td colspan="2">' + balance + '</td>' +
                        '</tr>';

                    $('.myTFoot').empty();
                    $('.myTFoot').append(tblFooter);
                }
                else {
                    toastr["error"]("هذاالحساب موجود في القائمة", "خطأ");
                }

                $(".AmountCurrencyDecimalText").text('');
                $(".AmountCurrencyDecimalTextCr").text('');
            } else {
                toastr["error"]("الرجاء ادخال جميع البيانات", "خطأ");
            }

            console.clear();
            console.log(rptList);


            creditAmountObj.set(0);

        }

        function drawTable() {

            $('.myTbody').empty();

            $.each(rptList, function (index, item) {

                var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                    + "<td class='id'>" + item.accTrreId + "</td>"
                    + "<td class='name'>" + item.addAccName + "</td>"
                    + "<td class='creditAmount'>" + item.debit + "</td>"
                    + "<td class='debitAmount'>" + item.credit + "</td>"
                    + "<td class='transDetailId d-none'>0</td>"
                    //+ '<td class="btnDelete"><button id="delete" class="btn btn-warning transfer delete">حذف<i class="transfer-fa fa fa-trash"></i></button></td>'
                    + "</tr>";

                $('.myTbody').append(rows);
            });
        }

        function saveData() {
            var transactionId = $('#TransactionId').text();
            var currencyId = $('#addCurrencyType').val();
            var recipientId = $('#recipient').val();
            var recipient = $('#recipient').text();
            var statement = $('#statement').val();

            var today = new Date();

            var transactionDate =
                (today.getMonth() + 1).toString().padStart(2, '0') + '/' +
                today.getDate().toString().padStart(2, '0') + '/' +
                today.getFullYear();

            debugger;
            console.log(transactionDate); // مثال: 07/19/2026
            //var transactionDate = moment($('#transactionDate').val(), "DD/MM/YYYY").format("MM/DD/yyyy");

            if (statement != null & transactionDate != null) {
                //هنا اضفنا حقل البيان والتاريخ لي مصفوفة موجودة مسبقا بها بيانات
                rptList = rptList.map(v => Object.assign(v, {
                    'documentTypeId': 7,
                    "recipient": recipient,
                    "note": statement,
                    "transactionDate": transactionDate,
                    "currencyId": parseInt(currencyId),
                    "recipientId": parseInt(recipientId),
                    "transactionId": parseInt(transactionId)
                }));

                console.log(rptList);

                $.ajax({
                    url: "/Shared/Create",
                    type: "POST",
                    data: JSON.stringify(rptList),
                    contentType: "application/json charset=utf-8",
                    dataType: "json",
                    error: function (response) {
                        toastr[response.Status](response.Message, response.Title);
                    },
                    success: function (response) {
                        if (response.Status == "warning") {
                            toastr[response.Status](response.Message, response.Title);
                        } else {
                            toastr[response.Status](response.Message, response.Title);
                            //$('.list').val(null).trigger('change');
                            $('#add-modal').modal("hide");
                            $('#add-statement-modal').modal("hide");
                            $(".presntTBody").empty();
                            window.location.reload();
                        }
                    }
                });

            } else {
                toastr["error"]("الرجاء ادخال جميع البيانات", "خطأ");
            }
        }


        $('#add-statement-form').on('submit', function (e) {
            e.preventDefault();

            // كل الحقول صحيحة
            saveData();

            this.reset(); // إعادة تعيين النموذج بعد الحفظ
        });


        function saveData1() {
            if (rptList.length === 0) {
                toastr["error"]("لا يوجد بيانات للحفظ", "خطأ");
                return;
            }
            var totalCreditAmount = 0;
            var totalDebitAmount = 0;
            $.each(rptList, function (index, value) {
                totalDebitAmount += parseFloat(value.debit || 0);
                totalCreditAmount += parseFloat(value.credit || 0);
            });
            if (totalCreditAmount !== totalDebitAmount) {
                toastr["error"]("إجمالي المدين لا يساوي إجمالي الدائن", "خطأ");
                return;
            }
            var dataToSend = {
                TransactionId: @ViewBag.TransactionId,
                TransactionDetails: rptList
            };
            $.ajax({
                url: '/Transactions/RemovePettyCash',
                type: 'POST',
                data: JSON.stringify(dataToSend),
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                    if (response.success) {
                        toastr["success"](response.message, "نجاح");
                        setTimeout(function () {
                            window.location.href = '/Transactions/PettyCashNotPayed';
                        }, 2000);
                    } else {
                        toastr["error"](response.message, "خطأ");
                    }
                },
                error: function (xhr, status, error) {
                    toastr["error"]("حدث خطأ أثناء الحفظ", "خطأ");
                }
            });
        }

    </script>
}