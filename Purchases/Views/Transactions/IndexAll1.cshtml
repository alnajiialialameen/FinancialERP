        function saveNew() {
            var statement = $('#statement').val();
            var currencyId = $('#addCurrencyType').val();
            var recipientId = $('#recipient').val();
            var recipient = $('#recipient option:selected').text();

            if (recipient.includes(" - ")) {
                recipient = recipient.split(" - ")[0];
            } else {
                recipient = recipient; // لو مافي شرطة، نحتفظ بالنص كما هو
            }
            var transactionDate = $('#transactionDate').val();
            // var transactionDate = moment($('#transactionDate').val()).format("MM/DD/YYYY");

            var documentTypeId = $('#documentType').val();

            if (statement != null & transactionDate != null) {
                //هنا اضفنا حقل البيان والتاريخ لي مصفوفة موجودة مسبقا بها بيانات
                rptList = rptList.map(v => Object.assign(v, {
                    'documentTypeId': documentTypeId,
                    "recipient": recipient,
                    "note": statement,
                    "transactionDate": transactionDate,
                    "currencyId": currencyId,
                    "recipientId": recipientId
                }));

                $.ajax({
                    url: "/Shared/Create",
                    type: "POST",
                    data: JSON.stringify(rptList),
                    contentType: "application/json charset=utf-8",
                    dataType: "json",
                    error: function (response) {
                        toastr[response.Status](response.Message, response.Title);
                    },
                    success: function (response) {
                        if (response.Status == "warning") {
                            toastr[response.Status](response.Message, response.Title);
                        } else {
                            toastr[response.Status](response.Message, response.Title);

                            var modalElement = document.getElementById('add-statement-modal');
                            var modal = bootstrap.Modal.getInstance(modalElement);

                            // سجّل الحدث BEFORE hide
                            modalElement.addEventListener('hidden.bs.modal', function () {

                                // تحديث DataTable
                                $('#tbx').DataTable().ajax.reload(null, false);

                                $(".presntTBody").empty();
                                $(".myTbody").empty();
                                $('.myTFoot').empty();

                                // Bootstrap 5.3 cleanup
                                document.querySelectorAll('.modal-backdrop').forEach(function (backdrop) {
                                    backdrop.remove();
                                });

                                document.body.classList.remove('modal-open');
                                document.body.style.removeProperty('overflow');
                                document.body.style.removeProperty('padding-right');

                            }, { once: true });

                            if (modal) {
                                modal.hide();
                            }

                            setTimeout(function () {

                                console.log("Modals:", $('.modal.show').length);
                                console.log("Backdrops:", $('.modal-backdrop').length);
                                console.log("Body classes:", $('body').attr('class'));

                            }, 500);
                            $('#add-statement-form')[0].reset();

                            rptList = [];
                        }
                    }
                });

            } else {
                toastr["error"]("الرجاء ادخال جميع البيانات", "خطأ");
            }
        }

