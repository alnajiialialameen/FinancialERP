@{
    Layout = null;
}

<!DOCTYPE html>

<html dir="rtl">
<head>
    <meta name="viewport" content="width=device-width" />

    <link href="~/My-Layout/Select2 4.1.0/css/Select2 4.1.0.min.css" rel="stylesheet" />
    <link href="~/My-Layout/Bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/My-Layout/Bootstrap/css/bootstrap-icons.css" rel="stylesheet" />
    @*<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />*@
    <link href="~/My-Layout/DataTable/datatables.min.css" rel="stylesheet" />
    <link href="~/Content/toastr.min.css" rel="stylesheet" />

    <style>
        #tbx,
        #tbx_wrapper,
        #tbx tbody,
        #tbx td {
            overflow: visible !important;
        }

        .select2-container {
            flex: 1 1 auto;
            width: 100% !important;
        }

            .select2-container .select2-selection--single {
                height: 38px !important;
                border: 1px solid #dee2e6 !important;
                border-radius: 0 0.375rem 0.375rem 0 !important;
            }

        .select2-container--default
        .select2-selection--single
        .select2-selection__rendered {
            line-height: 36px !important;
            padding-right: 12px !important;
            padding-left: 12px !important;
        }

        .select2-container--default
        .select2-selection--single
        .select2-selection__arrow {
            height: 36px !important;
        }

        [dir="rtl"] .input-group .select2-container .select2-selection--single {
            border-radius: 0.375rem 0 0 0.375rem !important;
        }

        [dir="rtl"] .select2-container--default
        .select2-selection--single
        .select2-selection__arrow {
            left: 6px;
            right: auto;
        }

        .modal {
            overflow: visible !important;
        }

        .select2-container {
            z-index: 9999 !important;
        }

        /*إجبار القائمة المنسدلة لـ Select2 على الظهور فوق أي موديل أو شاشة سوداء*/
        .select2-container--open {
            z-index: 9999999 !important;
        }

        /*إصلاح مشكلة التركيز في حقل البحث داخل Select2*/
        .select2-search__field {
            z-index: 9999999 !important;
        }

        .floating-btn {
            position: fixed;
            top: 15px;
            left: 20px;
            width: 50px;
            height: 50px;
            z-index: 1050;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }
    </style>
    <title>IndexAll1</title>
</head>

<body dir="rtl">
    <div class="container-fluid">

        <div class="d-flex flex-row w-100 justify-content-between align-items-center px-3 mt-3">
            <h3>
                سندات القيد
            </h3>
            @*<ol class="breadcrumb">
                    <li><a href="#" style="text-decoration:none;"><i class="bi bi-home-alt"></i> النظام المحاسبي</a></li>
                    >
                    <li class="active">  سندات القيد</li>
                </ol>*@

            <a href="/Home/Index"
               class="btn btn-success rounded-circle shadow floating-btn"
               title="الرئيسية">
                <i class="bi bi-house"></i>
            </a>
        </div>

        <div class="card card-body mt-3">
            <div class="mb-1">
                <button class="btn btn-primary float-start"
                        data-bs-toggle="modal"
                        data-bs-target="#add-modal">
                    إضافة قيد
                </button>
            </div>

            <table class="table table-striped table-bordered" id="tbx"></table>
        </div>
    </div>

    <!-- Modal -->
    <div class="example-modal">
        <div class="modal fade" id="add-modal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">

            <div class="modal-dialog modal-dialog-scrollable modal-xl">
                <div class="modal-content">

                    <!-- Modal Header -->
                    <div class="modal-header border-0 d-flex justify-content-between align-items-center">
                        <h5 class="modal-title" id="addModalLabel">
                            إضافة قيد جديد
                        </h5>

                        <button type="button"
                                class="btn-close ms-0"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body">

                        <form id="add-form">

                            <div class="row">

                                <!-- Account -->
                                <div class="col-lg-4 mb-3">
                                    <label for="addAccName" class="form-label">
                                        اسم الحساب
                                    </label>

                                    <select class="form-select addAccName"
                                            name="addAccName"
                                            id="addAccName"
                                            style="width:100%">
                                    </select>

                                </div>


                                <!-- Debit -->
                                <div class="col-lg-4">
                                    <div class="mb-3">

                                        <div class="d-flex">
                                            <label for="debitAmount" class="form-label">
                                                المبلغ المدين
                                            </label>

                                            <strong id="AmountCurrencyDecimalText"
                                                    class="AmountCurrencyDecimalText ms-1">
                                            </strong>
                                        </div>

                                        <input class="form-control debitAmount"
                                               type="text"
                                               name="debitAmount"
                                               id="debitAmount"
                                               placeholder="المبلغ مدين"
                                               autocomplete="off">
                                    </div>
                                </div>


                                <!-- Credit -->
                                <div class="col-lg-4">
                                    <div class="mb-3">

                                        <div class="d-flex">
                                            <label for="creditAmount" class="form-label">
                                                المبلغ الدائن
                                            </label>

                                            <strong id="AmountCurrencyDecimalTextCr"
                                                    class="AmountCurrencyDecimalTextCr ms-1">
                                            </strong>
                                        </div>

                                        <input class="form-control creditAmount"
                                               type="text"
                                               name="creditAmount"
                                               id="creditAmount"
                                               placeholder="المبلغ"
                                               autocomplete="off">

                                    </div>
                                </div>

                            </div>


                            <!-- Post Button -->
                            <div class="row">
                                <div class="col-lg-12">
                                    <button type="button"
                                            class="btn btn-info w-100"
                                            onclick="addToTable()">
                                        ترحيل
                                    </button>
                                </div>
                            </div>

                        </form>


                        <br>


                        <!-- Table -->
                        <div class="row">
                            <div class="col-lg-12">

                                <div class="table-responsive">
                                    <table id="example1"
                                           class="table table-bordered table-striped virtualTable">

                                        <thead>
                                            <tr>
                                                <th class="text-center" style="width:150px;">
                                                    #
                                                </th>

                                                <th class="text-center" style="width:750px;">
                                                    اسم الحساب
                                                </th>

                                                <th class="text-center" style="width:750px;">
                                                    مدين
                                                </th>

                                                <th class="text-center" style="width:750px;">
                                                    دائن
                                                </th>

                                                <th class="text-center">
                                                    <i class="bi bi-cogs"></i>
                                                </th>
                                            </tr>
                                        </thead>

                                        <tbody class="myTbody"></tbody>

                                        <tfoot class="myTFoot text-center">
                                        </tfoot>

                                    </table>

                                </div>
                            </div>
                        </div>


                        <!-- Footer Buttons -->
                        <div class="row">
                            <div class="col-lg-12">

                                <div class="d-flex justify-content-end gap-2">

                                    <button type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        رجوع
                                    </button>

                                    <button type="submit"
                                            id="btnSave"
                                            class="btn btn-primary">
                                        مراجعة القيد
                                    </button>

                                </div>

                            </div>
                        </div>

                    </div>
                    <!-- /.modal-body -->

                </div>
                <!-- /.modal-content -->

            </div>
            <!-- /.modal-dialog -->

        </div>
        <!-- /.modal -->
    </div>

    <div class="example-modal">

        <div class="modal"
             id="add-statement-modal"
             data-bs-backdrop="static"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-scrollable modal-lg">
                <div class="modal-content">

                    <!-- Modal Header -->
                    <div class="modal-header border-0 d-flex justify-content-between align-items-center">
                        <h5 class="modal-title" id="addStatementModalLabel">
                            إضافة عملية جديدة
                        </h5>

                        <button type="button"
                                class="btn-close ms-0"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body">

                        <form id="add-statement-form" novalidate>
                            <div class="row">
                                <!-- تاريخ القيد -->
                                <div class="col-6 mb-3">

                                    <label for="transactionDate" class="form-label d-block">
                                        تاريخ القيد
                                    </label>

                                    <input type="date"
                                           class="form-control calendar transactionDate"
                                           id="transactionDate"
                                           name="transactionDate"
                                           placeholder="تاريخ القيد"
                                           autocomplete="off">

                                </div>

                                <!-- العملة -->
                                <div class="col-lg-6 mb-3">

                                    <label for="addCurrencyType" class="form-label  d-block">
                                        العملة
                                    </label>

                                    <select class="form-control addCurrencyType"
                                            name="addCurrencyType"
                                            id="addCurrencyType"
                                            style="width:100%"
                                            required>
                                    </select>

                                    <div id="addCurrencyTypeError" class="invalid-feedback">
                                        يرجى اختيار العملة
                                    </div>
                                </div>

                                <!-- نوع السند -->
                                <div class="col-lg-6 mb-3">

                                    <label for="documentType" class="form-label">
                                        نوع السند
                                    </label>

                                    <select class="form-select documentType"
                                            name="documentType"
                                            id="documentType"
                                            style="width:100%"
                                            required>
                                    </select>

                                    <div id="documentTypeError" class="invalid-feedback">
                                        يرجى اختيار نوع السند
                                    </div>
                                </div>

                                <!-- اسم المستلم -->
                                <div class="col-lg-6 mb-3">

                                    <label for="recipient" class="form-label">
                                        اسم المستلم
                                    </label>

                                    <select class="form-select  recipient"
                                            name="recipient"
                                            id="recipient"
                                            style="width:100%"
                                            required>
                                    </select>

                                    <div id="recipientError" class="invalid-feedback">
                                        يرجى اختيار المستلم
                                    </div>

                                </div>

                                <!-- البيان -->
                                <div class="col-lg-12 mb-3">

                                    <label for="statement" class="form-label">
                                        البيان
                                    </label>

                                    <textarea class="form-control statement" id="statement" name="statement">@ViewBag.Note</textarea>

                                    <div id="statementError" class="invalid-feedback">
                                        يرجى ادخال البيان
                                    </div>
                                </div>
                            </div>

                            <!-- Save -->
                            <div class="row">
                                <div class="col-12">

                                    <button type="submit"
                                            class="btn btn-success btnCreate w-100">
                                        حفظ
                                    </button>

                                </div>

                            </div>

                        </form>


                        <hr />


                        <!-- Details Table -->
                        <div class="row">

                            <div class="col-12">

                                <div class="table-responsive">

                                    <table class="table table-bordered table-striped table-hover">

                                        <thead class="table-secondary">
                                            <tr class="text-center">
                                                <th>مدين</th>
                                                <th>دائن</th>
                                                <th>الحساب</th>
                                            </tr>
                                        </thead>

                                        <tbody class="presntTBody"></tbody>

                                    </table>

                                </div>

                            </div>

                        </div>

                    </div>
                    <!-- /.modal-body -->

                </div>
                <!-- /.modal-content -->

            </div>
            <!-- /.modal-dialog -->

        </div>
        <!-- /.modal -->

    </div>

    <div class="example-modal">

        <div class="modal fade"
             id="add-recipients-modal"
             data-bs-backdrop="static"
             tabindex="-1"
             aria-labelledby="addRecipientsModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-scrollable modal-lg">
                <div class="modal-content">

                    <!-- Modal Header -->
                    <div class="modal-header border-0 d-flex justify-content-between align-items-center">
                        <label id="recipientTransactionId"
                               class="recipientTransactionId d-none">
                            44444
                        </label>

                        <!-- العنوان أقصى اليمين -->
                        <h5 class="modal-title mb-0">
                            إضافة مستلمين
                        </h5>

                        <!-- زر الإغلاق أقصى اليسار -->
                        <button type="button"
                                class="btn-close ms-0"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body">

                        <div class="row">

                            <!-- اسم البنك -->
                            <div class="col-lg-6">
                                <div class="mb-3">

                                    <label for="recipientBank" class="form-label">
                                        اسم البنك
                                    </label>

                                    <select class="form-select recipientBank"
                                            name="recipientBank"
                                            id="recipientBank"
                                            style="width:100%">
                                    </select>


                                </div>
                            </div>


                            <!-- اسم المستلم -->
                            <div class="col-lg-6">
                                <div class="mb-3">

                                    <label for="recipientName" class="form-label">
                                        اسم المستلم
                                    </label>

                                    <select class="form-select recipientName"
                                            name="recipientName"
                                            id="recipientName"
                                            style="width:100%">
                                    </select>


                                </div>
                            </div>


                            <!-- المبلغ -->
                            <div class="col-lg-6">
                                <div class="mb-3">

                                    <label for="recipientAmount" class="form-label">
                                        المبلغ
                                    </label>


                                    <input type="text"
                                           class="form-control recipientAmount"
                                           name="recipientAmount"
                                           id="recipientAmount"
                                           placeholder="المبلغ"
                                           style="width:100%">


                                </div>
                            </div>


                            <!-- البيان -->
                            <div class="col-lg-12">
                                <div class="mb-3">

                                    <label for="recipientStatement" class="form-label">
                                        البيان
                                    </label>

                                    <textarea class="form-control recipientStatement"
                                              id="recipientStatement"
                                              name="recipientStatement"
                                              disabled></textarea>
                                </div>
                            </div>

                        </div>


                        <!-- حفظ -->
                        <div class="row mb-3">

                            <div class="col-12">

                                <button type="button"
                                        class="btn btn-success btnSaveRecipient w-100">
                                    حفظ
                                </button>

                            </div>

                        </div>


                        <!-- Recipients Table -->
                        <div class="row">

                            <div class="col-12">

                                <div class="table-responsive">

                                    <table class="table table-bordered table-striped table-hover tblRecipient d-none"
                                           id="tblRecipient">

                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>اسم المستلم</th>
                                                <th>اسم البنك</th>
                                                <th>رقم الحساب</th>
                                                <th>المبلغ</th>
                                                <th>#</th>
                                                <th>#</th>
                                            </tr>
                                        </thead>

                                        <tbody id="tblRecipientBody"></tbody>

                                    </table>

                                </div>

                            </div>

                        </div>

                    </div>
                    <!-- /.modal-body -->

                </div>
                <!-- /.modal-content -->

            </div>
            <!-- /.modal-dialog -->

        </div>
        <!-- /.modal -->

    </div>

    <div class="modal fade"
         id="addedTax-modal"
         data-bs-backdrop="static"
         data-bs-keyboard="false"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" style="max-width:60%;">
            <div class="modal-content">

                <div class="modal-header border-0 d-flex justify-content-between align-items-center">
                    <h5 class="modal-title">إضافة ضريبة القيمة المضافة</h5>

                    <label id="recipientTransactionId"
                           class="recipientTransactionId d-none">
                        44444
                    </label>

                    <button type="button"
                            class="btn-close ms-0"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="row">

                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label for="addTaxVal" class="form-label">
                                    ادخل القيمة
                                </label>

                                <input type="number"
                                       class="form-control"
                                       id="addTaxVal"
                                       value="17" />
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label for="addTaxValDisplay" class="form-label">
                                    القيمة الفعلية(%)
                                </label>

                                <label class="form-control"
                                       id="addTaxValDisplay">
                                </label>
                            </div>
                        </div>

                    </div>

                    <div class="row">
                        <div class="col-12">
                            <button type="button"
                                    class="btn btn-success btnSaveAddedTax"
                                    onclick="Add17Tax()">
                                حفظ
                            </button>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <div class="modal fade"
         id="taxConfirmation-modal"
         data-bs-backdrop="static"
         data-bs-keyboard="false"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" style="max-width:40%;">
            <div class="modal-content">

                <div class="modal-header border-0 d-flex justify-content-between align-items-center">
                    <h5 class="modal-title">
                        إضافة ضريبة الـ 1%
                    </h5>

                    <label id="taxConfirmationTransId"
                           class="taxConfirmationTransId d-none">
                        44444
                    </label>

                    <button type="button"
                            class="btn-close ms-0"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <div class="modal-body">

                    <h2 class="text-center">
                        سيتم خصم 1% من أصل المبلغ!
                    </h2>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-success"
                            onclick="AddOneTax()">
                        تأكيد
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        إلغاء
                    </button>

                </div>

            </div>
        </div>
    </div>

    <div class="modal fade"
         id="details-modal"
         data-bs-backdrop="static"
         data-bs-keyboard="false"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" style="max-width: 60%;">
            <div class="modal-content">

                <div class="modal-header border-0 d-flex justify-content-between align-items-center">
                    <h5 class="modal-title">
                        عرض تفاصيل القيد
                    </h5>

                    <button type="button"
                            class="btn-close ms-0"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="row m-0">
                        <div class="col-lg-3 text-end">
                            <label>التاريخ :</label>
                            <label class="tarnsDate"></label>
                        </div>

                        <div class="col-lg-9 text-start">
                            <label>البيان :</label>
                            <label class="tarnsStatement"></label>
                        </div>
                    </div>

                    <hr />

                    <div class="row">

                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover">
                                <thead class="table-secondary">
                                    <tr class="text-center">
                                        <th>#</th>
                                        <th>الحساب</th>
                                        <th>مدين</th>
                                        <th>دائن</th>
                                    </tr>
                                </thead>
                                <tbody class="detailsTBody"></tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="2">الاجمالي</th>
                                        <th id="tdDebitAmount"></th>
                                        <th id="tdCreditAmount"></th>
                                    </tr>
                                    <tr>
                                        <th colspan="2">الصافي</th>
                                        <th colspan="2" id="tdBalance"></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- 1. jQuery أولاً -->
    <script src="~/My-Layout/jQuery-v3.7.1/jQuery v3.7.1.min.js"></script>

    <!-- 2. Bootstrap -->
    <script src="~/My-Layout/Bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- 3. Select2 -->
    <script src="~/My-Layout/Select2 4.1.0/js/Select2 4.1.0.js"></script>
    <script src="~/My-Layout/DataTable/js/DataTables 3.1.3.js"></script>
    <script src="~/Temp/AutoNumeric/auto-numeric.js"></script>
    <script src="~/Scripts/moment.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>

    <script>
        var myId = 0;
        var dataTable;
        var creditAmountObj;
        var debitAmountObj;
        var recipientAmountObj;

        $(document).ready(function () {
            const today = new Date();
            const selectedYear = @ViewBag.Year;

            const dateValue = `${selectedYear}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

            $('#transactionDate').val(dateValue);

            //*********************************************************** */

            select2list("#addAccName", "/Shared/getAccTrees", "اسم الحساب", "#add-modal");

            creditAmountObj = CustomAutoNumeric('#creditAmount');
            debitAmountObj = CustomAutoNumeric('#debitAmount');
            recipientAmountObj = CustomAutoNumeric('#recipientAmount');

            loadData();
        });

        function loadData() {
            dataTable = $('#tbx').DataTable({
                "language": {
                    "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                    "search": "بحث"
                },
                "columnDefs": [
                    {
                        "targets": 0,
                        "className": "text-center",
                    },
                ],
                ajax: {
                    url: '/Shared/LoadData',
                    dataSrc: ''
                },
                columns: [
                    {
                        "title": "",
                        "data": "transactionId",
                        "orderable": false,
                        "render": function (data) {
                            return '<a class="btn btn-info btnDetails" data-bs-toggle="modal" data-bs-target="#details-modal"><i class="bi bi-info"></i></a>';
                        }
                    },
                    {
                        "title": "# ",
                        "data": "transactionId"
                    },
                    {
                        "title": "البيان",
                        "data": "note"
                    },
                    {
                        "title": "نوع القيد",
                        "data": "documentType"
                    },
                    {
                        "title": "اصل المبلغ",
                        "data": "total",
                        "render": function (data, type, row) {
                            return formatNumber(data.toString());
                        }
                    },
                    {
                        "title": "العملة",
                        "data": "currency"
                    },
                    {
                        "title": "سعر الصرف",
                        "data": "exchangeRate",
                        "render": function (data, type, row) {
                            return formatNumber(data.toString());
                        }
                    },
                    {
                        "title": "تاريخ القيد",
