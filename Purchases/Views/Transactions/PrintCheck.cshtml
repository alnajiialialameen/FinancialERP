@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

@section content{

    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <div class="grad"></div>

        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>
                الحركات المحاسبية
            </h1>
            <ol class="breadcrumb">
                <li><a href="#"><i class="fa fa-home"></i> النظام المالي </a></li>
                <li class="active"> الحركات المحاسبية </li>
            </ol>

        </section>

        <section class="content">
            <div class="row">
                <div class="col-xs-12">
                    <div class="box">
                        <div class="box-header hidden">
                            <div class="date-input" style="border: 1px solid #4f579b; padding: 10px; width: fit-content; margin: 0 auto; border-radius: 5px;">
                                <label for="start-date"> من</label>
                                <input type="date" id="start-date" class="start-date calendar" style="margin-left:20px" />

                                <label for="end-date"> الي</label>
                                <input type="date" id="edb-date" class="end-date calendar" />
                            </div>
                        </div>
                        <div class="box-body">
                            <table id="tbx" class="table table-bordered table-striped table-hover"></table>
                        </div><!-- /.box-body -->
                    </div><!-- /.box -->
                </div><!-- /.col -->
            </div><!-- /.row -->
        </section>


    </div><!-- /.content-wrapper -->



}



@section scripts{

    <script>
    
        $(function () {

        });//End Document Ready


    </script>



}


