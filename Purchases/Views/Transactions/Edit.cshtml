        function saveNew() {
            var transactionId = $('#TransactionId').text();
            var statement = $('#finalNote').val();
            var currencyId = $('#finalCurrencyType').val();
            var transactionDate = $('#finalTransactionDate').val();

            //on local
            //var transactionDate = moment($('#finalTransactionDate').val(), "DD/MM/YYYY").format("MM/DD/yyyy");
            // on server
            //var transactionDate = moment($('#finalTransactionDate').val(), "MM/DD/YYYY").format("DD/MM/yyyy");

            console.clear();
            console.log(rptList);
            console.log(transactionDate);

            if (statement != null & transactionDate != null & currencyId != null) {
                //هنا اضفنا حقل البيان والتاريخ لي مصفوفة موجودة مسبقا بها بيانات
                rptList = rptList.map(v => Object.assign(v, { "note": statement, "transactionDate": transactionDate, "currencyId": currencyId, "transactionId": transactionId }));

                $.ajax({
                    url: "/Transactions/Update",
                    type: "POST",
                    data: JSON.stringify(rptList),
                    contentType: "application/json charset=utf-8",
                    dataType: "json",
                    error: function (response) {
                        toastr[response.Status](response.Message, response.Title);
                    },
                    success: function (response) {
                        if (response.Status == "warning") {
                            toastr[response.Status](response.Message, response.Title);
                        } else {
                            toastr[response.Status](response.Message, response.Title);
                            $('#add-modal').modal("hide");
                            $('#add-statement-modal').modal("hide");
                            $('#edit-modal').modal("hide");
                            $(".presntTBody").empty();
                            //window.location.reload();
                        }
                    }
                });

                console.log(rptList);
            } else {
                toastr["error"]("الرجاء ادخال جميع البيانات", "خطأ");
            }
        }

        $('#creditAmount').keyup(function () {
            var creditAmount = $(this).val();

            if (creditAmount != null & creditAmount > 0) {
                $('#debitAmount').val(0);
            }
        });

        $('#debitAmount').keyup(function () {
            var debitAmount = $(this).val();

            if (debitAmount != null & debitAmount > 0) {
                $('#creditAmount').val(0);
            }
        });

