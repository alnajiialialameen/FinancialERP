@model Purchases.Models.Transaction
@using Purchases.Models;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

@{
    Entities db = new Entities();
    AccountTree Select = new AccountTree();
}

<style type="text/css">
    .displaying {
        display: none;
    }

    fieldset{
        border: solid 1px #808080 !important;
        padding: 10px;
        border-radius: 5px;
    }

    .trans{
        border: solid 1px #808080 !important; 
        border-radius: 5px; 
        width:70%; 
        padding:5px;
    }
    
    .legend{
        position: absolute;
        top: -25px;
        left: 55px;
        background-color: white;
        padding: 0 10px;
        transform: scale3d(1.2, 1.2, 1.2);
    }


</style>

@section content{
    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <div class="grad"></div>
        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>
                تعديل القيود
            </h1>
            <label id="TransactionId" class="hidden">@ViewBag.TransactionId</label>
            <ol class="breadcrumb">
                <li><a href="#"><i class="fa fa-home"></i> النظام المحاسبي</a></li>
                <li class="active">قيود اليومية</li>
            </ol>
        </section>

        <section class="content">
            <div class="row">
                <div class="col-xs-8">
                    <div class="box">
                        <!-- /.box-header -->
                        <div class="box-body">
                            <h4 style="float:right">تفاصيل القيد</h4>
                            <button class="btn btn-warning btnEidtMain" style="float:left"> تعديل القيد</button>
                            <br />
                            <div class="container" style="margin-top:30px; clear:both;">
                                <table id="tbx" class="table table-bordered table-sm table-hover" style="width:100%"></table>
                            </div><!-- /.box-body -->
                        </div><!-- /.box -->
                    </div><!-- /.col -->
                </div>
                <div class="col-xs-4">
                    <div class="box">
                        <!-- /.box-header -->
                        <div class="box-body">
                            <fieldset style="border: solid 1px #808080 !important; padding: 10px; border-radius: 5px;">
                                <label class="legend">بيانات القيد</label>
                                <table>
                                    <tbody>
                                        <tr>
                                            <td>رقم السند</td>
                                            <td>
                                            <label class="form-control trans mainTransactionId">@ViewBag.TransactionId</label></td>
                                        </tr>
                                        <tr>
                                            <td>تاريخ السند</td>
                                            <td>
                                                <label  class="form-control trans mainTransactionDate" id="mainTransactionDate" name="mainTransactionDate" >@ViewBag.TransactionDate</label>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>العملة</td>
                                            <td>
                                                <label class="form-control trans mainCurrencyType" name="CurrencyType" id="CurrencyType">@ViewBag.CurrencyType</label>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>سعرالصرف</td>
                                            <td style="width:100%;" >
                                                <label class="form-control trans ExchangeRate" id="ExchangeRate" name="ExchangeRate">@ViewBag.ExchangeRate</label>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>البيان</td>
                                            <td>
                                                <textarea rows="5" disabled class="form-control trans mainNote" id="Note" name="Note">@ViewBag.Note</textarea>
                                            </td>
                                        </tr>

                                    </tbody>
                                </table>
                            </fieldset>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </div><!-- /.content-wrapper -->

    <div class="example-modal">
        <div class="modal fade in" id="edit-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:80% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> تعديل القيد</h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="row">
                                    <div class="col-lg-12">
                                        <!-- Input addon -->
                                        <div class="row">
                                            <form id="add-form">
                                                <div class="col-lg-12">
                                                    <div class="col-lg-4">
                                                        <div class="form-group">
                                                            <label for="name">اسم الحساب</label>
                                                            <div class="input-group">
                                                                <div class="input-group-addon">
                                                                    <i class="fa fa-book"></i>
                                                                </div>
                                                                <select class="form-control list addAccName" name="addAccName" id="addAccName" style="width:100%"></select>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-4">
                                                        <div class="form-group">
                                                            <label for="name">المبلغ مدين</label>
                                                            <div class="input-group">
                                                                <div class="input-group-addon">
                                                                    <i class="fa  fa-book"></i>
                                                                </div>
                                                                <input class="form-control debitAmount" value="0" type="number" name="debitAmount" id="debitAmount" placeholder="المبلغ مدين" autocomplete="off" />
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-4">
                                                        <div class="form-group">
                                                            <label for="name">المبلغ دائن</label>
                                                            <div class="input-group">
                                                                <div class="input-group-addon">
                                                                    <i class="fa  fa-book"></i>
                                                                </div>
                                                                <input class="form-control creditAmount" value="0" type="number" name="creditAmount" id="creditAmount" placeholder="المبلغ دائن" autocomplete="off" />

                                                            </div>
                                                        </div>
                                                    </div>


                                                    @*<div class="col-lg-3">
                                                        <div class="form-group">
                                                            <label for="addBalanceId">بند الخصم</label>
                                                            <div class="input-group">
                                                                <div class="input-group-addon">
                                                                    <i class="fa fa-book"></i>
                                                                </div>
                                                                <select class="form-control list addBalanceId" name="addBalanceId" id="addBalanceId" style="width:100%"></select>
                                                            </div>
                                                        </div>
                                                    </div>*@

                                                </div>

                                                <div class="col-lg-12">
                                                    <button class="btn btn-info btn-block m-4" onclick="addToTable()">ترحيل</button>
                                                </div>
                                            </form>
                                        </div>

                                        <br />

                                        <div class="row">
                                            <div class="col-lg-12">
                                                <table id="example1" class="table table-bordered table-striped virtualTable">
                                                    <thead>
                                                        <tr>
                                                            <th style="text-align:center ;width:150px;">#</th>
                                                            <th style="text-align:center ;width:750px;">اسم الحساب</th>
                                                            <th style="text-align:center ;width:750px;">المبلغ(مدين)</th>
                                                            <th style="text-align:center ;width:750px;">المبلغ(دائن)</th>
                                                            @*<th style="text-align:center ;width:750px;">بند الخصم</th>*@
                                                            <th style="text-align:center;"><i class="fa fa-cogs"></i></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody class="myVirtualTbody"></tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-lg-12 ">
                                                <div class="pull-left">
                                                    <button type="button" class="btn btn-default " data-dismiss="modal">رجوع</button>
                                                    <button type="submit" id="btnSave" class="btn btn-primary">مراجعة القيد</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div><!-- /.row (main row) -->

                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>

    <div class="example-modal">
        <div class="modal fade in" id="add-statement-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:40% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> مراجعة بيانات القيد</h4>
                    </div>
                    <div class="modal-body">
                    <textarea class="form-control finalNote" id="finalNote" name="finalNote"> @ViewBag.Note </textarea>
                    <br />
                    <select class="list form-control   finalCurrencyType" name="finalCurrencyType" id="finalCurrencyType"></select>
                    <br />  
                        <input type="text" class="form-control trans calendar finalTransactionDate" value="@ViewBag.TransactionDate" id="finalTransactionDate" name="finalTransactionDate" placeholder="تاريخ القيد" autocomplete="off">

                    @*<input type="text" class="form-control calendar finalTransactionDate" value="@ViewBag.TransactionDate" id="transDate" name="transDate" placeholder="تاريخ القيد" autocomplete="off">*@

                    <hr />
                        <div class="row">
                            <table class="table table-bordered table-striped table-hover">
                                <thead style="background-color:#808080">
                                    <tr class="text-center">
                                        <td>مدين</td>
                                        <td>دائن</td>
                                        <td>الحساب</td>
                                    </tr>
                                </thead>
                                <tbody class="presntTBody"></tbody>
                            </table>
                            <button type="submit" class="btn btn-warning btnUpdate" onclick="saveNew()" style="width: 100%;">تعديل</button>
                        </div>
                    </div><!-- /.modal-content -->
                </div><!-- /.modal-dialog -->
            </div><!-- /.modal -->
        </div>
    </div>


