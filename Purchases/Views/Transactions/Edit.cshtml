@section scripts{

    <script>
        var myId = 0;
        var dataTable;
        var rptList = [];


        $(document).ready(function () {
            var Id = $('#TransactionId').text();
            function loadData() {
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    "columnDefs": [
                      {
                          "targets": [4],
                          'visible': false
                        }
                    ],
                    ajax: {
                        url: '/Transactions/getDetailData/' + Id,
                        dataSrc: ''
                    },
                    columns: [
                        {
                            "title": "# ",
                            "data": "id"
                        },
                        {
                            "title": "الحساب",
                            "data": "accName"
                        },
                        {
                            "title": "مدين",
                            "data": "debit"
                        },
                        {
                            "title": "دائن",
                            "data": "credit"
                        },
                        //{
                        //    "title": "بند الخصم",
                        //    "data": "balanceAccName"
                        //},
                        //{
                        //    "title": '<i class="fa fa-cogs"></i>',
                        //    "data": null,
                        //    "width": "10%",
                        //    "orderable": false,
                        //    "render": function (data) {
                        //        return '<button id="btnDelete" onClick="Delete('+ data.id +')" class="btn btn-warning transfer btnDelete">حذف<i class=" transfer-fa fa  fa-trash"></i></button>  <a href="#" id="edit" class="edit"><i class=" transfer-fa fa  fa-pen"></i></a>';
                        //    }
                        //},
                        {
                            "title": "accTrreId",
                            "data": "accTrreId"
                        },
                        //{
                        //    "title": "balanceId",
                        //    "data": "balanceId"
                        //}
                    ]
                });

            }
            loadData();

            function select2list(selector, url, placeholder) {
                $(selector).select2({
                    language: { inputTooShort: function () { return 'ادخل حرف واحد علي الاقل'; } },
                    ajax: {
                        url: url,
                        dataType: 'json',
                        delay: 100,
                        data: function (params) {
                            return {
                                q: params.term,
                                page: params.page
                            };
                        },
                        processResults: function (data, params) {
                            params.page = params.page || 1;
                            return {
                                results: data,
                                pagination: {
                                    more: ((data.total_count) > (params.page * 20))
                                }
                            };
                        },
                        cache: true
                    },
                    placeholder: placeholder,
                    minimumInputLength: 1,
                });

            };
            select2list("#addAccName", "/Transactions/getAccTrees", "اسم الحساب");
            //select2list("#addBalanceId", "/Transactions/getBalanceIds", "بند الخصم");
            select2list("#addCurrencyType", "/Transactions/getCurrency", "العملة");
            select2list("#finalCurrencyType", "/Transactions/getCurrency", "العملة");

        });

        //-------------------------------------------------Start Validator ------------------------------------------------------------------------------------------------------------

        $('#add-form').bootstrapValidator({
            onSuccess: function (e) {
                //save();
                e.preventDefault();

            },
            submitButtons: 'button[type="submit"]',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok success-feedback-icons',
                invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                validating: 'fa fa-refresh fa-spin success-feedback-icons'
            },
            //fields: {
            //    addAccName: {
            //        validators: {
            //            notEmpty: {
            //                message: 'يجب الا يكون حقل اسم الحساب  فارغ'
            //            }
            //        }
            //    },
            //    debitAmount: {
            //        validators: {
            //            required: true,
            //            number: true,
            //            minimumInputLength: 0,
            //            range: {
            //                    [0.1, 9999999999],
            //                }
            //            ,
            //            notEmpty: {
            //                message: 'يجب الا يكون حقل المبلغ فارغ'
            //            },
            //        }
            //    },
            //}

            fields: {
                addAccName: {
                    required: 'يجب الا يكون حقل اسم الحساب  فارغ',
                    minimumInputLength: 'يجب الا يكون حقل اسم الحساب  فارغ',
                },
                debitAmount: {
                    required: 'يجب الا يكون حقل اسم الحساب  فارغ',
                    number: 'يجب ان تكون القيمة رقمية',
                    minimumInputLength: 'يجب الا يكون حقل اسم الحساب  فارغ',
                    range: 'الرقم خارج المدي',
                },
                creditAmount: {
                    required: 'يجب الا يكون حقل اسم الحساب  فارغ',
                    number: 'يجب ان تكون القيمة رقمية',
                    minimumInputLength: 'يجب الا يكون حقل اسم الحساب  فارغ',
                    range: 'الرقم خارج المدي',
                },
                //addBalanceId: {
                //    required: 'يجب الا يكون حقل اسم الحساب  فارغ',
                //    minimumInputLength: 'يجب الا يكون حقل اسم الحساب  فارغ',
                //}
            },
            messages: {
                addAccName: {
                    required: true,
                    minimumInputLength: 0,
                },
                debitAmount: {
                    required: true,
                    number: true,
                    minimumInputLength: 0,
                    range: [0.1, 9999999999],
                },
                creditAmount: {
                    required: true,
                    number: true,
                    minimumInputLength: 0,
                    range: [0.1, 9999999999],
                },
                //addBalanceId: {
                //    required: true,
                //    minimumInputLength: 0,
                //}
            }

        });
        $('#add-statement-form').bootstrapValidator({
            onSuccess: function (e) {
                saveNew();
                e.preventDefault();
            },
            submitButtons: 'button[type="submit"]',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok success-feedback-icons',
                invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                validating: 'fa fa-refresh fa-spin success-feedback-icons'
            },
            fields: {
                journalDate: {
                    validators: {
                        notEmpty: {
                            message: 'يجب الا يكون حقل اسم تاريخ القيد  فارغ'
                        }
                    }
                },
                statement: {
                    validators: {
                        notEmpty: {
                            message: 'يجب الا يكون حقل البيان  فارغ'
                        }
                    }
                },
            }
        });


        //-------------------------------------------------End Validator ------------------------------------------------------------------------------------------------------------

        /*---------------------------------------------new work-------------------------------------------*/

        $('.btnEidtMain').click(function () {
            console.clear();
            var transDetailId, accTreeId, balanceId, accTreeName, accCrited, accDebit;
            var row = '';
            $('.myVirtualTbody').empty();

            $('#tbx tbody tr').each(function () {

                var transDetailId = $(this).find('td:eq(0)').text();
                var accTreeName = $(this).find('td:eq(1)').text();
                var accDebit = $(this).find('td:eq(2)').text();
                var accCrited = $(this).find('td:eq(3)').text();
                var balanceAccTreeName = $(this).find('td:eq(4)').text();

                var currentRow = $(this).closest("tr");
                var data = $('#tbx').DataTable().row(currentRow).data();
                accTrreId = data['accTrreId'];
                balanceId = data['balanceId'];

                rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                                + "<td class='accTreeId'>" + accTrreId + "</td>"
                                + "<td class='hidden id'>" + transDetailId + "</td>"
                                + "<td class='name'>" + accTreeName + "</td>"
                                + "<td class='accDebit'>" + accDebit + "</td>"
                                + "<td class='accCrited'>" + accCrited + "</td>"
                                //+ "<td class='hidden balanceId'>" + balanceId + "</td>"
                                //+ "<td class='balanceAccTreeName'>" + balanceAccTreeName + "</td>"
                                //+ '<td  class="tdBtnDelete" > <button id="delete" class="btn btn-warning transfer delete">حذف<i class=" transfer-fa fa  fa-trash"></i></button>  <a href="#" id="edit" class="edit"><i class=" transfer-fa fa  fa-pen"></i></a>' + "</td>"
                                + '<td  class="tdBtnDelete" > <button id="delete" class="btn btn-warning transfer delete">حذف<i class=" transfer-fa fa  fa-trash"></i></button>' + "</td>"
                        + '</tr>';

                $('.myVirtualTbody').append(rows);

                if (accCrited > 0) {
                    rptList.push({
                        "transDetailId": transDetailId,
                        "addAccName": accTreeName,
                        "accTrreId": accTrreId,
                        "amount": 0,
                        "credit": accCrited,
                        "debit": 0,
                        //"balanceId": balanceId,
                        "isCredit": "true",
                    });
                } else {
                    rptList.push({
                        "transDetailId": transDetailId,
                        "addAccName": accTreeName,
                        "accTrreId": accTrreId,
                        "Amount": 0,
                        "credit": 0,
                        "debit": accDebit,
                        //"balanceId": balanceId,
                        "IsCredit": "false",
                    });
                }
            });

            console.log(rptList);
            $('#edit-modal').modal('show');
        });

        $('.myVirtualTbody').on('click', '#delete', function () {
            var accTreeId = $(this).closest("tr").find('td:eq(0)').text();
            //debugger;
            console.log(accTreeId);
            accTreeId = parseInt(accTreeId);

            rptList = rptList.filter(item => item.accTrreId !== accTreeId);
            //rptList = rptList.splice(rptList.indexOf(x=>x.accTreeId == accTreeId),1);

            console.log(rptList);
            $(this).closest('tr').remove();
        });

        function addToTable() {
            //هنا لازم ندخل اسم الحساب
            var addAccName = $('#select2-addAccName-container').text();
