@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .displaying{
        display:none;
    }
</style>

@section content{
<!-- Content Wrapper. Contains page content -->
    <div>
        <!-- Content Header (Page header) -->
        <section class="d-flex flex-row justify-content-between align-items-center my-3">
            <h3>
                القيود المرحلة
            </h3>
            <ol class="breadcrumb">
                <li>
                    <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                        <i class="bi bi-house-fill"></i> 
                        النظام المحاسبي >
                    </a>
                </li>
                <li class="active">  قيود اليومية</li>
            </ol>
        </section>

        <section class="container-fluid">
            <div class="row">
                <table id="tbx" class="table table-bordered table-sm table-hover" style="width:100%">
                </table>
            </div>
        </section>

    </div><!-- /.content-wrapper -->
}

@section scripts{
    
<script>
    var myId = 0;
    var dataTable;

    $(document).ready(function () {

        function loadData() {
            dataTable = $('#tbx').DataTable({
                "language": {
                    "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                    "search": "بحث"
                },
                "columnDefs": [
                      {
                          "targets": 0,
                          "className": "text-center",
                      },
                ],
                ajax: {
                    url: '/Transactions/LoadDataPosted',
                    dataSrc: ''
                },
                columns: [
                    {
                        "title": "",
                        "data": "transactionId",
                        "orderable": false,
                        "render": function (data) {
                            return '<a class="btn btn-info btnDetails" data-bs-toggle="modal" data-bs-target="#details-modal"><i class="bi bi-info"></i></a>';
                        }
                    },
                    {
                        "title": "# ",
                        "data": "transactionId"
                    },
                    {
                        "title": "البيان",
                        "data": "note"
                    },
                    {
                        "title": "نوع السند",
                        "data": "documentType"
                    },
                    {
                        "title": "العملة",
                        "data": "currency"
                    },
                    {
                        "title": "اجمالي المبلغ",
                        "data": "total"
                    },
                     {
                         "title": "سعر الصرف",
                         "data": "exchangeRate"
                     },
                    {
                        "title": "  التاريخ  ",
                        "data": "transactionDateStr"
                    },
                ]
            });

        }
        loadData();
    });

</script>
}