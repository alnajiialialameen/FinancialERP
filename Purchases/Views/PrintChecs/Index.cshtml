@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section content{

    <style>
        .header-content {
            font-size: 20px;
            color: red;
            padding: 15px;
            background-color: #ff000021;
            text-align: center;
        }

        .print-dueDate {
            position: absolute;
            top: 105px;
            right: 120px;
            font-size: 18px;
            font-weight: bold;
        }

        .print-payNo {
            position: absolute;
            top: 110px;
            left: 110px;
            font-size: 20px;
            font-weight: bold;
            display: none;
        }

        .print-amount {
            position: absolute;
            top: 295px;
            left: 640px;
            font-size: 22px;
            font-weight: bold;
        }

        .print-textAmount {
            position: absolute;
            top: 185px;
            right: 140px;
            font-size: 18px;
            font-weight: bold;
            line-height: 1.7;
        }

        .print-recipient {
            position: absolute;
            top: 140px;
            right: 130px;
            font-size: 20px;
            font-weight: bold;
            line-height: 1.7;
        }

        .print-checkNo {
            position: absolute;
            top: 10px;
            right: 60px;
            font-size: 20px;
            font-weight: bold;
            line-height: 1.7;
        }

        .print-span {
            color: red
        }
    </style>


    <section class="d-flex flex-row justify-content-between align-items-center my-3">
        <h3>
            طباعة الشيكات
        </h3>

        <ol class="breadcrumb">
            <li>
                <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-house-fill"></i>
                    النظام المحاسبي >
                </a>
            </li>
            <li class="breadcrumb-item active">
                طباعة الشيكات
            </li>
        </ol>
    </section>

    <h4 class="TransactionId d-none">@ViewBag.TransactionId</h4>

    <section class="content py-3">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card shadow-sm">

                        <div class="card-header">
                            <div class="header-content d-none" id="header-content">
                                تم استخراج شيك من قبل ... عند الطباعة سيتم التعديل على البيانات السابقة
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="row g-3">

                                <!-- Check Data -->
                                <div class="col-12 col-lg-3">
                                    <div class="card border-info h-100">
                                        <div class="card-body">

                                            <div class="checs-data">

                                                <div class="mb-3">
                                                    <label for="dueDate" class="form-label">التاريخ</label>
                                                    <input type="date"
                                                           class="form-control checs-input dueDate calendar"
                                                           id="dueDate"
                                                           name="dueDate"
                                                           placeholder="تاريخ الشيك"
                                                           autocomplete="off" />
                                                </div>

                                                <div class="mb-3">
                                                    <label for="payNo" class="form-label">رقم الدفع</label>
                                                    <input type="text"
                                                           class="form-control checs-input payNo"
                                                           id="payNo"
                                                           name="payNo"
                                                           value="@ViewBag.TransactionId"
                                                           disabled
                                                           placeholder="رقم الدفع"
                                                           autocomplete="off" />
                                                </div>

                                                <div class="mb-3">
                                                    <label for="amount" class="form-label">المبلغ</label>
                                                    <input type="text"
                                                           class="form-control checs-input amount"
                                                           value="@ViewBag.amount"
                                                           id="amount"
                                                           name="amount"
                                                           placeholder="المبلغ بالأرقام"
                                                           autocomplete="off" />
                                                </div>

                                                <div class="mb-3">
                                                    <label for="checkNo" class="form-label">رقم الشيك</label>
                                                    <input type="text"
                                                           class="form-control checs-input checkNo"
                                                           id="checkNo"
                                                           name="checkNo"
                                                           placeholder="رقم الشيك - المتسلسل"
                                                           autocomplete="off" />
                                                </div>

                                                <div class="mb-3">
                                                    <label for="recipientname" class="form-label">اسم المستلم</label>
                                                    <input type="text"
                                                           class="form-control checs-input recipientname"
                                                           value="@ViewBag.Recipient"
                                                           id="recipientname"
                                                           name="recipientname"
                                                           placeholder="اسم المستلم"
                                                           autocomplete="off" />
                                                </div>

                                                <button type="button"
                                                        class="btn btn-info w-100 mt-3"
                                                        onclick="print()">
                                                    <i class="bi bi-printer me-1"></i>
                                                    طباعة
                                                </button>

                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Check Preview -->
                                <div class="col-12 col-lg-9">
                                    <div class="checs-preview">
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="checs-info position-relative">
                                                    <span class="print-dueDate print-span"></span>
                                                    <span class="print-payNo print-span">@ViewBag.TransactionId</span>
                                                    <span class="print-amount print-span"></span>
                                                    <span class="print-textAmount print-span">@ViewBag.textAmount</span>
                                                    <span class="print-recipient print-span">@ViewBag.Recipient</span>
                                                    <span class="print-checkNo print-span">@ViewBag.CheckNo</span>
                                                </div>

                                                <img src="~/Content/img/checs.jpg"
                                                     class="img-fluid w-100"
                                                     alt="Check Preview" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>
   
}



@section scripts{

    <script>
        var dataTable;

        $(function () {
            //select2listNew("#recipient", "/Shared/getAllRecipient", "اسم المستلم");
            //$('.calendar').datepicker({
            //    todayBtn: "linked",
            //    language: "it",
            //    autoclose: true,
            //    todayHighlight: true,
            //    format: 'dd/mm/yyyy'
            //});

            if($('#IsCheckPrinted').text() == "true") {
                $(".header-content").removeClass("hidden");
            }

            $(".amount").val(@ViewBag.amount);
            $(".print-amount").text(@ViewBag.amount);
            $(".print-payNo").text(@ViewBag.TransactionId);
            $("#checkNo").val(@ViewBag.CheckNo);
            // $(".print-checkNo").text() == "" ||$("#checkNo").text() == undefined? $("#checkNo").prop('disabled', false) : $("#checkNo").prop('disabled', true);

            $.ajax({
                url: "/Home/ConvertToText?amount=" + @ViewBag.amount,
                type: "POST",
                data: JSON.stringify(),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    $('.print-textAmount').html(response);
                    //console.log(response);
                }
            });

            $('.dueDate').on("change", function () {
                $('.print-dueDate').html($(this).val());
            });

            $('.payNo').on("keyup", function () {
                $('.print-payNo').html($(this).val());
            });

            $('.recipientname').on("keyup", function () {
                $('.print-recipient').html($(this).val());
            });

            $('.amount').on("keyup", function () {
                $('.print-amount').html($(this).val());
                $.ajax({
                    url: "/Home/ConvertToText?amount=" + $(this).val(),
                    type: "POST",
                    data: JSON.stringify(),
                    contentType: "application/json charset=utf-8",
                    dataType: "json",
                    error: function (response) {
                        toastr[response.Status](response.Message, response.Title);
                    },
                    success: function (response) {
                        $('.print-textAmount').html(response);
                        //console.log(response);
                    }
                });
            });


            $('.checkNo').on("keyup", function () {
                $('.print-checkNo').html($(this).val());
            });


        });//End Document Ready


        function print() {
            var TransactionId = $('.TransactionId').text();
            // var dueDate = moment($(".dueDate").val(), "DD/MM/YYYY").format("MM/DD/YYYY");
            var dueDate = $(".dueDate").val();
            // var dueDate = $(".dueDate").val();
            if ($('.dueDate').val() == null ||$('.dueDate').val() == '' || $('.payNo').val() == null | $('.amount').val() == null || $('.checkNo').val() == null || $('.recipientname').val() == null) {
                toastr["error"]("يجب ملئ جميع الحقول", "خطأ");
            } else {
                window.location.href = "/PrintChecs/PrintChecs?Id=" + TransactionId + "&duedate=" + dueDate + "&payNo=" + $('.payNo').val() + "&amount="
                    + $('.amount').val() + "&textAmount=" + $('.print-textAmount').text() + "&checkNo=" + $('.checkNo').val() + "&recipient=" + $('.print-recipient').text();

            }
        }

    </script>
}


