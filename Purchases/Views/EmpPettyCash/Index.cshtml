@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section content{
    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">

        <section class="d-flex flex-row justify-content-between align-items-center my-3">
            <h3>عهد الموظفين</h3>

            <ol class="breadcrumb">
                <li>
                    <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                        <i class="bi bi-house-fill"></i>
                        النظام المحاسبي >
                    </a>
                </li>
                <li class="active">عهد الموظفين</li>
            </ol>
        </section>

        <section class="container-fluid">
            <div class="row">
                <div class="col-lg-12">
                    <div class="w-25">
                        <select id="accTreeId" class="form-select">
                            @{
                                foreach(var item in ViewBag.GetPettyCachItems as List<Purchases.Models.ViewModel.DDListObj>)
                                {
                                    <option value="@item.id">@item.text</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <table id="tbx" class="table table-bordered table-hover"></table>
                    </div>
                </div>
            </div>
        </section>
    </div>

}


@section scripts{
    <script>
        var dataTable;
        var totalDeductionAmount;

        $(document).ready(function () {
            function loadData() {
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    "columnDefs": [
                        {
                            "targets": 0,
                            "className": "text-center",
                        },
                    ],
                    ajax: {
                        url: '/EmpPettyCash/LoadData/0',
                        dataSrc: ''
                    },
                    columnDefs: [
                        {
                            targets: [5, 6],
                            className: 'd-none'
                        }
                    ],
                    columns: [
                        {
                            "title": "# ",
                            "data": "EmployeeId"
                        },
                        {
                            "title": "اسم الموظف",
                            "data": "EmployeeName"
                        },
                        {
                            "title": "المبلغ",
                            "data": "TotalDeductionAmount",
                            "render": function (data, type, row) {
                                return `<input type="text" class="form-control totalDeductionAmount" placeholder="اجمالي المبلغ" value="${data}"/>`;
                            }
                        },
                        {
                            "title": "المبلغ المسدد",
                            "data": "PaiedAmount",
                            "render": function (data, type, row) {
                                return `<input type="text" class="form-control paiedAmount" placeholder="اجمالي المبلغ" disabled value="${data}"/>`;
                            }
                        },
                        {
                            "title": "<i class='fa fa-cog'></i>",
                            "data": null,
                            "width": "10%",
                            "orderable": false,
                            "render": function (data) {
                                return '<a href="#" class="btn btn-success  btnSaveData" id="btnSaveData">حفظ</a>';
                            }
                        },
                        {
                            "title": "EmployeeId",
                            "data": "EmployeeId"
                        },
                        {
                            "title": "AccTreeId",
                            "data": "AccTreeId"
                        },
                    ]
                });

            }

            loadData();


            $('#tbx').on('input', '.totalDeductionAmount', function () {
                //console.log('Input value:', $(this).val());
                if (!AutoNumeric.getAutoNumericElement(this)) {
                    CustomAutoNumericForElement(this);
                }
            });

            $('#tbx').on('input', '.paiedAmount', function () {
                //console.log('Input value:', $(this).val());
                if (!AutoNumeric.getAutoNumericElement(this)) {
                    CustomAutoNumericForElement(this);
                }
            });
        });


        $('#tbx').on('click', '.btnSaveData', function () {
            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var Id = data['Id'];
            var employeeId = data['EmployeeId'];

            var accTreeId = $('#accTreeId').val();
            var totalDeductionAmount = currentRow.find('.totalDeductionAmount').val();
            var paiedAmount = currentRow.find('.paiedAmount').val();

            // إزالة فواصل الآلاف لتحويل القيمة لرقم
            totalDeductionAmount = parseFloat(totalDeductionAmount.replace(/,/g, ''));

            var data = {
                "AccTreeId": parseInt(accTreeId),
                "Id": Id,
                "EmployeeId": employeeId,
                "TotalDeductionAmount": totalDeductionAmount,
                "PaiedAmount": paiedAmount,
            }

            $.post('/EmpPettyCash/SaveData', { data: data }, function (response) {
                toastr[response.Status](response.Message, response.Title);
                $('#tbx').DataTable().ajax.reload();
            });
        });

    </script>

}