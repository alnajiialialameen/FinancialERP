@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section content{
    <!-- Content Wrapper. Contains page content -->

        <section class="d-flex flex-row justify-content-between align-items-center my-3">
            <h3>
                بنود الموازنة
            </h3>

            <ol class="breadcrumb">
                <li>
                    <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                        <i class="bi bi-house-fill"></i>
                        النظام المحاسبي >
                    </a>
                </li>
                <li class="breadcrumb-item active">
                    بنود الموازنة
                </li>
            </ol>
        </section>

        <!-- Main Content -->
        <section class="content py-3">
            <div class="container-fluid">

                <div class="row">
                    <div class="col-12">

                        <div class="card">

                            <!-- Card Header -->
                            <div class="card-header d-flex justify-content-between">
                                <button type="button"
                                        id="btnAdd"
                                        class="btn btn-primary btn-add">
                                    <i class="fa fa-plus-square me-1"></i>
                                    بند جديد
                                </button>
                            </div>

                            <!-- Card Body -->
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="tbx"
                                           class="table table-bordered table-hover align-middle w-100">
                                    </table>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

            </div>
        </section>

    </div>


    <div class="example-modal">

        <div class="modal fade" id="add-modal"
             data-bs-backdrop="static"
             tabindex="-1"
             aria-labelledby="addModalLabel"
             aria-hidden="true">

            <div class="modal-dialog  modal-dialog-scrollable modal-xl" style="max-width:90%;">

                <div class="modal-content">

                    <!-- Modal Header -->
                    <div class="d-flex flex-row justify-content-between p-4">
                        <h5 class="modal-title" id="addModalLabel">
                            إضافة جديد
                        </h5>

                        <button type="button"
                                class="btn btn-primary btn-save d-none"
                                onclick="saveData()">
                            حفظ
                        </button>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body">

                        @*<div class="save-btn d-none">
                            <button type="button"
                                    class="btn btn-primary btn-save"
                                    onclick="saveData()">
                                حفظ
                            </button>
                        </div>*@

                        <div class="row row-choise mb-3" dir="rtl">

                            <div class="d-none">
                                <input type="radio"
                                       name="accNameChoise"
                                       class="accNameChoise"
                                       value="-1"
                                       title="" />
                                Default
                            </div>

                            <div class="col-auto choise">
                                <div class="form-check">
                                    <label class="form-check-label"
                                           for="revenueChoice">
                                        الإيرادات
                                    </label>

                                    <input type="radio"
                                           name="accNameChoise"
                                           class="form-check-input accNameChoise"
                                           value="3"
                                           id="revenueChoice" />

                                </div>
                            </div>

                            <div class="col-auto choise">
                                <div class="form-check">
                                    <label class="form-check-label"
                                           for="expenseChoice">
                                        المصروفات
                                    </label>

                                    <input type="radio"
                                           name="accNameChoise"
                                           class="form-check-input accNameChoise"
                                           value="4"
                                           id="expenseChoice" />

                                </div>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-12">

                                <div class="table-responsive">
                                    <table id="tbl"
                                           class="table table-striped table-bordered table-hover align-middle w-100">

                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>اسم البند</th>
                                                <th>الاعتماد</th>
                                            </tr>
                                        </thead>

                                        <tbody class="tbl-body"></tbody>

                                    </table>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="modal fade" id="edit-modal"
         data-bs-backdrop="static"
         tabindex="-1"
         aria-labelledby="editModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <!-- HEADER -->
                <div class="d-flex flex-row justify-content-between p-4">
                    <h5 class="modal-title" id="editModalLabel">
                        تعديل الموازنة
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <!-- BODY -->
                <div class="modal-body">

                    <input type="hidden" id="BalanceId">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label for="accName" class="form-label">
                                اسم البند
                            </label>
                            <input id="accName"
                                   class="form-control"
                                   disabled />
                        </div>

                        <div class="col-md-6">
                            <label for="oldCredient" class="form-label">
                                التصديق قبل التعديل
                            </label>
                            <input id="oldCredient"
                                   class="form-control"
                                   disabled />
                        </div>

                        <div class="col-12">
                            <label for="Credient" class="form-label">
                                المبلغ المصدق
                            </label>
                            <input id="Credient" class="form-control" />
                        </div>

                    </div>

                </div>

                <!-- FOOTER -->
                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        إلغاء
                    </button>

                    <button type="button"
                            class="btn btn-warning"
                            onclick="updateData()">
                        تعديل
                    </button>

                </div>

            </div>
        </div>
    </div>

    <style>
        /* Important part */
        .modal-dialog {
            overflow-y: initial !important;
        }

        .modal-body {
            /*            height: 80vh;*/
            overflow-y: auto;
        }

        .row-choise {
            display: flex;
            justify-content: space-between;
        }
    </style>
}

@section scripts{

    <script>
        var type = 0;
        var credientAmountObj;
        $(function () {
            function loadData() {
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    ajax: {
                        url: '/Balances/LoadData',
                        dataSrc: ''
                    },
                    "columnDefs": [
                        {
                            "targets": 8,
                            "visible": false
                        }
                    ],
                    columns: [
                        {
                            "title": "# ",
                            "data": "Id"
                        },
                        {
                            "title": "العام ",
                            "data": "Year"
                        },
                        {
                            "title": "البــند  ",
                            "data": "Name"
                        },
                        {
                            "title": " الاعتماد ",
                            "data": "Credint",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": "الصرف / الايراد الفعلي  ",
                            "data": "ActualExchange",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": "الانحراف النسبي  ",
                            "data": "RelativeDeviation",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": "نسبة الانحراف  ",
                            "data": "DeviationRatio"
                        },
                        {
                            "title": "<i class='fa fa-cog'></i>",
                            "data": null,
                            "orderable": false,
                            "render": function (data) {
                                //return `<div class="btn-opreation">
                                ////+ '<button class="btn btn-success" onClick="editMe(' + data.Id + ')"><i class=" transfer-fa fa  fa-edit">  </i> تعديل </button>
                                //    <button class="btn btn-success" onClick="editMe('${data.Id},${data.Name},${data.Credint})"><i class=" transfer-fa fa  fa-edit">  </i> تعديل </button>
                                //    </div>`;
                                return `<div class="btn-opreation">
                                                                        <button class="btn btn-success"
                                                                        onClick="editMe(${data.Id}, '${data.Name}', '${data.Credint}')">
                                                                        <i class="transfer-fa fa fa-edit"></i> تعديل </button>
                                                                    </div>`;
                            }
                        },
                        {
                            "title": "rootParentId",
                            "data": "rootParentId",
                        }
                    ]
                });
            }
            loadData();


            $('.accNameChoise').on('change', function () {
                addNew();
                $('.btn-save').removeClass('d-none');
            });

            credientAmountObj = CustomAutoNumeric('#Credient');

            select2list(".AccountTreeId", "/Balances/GetAccountTree", "الفصول");
            select2list(".FinanceCycleId", "/Balances/GetFinanceCycle", "العــــام");
            select2list(".EdAccountTreeId", "/Balances/GetAccountTree", "الفصول");
            select2list(".EdFinanceCycleId", "/Balances/GetFinanceCycle", "العــــام");
            select2list(".EdAccountTreeIdLevelOne", "/Balances/GetAccountTreeLevelOne", "البنـــود");
            select2list(".AccountTreeIdLastLevel", "/Balances/GetAccountTreeLastLevel", "القيود");
        });

        $('#btnAdd').click(function () {
            $('.tbl-body').empty();
            $('#add-modal').modal('show');
            type = 0;
        });

        function saveDataOld() {
            var obj = [];

            type = $('input[name="accNameChoise"]:checked').val();
            debugger;
            console.clear();
            console.log("Selected type:", type);
            if (type != "3") {
                $('.tbl-body tr').each(function () {
                    accId = $(this).find('.accId').text();
                    //credint = $(this).find('.credint').text();
                    credint = $(this).find('.credint').text().replace(/,/g, '');
                    BalanceId = $(this).find('.BalanceId').text();

                    obj.push({
                        "AccountTreeId": accId,
                        "Credint": credint,
                        "ActualExchange": "0",
                        "RelativeDeviation": "0",
                        "DeviationRatio": "0",
                        "Retainer": "0",
                        "IsActive": 1,
                        "Id": BalanceId
                    });
                });
            }
            else {
                $('.tbl-body tr').each(function () {
                    //accId = $(this).find('.mainAccId').text();
                    accId = $(this).data('accid'); // الحل الصحيح
                    //credint = $(this).find('.mainCredint').text();
                    credint = $(this).find('.mainCredint').text().replace(/,/g, '');
                    BalanceId = $(this).find('.mainBalanceId').text();

                    obj.push({
                        "AccountTreeId": accId,
                        "Credint": credint,
                        "ActualExchange": "0",
                        "RelativeDeviation": "0",
                        "DeviationRatio": "0",
                        "Retainer": "0",
                        "IsActive": 1,
                        "Id": BalanceId
                    });
                });
            }

            console.clear();
            console.log(obj);

            $.ajax({
                url: "/Balances/CreateOUpdate",
                type: "POST",
                data: JSON.stringify(obj),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    console.log(response);
                    toastr[response.Status](response.Message, response.Title);
                    //$('.Name').val(null);
                    $('#add-modal').modal('hide');
                    dataTable.ajax.reload();
                    $('input[name="accNameChoise"][value="-1"]').prop('checked', true);
                }
            });

        }

        function updateData() {
            var Id = $('#BalanceId').text();
            //var Credint = $('#Credient').val().replace(/,/g, '');


            var Credint = credientAmountObj.getNumber();

            console.clear();
            console.log(Id);

            $.ajax({
                url: `/Balances/Update/${Id}?Credint=${Credint}`,
                type: "POST",
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    console.log(response);
                    toastr[response.Status](response.Message, response.Title);
                    //$('.Name').val(null);
                    $('#edit-modal').modal('hide');
                    dataTable.ajax.reload();
                }
            });

        }

        //open edit modal
        function editMe111(Id) {
            type = Id;
            console.clear();
            console.log(type);
            $('.editTbl-body').empty();

            $.ajax({
                url: "/Balances/getSubaccountForAddUpdate?type=" + type,
                type: "GET",
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (result) {
                    if (result) {
                        var x;
                        var html = "";
                        var accParentName = "";
                        $.each(result, function (key, item) {
                            accParentName = item.AccParentName;
                            html += "<tr id='row' style='font-size: 16px;text-align:center;'>"
                                + "<td class='accId'>" + item.Id + "</td>"
                                + "<td class='name'>" + item.Name + "</td>"
                                + "<td class='credint' contenteditable='true' style='background-color:#0c5969; color: white'>" + item.Credint + "</td>"
                                + "<td class='actualExchange'>" + formatNumber(item.ActualExchange) + "</td>"
                                + "<td class='BalanceId hidden'>" + item.BalanceId + "</td>"
                                + "</tr>";
                        });

                        $('.accParentName').text(accParentName);
                        $('.editTbl-body').empty();
                        $('.editTbl-body').append(html);
                        $('#edit-modal').modal('show');
                    }
                }
            });
        }

        //open edit modal
        function editMe(Id, accName, oldCredient) {
            $('.editTbl-body').empty();

            $('#BalanceId').text(Id);
            $('#accName').val(accName);
            var oldCredient1 = formatNumber(oldCredient.toString());
            console.log(oldCredient1);
            $('#oldCredient').val(oldCredient1);


            $('.editTbl-body').empty();
            //$('.editTbl-body').append(html);
            $('#edit-modal').modal('show');
        }

        function formatInput(el)
        {
            let value = el.value.replace(/,/g, '').replace(/\D/g, '');

            if (value === '') {
                el.innerText = '';
                return;
            }

            let formatted = formatNumber(value.toString());
            el.innerText = formatted;

            // وضع المؤشر في نهاية النص
            let range = document.createRange();
            let sel = window.getSelection();
            range.selectNodeContents(el);
            range.collapse(false);
            sel.removeAllRanges();
            sel.addRange(range);
        }

        function formatCell(el) {
            let value = el.innerText.replace(/,/g, '').replace(/\D/g, '');

            if (value === '') {
                el.innerText = '';
                return;
            }

            let formatted = formatNumber(value.toString());
            el.innerText = formatted;

            // وضع المؤشر في نهاية النص
            let range = document.createRange();
            let sel = window.getSelection();
            range.selectNodeContents(el);
            range.collapse(false);
            sel.removeAllRanges();
            sel.addRange(range);
        }

     function addNew() {

        var type = $('input[name="accNameChoise"]:checked').val();

        $.ajax({
            url: "/Balances/GetAccountTree?type=" + type,
            type: "GET",
            dataType: "json",
            error: function (response) {
                console.log(response);
            },
            success: function (result) {
                var tbody = $('.tbl-body');
                tbody.empty();

                $.each(result, function (index, item) {
                    var hasChildren = item.Details && item.Details.length > 0;
                    var amount = getAccountTotal(item);
                    var tr = $(`
                        <tr style="font-size:16px;text-align:center;"
                            data-accid="${item.Id}">
                            <td class="mainAccId">
                                ${hasChildren
                                    ? `<button type="button" class="btn btn-info btnDetails">
                                           <i class="bi bi-arrow-down"></i>
                                       </button>`
                                    : item.Id
                                }
                            </td>
                            <td>${item.Name}</td>
                            <td class="mainCredint bg-pimary"
                                ${hasChildren ? '' : "contenteditable='true' oninput='formatCell(this)'"}>${formatNumber(amount.toString())}</td>
                            <td class="d-none mainBalanceId">${item.BalanceId}</td>
                        </tr>
                    `);

                    // تخزين تفاصيل الحساب
                    tr.data('details', item.Details);
                    tr.attr('data-accid', item.Id);
                    tbody.append(tr);
                });
            }
        });
    }

    function buildAccountRows(details) {
        var tbody = $('<tbody></tbody>');

        $.each(details, function (index, item) {
            var hasChildren = item.Details && item.Details.length > 0;
            var amount = getAccountTotal(item);

            var tr = $('<tr style="font-size:16px;text-align:center;"></tr>');
            tr.append(`
                <td class="accId">
                    ${hasChildren
                        ? `<button type="button" class="btn btn-info btnDetails">
                               <i class="bi bi-arrow-down"></i>
                           </button>`
                        : item.Id
                    }
                </td>
                <td>${item.Name}</td>
                <td class="credint bg-info"
                    ${hasChildren ? '' : "contenteditable='true' oninput='formatCell(this)'"}>${formatNumber(amount.toString())}</td>
                <td class="d-none BalanceId">${item.BalanceId}</td>
            `);

            tr.data('details', item.Details);
            tbody.append(tr);
        });

        return tbody;
     }

     function getAccountTotal(item) {
        if (item.Details && item.Details.length > 0) {
            return item.Details.reduce(function (sum, child) {
                return sum + getAccountTotal(child);
            }, 0);
        }

        return Number(item.Credint) || 0;
    }

    function ShowDetails(tr, details) {
        tr = $(tr);

        // إغلاق التفاصيل المفتوحة
        if (tr.next().hasClass('subTableRow')) {
            tr.next().remove();
            return;
        }

        if (!details || details.length === 0)
            return;

        var table = $(`
            <table class="table table-bordered" style="margin:0">
                <thead>
                    <tr style="background:#f5f5f5">
                        <th>#</th>
                        <th>إسم الحساب</th>
                        <th>الاعتماد</th>
                        <th class="d-none">BalanceId</th>
                    </tr>
                </thead>
            </table>
        `);

        table.append(buildAccountRows(details));

        var subTableRow = $('<tr class="subTableRow"></tr>');

        subTableRow.append(
            $('<td colspan="4"></td>').append(table)
        );

        tr.after(subTableRow);
    }

    $(document).on('click', '.btnDetails', function (e) {
        e.preventDefault();
        e.stopPropagation();
        console.clear();
        console.log("Details button clicked");

        var tr = $(this).closest('tr');

        ShowDetails(tr, tr.data('details'));
    });

    function saveData() {
        var obj = [];

        type = $('input[name="accNameChoise"]:checked').val();

        // كل الحسابات النهائية القابلة للتعديل
        $('.tbl-body .credint, .tbl-body .mainCredint').each(function () {
            var amountElement = $(this);
            // نتأكد إن المبلغ قابل للتعديل
            if (amountElement.attr('contenteditable') !== 'true')
                return;

            var tr = amountElement.closest('tr');

            var accId = tr.data('accId');

            if (!accId) {
                accId = tr.find('.accId').text();
            }

            var balanceId = tr.find('.BalanceId, .mainBalanceId').text().trim();

            var credint = amountElement.text().replace(/,/g, '').trim();

            obj.push({
                Id: balanceId || 0,
                AccountTreeId: parseInt(accId),
                Credint: parseFloat(credint) || 0,
                ActualExchange: 0,
                RelativeDeviation: 0,
                DeviationRatio: 0,
                Retainer: 0,
                IsActive: 1
            });
        });

        console.log("Data to save:", obj);

        // AJAX
        $.ajax({
            url: "/Balances/CreateOUpdate",
            type: "POST",
            data: JSON.stringify(obj),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            error: function (response) {
                console.log(response);
            },
            success: function (response) {
                console.log(response);

                toastr[response.Status](response.Message, response.Title);
                var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('add-modal'));

                modal.hide();

                dataTable.ajax.reload();

                $('input[name="accNameChoise"][value="-1"]').prop('checked', true);
            }
        });
    }
    </script>
}