@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section content{
    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">

        <section class="d-flex flex-row justify-content-between align-items-center my-3">
            <h3>حسابات الموظفين والعملاء</h3>

            <ol class="breadcrumb">
                <li>
                    <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                        <i class="bi bi-house-fill"></i>
                        النظام المحاسبي >
                    </a>
                </li>
                <li class="active">حسابات الموظفين والعملاء</li>
            </ol>
        </section>

        <section class="container-fluid">
            <div class="row">
                <div class="col-lg-12">

                    <button type="button"
                            class="btn btn-primary float-start mb-3"
                            data-bs-toggle="modal"
                            data-bs-target="#add-modal">
                        <i class="bi bi-plus-lg"></i>
                        إضافة
                    </button>

                    <div>
                        <table id="tbx" class="table table-bordered table-hover"></table>
                    </div>
                </div>
            </div>
        </section>
    </div>


    <div class="example-modal">
        <div class="modal fade" id="add-modal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 60%;">
                <div class="modal-content">

                    <div class="modal-header border-0">
                        <h5 class="modal-title">إضافة</h5>
                        <h4 id="Id" class="d-none Id">Id</h4>

                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <form id="add-form">
                            <div class="row">
                                <div class="col-lg-6 mb-3">
                                    <label for="RecipientName" class="form-label">اسم العميل أو الموظف</label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-person"></i>
                                        </span>
                                        <input type="text" class="form-control RecipientName"
                                               id="RecipientName" name="RecipientName"
                                               placeholder="اسم الموظف" autocomplete="off">
                                    </div>
                                </div>

                                <div class="col-lg-6 mb-3">
                                    <label for="BankName" class="form-label">البنك</label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-house"></i>
                                        </span>
                                        <select class="form-select list BankName"
                                                name="BankName" id="BankName" style="width:100%">
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-6 mb-3">
                                    <label for="BranchName" class="form-label">الفرع</label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-building"></i>
                                        </span>
                                        <select class="form-select list BranchName"
                                                name="BranchName" id="BranchName" style="width:100%">
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-6 mb-3">
                                    <label for="AccountNumber" class="form-label">رقم الحساب</label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-credit-card"></i>
                                        </span>
                                        <input type="number" class="form-control AccountNumber"
                                               id="AccountNumber" name="AccountNumber"
                                               placeholder="رقم الحساب" autocomplete="off">
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-success btnCreate float-start">
                                        حفظ
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>


}

@section scripts{
    <script>

        $(document).ready(function () {
            loadData();

            select2listNew("#BankName", "/Recipients/GetBanks", "اسم البنك", "#add-modal");
            select2listNew("#BranchName", "/Recipients/GetBranches", "اسم الفرع", "#add-modal");
        });

        function loadData() {
            dataTable = $('#tbx').DataTable({
                "language": {
                    "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                    "search": "بحث"
                },
                "columnDefs": [
                    {
                        "targets": 0,
                        "className": "text-center",
                    },
                ],
                ajax: {
                    url: '/Recipients/LoadData',
                    dataSrc: ''
                },
                columns: [
                    {
                        "title": "# ",
                        "data": "Id"
                    },
                    {
                        "title": "الاسم",
                        "data": "RecipientName"
                    },
                    {
                        "title": "رقم الحساب",
                        "data": "AccountNumber"
                    },
                    {
                        "title": "اسم البنك",
                        "data": "BankName"
                    },
                    {
                        "title": "اسم الفرع",
                        "data": "BranchName"
                    },
                    {
                        "title": "<i class='fa fa-cog'></i>",
                        "data": null,
                        "width": "10%",
                        "orderable": false,
                        "render": function (data) {
                            return `
                                                 <div class="dropdown">
                                                     <button type="button"
                                                             class="btn btn-link text-dark p-0 border-0"
                                                             data-bs-toggle="dropdown"
                                                             aria-expanded="false">
                                                         <i class="bi bi-three-dots-vertical fs-4"></i>
                                                     </button>

                                                     <ul class="dropdown-menu dropdown-menu-end">
                                                         <li>
                                                              <a href="#" class="dropdown-item btnUpdate">تعديل</a><br />
                                                         </li>
                                                         <li>
                                                                <a href="#" class="dropdown-item btnDelete">حذف</a><br />
                                                         </li>

                                                    </ul>
                                                </div>
                                                `;
                        }
                    },
                ]
            });

        }

        function save() {
            var RecipientName = $("#RecipientName").val();
            var AccountNumber = $("#AccountNumber").val();
            var BankName = $("#BankName").val();
            var BranchName = $("#BranchName").val();
            var Id = $("#Id").text();

            var usl = '';
            var btnCreateText = $(".btnCreate").text();
            url = btnCreateText == "تعديل" ? "/Recipients/Update" : "/Recipients/Create";
            console.log(BranchName);
            console.log(BankName);
            console.log(AccountNumber);
            console.log(RecipientName);
            debugger;

            if (RecipientName != "" && AccountNumber != "" && BankName != "" && BranchName != "") {
                $.post(url,
                    {
                        Id: "0", RecipientName: RecipientName, AccountNumber: AccountNumber,
                        BankName: BankName, BranchName: BranchName, Id: Id
                    },
                    function (response) {
                        toastr[response.Status](response.Message, response.Title);
                        $('#tbx').DataTable().ajax.reload();
                        $('#add-modal').modal('hide');
                        // $('#add-form').reset();
                    }
                );
            } else {
                toastr['error']("يجب التاكد من صحة البيانات", "خطأ");
            }
        }

        $('#tbx').on('click', '.btnUpdate', function () {
            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var Id = data['Id'];
            var RecipientName = data['RecipientName'];
            var AccountNumber = data['AccountNumber'];
            var BankName = data['BankName'];
            var BranchName = data['BranchName'];

            $("#Id").text(Id);
            $("#BranchName").val(BranchName);
            $("#RecipientName").val(RecipientName);
            $("#AccountNumber").val(AccountNumber);
            $("#BankName").val(BankName);


            // أنشئ خيار جديد واضفه
            var option = new Option(BankName, BankName, true, true);
            $('#BankName').append(option).trigger('change');

            // أنشئ خيار جديد واضفه
            var option = new Option(BranchName, BranchName, true, true);
            $('#BranchName').append(option).trigger('change');



            $(".modal-title").text("تعديل");
            $(".btnCreate").text("تعديل");
            $(".btnCreate").removeClass("btn-success");
            $(".btnCreate").addClass("btn-warning");

            $('#add-modal').modal('show');
        });

        $('#tbx').on('click', '.btnDelete', function () {
            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var Id = data['Id'];

            console.clear();
            console.log(Id);

            $.post("/Recipients/Delete", { Id: Id },
                function (response) {
                    toastr[response.Status](response.Message, response.Title);
                    $('#tbx').DataTable().ajax.reload();
                }
            )
        });

        document.addEventListener('DOMContentLoaded', function () {

            const form = document.getElementById('add-form');

            form.addEventListener('submit', function (event) {

                event.preventDefault();
                event.stopPropagation();

                form.classList.add('was-validated');

                if (!form.checkValidity()) {
                    return;
                }

                save();

            });

        });

    </script>

}