                            </div>
                        </div><!-- /.row (main row) -->

                    </div>
                    @*<div class="modal-footer">

                        </div>*@
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>






<div class="modal fade in" id="CircuModal" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" style="width:50% !important">
        <div class="modal-content">
            <div class="modal-header .no-border">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title"> تسجيل الطلبيات في السيرك</h4>
                <label class="hidden" id="Id"></label>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12">
                        <form method="post" id="add-form">
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="DepartmentRecipientName"> اسم الادارة المرسلة </label>
                                        <input class="form-control" id="DepartmentRecipientName" onkeyup="return validateText(this.value, 'DepartmentRecipientName');" name="DepartmentRecipientName" placeholder="اسم الادارة المستلمة" />
                                        <label id="DepartmentSenderId" class="hidden">DepartmentSenderId</label>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="name">الايميل</label>
                                        <input class="form-control" id="DepartmentSenderName" onkeyup="return validateText(this.value, 'DepartmentSenderName');" name="DepartmentSenderName" placeholder="اسم الادارة المرسلة" />
                                        <label id="DepartmentRecipientId" class="hidden">DepartmentRecipientId</label>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="name">الموضوع</label>
                                        <input class="form-control" type="text" disabled id="Subject" name="Subject" placeholder="الموضوع" />
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="name"> رقم الهاتف - 2 </label>
                                        <input class="form-control" type="number" id="Phone2" onkeyup="return validatePhone(this.value, 'Phone2');" name="Phone2" placeholder="رقم الهاتف - 2" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label for="name"> العنوان </label>
                                        <textarea class="form-control" id="Address" name="Address" placeholder="العنوان" cols="4"></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-3">
                                    <input type="checkbox" id="status" value="1" />
                                    <label>مفعلة</label>
                                </div>
                                <div class="col-6">
                                    <input type="text" id="LicenseNumber" class="form-control" onkeyup="return validateText(this.value, 'LicenseNumber');" placeholder="رقم الرخصة التجارية" />

                                </div>
                            </div>
                        </form>
                    </div>
                </div><!-- /.row (main row) -->

            </div>
            <div class="modal-footer">
                <button class="btn btn-primary btnSave pull-right" onclick="SaveAndUpdate()">حفظ</button>
                <button class="btn btn-danger btnCancel" data-dismiss="modal">إلغاء</button>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div>
<!-- /.modal -->
}

@section scripts{

    <script>
        function loadData(url) {
            var dataTable = $('#tbx').DataTable({
                "language": {
                    "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                    "search": "بحث"
                },
                ajax: {
                    url: url,
                    dataSrc: ''
                },
                columns: [
                    {
                        "title": "# ",
                        "data": "Id"
                    },
                    {
                        "title": " الادارة   ",
                        "data": "Department"
                    },
                    {
                        "title": " الموضوع ",
                        "data": "Description"
                    },
                    {
                        "title": " تاريخ الطلب ",
                        "data": "OrderDate",
                    },
                    {
                        "title": "<i class='fa fa-cog'></i>",
                        "data": null,
                        "width": "10%",
                        "orderable": false,
                        "render": function (data) {
                            return '<div class="btn-group">' +
                                        '<button type="button" class="btn btn-default" data-toggle="dropdown">  <i class="fa fa-ellipsis-v"></i> </button> <div class="dropdown-menu btn-threePoint">' +
                                        '<a class="dropdown-item" href="#" onclick="registerToCircus(' + data.Id + ')">التسجيل في السيرك</a> <br />' +
                                        //'<a class="dropdown-item" href="#" onclick="viewOrderImage(' + data.Id + ')">عرض صورة الطلب</a> <br />' +
                                  '</div></div>'

                        },
                    }
                ]
            });
        }
    $(function () {
        $('.calendar').datepicker({
            todayBtn: "linked",
            language: "it",
            autoclose: true,
            todayHighlight: true,
            dateFormat: 'dd/mm/yy'
        });

        
        loadData('/ACUCircus/Orders');

        $('.passenger-tbl').on('click', '.btn-remove', function () {
            $(this).closest('tr').remove();

        })
    });

    //Open Edit Modal
    $("#tbx").on('click', '.openEditModal', function () {
        // get the current row
        var currentRow = $(this).closest("tr");

        $('#ed-id').val(currentRow.find("td:eq(0)").text());
        $('#edname').val(currentRow.find("td:eq(1)").text()); // get current row st 2TD value
        $('#edphone').val(currentRow.find("td:eq(2)").text()); // get current row st 2TD value
        $('#edit-modal').modal('show');

    });


    $('.btnChange').on('click', function () {
        console.clear();
        loadData('/ACUCircus/LoadCircuedData');

    });

    function registerToCircus(Id) {
        window.open('Create?id=' + Id, target = "_blank");
    }

    //Validation And Save Edit Data
    $('#edit-form').bootstrapValidator({
        onSuccess: function (e) {
            edit();
            e.preventDefault();

        },
        submitButtons: 'button[type="submit"]',
        feedbackIcons: {
            valid: 'glyphicon glyphicon-ok success-feedback-icons',
            invalid: 'glyphicon glyphicon-remove error-feedback-icons',
            validating: 'fa fa-refresh fa-spin success-feedback-icons'
        },
        fields: {
            edname: {
                validators: {
                    notEmpty: {
                        message: 'يجب الا يكون حقل اسم المورد  فارغ'
                    }
                }
            },
            edphone: {
                validators: {
                    notEmpty: {
                        message: 'يجب الا يكون حقل رقم الهاتف   فارغ'
                    }
                }
            }

        }
    });
    </script>
}
