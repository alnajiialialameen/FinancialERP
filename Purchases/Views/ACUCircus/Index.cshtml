                                                    </thead>
                                                    <tbody class="invoicechoosed-tbl-body" id="invoicechoosed-tbl-body"></tbody>

                                                </table>
                                            </div>


                                            <div class="col-lg-12 ">
                                                <div class="pull-left">
                                                    <button type="button" class="btn btn-default " data-dismiss="modal">رجوع</button>
                                                    <button type="submit" class="btn btn-primary save " value="add">حفظ</button>
                                                </div>
                                            </div>

                                        </div><!-- /.box-body -->

                                    </div>

