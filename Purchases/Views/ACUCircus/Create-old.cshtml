@using Purchases.Models;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout2.cshtml";
    Entities db = new Entities();
}

@section content{

<div class="content-wrapper">
    <div class="grad"></div>
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>
            التسجيل في السيرك
        </h1>
        <ol class="breadcrumb">
            <li><a href="#"><i class="fa fa-home"></i> النظام المالي </a></li>
            <li class="active"> التسجيل في السيرك</li>
        </ol>

    </section>

    <label id="CommitteeFormationId" class="hidden">@ViewBag.ACUCommitteFormationId</label>
    <label id="OrderId" class="hidden">@ViewBag.OrderId</label>
    <label id="EmployeeId" class="hidden">EmployeeId</label>
    
    <section class="content">
        <div class="row">
            <div class="col-lg-9">
                <div class="box box-primary" style="padding:16px;">
                    <br />
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label for="DepartmentSenderName"> اسم الادارة المرسلة </label>
                                <label class="form-control  disabled" id="DepartmentSenderName" name="DepartmentSenderName">@ViewBag.DepartmentSenderName</label>
                                <label class="hidden" id="DepartmentSenderId">@ViewBag.DepartmentSenderId</label>
                            </div>
                        </div>

                        

                        <div class="col-lg-6">
                            <div class="form-group">
                                <label for="DepartmentRecipientName"> اسم الادارة المستلمة </label>
                                <label class="form-control  disabled" id="DepartmentRecipientName" name="DepartmentRecipientName">@ViewBag.DepartmentRecipientName</label>
                                <label class="hidden" id="DepartmentRecipientId">@ViewBag.DepartmentRecipientId</label>
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label for="Subject"> الموضوع </label>
                                <label class="form-control  disabled" id="Subject" name="Subject">@ViewBag.Subject</label>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="form-group">
                                <label for="OrderDate"> تاريخ الطلب </label>
                                <label class="form-control  disabled" id="OrderDate" name="OrderDate">@ViewBag.OrderDate</label>
                            </div>
                        </div>

                        
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label for="FNo">رقم الملف</label>
                                <input type="text" class="form-control" id="FNo" name="FNo" placeholder="رقم الملف"/>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="form-group">
                                <label for="CircusDate"> تاريخ السيرك </label>
                                <label class="form-control  disabled" id="CircusDate" name="CircusDate">@ViewBag.CircusDate</label>
                            </div>
                        </div>
                    </div>
                     <br />
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label for="ReceiverEmployeeName"> اسم الموظف المستلم (من اسم المستخدم)</label>
                                <label class="form-control  disabled" id="ReceiverEmployeeName" name="ReceiverEmployeeName">@ViewBag.ReceiverEmployeeName</label>
                                <label class="hidden" id="ReceiverId">@ViewBag.ReceiverId</label>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="form-group">
                                <label for="Signatur"> التوقيع </label>
                                <label class="form-control  disabled" id="Signatur" name="Signatur">@ViewBag.Signatur</label>
                            </div>
                        </div>
                    </div>
                    <br />
                    <button type="button" class="btn btn-success btn-block" onclick="RegisterToCircu()"><b>تسجيل في السيرك</b></button>
                    <br />

                </div>
            </div>

            <div class="col-lg-3">

                <!-- Profile Image -->
                <div class="box box-primary">
                    <div class="box-body box-profile">
                        @*<img class="profile-user-img img-responsive img-circle" src="../../dist/img/user4-128x128.jpg" alt="User profile picture">*@
                        <h4>عن العطاء</h4>

                        <h3 class="profile-username text-center" id="OrderDescription">@ViewBag.Subject</h3>

                        <p class="text-muted text-center" id="DepartmentName">@ViewBag.DepartmentSenderName</p>

                        <ul class="list-group list-group-unbordered">
                            <li class="list-group-item">
                                <b>تاريخ الطلب</b> <span class="pull-left" id="OrderDate">@ViewBag.OrderDate</span>
                            </li>
                            <li class="list-group-item">
                                <b>نوع الطلب</b> <span class="pull-left">مناقصة</span>
                            </li>
                            <li class="list-group-item">
                                <b>الحالة الحالية</b> <span class="pull-left">مصدق</span>
                            </li>
                            @*<li class="list-group-item">
                                <b>تاريخ أمر التشكيل</b> <span class="pull-left" id="ResolutionDate">@ViewBag.ResolutionDate</span>
                            </li>*@
                        </ul>

                        <a href="~/ACUCommitteFormations/Index/@ViewBag.OrderId" class="btn btn-primary btn-block"><b>انتقل للطلب</b></a>
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>

        <!-- /.col -->
        </div>
        <!-- /.row -->
    </section>
    </div>

    <div class="modal fade in" id="myModal"  data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog" style="width:50% !important">
            <div class="modal-content">
                <div class="modal-header .no-border">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title"> إضافة عضو جديد</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <form method="post" id="add-form">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label for="name"> اسم العضو </label>
                                            <label class="form-control  disabled" id="MemberName" name="MemberName">هشام سليمان محمد</label>
                                        </div>
                                    </div>

                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label for="name">الوظيفة في اللجنة</label>                                            
                                                <select id="CommitteeJobId" class="form-control">
                                                    <option value="-1">-إختار الوظيفة-</option>
                                                    @{
                                                        foreach (var item in db.CommitteeJobs.ToList())
                                                        {
                                                            <option value="@item.Id">
                                                                @item.Name
                                                            </option>
                                                        }
                                                    }
                                                </select>                                            
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div><!-- /.row (main row) -->
                    
                </div>

            <div class="modal-footer">
                <div class="row">
                    <button type="submit" class="btn btn-primary save" style="float:right" onclick="AddMember()">حفظ</button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal" aria-label="close" >إلغاء</button>
                </div>
            </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>
    <!-- /.modal -->


}

@section scripts{

    <script>
        ///var dataTable = $("#tbx").DataTable();
   

        var obj = [];
        $("#tbx").on('click', '.transfer', function () {
            var currentRow = $(this).closest("tr");

            var EmployeeId = currentRow.find("td:eq(0)").text();
            var MemberName = currentRow.find("td:eq(1)").text();
            console.clear();
            console.log(EmployeeId);
            $('#EmployeeId').text(EmployeeId);
            $('#MemberName').text(MemberName);
            
            $('#myModal').modal('show');
        });

        function AddMember() {
            var EmployeeId = $('#EmployeeId').text();
            var CommitteFormationId = $('#CommitteeFormationId').text();
            var OrderId = $('#OrderId').text();
            var CommitteeJobId = $('#CommitteeJobId').val();

            obj = {
                "EmployeeId": EmployeeId,
                "CommitteeJobId": CommitteeJobId,
                "CommitteFormationId": CommitteFormationId,
                "OrderId": OrderId,
            };

            console.clear();
            console.log(obj);
            
            $.ajax({
                "type": "POST",
                "url": '/ACUCommitteFormations/AddMember',
                "dataType": "json",
                "traditional": true,
                "data": JSON.stringify(obj),
                "contentType": "application/json  charset=utf-8",
                "error": function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                "success": function (response) {
                    toastr[response.Status](response.Message, response.Title);
                    dataTable.ajax.reload();
                    $('#myModal').modal('toggle');
                }
            });

        }


        function RegisterToCircu() {
            var OrderId = $('#OrderId').text();
            var CircusDate = $('#CircusDate').text();
            var Subject = $('#Subject').text();
            var DepartmentSenderId = $('#DepartmentSenderId').text();
            var DepartmentRecipientId = $('#DepartmentRecipientId').text();
            var DepartmentSenderName = $('#DepartmentSenderName').text();
            var DepartmentRecipientName = $('#DepartmentRecipientName').text();
            var ReceiverId = $('#ReceiverId').text();
            var ReceiverEmployeeName = $('#ReceiverEmployeeName').text();
            var Signatur = $('#Signatur').text();
            var FNo = $('#FNo').val();

            var circu = {
                "OrderId": OrderId,
                "CircusDate": CircusDate,
                "Subject": Subject,
                "DepartmentSenderId": DepartmentSenderId,
                "DepartmentRecipientId": DepartmentRecipientId,
                "DepartmentSenderName": DepartmentSenderName,
                "DepartmentRecipientName": DepartmentRecipientName,
                "ReceiverId": ReceiverId,
                "ReceiverEmployeeName": ReceiverEmployeeName,
                "Signatur": Signatur,
                "FNo": FNo,
            };


            console.clear();
            console.log(circu);

            $.ajax({
                "type": "POST",
                "url": '/ACUCircus/Create',
                "dataType": "json",
                "traditional": true,
                "data": JSON.stringify(circu),
                "contentType": "application/json  charset=utf-8",
                "error": function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                "success": function (response) {
                    toastr[response.Status](response.Message, response.Title);
                }
            });

        }
    </script>
}