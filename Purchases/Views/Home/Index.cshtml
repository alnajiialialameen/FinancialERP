
@{
    //ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

@section content{
    <style>
    
    </style>
    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <div class="grad"></div>

        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>
                اللوحة الرئيسية
            </h1>
            <ol class="breadcrumb">
                <li><a href="#"><i class="fa fa-home"></i> اللوحة الرئيسية  </a></li>
                <li class="active">DashBoard </li>
            </ol>

        </section>


        <section class="content">
            <!-- Info boxes -->
            <div class="row">
                <div class="col-lg-12">

                    <div class=" col-md-3 col-sm-6 col-xs-12  ">
                        <div class="info-box">
                            <span class="info-box-icon bg-red"><i class="fa fa-chart-bar"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">  اكثر الاصناف طلبا</span>
                                <span class="info-box-number"> @ViewBag.RushItem  /  @ViewBag.RushItemCount</span>
                            </div><!-- /.info-box-content -->
                        </div><!-- /.info-box -->
                    </div><!-- /.col -->
            
                    <div class=" col-md-3 col-sm-6 col-xs-12  ">
                        <div class="info-box">
                            <span class="info-box-icon bg-green"><i class="fa fa-chart-line"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text"> الاكثر طلبا في الشهر الحالي  </span>
                                <span class="info-box-number"> @ViewBag.RushItemThisMonth  /  @ViewBag.RushItemCountThisMonth</span>
                            </div><!-- /.info-box-content -->
                        </div><!-- /.info-box -->
                    </div>


                    <div class=" col-md-3 col-sm-6 col-xs-12  ">
                        <div class="info-box">
                            <span class="info-box-icon bg-aqua"><i class="fa fa-building"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">  الادارة الاكثر طلبا </span>
                                <span class="info-box-number"> @ViewBag.RushDepartment  /  @ViewBag.RushDepartmentCount</span>
                            </div><!-- /.info-box-content -->
                        </div><!-- /.info-box -->
                    </div>
                    <div class=" col-md-3 col-sm-6 col-xs-12  ">
                        <div class="info-box">
                            <span class="info-box-icon bg-yellow"><i class="fa fa-building"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">  الاكثر طلبا في الشهر الحالي   </span>
                                <span class="info-box-number"> @ViewBag.RushDepartmentThisMonth  /  @ViewBag.RushDepartmentCountThisMonth</span>
                            </div><!-- /.info-box-content -->
                        </div><!-- /.info-box -->
                    </div>




                    



                </div>

                
                    



                </div>
            </div><!-- /.row -->
          

        </section>


    </div><!-- /.content-wrapper -->









}





@section scripts{
    <script src="~/Scripts/Chart.min.js"></script>
    @*<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.3.0/chart.min.js"></script>*@

    

}
