@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

@section content{
    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>اللوحة الرئيسية</h1>
            <ol class="breadcrumb">
                <li><a href="#"><i class="fa fa-home"></i> اللوحة الرئيسية  </a></li>
                <li class="active">DashBoard </li>
            </ol>

        </section>


        @*<section class="content1">*@
            <!-- Info boxes -->
            <div class="row" style="margin:5px;">
                    <div class=" col-md-3 col-sm-6 col-xs-12  ">
                        <div class="info-box">
                            <span class="info-box-icon bg-red"><i class="fa fa-chart-bar"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">  اكثر الاصناف طلبا</span>
                                <span class="info-box-number"> @ViewBag.RushItem  /  @ViewBag.RushItemCount</span>
                            </div><!-- /.info-box-content -->
                        </div><!-- /.info-box -->
                    </div><!-- /.col -->
            
                    <div class=" col-md-3 col-sm-6 col-xs-12  ">
                        <div class="info-box">
                            <span class="info-box-icon bg-green"><i class="fa fa-chart-line"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text"> الاكثر طلبا في الشهر الحالي  </span>
                                <span class="info-box-number"> @ViewBag.RushItemThisMonth  /  @ViewBag.RushItemCountThisMonth</span>
                            </div><!-- /.info-box-content -->
                        </div><!-- /.info-box -->
                    </div>

                    <div class=" col-md-3 col-sm-6 col-xs-12  ">
                        <div class="info-box">
                            <span class="info-box-icon bg-aqua"><i class="fa fa-building"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">  الادارة الاكثر طلبا </span>
                                <span class="info-box-number"> @ViewBag.RushDepartment  /  @ViewBag.RushDepartmentCount</span>
                            </div><!-- /.info-box-content -->
                        </div><!-- /.info-box -->
                    </div>
                    
                    <div class=" col-md-3 col-sm-6 col-xs-12  ">
                        <div class="info-box">
                            <span class="info-box-icon bg-yellow"><i class="fa fa-building"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">  الاكثر طلبا في الشهر الحالي   </span>
                                <span class="info-box-number"> @ViewBag.RushDepartmentThisMonth  /  @ViewBag.RushDepartmentCountThisMonth</span>
                            </div><!-- /.info-box-content -->
                        </div><!-- /.info-box -->
                    </div>
              
            </div><!-- /.row -->
        @*</section>*@

    <section class="content">
        <div class="box">
            <div class="box-body">
                <div class="row">
                    <div class="col-lg-8">
                        <div class="border">
                            <canvas id="myChart"></canvas>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="border">
                            <canvas id="myChart1"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

</section>

    </div><!-- /.content-wrapper -->
}





@section scripts{

    
    <script>

            $(document).ready(function () {
                getLinePointChartData();
                getDoctTypeChartData();
            });

            function getLinePointChartData() {
                $.get("/Account/GetChartData", { type: "dashboard" }, function (response) {
                    //console.clear();
                    //console.log(response); // Log the response to check its structure

                    const ctx = document.getElementById('myChart').getContext('2d');

                    const config = {
                        type: 'line', // Line chart
                        data: {
                            labels: response.labels, // The labels from your server (e.g., months)
                            datasets: response.datasets // The datasets (transaction counts)
                        },
                        options: {
                            responsive: true,
                            plugins: {
                                title: {
                                    display: true,
                                    text: 'العمليات المحاسبية حسب الشهر' // Chart title
                                }
                            },
                            scales: {
                                x: {
                                    display: true,
                                    title: {
                                        display: true,
                                        text: 'الشهور' // X-axis label
                                    }
                                },
                                y: {
                                    display: true,
                                    title: {
                                        display: true,
                                        text: 'العمليات' // Y-axis label
                                    }
                                }
                            }
                        }
                    };

                    // Create and render the chart
                    new Chart(ctx, config);
                });
            }

            // Function to generate random colors
            function getRandomColor() {
                const letters = '0123456789ABCDEF';
                let color = '#';
                for (let i = 0; i < 10; i++) {
                    color += letters[Math.floor(Math.random() * 16)];
                }
                return color;
            }

            function getDoctTypeChartData() {
                $.get("/Account/GetDoctTypeChartData", { type: "dashboard" }, function (response) {
                    //console.clear();
                    //console.log(response); // Log the response to check its structure

                    const backgroundColors = response.datasets[0].data.map(() => getRandomColor());

                    const ctx = document.getElementById('myChart1').getContext('2d');

                    const config = {
                        type: 'pie', // Line chart
                        data:response,
                        options: {
                            responsive: true,
                            plugins: {
                                title: {
                                    display: true,
                                    text: 'العمليات المحاسبية حسب نوع العملية' // Chart title
                                },
                                legend: {
                                    position: 'top',
                                },
                            },
                            //scales: {
                            //    x: {
                            //        display: true,
                            //        title: {
                            //            display: true,
                            //            text: 'الشهور' // X-axis label
                            //        }
                            //    },
                            //    y: {
                            //        display: true,
                            //        title: {
                            //            display: true,
                            //            text: 'العمليات' // Y-axis label
                            //        }
                            //    }
                            //}
                        }
                    };

                    // Create and render the chart
                    new Chart(ctx, config);
                });
            }

    </script>
}
