@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
<style>
    .info-box {
        min-height: 90px;
        overflow: hidden;
    }

    .info-box-icon {
        width: 75px;
        min-width: 75px;
        align-self: stretch;
        font-size: 24px;
    }

    .info-box-content {
        min-width: 0;
        flex: 1;
    }

    .info-box-text {
        font-size: 14px;
        white-space: normal;
    }

    .info-box-number {
        font-size: 17px;
    }

    .border canvas {
        max-width: 100%;
    }
</style>
@section content{

    <section class="d-flex flex-row justify-content-between align-items-center my-3">
        <h3>
            اللوحة الرئيسية
        </h3>

        <ol class="breadcrumb">
            <li>
                <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-house-fill"></i>
                    النظام المحاسبي >
                </a>
            </li>
            <li class="breadcrumb-item active">
                DashBoard
            </li>
        </ol>
    </section>

    <!-- Info Boxes -->
    <div class="row g-3 mx-1 mb-3">

        <div class="col-md-3 col-sm-6 col-12">
            <div class="info-box d-flex align-items-center bg-white border rounded shadow-sm">
                <span class="info-box-icon bg-danger text-white d-flex align-items-center justify-content-center p-3">
                    <i class="bi bi-bar-chart fs-2"></i>
                </span>
                <div class="info-box-content p-3">
                    <span class="info-box-text d-block">أكثر الأصناف طلباً</span>
                    <span class="info-box-number fw-bold">
                        @ViewBag.RushItem / @ViewBag.RushItemCount
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6 col-12">
            <div class="info-box d-flex align-items-center bg-white border rounded shadow-sm">
                <span class="info-box-icon bg-success text-white d-flex align-items-center justify-content-center p-3">
                    <i class="bi bi-graph-up-arrow fs-2"></i>
                </span>
                <div class="info-box-content p-3">
                    <span class="info-box-text d-block">الأكثر طلباً في الشهر الحالي</span>
                    <span class="info-box-number fw-bold">
                        @ViewBag.RushItemThisMonth / @ViewBag.RushItemCountThisMonth
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6 col-12">
            <div class="info-box d-flex align-items-center bg-white border rounded shadow-sm">
                <span class="info-box-icon bg-info text-white d-flex align-items-center justify-content-center p-3">
                    <i class="bi bi-building fs-2"></i>
                </span>
                <div class="info-box-content px-3">
                    <span class="info-box-text d-block">الإدارة الأكثر طلباً</span>
                    <span class="info-box-number fw-bold">
                        @ViewBag.RushDepartment / @ViewBag.RushDepartmentCount
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6 col-12">
            <div class="info-box d-flex align-items-center bg-white border rounded shadow-sm">
                <span class="info-box-icon bg-warning text-dark d-flex align-items-center justify-content-center p-3">
                    <i class="bi bi-building fs-2"></i>
                </span>
                <div class="info-box-content px-3">
                    <span class="info-box-text d-block">الإدارة الأكثر طلباً في الشهر الحالي</span>
                    <span class="info-box-number fw-bold">
                        @ViewBag.RushDepartmentThisMonth / @ViewBag.RushDepartmentCountThisMonth
                    </span>
                </div>
            </div>
        </div>

    </div>

    <!-- Charts -->
    <section class="container-fluid">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row g-3">

                    <div class="col-lg-8">
                        <div class="border rounded p-2">
                            <canvas id="myChart"></canvas>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="border rounded p-2">
                            <canvas id="myChart1"></canvas>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
}

@section scripts{
    <script>

        $(document).ready(function () {
            getLinePointChartData();
            getDoctTypeChartData();
        });

        function getLinePointChartData() {
            $.get("/Account/GetChartData", { type: "dashboard" }, function (response) {
                //console.clear();
                //console.log(response); // Log the response to check its structure

                const ctx = document.getElementById('myChart').getContext('2d');

                const config = {
                    type: 'line', // Line chart
                    data: {
                        labels: response.labels, // The labels from your server (e.g., months)
                        datasets: response.datasets // The datasets (transaction counts)
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            title: {
                                display: true,
                                text: 'العمليات المحاسبية حسب الشهر' // Chart title
                            }
                        },
                        scales: {
                            x: {
                                display: true,
                                title: {
                                    display: true,
                                    text: 'الشهور' // X-axis label
                                }
                            },
                            y: {
                                display: true,
                                title: {
                                    display: true,
                                    text: 'العمليات' // Y-axis label
                                }
                            }
                        }
                    }
                };

                // Create and render the chart
                new Chart(ctx, config);
            });
        }

        // Function to generate random colors
        function getRandomColor() {
            const letters = '0123456789ABCDEF';
            let color = '#';
            for (let i = 0; i < 10; i++) {
                color += letters[Math.floor(Math.random() * 16)];
            }
            return color;
        }

        function getDoctTypeChartData() {
            $.get("/Account/GetDoctTypeChartData", { type: "dashboard" }, function (response) {
                //console.clear();
                //console.log(response); // Log the response to check its structure

                const backgroundColors = response.datasets[0].data.map(() => getRandomColor());

                const ctx = document.getElementById('myChart1').getContext('2d');

                const config = {
                    type: 'pie', // Line chart
                    data: response,
                    options: {
                        responsive: true,
                        plugins: {
                            title: {
                                display: true,
                                text: 'العمليات المحاسبية حسب نوع العملية' // Chart title
                            },
                            legend: {
                                position: 'top',
                            },
                        },
                        //scales: {
                        //    x: {
                        //        display: true,
                        //        title: {
                        //            display: true,
                        //            text: 'الشهور' // X-axis label
                        //        }
                        //    },
                        //    y: {
                        //        display: true,
                        //        title: {
                        //            display: true,
                        //            text: 'العمليات' // Y-axis label
                        //        }
                        //    }
                        //}
                    }
                };

                // Create and render the chart
                new Chart(ctx, config);
            });
        }

    </script>
}
