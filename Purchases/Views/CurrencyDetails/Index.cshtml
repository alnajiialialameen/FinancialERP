@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section content{
    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">

        <section class="d-flex flex-row justify-content-between align-items-center my-3">
            <h3>سعر الصرف</h3>

            <ol class="breadcrumb">
                <li>
                    <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                        <i class="bi bi-house-fill"></i>
                        النظام المحاسبي >
                    </a>
                </li>
                <li class="active">سعر الصرف</li>
            </ol>
        </section>

        <section class="container-fluid">
            <div class="row">
                <div class="col-lg-12">

                    <button type="button"
                            class="btn btn-primary float-start mb-3"
                            data-bs-toggle="modal"
                            data-bs-target="#add-modal">
                        <i class="bi bi-plus-lg"></i>
                        إضافة
                    </button>

                    <div>
                        <table id="tbx" class="table table-bordered table-hover"></table>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="modal fade"
         id="add-modal"
         tabindex="-1"
         aria-labelledby="addModalLabel"
         aria-hidden="true"
         data-bs-backdrop="static">

        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="addModalLabel">إضافة سعر صرف</h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <form id="add-form">
                    <div class="modal-body">
                        <div class="row">

                            <div class="col-lg-4">
                                <label for="CurrencyTypeId" class="form-label">
                                    اختار العملة
                                </label>

                                <select id="CurrencyTypeId"
                                        class="form-select list"
                                        name="CurrencyTypeId"
                                        style="width: 100%;">
                                </select>
                            </div>

                            <div class="col-lg-4">
                                <label for="ExchangeRate" class="form-label">
                                    سعر الصرف
                                </label>

                                <input type="text"
                                       id="ExchangeRate"
                                       class="form-control ExchangeRate"
                                       name="ExchangeRate"
                                       placeholder="سعر الصرف" />
                            </div>

                            <div class="col-lg-4">
                                <label for="ExchangeDate" class="form-label">
                                    التاريخ
                                </label>

                                <input type="date"
                                       id="ExchangeDate"
                                       class="form-control ExchangeDate"
                                       name="ExchangeDate" />
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg"></i>
                            حفظ
                        </button>

                        <button type="button"
                                class="btn btn-danger"
                                data-bs-dismiss="modal">
                            إلغاء
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <div class="modal fade"
         id="edit-modal"
         tabindex="-1"
         aria-labelledby="editModalLabel"
         aria-hidden="true"
         data-bs-backdrop="static">

        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel">تعديل سعر الصرف</h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <form id="edit-form">
                    <div class="modal-body">
                        <div class="row">

                            <div class="col-lg-4">
                                <label class="form-label" for="edCurrencyTypeId">
                                    اختار العملة
                                </label>

                                <label class="displaying"
                                       name="CurrencyDetailId"
                                       id="CurrencyDetailId">
                                </label>

                                <select id="edCurrencyTypeId"
                                        class="form-select list"
                                        name="edCurrencyTypeId"
                                        style="width: 100%;">
                                </select>
                            </div>

                            <div class="col-lg-4">
                                <label for="edExchangeRate" class="form-label">
                                    سعر الصرف
                                </label>

                                <input type="text"
                                       id="edExchangeRate"
                                       class="form-control edExchangeRate"
                                       name="edExchangeRate"
                                       placeholder="سعر الصرف" />
                            </div>

                            <div class="col-lg-4">
                                <label for="edExchangeDate" class="form-label">
                                    التاريخ
                                </label>

                                <input type="date"
                                       class="form-control calendar edExchangeDate"
                                       id="edExchangeDate"
                                       name="edExchangeDate"
                                       placeholder="تاريخ التحويل"
                                       autocomplete="off">
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-pencil-square"></i>
                            تعديل
                        </button>

                        <button type="button"
                                class="btn btn-danger"
                                data-bs-dismiss="modal">
                            إلغاء
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>


}

@section scripts{
    <script>
        var myId = 0;
        var dataTable;

        var addExchangeRateObj;
        var editExchangeRateObj;

        $(document).ready(function () {

            function loadData() {
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    "columnDefs": [
                        {
                            "targets": [6],
                            'visible': false,
                            'sClass': 'center',
                        },
                        {
                            "targets": 0,
                            "className": "text-center",
                        },
                    ],
                    ajax: {
                        url: '/CurrencyDetails/LoadData',
                        dataSrc: ''
                    },
                    columns: [
                        {
                            "title": "# ",
                            "data": "Id"
                        },
                        {
                            "title": "العملة",
                            "data": "CurrencyType"
                        },
                        {
                            "title": "العام",
                            "data": "Year"
                        },
                        {
                            "title": "الشهر",
                            "data": "Month"
                        },
                        {
                            "title": "سعر الصرف",
                            "data": "ExchangeRate",
                            "render": function (data, type, row) {
                                return formatNumber(data.toString());
                            }
                        },
                        {
                            "title": "<i class='fa fa-cog'></i>",
                            "data": null,
                            "width": "10%",
                            "orderable": false,
                            "render": function (data) {
                                return '<div class="btn-opreation">'
                                    + '<a class="btn btn-success btnnEdit"> <i class="bi bi-pencil-square"></i></a> '
                                    + '<a class="btn btn-danger btnDelete"><i class="bi bi-trash"></i></a> '
                                    + '</div> ';
                            }
                        },
                        {
                            "title": "CurrencyTypeId",
                            "data": "CurrencyTypeId"
                        },
                    ]
                });
            }
            loadData();


            addExchangeRateObj = CustomAutoNumeric('#ExchangeRate');
            editExchangeRateObj = CustomAutoNumeric('#edExchangeRate');


            select2list("#CurrencyTypeId", "/Shared/getCurrency", "العملة", "#add-modal");
            select2list("#edCurrencyTypeId", "/Shared/getCurrency", "العملة", "#edit-modal");
        });

        var rptList = [];

        function save() {
            var CurrencyTypeId = $("#CurrencyTypeId").val();
            var ExchangeDate = $("#ExchangeDate").val();
            var ExchangeRate = addExchangeRateObj.getNumber();
            $.post('/CurrencyDetails/Create', { "CurrencyTypeId": CurrencyTypeId, "ExchangeRate": ExchangeRate, "ExchangeDate": ExchangeDate, }, function (response) {
                toastr[response.Status](response.Message, response.Title);
                $('#tbx').DataTable().ajax.reload();
            });
        }

        /*----------------------------------------------------------------------------------------*/

        $('#tbx').on('click', '.btnDelete', function () {

            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var Id = data['Id'];

            $.get('/CurrencyDetails/Delete', { "Id": Id }, function (response) {
                toastr[response.Status](response.Message, response.Title);
                $('#tbx').DataTable().ajax.reload();
            });
        });

        $('#tbx').on('click', '.btnnEdit', function () {

            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var CurrencyTypeId = data['CurrencyTypeId'];
            var CurrencyType = data['CurrencyType'];
            var ExchangeRate = data['ExchangeRate'];
            var Month = data['Month'];
            var Year = data['Year'];
            var Id = data['Id'];

            // أنشئ خيار جديد واضفه
            var option = new Option(CurrencyType, CurrencyTypeId, true, true);
            $('#edCurrencyTypeId').append(option).trigger('change');

            var ExchangeDate = new Date(Month + "/15/" + Year);
            console.clear();
            console.log(ExchangeDate);
            const formattedDate = moment(ExchangeDate).format('MM/DD/YYYY');
            $('#edCurrencyTypeId').val(CurrencyTypeId);

            editExchangeRateObj.set(ExchangeRate);

            console.log(formattedDate);

            $('#edExchangeDate').val(formattedDate);
            $('#CurrencyDetailId').text(Id);

            $('#edit-modal').modal('show');
        });

        function Edit() {
            var CurrencyTypeId = $('#edCurrencyTypeId').val();
            var ExchangeDate = $('#edExchangeDate').val();
            var Id = $('#CurrencyDetailId').text();
            var ExchangeRate = editExchangeRateObj.getNumber();

            console.clear();
            console.log(CurrencyTypeId);
            console.log(ExchangeRate);
            console.log(ExchangeDate);
            console.log(Id);

            $.get('/CurrencyDetails/Update', { "Id": Id, "CurrencyTypeId": CurrencyTypeId, "ExchangeRate": ExchangeRate, "ExchangeDate": ExchangeDate }, function (response) {
                toastr[response.Status](response.Message, response.Title);
                $('#tbx').DataTable().ajax.reload();
            });
            $('#edit-modal').modal('hide');

        }



        document.addEventListener('DOMContentLoaded', function () {

            const editForm = document.getElementById('edit-form');
            const addForm = document.getElementById('add-form');

            addForm.addEventListener('submit', function (event) {

                event.preventDefault();
                event.stopPropagation();

                addForm.classList.add('was-validated');

                if (!addForm.checkValidity()) {
                    return;
                }

                save();
            });

            editForm.addEventListener('submit', function (event) {

                event.preventDefault();
                event.stopPropagation();

                editForm.classList.add('was-validated');

                if (!editForm.checkValidity()) {
                    return;
                }

                Edit();
            });

        });

    </script>
}