@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .breadcrumb-item + .breadcrumb-item::before {
        content: ""
    }
</style>
@section content{

    <div class="content-wrapper">
        <div class="grad"></div>

        <section class="d-flex flex-row justify-content-between align-items-center my-3">
            <h3>السنة المالية</h3>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                            <i class="bi bi-house"></i>
                            النظام المالي >
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        السنوات المالية
                    </li>
                </ol>
            </nav>
        </section>

        <section class="content">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <button type="button"
                                    class="btn btn-primary btn-add float-start"
                                    data-bs-toggle="modal"
                                    data-bs-target="#add-modal">
                                <i class="bi bi-plus-square"></i>
                                سنة جديدة
                            </button>
                        </div>

                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="tbx"
                                       class="table table-bordered table-hover">
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="modal fade" id="add-modal" tabindex="-1"
         aria-labelledby="addModalLabel" aria-hidden="true">

        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="addModalLabel">
                        إضافة سنة جديدة
                    </h5>

                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <form method="post" id="add-form">

                        <div class="row align-items-end">
                            <div class="col-lg-9">
                                <div class="mb-3">
                                    <label for="Year" class="form-label">
                                        السنة
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-calendar"></i>
                                        </span>

                                        <input type="text"
                                               class="form-control Year"
                                               id="Year"
                                               name="Year"
                                               placeholder="السنة"
                                               autocomplete="off">
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <button type="submit"
                                        class="btn btn-primary save w-100 mb-3"
                                        value="save">
                                    حفظ
                                </button>
                            </div>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="edit-modal" tabindex="-1"
         aria-labelledby="editModalLabel" aria-hidden="true">

        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel">
                        تعديل السنة
                    </h5>

                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <form method="post" id="edit-form">

                        <div class="row align-items-end">
                            <div class="col-lg-9">
                                <div class="mb-3">
                                    <label for="EdYear" class="form-label">
                                        السنة
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-calendar"></i>
                                        </span>

                                        <input type="hidden"
                                               id="EdId"
                                               class="EdId"
                                               name="EdId">

                                        <input type="text"
                                               class="form-control EdYear"
                                               id="EdYear"
                                               name="EdYear"
                                               placeholder="السنة"
                                               autocomplete="off">
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <button type="submit"
                                        class="btn btn-primary w-100 mb-3"
                                        value="edit">
                                    حفظ
                                </button>
                            </div>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>



}

@section scripts{

    <script>

        $(function () {
            function loadData() {
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    ajax: {
                        url: '/FinancialCycles/LoadData',
                        dataSrc: ''
                    },
                    columns: [
                        {
                            "title": "#",
                            "data": "Id"
                        },
                        {
                            "title": "السنة",
                            "data": "Year"
                        },
                        {
                            "title": "الاعتماد   ",
                            "data": "Credint"
                        },
                        {
                            "title": "الصرف الفعلي   ",
                            "data": "ActualExchange"
                        },
                        {
                            "title": "الانحراف النسبي   ",
                            "data": "RelativeDeviation"
                        },
                        {
                            "title": "نسبة الانحراف النسبي    ",
                            "data": "RelativeRatio"
                        },
                        {
                            "title": "الحالة",
                            "data": null,
                            "width": "10%",
                            "orderable": true,
                            "render": function (data) {
                                if(data.CurrentYear == true)
                                {
                                    return '<div class="btn-opreation">'
                                    + '<label class="text-success">العام المالي الحالي</label>'
                                    + '</div> ';
                                }else{
                                    return '<div class="btn-opreation">'
                                   + '<label class="text-danger">ليس العام المالي الحالي</label>'
                                   + '</div> ';
                                }
                            }
                        },
                        {
                            "title": " اغلاق ",
                            "data": null,
                            "render": function (data) {
                                if (data.IsClosed != true) {
                                    return '<div class="btn-opreation">'
                                        + '<button class="btn btn-danger transfer" onclick="return Stop(' + data.Id + ') "> قفل العام <i class=" fa fa-edit align-middle"></i></button> '
                                       + '</div> ';
                                }
                                else {
                                    return '<div class="btn-opreation">'
                                        + '<button class="btn btn-success transfer" onclick="return UnStop(' + data.Id + ') ">  فتح العام <i class=" fa fa-edit align-middle"></i></button> '
                                       + '</div> ';
                                }
                            }
                        },
                        {
                            "title": "<i class='fa fa-cog'></i>",
                            "data": null,
                            "width": "10%",
                            "orderable": false,
                            "render": function (data) {
                                return '<div class="btn-opreation">'
                                    + '<button class="btn btn-success transfer openEditModal">تعديل <i class=" bi bi-pencil-square"></i></button> '
                                    + '</div> ';
                            }
                        },
                        {
                            "title": "<i class='fa fa-cog'></i>",
                            "data": null,
                            "width": "10%",
                            "orderable": false,
                            "render": function (data) {
                                return '<div class="btn-opreation">'
                                       + '<button class="btn btn-warning transfer" onclick="isCurrentYear(' + data.Id + ') ">العام الحالي<i class=" fa fa-edit align-middle"></i></button> '
                                    + '</div> ';
                            }
                        }
                    ]
                });
            }
            loadData();

            //save
            function save() {
                var ob = {
                    Year: $('#Year').val()
                };

                $.ajax({
                    url: '@Url.Action("Save", "FinancialCycles")',
                    type: 'POST',
                    data: JSON.stringify(ob),
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',

                    error: function (xhr) {
                        console.log(xhr.responseText);
                    },

                    success: function (response) {
                        toastr[response.Status](response.Message, response.Title);

                        bootstrap.Modal.getOrCreateInstance(
                            document.getElementById('add-modal')
                        ).hide();

                        dataTable.ajax.reload();
                    }
                });
            }
            // Open Edit Modal
            $("#tbx").on('click', '.openEditModal', function () {

                var currentRow = $(this).closest("tr");

                $('#EdId').val(currentRow.find("td:eq(0)").text().trim());
                $('#EdYear').val(currentRow.find("td:eq(1)").text().trim());

                const editModal = bootstrap.Modal.getOrCreateInstance(
                    document.getElementById('edit-modal')
                );

                editModal.show();
            });

           function edit() {
                var ob = {
                    Id: $('#EdId').val(),
                    Year: $('#EdYear').val()
                };

                $.ajax({
                    url: '@Url.Action("Edit", "FinancialCycles")',
                    type: 'POST',
                    data: JSON.stringify(ob),
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',

                    error: function (xhr) {
                        console.log(xhr.responseText);
                    },

                    success: function (response) {
                        toastr[response.Status](response.Message, response.Title);

                        bootstrap.Modal.getOrCreateInstance(
                            document.getElementById('edit-modal')
                        ).hide();

                        dataTable.ajax.reload();
                    }
                });
            }

            $('#add-form').on('submit', function (e) {
                e.preventDefault();
                save();
            });

            $('#edit-form').on('submit', function (e) {
                e.preventDefault();
                edit();
            });
        });

        //stop last level
        function Stop(id) {
            var currentRow = $(this).closest("tr");

            Swal.fire({
                title: '   إغلاق ',
                text: " هل تريد اغلاق هذا العام ",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'موافق',
                cancelButtonText: 'رجوع'
            }).then((result) => {
                if (result.isConfirmed) {
                    StopBalances(id, true);
                }
            })

        }
        //unstop

        //stop last level
        function UnStop(id) {
            var currentRow = $(this).closest("tr");

            Swal.fire({
                title: '   فتح العام ',
                text: " هل تريد فتح  هذا العام ",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'موافق',
                cancelButtonText: 'رجوع'
            }).then((result) => {
                if (result.isConfirmed) {
                    UnStopBalances(id, false);
                }
            })

        }

        // stop function
        function StopBalances(id, isClosed) {
            var ob = {
                Id: id,
                IsClosed: isClosed
            }
            $.ajax({
                url: "@Url.Action("StopBalances", "FinancialCycles")",
                type: "POST",
                data: JSON.stringify(ob),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                    dataTable.ajax.reload();
                }
            });
        }
        // un stop function

        // stop function
        function UnStopBalances(id) {
            var ob = {
                Id: id,
            }
            $.ajax({
                url: "@Url.Action("StopBalances", "FinancialCycles")",
                type: "POST",
                data: JSON.stringify(ob),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                    dataTable.ajax.reload();

                }
            });
        }

        // stop function
        function isCurrentYear(id) {
            console.clear();
            console.log(id);
            $.ajax({
                url: "/FinancialCycles/ChangeCurrentFinancialCycle/" + id,
                type: "POST",
                data: null,
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                    //$('#add-form').bootstrapValidator('resetForm', true);
                    //$('#add-modal').modal('hide');
                    // dataTable.ajax.reload();
                    dataTable.ajax.reload();

                }
            });
        }

    </script>
}


