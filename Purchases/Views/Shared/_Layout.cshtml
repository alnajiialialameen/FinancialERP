    </div>
    @*@Scripts.Render("~/bundles/jquery")
        @Scripts.Render("~/bundles/bootstrap")*@


    <!-- 1. jQuery أولاً -->
    <script src="~/My-Layout/jQuery-v3.7.1/jQuery v3.7.1.min.js"></script>

    <!-- 2. Bootstrap -->
    <script src="~/My-Layout/Bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- 3. Select2 -->
    <script src="~/My-Layout/Select2 4.1.0/js/Select2 4.1.0.js"></script>
    <script src="~/My-Layout/DataTable/js/DataTables 3.1.3.js"></script>
    <script src="~/Temp/AutoNumeric/auto-numeric.js"></script>
    <script src="~/My-Layout/sweetalert2/sweetalert2-v11.26.25.js"></script>
    <script src="~/Temp/Tree/dist/jstree.js"></script>
    <script src="~/Scripts/moment.js"></script>
    <script src="~/Temp/charts/chart.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>


    @RenderSection("scripts", required: false)

    <script>

        function CustomAutoNumeric(inputId) {
            return new AutoNumeric(inputId, {
                digitGroupSeparator: ',', // الفاصلة بين الآلاف
                decimalCharacter: '.',    // النقطة كعلامة عشرية
                decimalPlaces: 2         // عدد المنازل العشرية
                //defaultValue: "0.00"      // القيمة الافتراضية
            });
        }

        // الدالة دي بغرض توحيد الدوال حذفت من جميع الشاشات و بقت هنا فقط
        function select2list(selector, url, placeholder, modalName = null) {
            $(selector).select2({
                //dropdownParent: $(modalName),
                ...(modalName ? { dropdownParent: $(modalName) } : {}),
                language: {
                    inputTooShort: function () { return 'ادخل حرف واحد علي الاقل'; },
                    noResults: function () { return 'لا توجد نتائج مطابقة، يمكنك إدخال قيمة جديدة'; } // رسالة في حالة عدم وجود نتائج
                },
                ajax: {
                    url: url,
                    dataType: 'json',
                    delay: 100,
                    data: function (params) {
                        return {
                            q: params.term,
                            page: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data,
                            pagination: {
                                more: ((data.total_count) > (params.page * 20))
                            }
                        };
                    },
                    cache: false
                },
                placeholder: placeholder,
                minimumInputLength: 1,
                width: '100%' // لضبط عرض القائمة المنسدلة لتكون بعرض العنصر الأساسي
            });
        };

        // دي حقت اسم المستلم بتقبل انه يدخل قيمة جديدة اذا ما موجودة في البيانات الراجعة - مستخدمة في اسم المستلم
        function select2listNew(selector, url, placeholder, modalName = null) {
            $(selector).select2({
                tags: true, // السماح بإضافة قيم جديدة
                dropdownParent: $(modalName),
                language: {
                    inputTooShort: function () { return 'ادخل حرف واحد على الأقل'; },
                    noResults: function () { return 'لا توجد نتائج مطابقة، يمكنك إدخال قيمة جديدة'; } // رسالة في حالة عدم وجود نتائج
                },
                ajax: {
                    url: url,
                    dataType: 'json',
                    delay: 100,
                    data: function (params) {
                        return {
                            q: params.term,
                            page: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        // تحويل البيانات إلى تنسيق { id: ..., text: ... } المطلوب بواسطة Select2
                        var transformedData = data.map(function (item) {
                            //return { id: item.text, text: item.text }; // هنا نقوم باستخدام `text` كـ `id` أيضًا
                            //return { id: item.id??0, text: item.text };
                            return { id: item.id != null && item.id != 0 ? item.id : item.text, text: item.text };
                        });

                        // إرجاع البيانات مع التحكم في التحميل المتدرج
                        return {
                            results: transformedData,
                            pagination: {
                                more: (data.length >= 20) // استخدم شرط مناسب للتحكم في التحميل المتدرج
                            }
                        };
                    },
                    cache: true
                },
                placeholder: placeholder,
                minimumInputLength: 1,
                createTag: function (params) { // للسماح بإدخال القيم الجديدة
                    return {
                        id: params.term,
                        text: params.term,
                        newTag: true // تحديد العنصر كقيمة جديدة
                    };
                }
            });
        }

        function formatNumber(num) {
            //if (num === null) {
            //    return '0';
            //}

            if (num === null || num === undefined || isNaN(num)) {
                return '0';
            }

            // تمت اضفاته مؤخرا وشغالة تمام
            num = num.toString(); // ✅ حول القيمة لنص

            // معالجة الجزء الصحيح والجزء العشري
            var parts = num.split('.');
            var integerPart = parts[0];
            var decimalPart = parts[1] || '';

            // إذا كان هناك جزء صحيح، أضف له الفواصل
            integerPart = integerPart.replace(/\D/g, '').replace(/\B(?=(\d{3})+(?!\d))/g, ",");

            // إذا كان هناك جزء عشري، أضف له الفواصل
            if (decimalPart) {
                // var roundedDecimal = parseFloat(decimalPart).toFixed(2); // تقريب إلى خانتين عشريتين
                var roundedDecimal = (parseFloat('0.' + decimalPart).toFixed(2)).split('.')[1];
                // roundedDecimal = roundedDecimal.replace(/\D/g, '').replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                roundedDecimal = roundedDecimal.replace(/\D/g, '').replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                return integerPart + '.' + roundedDecimal;
            }

            return integerPart;
        }

        function loadNotifications() {

            $.get("/Home/GetNotifications", function (data) {

                var menu = $("#notificationMenu");
                menu.empty();

                if (data.length > 0) {
                    $("#notificationDropdown").show(); // إظهار الجرس
                    $("#notificationDropdown").css("display", "block"); // إظهار
                    data.forEach(function (item) {
                        menu.append(`
                            <li class="border-bottom">
                                <a class="text-decoration-none text-dark d-block p-2 notification-item"
                                   href="#"
                                   onclick="GoToSpecificPage(${item.type})">
                                    ${item.message}
                                </a>
                            </li>
                        `);
                    });

                    $("#notificationCount").text(data.length);
                } else {
                    // إخفاء الجرس إذا لم توجد إشعارات
                    $("#notificationDropdown").css("display", "none");  // إخفاء
                    $("#notificationDropdown").hide(); // إخفاء الجرس
                    $("#notificationCount").text("0");
                }
            });
        }

        $(function () {
            loadNotifications();
        });

        function GoToSpecificPage(type) {
            switch (type) {
                case 1:
                    window.location.href = "/Transactions/PettyCashNotPayed";
                    break;
                case 2:
                    window.location.href = "/Balances/OverLimitItems";
                    break;
                case 3:
                    window.location.href = "/Transactions/IndexAll1";
                    break;
                default:
                    console.log("Unknown type: " + type);
            }
        }

        function CustomAutoNumericForElement(inputElement) {
            return new AutoNumeric(inputElement, {
                digitGroupSeparator: ',',
                decimalCharacter: '.',
                decimalPlaces: 2,
                minimumValue: '0',
                emptyInputBehavior: 'zero'
            });
        }

    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const toggle = document.getElementById('sidebarToggle');
            const sidebar = document.getElementById('mainSidebar');
            const overlay = document.getElementById('sidebarOverlay');

            // Sidebar Toggle
            toggle?.addEventListener('click', function () {

                const isOpen = sidebar.classList.contains('show');

                sidebar.classList.toggle('show', !isOpen);
                overlay?.classList.toggle('show', !isOpen);

                toggle.setAttribute('aria-expanded', !isOpen);
            });

            // Close Sidebar when clicking overlay
            overlay?.addEventListener('click', function () {
                sidebar.classList.remove('show');
                overlay.classList.remove('show');
                toggle.setAttribute('aria-expanded', 'false');
            });

            // Submenu Toggle
            document.querySelectorAll('.sidebar-menu .menu-toggle')
                .forEach(function (menuToggle) {

                    menuToggle.addEventListener('click', function (event) {

                        event.preventDefault();

                        const parent = this.closest('.treeview');

                        if (!parent) return;

                        parent.classList.toggle('open');
                    });

                });

        });

        // عرض التفاصيل
        $('#tbx').on('click', '.btnDetails', function () {
            var currentRow = $(this).closest("tr");
            var data = $('#tbx').DataTable().row(currentRow).data();
            var IsDeleted = data['IsDeleted'];
            var TransactionId = data['transactionId'];
            var TransactionDate = data['transactionDateStr'];
            var Note = data['note'];

            $('.tarnsDate').text(TransactionDate);
            $('.tarnsStatement').text(Note);

            if (!IsDeleted) {
                $.get('/Transactions/getDetailData', { "Id": TransactionId }, function (response) {
                    $('.detailsTBody').empty();
                    var sumOfDebit = 0;
                    var sumOfCredit = 0;
                    $.each(response, function (key, value) {
                        var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                            + "<td class='id'>" + value.id + "</td>"
                            + "<td class='accName'>" + value.accName + "</td>"
                            + "<td class='accName'>" + formatNumber(value.debit.toString()) + "</td>"
                            + "<td class='credit'>" + formatNumber(value.credit.toString()) + "</td>"
                            + "</tr>";
                        $('.detailsTBody').append(rows);

                        sumOfCredit = sumOfCredit + value.credit;
                        sumOfDebit = sumOfDebit + value.debit;

                    });

                    var balance = sumOfDebit.toFixed(2) - sumOfCredit.toFixed(2);

                    $('#tdDebitAmount').text(formatNumber(sumOfDebit.toString()));
                    $('#tdCreditAmount').text(formatNumber(sumOfCredit.toString()));
                    $('#tdBalance').text(formatNumber(balance.toString()));

                });
            }
            else {
                $.get('/DeleteTransactions/getDeletedDetailData', { "Id": TransactionId }, function (response) {
                    $('.detailsTBody').empty();
                    var sumOfDebit = 0;
                    var sumOfCredit = 0;
                    $.each(response, function (key, value) {
                        var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                            + "<td class='id'>" + value.id + "</td>"
                            + "<td class='accName'>" + value.accName + "</td>"
                            + "<td class='accName'>" + formatNumber(value.debit.toString()) + "</td>"
                            + "<td class='credit'>" + formatNumber(value.credit.toString()) + "</td>"
                            + "</tr>";
                        $('.detailsTBody').append(rows);

                        sumOfCredit = sumOfCredit + value.credit;
                        sumOfDebit = sumOfDebit + value.debit;

                    });

                    var balance = sumOfDebit.toFixed(2) - sumOfCredit.toFixed(2);

                    $('#tdDebitAmount').text(formatNumber(sumOfDebit.toString()));
                    $('#tdCreditAmount').text(formatNumber(sumOfCredit.toString()));
                    $('#tdBalance').text(formatNumber(balance.toString()));

                });
            }
        });

    </script>
</body>
</html>
