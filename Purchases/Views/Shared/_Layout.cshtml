    <style>
        :root {
            --sidebar-width: 230px;
            --header-height: 50px;
        }

        * {
            box-sizing: border-box;
        }

        /* Header */
        .main-header {
            height: var(--header-height);
            width: 100%;
            display: flex;
            background: #3c8dbc;
            color: #fff;
            position: relative;
            z-index: 1030;
        }

            .main-header .logo {
                width: var(--sidebar-width);
                min-width: var(--sidebar-width);
                height: var(--header-height);
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                background: #367fa9;
                color: #fff;
                text-decoration: none;
            }

            .main-header .navbar {
                min-width: 0;
                min-height: var(--header-height);
                padding: 0;
            }

            .main-header .navbar-nav .nav-link {
                color: #fff;
            }

            .main-header .dropdown-menu {
                min-width: 250px;
            }

        .navbar-expand .navbar-nav .dropdown-menu {
        }
        /* Sidebar - right side */
        .main-sidebar {
            position: fixed;
            top: var(--header-height);
            right: 0;
            left: auto;
            bottom: 0;
            width: var(--sidebar-width);
            overflow-y: auto;
            background: #222d32;
            color: #b8c7ce;
            z-index: 1020;
            transform: translateX(0);
            transition: transform .25s ease;
        }

        .sidebar-menu,
        .treeview-menu {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .sidebar-menu > li > a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 12px 15px;
                color: #b8c7ce;
                text-decoration: none;
            }

                .sidebar-menu > li > a:hover,
                .sidebar-menu > li.active > a {
                    color: #fff;
                    background: #1e282c;
                }

                .sidebar-menu > li > a > i:first-child {
                    width: 20px;
                    text-align: center;
                    flex-shrink: 0;
                }

            .sidebar-menu .menu-arrow {
                margin-right: auto;
                transition: transform .2s ease;
            }

        .treeview-menu {
            display: none;
            background: #2c3b41;
        }

        .treeview.open > .treeview-menu {
            display: block;
        }

        .treeview.open > .menu-toggle .menu-arrow {
            transform: rotate(-90deg);
        }

        .treeview-menu a {
            display: block;
            padding: 10px 42px 10px 15px;
            color: #b8c7ce;
            text-decoration: none;
        }

            .treeview-menu a:hover {
                color: #fff;
                background: #1e282c;
            }

            .treeview-menu a i {
                width: 20px;
                margin-left: 5px;
                text-align: center;
            }

        /* Main content: always reserve space for right sidebar */
        .main-content {
            display: block;
            width: calc(100% - var(--sidebar-width));
            margin-right: var(--sidebar-width);
            margin-left: 0;
            padding: 20px;
            min-width: 0;
            min-height: calc(100vh - var(--header-height));
            box-sizing: border-box;
            transition: width .25s ease, margin-right .25s ease;
        }

        /* Footer */
        .main-footer {
            width: calc(100% - var(--sidebar-width));
            margin-right: var(--sidebar-width);
            margin-left: 0;
            padding: 15px;
            border-top: 1px solid #dee2e6;
            background: #fff;
            box-sizing: border-box;
            transition: width .25s ease, margin-right .25s ease;
        }

        /* Sidebar collapsed on desktop */
        body.sidebar-collapsed .main-sidebar {
            transform: translateX(100%);
        }

        body.sidebar-collapsed .main-content,
        body.sidebar-collapsed .main-footer {
            width: 100%;
            margin-right: 0;
        }

        .input-group > .form-control {
            border-radius: 0.375rem 0 0 0.375rem !important;
        }

        .input-group > .input-group-text {
            border-radius: 0 0.375rem 0.375rem 0 !important;
        }
        /* Mobile */
        @@media (max-width: 767.98px) {
            .main-header .logo {
                width: 90px;
                min-width: 90px;
            }

            .main-header .logo-lg {
                display: none;
            }
            /* Sidebar hidden by default on mobile */
            .main-sidebar {
                transform: translateX(100%);
            }

            body:not(.sidebar-collapsed) .main-sidebar {
                transform: translateX(0);
            }
            /* Content always full width on mobile */
            .main-content,
            .main-footer {
                width: 100%;
                margin-right: 0;
                margin-left: 0;
            }
        }
    </style>

    <!-- Side bar style -->
    <style>
        .main-sidebar {
            position: fixed;
            top: 0;
            right: 0;
            width: 250px;
            height: 100vh;
            background: #222d32;
            z-index: 1050;
            transform: translateX(100%);
            visibility: hidden;
            transition: transform 0.3s ease, visibility 0.3s ease;
            overflow-y: auto;
        }

            .main-sidebar.show {
                transform: translateX(0);
                visibility: visible;
            }

        .sidebar-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.4);
            z-index: 1040;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }

            .sidebar-overlay.show {
                opacity: 1;
                visibility: visible;
            }

        .sidebar-menu .treeview > .treeview-menu {
            display: none;
        }

        .sidebar-menu .treeview.open > .treeview-menu {
            display: block;
        }

        .sidebar-menu .treeview > a .menu-arrow {
            transition: transform 0.3s ease;
        }

        .sidebar-menu .treeview.open > a .menu-arrow {
            transform: rotate(-90deg);
        }


        .input-group .select2-container {
            flex: 1 1 auto;
            width: 1% !important;
        }

            .input-group .select2-container .select2-selection--single {
                height: 38px;
                border-radius: 0 6px 6px 0;
            }

            .input-group .select2-container .select2-selection__rendered {
                line-height: 36px;
                text-align: right;
            }

            .input-group .select2-container .select2-selection__arrow {
                height: 36px;
            }


        .buttons {
            display: flex !important;
            flex-direction: row;
            justify-content: space-between;
        }

        .float {
            position: fixed;
            width: 40px;
            height: 40px;
            bottom: 50px;
            left: 100px;
            border-radius: 50px;
            text-align: center;
            box-shadow: 7px 2px 3px #7e7b7b;
        }

        .one {
            background-color: #ff6a00;
            color: #FFF;
            margin-left: 210px;
        }

        .two {
            margin-left: 70px;
            background-color: #0094ff;
            color: #FFF;
        }

        .third {
            margin-left: 140px;
            background-color: #0C9;
            color: #FFF;
        }

        .exit {
            float: right;
            bottom: 120px;
            background-color: red;
            color: #FFF;
        }

        .my-float {
            margin-top: 10px;
        }
        .notification-item {
            direction: rtl;
            text-align: right;
            white-space: normal;
        }

        .dropdown-menu {
            width: max-content;
            min-width: 250px;
            max-width: 450px;
            white-space: normal;
        }

        .notification-item:hover {
            background-color: var(--bs-tertiary-bg);
        }
        .notification-item:hover {
            background-color: var(--bs-tertiary-bg);
        }
    </style>
</head>
