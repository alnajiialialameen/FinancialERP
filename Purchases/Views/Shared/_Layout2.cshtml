    <style type="text/css">
        .displaying {
            display: none;
        }

        fieldset {
            border: solid 1px #808080 !important;
            padding: 10px;
            border-radius: 5px;
            margin-top:20px;
        }

        .trans {
            border: solid 1px #808080 !important;
            border-radius: 5px;
            width: 100%;
            padding: 5px;
            margin-top:15px;
        }

        .trans-edit {
            border: solid 1px #00ff21 !important;
            border-radius: 5px;
            width: 100%;
            padding: 5px;
            margin-top:15px;
        }

        .legend {
            position: absolute;
            top: 15px;
            right:45px;
            background-color: white;
            padding: 0 10px;
            transform: scale3d(1.2, 1.2, 1.2);
        }
        
        .buttons{
            display: flex !important;
            align-content:space-between;
        }

        .float{
	        position:fixed;
	        width:40px;
	        height:40px;
	        bottom:50px;
	        left:100px;
	        border-radius:50px;
	        text-align:center;
	        box-shadow: 7px 2px 3px #7e7b7b; 
        }

       .one{
	        background-color:#ff6a00;
	        color:#FFF;
        }

