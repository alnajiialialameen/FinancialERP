    <script src="~/Temp/jquery/jquery.min.js"></script>
    <script src="~/Temp/AutoNumeric/auto-numeric.js"></script>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script>
        $('.numberFormat').each(function () {
            var item = $(this).text();

            var N = round(item, 2);
            var formattedVal = formatNumber(inputVal);

            $(this).text(num);
        });

        function formatNumber(num) {
            // تحويل الرقم إلى سلسلة نصية لضمان المعالجة
            num = num.toString();

            // تقسيم الرقم إلى جزء صحيح وجزء عشري
            var parts = num.split('.');
            var integerPart = parts[0];
            var decimalPart = parts[1] || '';

            // معالجة الجزء الصحيح بإضافة الفواصل
            integerPart = integerPart.replace(/\B(?=(\d{3})+(?!\d))/g, ",");

            // معالجة الجزء العشري بالتقريب إلى خانتين عشريتين
            if (decimalPart) {
                decimalPart = (parseFloat('0.' + decimalPart).toFixed(2)).split('.')[1];
            }

            // إرجاع الرقم بالصيغة المطلوبة
            return decimalPart ? integerPart + '.' + decimalPart : integerPart;
        }

        window.addEventListener("load", window.print());


        function CustomAutoNumeric(inputId) {
            return new AutoNumeric(inputId, {
                digitGroupSeparator: ',', // الفاصلة بين الآلاف
                decimalCharacter: '.',    // النقطة كعلامة عشرية
                decimalPlaces: 2,          // عدد المنازل العشرية
                defaultValue: "0.00"      // القيمة الافتراضية
            });
        }



        $('.amount').each(function () {
            var item = $(this).text();

            // var inputVal = round(item, 2);
            var formattedVal = formatNumber(item);

            $(this).text(formattedVal);
        });



        // التحويل الي اكسيل شيت
        $(function () {
            $("#btnExport").click(function () {
                $("#tblCustomers").table2excel({
                    filename: "Table.xls"
                });
            });
        });



        function truncateDecimal() {
            document.querySelectorAll('.truncateDecimal').forEach(element => {
                const value = element.textContent.trim().replace(/,/g, '');
                const number = Number(value);

                if (!isNaN(number)) {
                    element.textContent = number.toLocaleString('en-US', {
                        minimumFractionDigits: 0,
                        maximumFractionDigits: 20
                    });
                }
            });
        }

        // تنفيذ الدالة
        truncateDecimal();


    </script>
