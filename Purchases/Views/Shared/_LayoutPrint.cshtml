<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Report</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
            body {
                font-family: Arial, sans-serif;
                text-align: center;
            }
        
            .invoiceCupps {
                padding: 0px 20px;
                font-family: Arial;
                margin: 0px 20px;
            }
            .invoiceCupps .invoice-Cupps-header {
                display: flex;
                flex-direction: row;
                justify-content: space-between;
                align-items: flex-end;
                border: 2px solid #808080;
                border-radius: 5px;
                padding: 16px;
                margin-bottom: 10px;
            }
            .invoiceCupps .invoice-Cupps-header .text-word {
                float: none;
            }

            .invoiceCupps .invoice-Cupps-header .text-word h6 {
                font-size: 21px;
                font-weight: bolder;
            }

            .invoiceCupps .invoice-Cupps-header .image-R {
                float: right;
                margin-right: 30px;
                margin-top: -100px;
            }

            .invoiceCupps .invoice-Cupps-header .image-L {
                float: left;
                margin-left: 30px;
                margin-top: -100px;
            }

            .invoiceCupps .invoice-Cupps-Body {
                clear: both;
            }

            .invoiceCupps .invoice-Cupps-Body .h-mr {
                margin-right: 20px;
                font-size: 21px;
            }

            .invoiceCupps .invoice-Cupps-details th {
                background-color: #ebefef;
            }

            .invoiceCupps .invoice-Cupps-details table {
                min-width: 100%;
                text-align: right;
            }

            .invoiceCupps .invoice-Cupps-details table, th, td {
                border: 1px solid #282a2c;
                padding: .5rem;
                font-size: 18px;
                text-align: center;
            }

            .invoiceCupps .invoice-Cupps-details .footer {
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                background-color: #ebefef;
                font-weight: bolder;
                font-size: 20px;
                min-width: 30%;
                margin-top: 3%;
                padding: 16px;
                line-height: 30px;
            }

            .footer .titel {
                float: right;
            }

            .footer .value {
                float: left;
            }
        
            .numberFormat {
                margin: 2px;
                padding: 2px;
                font-size: 18px;
            }
    </style>

</head>
<body>
    @*<div class="wrapper">*@
        @RenderBody()
    @*</div>*@

    <script src="~/Temp/jquery/jquery.min.js"></script>
    <script src="~/Temp/AutoNumeric/auto-numeric.js"></script>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script>
        $('.numberFormat').each(function () {
            var item = $(this).text();

            var N = round(item, 2);
            var formattedVal = formatNumber(inputVal);

            $(this).text(num);
        });

        function formatNumber(num) {
            // تحويل الرقم إلى سلسلة نصية لضمان المعالجة
            num = num.toString();

            // تقسيم الرقم إلى جزء صحيح وجزء عشري
            var parts = num.split('.');
            var integerPart = parts[0];
            var decimalPart = parts[1] || '';

            // معالجة الجزء الصحيح بإضافة الفواصل
            integerPart = integerPart.replace(/\B(?=(\d{3})+(?!\d))/g, ",");

            // معالجة الجزء العشري بالتقريب إلى خانتين عشريتين
            if (decimalPart) {
                decimalPart = (parseFloat('0.' + decimalPart).toFixed(2)).split('.')[1];
            }

            // إرجاع الرقم بالصيغة المطلوبة
            return decimalPart ? integerPart + '.' + decimalPart : integerPart;
        }

        window.addEventListener("load", window.print());


        function CustomAutoNumeric(inputId) {
            return new AutoNumeric(inputId, {
                digitGroupSeparator: ',', // الفاصلة بين الآلاف
                decimalCharacter: '.',    // النقطة كعلامة عشرية
                decimalPlaces: 2,          // عدد المنازل العشرية
                defaultValue: "0.00"      // القيمة الافتراضية
            });
        }



        $('.amount').each(function () {
            var item = $(this).text();

            // var inputVal = round(item, 2);
            var formattedVal = formatNumber(item);

            $(this).text(formattedVal);
        });



        // التحويل الي اكسيل شيت
        $(function () {
            $("#btnExport").click(function () {
                $("#tblCustomers").table2excel({
                    filename: "Table.xls"
                });
            });
        });


    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
