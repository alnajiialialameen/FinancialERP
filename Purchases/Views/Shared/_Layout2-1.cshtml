                        + "<td class='accName'>" + value.accName + "</td>"
                        + "<td class='accName'>" + formatNumber(value.debit.toString()) + "</td>"
                        + "<td class='credit'>" + formatNumber(value.credit.toString()) + "</td>"
                        + "</tr>";
                    $('.detailsTBody').append(rows);

                    sumOfCredit = sumOfCredit + value.credit;
                    sumOfDebit = sumOfDebit + value.debit;

                });

                var balance = sumOfDebit.toFixed(2) - sumOfCredit.toFixed(2);

                $('#tdDebitAmount').text(formatNumber(sumOfDebit.toString()));
                $('#tdCreditAmount').text(formatNumber(sumOfCredit.toString()));
                $('#tdBalance').text(formatNumber(balance.toString()));

            });
        }
        else {
            $.get('/DeleteTransactions/getDeletedDetailData', { "Id": TransactionId }, function (response) {
                $('.detailsTBody').empty();
                var sumOfDebit = 0;
                var sumOfCredit = 0;
                $.each(response, function (key, value) {
                    var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                        + "<td class='id'>" + value.id + "</td>"
                        + "<td class='accName'>" + value.accName + "</td>"
                        + "<td class='accName'>" + formatNumber(value.debit.toString()) + "</td>"
                        + "<td class='credit'>" + formatNumber(value.credit.toString()) + "</td>"
                        + "</tr>";
                    $('.detailsTBody').append(rows);

                    sumOfCredit = sumOfCredit + value.credit;
                    sumOfDebit = sumOfDebit + value.debit;

                });

                var balance = sumOfDebit.toFixed(2) - sumOfCredit.toFixed(2);

                $('#tdDebitAmount').text(formatNumber(sumOfDebit.toString()));
                $('#tdCreditAmount').text(formatNumber(sumOfCredit.toString()));
                $('#tdBalance').text(formatNumber(balance.toString()));

            });
        }
    });

