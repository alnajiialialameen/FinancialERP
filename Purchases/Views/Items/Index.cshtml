
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}


@section content{



    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <div class="grad"></div>

        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>
                الاصنـــاف
            </h1>
            <ol class="breadcrumb">
                <li><a href="#"><i class="fa fa-home"></i> النظام المالي </a></li>
                <li class="active"> الاصنــاف</li>
            </ol>

        </section>


        <section class="content">
            <div class="row">
                <div class="col-xs-12">
                    <div class="box">
                        <div class="box-header">
                            <button type="button" class="btn btn-primary pull-left btn-add" data-toggle="modal" data-target="#add-modal"><i class="fa fa-plus-square">  </i> صنف جديد </button>
                        </div><!-- /.box-header -->
                        <div class="box-body">
                            <table id="tbx" class="table table-bordered table-hover"></table>
                        </div><!-- /.box-body -->
                    </div><!-- /.box -->
                </div><!-- /.col -->
            </div><!-- /.row -->
        </section>


    </div><!-- /.content-wrapper -->




    <div class="example-modal">
        <div class="modal fade in" id="add-modal">
            <div class="modal-dialog" style="width:80% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة صنف جديد</h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-12">
                                <form method="post" id="add-form">
                                    <div class="box .no-border">
                                        <!-- /.box-header -->
                                        <div class="box-body">
                                            <!-- Input addon -->
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    <div class="col-lg-9">
                                                        <div class="form-group">
                                                            <label for="name"> الصنف </label>
                                                            <div class="input-group">
                                                                <span class="input-group-addon"><i class="fa fa-home"></i></span>
                                                                <input type="text" class="form-control  name" id="name" name="name" placeholder="اسم الصنف " autocomplete="off">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-3">
                                                        <button type="submit" class="btn btn-primary save" value="save" style="width: 100%;position: relative;top: 25px;">حفظ</button>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                        <!-- /.box-body -->
                                    </div>

                                </form>
                            </div>
                        </div><!-- /.row (main row) -->

                    </div>
                    @*<div class="modal-footer">

                        </div>*@
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>




    <!-- Edit Modal -->
    <div class="example-modal">
        <div class="modal fade in" id="edit-modal">
            <div class="modal-dialog" style="width:80% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title">تعديل الاصناف </h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-12">
                                <form method="post" id="edit-form">
                                    <div class="box .no-border">
                                        <!-- /.box-header -->
                                        <div class="box-body">
                                            <!-- Input addon -->
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    <div class="col-lg-9">
                                                        <div class="form-group">
                                                            <label for="ed-name"> الصنف</label>
                                                            <div class="input-group">
                                                                <span class="input-group-addon"><i class="fa fa-home"></i></span>
                                                                <input id="ed-id" class="ed-id hidden" name="ed-id" />
                                                                <input type="text" class="form-control  edname" id="edname" name="edname" placeholder="الصنف " autocomplete="off">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-3">
                                                        <button type="submit" class="btn btn-primary" value="edit" style="width: 100%;position: relative;top: 25px;">حفظ</button>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                        <!-- /.box-body -->
                                    </div>

                                </form>
                            </div>
                        </div><!-- /.row (main row) -->

                    </div>
                    @*<div class="modal-footer">

                        </div>*@
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>





    <!-- Add Modal housing -->
    <div class="example-modal-item-detail">
        <div class="modal fade in" id="add-modal-item-detail">
            <div class="modal-dialog" style="width:80% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة عنصر  </h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-12">
                                <form method="post" id="add-form-item-detail">
                                    <div class="box .no-border">
                                        <!-- /.box-header -->
                                        <div class="box-body">
                                            <!-- Input addon -->
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    <div class="col-lg-9">
                                                        <div class="form-group">
                                                            <label for="ed-name"> العناصر</label>
                                                            <div class="input-group">
                                                                <span class="input-group-addon"><i class="fa fa-home"></i></span>
                                                                <input id="ad-id" class="ed-id hidden" name="ad-id" />
                                                                <input type="text" class="form-control  ed-name" id="ad-name" name="adname" placeholder="العنصر " autocomplete="off">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-3">
                                                        <button type="submit" class="btn btn-primary" value="edit" style="width: 100%;position: relative;top: 25px;">حفظ</button>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                        <!-- /.box-body -->
                                    </div>

                                </form>
                            </div>
                        </div><!-- /.row (main row) -->

                    </div>
                    @*<div class="modal-footer">

                        </div>*@
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>



    <!-- show Modal housing -->
    <div class="example-modal-housing">
        <div class="modal fade in" id="show-modal-housing" data-backdrop="static">
            <div class="modal-dialog" style="width:80% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" id="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title">  العناصر </h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-12">

                                <div class="box .no-border">
                                    <!-- /.box-header -->
                                    <div class="box-body">
                                        <!-- Input addon -->
                                        <h4 id="ad-name2" class="ad-name2"></h4>
                                        <input id="ad-id2" class="ed-id2 hidden" name="ad-id2" />

                                        <table id="tbx2" class="table table-bordered table-hover"></table>

                                    </div>
                                    <!-- /.box-body -->
                                </div>


                            </div>
                        </div><!-- /.row (main row) -->

                    </div>
                    @*<div class="modal-footer">

                        </div>*@
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>



    <!-- edit Modal housing -->
    <div class="example-modal-housing">
        <div class="modal fade in" id="edit-modal-housing">
            <div class="modal-dialog" style="width:80% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> تعديل العنصر  </h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-12">
                                <form method="post" id="edit-form-housing">
                                    <div class="box .no-border">
                                        <!-- /.box-header -->
                                        <div class="box-body">
                                            <!-- Input addon -->
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    <div class="col-lg-9">
                                                        <div class="form-group">
                                                            <label for="ed-name"> العنصر</label>
                                                            <div class="input-group">
                                                                <span class="input-group-addon"><i class="fa fa-home"></i></span>
                                                                <input id="ed-id-h" class="ed-id-h hidden" name="ad-id-h" />
                                                                <input type="text" class="form-control  adname-detail" id="adname-detail" name="adnamedetail" placeholder="العنصر " autocomplete="off">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-3">
                                                        <button type="submit" class="btn btn-primary" value="edit" style="width: 100%;position: relative;top: 25px;">حفظ</button>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                        <!-- /.box-body -->
                                    </div>

                                </form>
                            </div>
                        </div><!-- /.row (main row) -->

                    </div>
                    @*<div class="modal-footer">

                        </div>*@
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>

}



@section scripts{

    <script>

     $(function () {


         function loadData() {
             dataTable = $('#tbx').DataTable({
                 "language": {
                     "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                     "search": "بحث"
                 },
                 ajax: {
                     url: '/Items/LoadData',
                     dataSrc: ''
                 },
                 columns: [
                     {
                         "title": "# ",
                         "data": "Id"
                     },
                     {
                         "title": "إسم  الصنف  ",
                         "data": "Name"
                     },

                     {
                         "title": "عدد العناصر  ",
                         "data": null,
                         "render": function (data) {
                             return '<input readonly class="btn btn-info transfer btn-number-in openHousingModal" value=" ' + data.Count + ' "/>'
                         }
                     },
                     {
                         "title": "<i class='fa fa-cog'></i>",
                         "data": null,
                         "width": "30%",
                         "orderable": false,
                         "render": function (data) {
                             return  '<div class="btn-opreation">'
                                          + '<button class="btn btn-success transfer openEditModal">تعديل <i class=" transfer-fa fa  fa-edit"></i></button> '
                                                                           + '<button class="btn btn-success transfer openAditModal">  إضافة عنصر جديد <i class=" transfer-fa fa  fa-edit"></i></button> '
                                 + '</div> '

                             ;

                         }
                     }


                 ]

             });

         }
         loadData();





         $('#add-form').bootstrapValidator({
             onSuccess: function (e) {
                 save();
                 e.preventDefault();

             },
             submitButtons: 'button[type="submit"]',
             feedbackIcons: {
                 valid: 'glyphicon glyphicon-ok success-feedback-icons',
                 invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                 validating: 'fa fa-refresh fa-spin success-feedback-icons'
             },
             fields: {
                 name: {
                     validators: {
                         notEmpty: {
                             message: 'يجب الا يكون حقل الصنف  فارغ'
                         }
                     }
                 }

             }
         });
         //$('#adit-form-housing').bootstrapValidator({
         //    onSuccess: function (e) {
         //        saveHousing();
         //        e.preventDefault();

         //    },
         //    submitButtons: 'button[type="submit"]',
         //    feedbackIcons: {
         //        valid: 'glyphicon glyphicon-ok success-feedback-icons',
         //        invalid: 'glyphicon glyphicon-remove error-feedback-icons',
         //        validating: 'fa fa-refresh fa-spin success-feedback-icons'
         //    },
         //    fields: {
         //        name: {
         //            validators: {
         //                notEmpty: {
         //                    message: 'يجب الا يكون حقل المحلية  فارغ'
         //                }
         //            }
         //        }

         //    }
         //});
     });




     function save() {


         var ob = {
             "Name": $('#name').val()
         };
         $.ajax({
             url: "@Url.Action("Save", "Items")",
             type: "POST",
             data: JSON.stringify(ob),
             contentType: "application/json charset=utf-8",
             dataType: "json",
             error: function (response) {
                 //toastr[response.Status](response.Message, response.Title);
             },
             success: function (response) {
                 toastr[response.Status](response.Message, response.Title);
                 $('.name').val(null);
                 $('#add-modal').modal('hide');
                 dataTable.ajax.reload();

             }
         });

     }

     function saveItemDetails() {


         var ob = {
             "Name": $('#ad-name').val(),
             "Id": $('#ad-id').val()
         };
         $.ajax({
             url: "@Url.Action("SaveItemDetails", "Items")",
             type: "POST",
         data: JSON.stringify(ob),
         contentType: "application/json charset=utf-8",
         dataType: "json",
         error: function (response) {
             //toastr[response.Status](response.Message, response.Title);
         },
         success: function (response) {
             toastr[response.Status](response.Message, response.Title);
             $('.name').val(null);
             $('#add-modal-item-detail').modal('hide');
             dataTable.ajax.reload();

         }
     });

     }


         //End Document Ready


         ///////////////////////////////////////////////////////////////////////

         //Open Edit Modal
         $("#tbx").on('click', '.openEditModal', function () {
             // get the current row
             var currentRow = $(this).closest("tr");

             $('#ed-id').val(currentRow.find("td:eq(0)").text());
             $('#edname').val(currentRow.find("td:eq(1)").text()); // get current row 1st TD value
             $('#edit-modal').modal('show');

         });




         //Open Edit Modal Housing
         $("#tbx2").on('click', '.openEditModalHousing', function () {
             // get the current row
             var currentRow = $(this).closest("tr");

             $('#ed-id-h').val(currentRow.find("td:eq(0)").text());
             $('#adname-detail').val(currentRow.find("td:eq(1)").text()); // get current row 1st TD value
             $('#edit-modal-housing').modal('show');

         });



         $("#close").on('click',  function () {

             window.location.reload();

         });

         //Open Adit Modal item detail
         $("#tbx").on('click', '.openAditModal', function () {
             // get the current row
             $('#ad-name').val(null);
             var currentRow = $(this).closest("tr");

             $('#ad-id').val(currentRow.find("td:eq(0)").text());
            // $('#ad-name').val(currentRow.find("td:eq(1)").text()); // get current row 1st TD value
             $('#add-modal-item-detail').modal('show');

         });

     //Open show  Modal HOUSING
         $("#tbx").on('click', '.openHousingModal', function () {
             // get the current row

             var currentRow = $(this).closest("tr");

             $('#ad-id2').val(currentRow.find("td:eq(0)").text());
             $('#ad-name2').text(currentRow.find("td:eq(1)").text()); // get current row 1st TD value
             var x=currentRow.find("td:eq(0)").text();
             $('#show-modal-housing').modal('show');
             console.log(x);


             loadDataItemDetail(x);
             // dataTable2.clear().draw();

         });

         //Validation And Save Edit Data
         $('#add-form-item-detail').bootstrapValidator({
             onSuccess: function (e) {
                 saveItemDetails();
                 e.preventDefault();

             },
             submitButtons: 'button[type="submit"]',
             feedbackIcons: {
                 valid: 'glyphicon glyphicon-ok success-feedback-icons',
                 invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                 validating: 'fa fa-refresh fa-spin success-feedback-icons'
             },
             fields: {
                 adname: {
                     validators: {
                         notEmpty: {
                             message: 'يجب الا يكون حقل اسم العنصر فارغ'
                         }
                     }
                 },


             }
         });


         //Validation And Save Edit Data
         $('#edit-form').bootstrapValidator({
             onSuccess: function (e) {
                 edit();
                 e.preventDefault();

             },
             submitButtons: 'button[type="submit"]',
             feedbackIcons: {
                 valid: 'glyphicon glyphicon-ok success-feedback-icons',
                 invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                 validating: 'fa fa-refresh fa-spin success-feedback-icons'
             },
             fields: {
                 edname: {
                     validators: {
                         notEmpty: {
                             message: 'يجب الا يكون حقل اسم الصنف فارغ'
                         }
                     }
                 }
             }
         });





         //Validation And Save Edit Housing Data
         $('#edit-form-housing').bootstrapValidator({
             onSuccess: function (e) {
                 editItemDetail();
                 e.preventDefault();

             },
             submitButtons: 'button[type="submit"]',
             feedbackIcons: {
                 valid: 'glyphicon glyphicon-ok success-feedback-icons',
                 invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                 validating: 'fa fa-refresh fa-spin success-feedback-icons'
             },
             fields: {
                adnamedetail: {
                     validators: {
                         notEmpty: {
                             message: 'يجب الا يكون حقل اسم العنصر فارغ'
                         }
                     }
                 },



             }
         });

         function edit() {


             var ob = {
                 "Id": $('#ed-id').val(),
                 "Name": $('#edname').val(),

             };
             $.ajax({
                 url: "@Url.Action("Edit", "Items")",
                 type: "POST",
             data: JSON.stringify(ob),
             contentType: "application/json charset=utf-8",
             dataType: "json",
             error: function (response) {
                 //toastr[response.Status](response.Message, response.Title);
             },
             success: function (response) {
                 toastr[response.Status](response.Message, response.Title);
                 $('#edit-modal').modal('hide');
                 dataTable.ajax.reload();

             }
         });
         };



     function editItemDetail() {


         var ob = {
             "Id": $('#ed-id-h').val(),
             "Name": $('#adname-detail').val(),

         };
         $.ajax({
             url: "@Url.Action("EditItemDetails", "Items")",
             type: "POST",
         data: JSON.stringify(ob),
         contentType: "application/json charset=utf-8",
         dataType: "json",
         error: function (response) {
             //toastr[response.Status](response.Message, response.Title);
         },
         success: function (response) {
             toastr[response.Status](response.Message, response.Title);
             $('#edit-modal-housing').modal('hide');
             dataTable2.ajax.reload();
             window.location.reload

         }
     });
     };

     function loadDataItemDetail(id) {
         console.log(id);

         dataTable2 = $('#tbx2').DataTable({
             "language": {
                 "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                 "search": "بحث"
             },
             ajax: {
                 url: '/Items/LoadDataItemDetail/' + id,
                 dataSrc: ''

             },
             columns: [
                 {
                     "title": "# ",
                     "data": "Id"
                 },
                 {
                     "title": "إسم  العنصر  ",
                     "data": "Name"
                 },


                 {
                     "title": "<i class='fa fa-cog'></i>",
                     "data": null,
                     "width": "30%",
                     "orderable": false,
                     "render": function (data) {
                         return '<div class="btn-opreation">'
                                      + '<button class="btn btn-success transfer openEditModalHousing">تعديل <i class=" transfer-fa fa  fa-edit"></i></button> '

                             + '</div> '

                         ;

                     }
                 }


             ]

         });



     }
    </script>
}




