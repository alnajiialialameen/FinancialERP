@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

@section content{

    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <div class="grad"></div>

        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>
                دليل االبنوك
            </h1>
            <ol class="breadcrumb">
                <li><a href="#"><i class="fa fa-home"></i>النظام المحاسبي </a></li>
                <li class="active"> دليل البنوك</li>
            </ol>
        </section>

        <section class="content">
            <div class="row">
                <div class="col-xs-12">
                    <div class="box">
                        <div class="box-header">
                            <button type="button" class="btn btn-primary pull-left btn-add"><i class="fa fa-plus-square">  </i> اضافة </button>
                        </div>
                        <div class="box-body">
                            <table id="tbx" class="table table-bordered table-hover"></table>
                        </div><!-- /.box-body -->
                    </div><!-- /.box -->
                </div><!-- /.col -->
            </div><!-- /.row -->
        </section>
    </div>


    <div class="example-modal">
        <div class="modal fade in" id="add-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:80% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة  بنك جديد</h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-12">
                                <form method="post" id="addForm">
                                    <div class="box .no-border">
                                        <!-- /.box-header -->
                                        <div class="box-body">
                                            <!-- Input addon -->
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    <div class="box .no-border">
                                                        <!-- /.box-header -->
                                                        <div class="box-body">
                                                            <!-- Input addon -->
                                                            <div class="row">

                                                                <div class="col-lg-12">
                                                                    <div class="col-lg-6">
                                                                        <div class="form-group">
                                                                            <label for="name"> الحساب البنكي</label>
                                                                            <div class="input-group">
                                                                                <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                                                <input type="text" class="form-control name" name="name" id="name" placeholder=" اسم الحساب البنكي" autocomplete="off" />
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-6">
                                                                        <div class="form-group">
                                                                            <label for="number">رقم الحساب البنكي</label>
                                                                            <div class="input-group">
                                                                                <div class="input-group-addon">
                                                                                    <i class="fa  fa-sort-numeric-down"></i>
                                                                                </div>
                                                                                <input type="number" class="form-control number" name="number" id="number" placeholder=" رقم الحساب البنكي" autocomplete="off" />
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <div class="col-lg-6">
                                                                        <div class="form-group">
                                                                            <label for="account-type">نوع الحساب</label>
                                                                            <div class="input-group">
                                                                                <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                                                <select class="form-control account-type" id="account-type" name="account-type" style="width:100%"></select>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-6">
                                                                        <div class="form-group">
                                                                            <label for="currency"> العملة</label>
                                                                            <div class="input-group">
                                                                                <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                                                <select class="form-control currency" id="currency" name="currency" style="width:100%"></select>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-6">
                                                                        <div class="form-group">
                                                                            <label for="open-date">تاريخ فتح الحساب</label>
                                                                            <div class="input-group">
                                                                                <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                                                <input type="text" class="form-control calendar open-date" id="open-date" name="open-date" placeholder="تاريخ فتح الحساب البنكي" autocomplete="off">
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <div class="col-lg-6">
                                                                        <div class="form-group">
                                                                            <label for="iban">الرقم الدولي(IBAN)</label>
                                                                            <div class="input-group">
                                                                                <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                                                <input type="text" class="form-control iban" id="iban" name="iban" placeholder="الرقم الدولي" autocomplete="off">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="col-lg-12 ">
                                                                    <div class="pull-left">
                                                                        <label class="hidden" id="AccountSubId">AccountSubId</label>
                                                                        <label class="hidden" id="AccId">AccId</label>
                                                                        <label class="hidden" id="Id">Id</label>
                                                                        <button type="button" class="btn btn-default " data-dismiss="modal">رجوع</button>
                                                                        <button type="submit" class="btn btn-primary save">حفظ</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <!-- /.box-body -->
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- /.box-body -->
                                    </div>
                                </form>
                            </div>
                        </div><!-- /.row (main row) -->
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>

}

@section scripts{
    <script>
        var dataTable;

        $(function () {
            function loadData() {
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    ajax: {
                        url: '/BankAccounts/LoadData',
                        dataSrc: ''
                    },
                    columnDefs: [
                        {
                            "targets": [7, 8, 9, 10, 11],
                            "visible": false,
                            "sClass":"hidden-cell"
                        }
                    ],
                    columns: [
                        {
                            "title": "# ",
                            "data": "Id"
                        },
                        {
                            "title": "الحساب",
                            "data": "Name"
                        },
                        {
                            "title": "نوع الحساب",
                            "data": "Category"
                        },
                        {
                            "title": "رقم الحساب البنكي",
                            "data": "Number"
                        },
                        {
                            "title": "العملة",
                            "data": "CurrencyType"
                        },
                        {
                            "title": "تاريخ فتح الحساب",
                            "data": "OpenDate"
                        },
                        {
                            "title": "<i class='fa fa-cog'></i>",
                            "data": "Id",
                            "width": "20%",
                            "orderable": false,
                            "render": function (data) {
                                return '<div class="btn-opreation">'
                                             + '<button class="btn btn-success transfer openEditModal">تعديل <i class=" transfer-fa fa  fa-edit"></i></button> '
                                             + '<button class="btn btn-primary transfer btncheck " onClick="goToCheck(' + data + ')">الشيكات <i class=" transfer-fa fas fa-money-check"></i></button> '
                                    + '</div> ';
                            }
                        },
                        {
                            "title": "الرقم الدولي",
                            "data": "IBan"
                        },
                        {
                            "title": "نوع الحساب",
                            "data": "BankAccountTypeId"
                        },
                        {
                            "title": "نوع العملة",
                            "data": "CurrencyTypeId"
                        },
                        {
                            "title": "نوع العملة",
                            "data": "AccountSubId"
                        },
                        {
                            "title": "نوع العملة",
                            "data": "AccId"
                        },
                    ]
                });
            }

            loadData();

            function select2list(selector, url, placeholder) {
                $(selector).select2({
                    language: { inputTooShort: function () { return 'أدخل حرف واحد علي الاقل'; } },
                    ajax: {
                        url: url,
                        dataType: 'json',
                        delay: 100,
                        data: function (params) {
                            return {
                                q: params.term,
                                page: params.page
                            };
                        },
                        processResults: function (data, params) {
                            params.page = params.page || 1;
                            return {
                                results: data,
                                pagination: {
                                    more: ((data.total_count) > (params.page * 20))
                                }
                            };
                        },
                        cache: true
                    },
                    placeholder: placeholder,
                    minimumInputLength: 1,
                });
            };

            select2list(".currency", "/BankAccounts/GetCurrencyType", "عملة الحساب البنكي");
            select2list(".account-type", "/BankAccounts/GetBankAccountType", "نوع الحساب البنكي");

            function save() {
                var ob = {
                    "BankAccountTypeId": $("select[name='account-type']").val(),
                    "Number": $("input[name='number']").val(),
                    "OpenDate": $(".open-date").val(),
                    "CurrencyTypeId": $("select[name='currency']").val(),
                    "IBan": $('#iban').val(),
                    "AccName": $('#name').val(),
                    "accParentName": "البنوك",
                    "AccId": $('#AccId').text(),
                    "Id": $('#Id').text(),
                    "AccountSubId": $('#AccountSubId').text(),
                    "AccCategoryId": "1",//Category Id for Banks = 1
                };
                console.log(ob);
                var url = '';
                if ($('.save').text() == 'حفظ') {
                    url = '/BankAccounts/Create';
                } else {
                    url = '/BankAccounts/Update';
                }
                $.ajax({
                    url: url,
                    type: "POST",
                    data: JSON.stringify(ob),
                    contentType: "application/json charset=utf-8",
                    dataType: "json",
                    error: function (response) {
                        toastr[response.Status](response.Message, response.Title);
                    },
                    success: function (response) {
                        toastr[response.Status](response.Message, response.Title);

                        //$('#addForm').bootstrapValidator("resetForm", true);
                        $('#add-modal').modal('hide');
                        dataTable.ajax.reload();

                        $('.modal-title').text('إضافة بنك جديد');
                        $('.save').text('حفظ');
                        $('.save').removeClass('btn-warning');
                        $('.save').addClass('btn-primary');
                    }
                });
            };

        $('#addForm').bootstrapValidator({
            onSuccess: function (e) {
                save();
                e.preventDefault();

            },
            submitButtons: 'button[type="submit"]',
            excluded: [':disabled'],
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok success-feedback-icons',
                invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                validating: 'fa fa-refresh fa-spin success-feedback-icons'
            },
            fields: {
                name: {
                    validators: {
                        notEmpty: {
                            message: 'يجب الا يكون حقل اسم الحساب  فارغ'
                        }
                    }
                },
                number: {
                    validators: {
                        notEmpty: {
                            message: 'يجب ادخال رقم الحساب'
                        }
                    }
                },
                'account-type': {
                    validators: {
                        notEmpty: {
                            message: 'يجب ادخال نوع الحساب'
                        }
                    }
                },
                currency: {
                    validators: {
                        notEmpty: {
                            message: 'يجب تحديد نوع العملة لهذا الحساب'
                        }
                    }
                },
                'open-date': {
                    validators: {
                        notEmpty: {
                            message: 'يجب تحديد تاريخ فتح الحساب'
                        }
                    }
                },
                //iban: {
                //    validators: {
                //        notEmpty: {
                //            message: 'يجب تحديد الرقم الدولي IBAN '
                //        }
                //    }
                //},
            }
        });
   });//End Document Ready

        //Open Edd-Edit Modal
        $("#tbx").on('click', '.openEditModal', function () {
            // get the current row
            var currentRow = $(this).closest("tr");
        
            var data = $('#tbx').DataTable().row(currentRow).data();

            console.log(currentRow.find("td:eq(0)").text());

            $('#Id').text(currentRow.find("td:eq(0)").text());
            $('#name').val(currentRow.find("td:eq(1)").text());
            $('#number').val(currentRow.find("td:eq(3)").text());
            $('#open-date').val(currentRow.find("td:eq(5)").text());
            $('#currency').val(data['CurrencyTypeId']);
            $('#account-type').val(data['BankAccountTypeId']);
            $('#iban').val(data['IBan']);
            $('#AccountSubId'). text(data['AccountSubId']);
            $('#AccId').text(data['AccId']);

            $('.modal-title').html('تعديل بيانات البنك');
            $('.save').text('تعديل');
            $('.save').removeClass('btn-primary');
            $('.save').addClass('btn-warning');

            $('#add-modal').modal('show');
        
        }); 

        $('.btn-add').on('click', function () {
            //$('#addForm').bootstrapValidator({ "resetForm": true });

            $('#name').val(null);
            $('#number').val(null);
            $('#account-type').val(null);
            $('#currency').val(null);
            $('#open-date').val(null);
            $('#iban').val(null);

            $('.modal-title').text('إضافة بنك جديد');
            $('.save').text('حفظ');
            $('.save').removeClass('btn-warning');
            $('.save').addClass('btn-primary');
            $('#add-modal').modal('show');
        });

        function goToCheck(Id) {
                window.open('/BankAccounts/Check/' + Id, '_blank');
            }
    </script>

}