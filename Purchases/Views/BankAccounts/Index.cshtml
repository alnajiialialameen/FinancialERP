@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section content{
    <section class="d-flex flex-row justify-content-between align-items-center my-3">
        <h3>
            دليل البنوك
        </h3>

        <ol class="breadcrumb">
            <li>
                <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-house-fill"></i>
                    النظام المحاسبي >
                </a>
            </li>
            <li class="breadcrumb-item active">
                دليل البنوك
            </li>
        </ol>
    </section>


    <div class="content me-2">
        <div class="row">

            <!-- Left Table -->
            <div class="col-lg-3">
                <table id="tbx"
                       class="table table-bordered table-striped table-hover">
                </table>
            </div>

            <!-- Right Content -->
            <div class="col-lg-9">

                <form method="post" id="addForm">

                    <div class="card border-0">
                        <div class="card-body">

                            <div class="row g-3">

                                <!-- Bank Account Name -->
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="name" class="form-label">
                                            الحساب البنكي
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-cash-register"></i>
                                            </span>

                                            <input type="text"
                                                   class="form-control name"
                                                   disabled
                                                   name="name"
                                                   id="name"
                                                   placeholder="اسم الحساب البنكي"
                                                   autocomplete="off" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Account Number -->
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="number" class="form-label">
                                            رقم الحساب البنكي
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-sort-numeric-down"></i>
                                            </span>

                                            <input type="number"
                                                   class="form-control number"
                                                   name="number"
                                                   id="number"
                                                   placeholder="رقم الحساب البنكي"
                                                   autocomplete="off" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Account Type -->
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="account-type" class="form-label">
                                            نوع الحساب
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fa fa-cash-register"></i>
                                            </span>

                                            <select class="form-select account-type"
                                                    id="account-type"
                                                    name="account-type"
                                                    style="width:100%">
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <!-- Currency -->
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="currency" class="form-label">
                                            العملة
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fa fa-cash-register"></i>
                                            </span>

                                            <select class="form-select currency"
                                                    id="currency"
                                                    name="currency"
                                                    style="width:100%">
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <!-- Open Date -->
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="open-date" class="form-label">
                                            تاريخ فتح الحساب
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fa fa-cash-register"></i>
                                            </span>

                                            <input type="text"
                                                   class="form-control calendar open-date"
                                                   id="open-date"
                                                   name="open-date"
                                                   placeholder="تاريخ فتح الحساب البنكي"
                                                   autocomplete="off">
                                        </div>
                                    </div>
                                </div>

                                <!-- IBAN -->
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="iban" class="form-label">
                                            الرقم الدولي (IBAN)
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fa fa-cash-register"></i>
                                            </span>

                                            <input type="text"
                                                   class="form-control iban"
                                                   id="iban"
                                                   name="iban"
                                                   placeholder="الرقم الدولي"
                                                   autocomplete="off">
                                        </div>
                                    </div>
                                </div>

                                <!-- Bank Name -->
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="bankLabel" class="form-label">
                                            اسم البنك (البنك/الفرع)
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fa fa-cash-register"></i>
                                            </span>

                                            <input type="text"
                                                   class="form-control bankLabel"
                                                   id="bankLabel"
                                                   name="bankLabel"
                                                   placeholder="اسم البنك-الفرع"
                                                   autocomplete="off">
                                        </div>
                                    </div>
                                </div>

                                <!-- First Signature -->
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="firstSignature" class="form-label">
                                            اسم الموظف (توقيع أول)
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fa fa-cash-register"></i>
                                            </span>

                                            <input type="text"
                                                   class="form-control firstSignature"
                                                   id="firstSignature"
                                                   name="firstSignature"
                                                   placeholder="اسم الموظف (توقيع أول)"
                                                   autocomplete="off">
                                        </div>
                                    </div>
                                </div>

                                <!-- Second Signature -->
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="secondSignature" class="form-label">
                                            اسم الموظف (توقيع ثاني)
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fa fa-cash-register"></i>
                                            </span>

                                            <input type="text"
                                                   class="form-control secondSignature"
                                                   id="secondSignature"
                                                   name="secondSignature"
                                                   placeholder="اسم الموظف (توقيع ثاني)"
                                                   autocomplete="off">
                                        </div>
                                    </div>
                                </div>

                                <!-- Buttons -->
                                <div class="col-12">
                                    <div class="d-flex justify-content-start gap-2">

                                        <label class="d-none" id="AccountSubId">
                                            AccountSubId
                                        </label>

                                        <label class="d-none" id="AccId"></label>
                                        <label class="d-none" id="Id"></label>

                                        <button type="reset"
                                                class="btn btn-secondary"
                                                data-bs-dismiss="modal">
                                            الغاء
                                        </button>

                                        <button type="submit"
                                                class="btn btn-primary btnSave d-none">
                                            حفظ
                                        </button>

                                        <a href="#"
                                           target="_blank"
                                           class="btn btn-warning btnGetBankTransactions d-none">
                                            كل العمليات
                                        </a>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </form>

                <!-- Bank Transactions -->
                <div class="row mt-3">
                    <div class="col-12">
                        <table id="bankTransTbl"
                               class="table table-bordered table-striped table-hover">
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

}

@section scripts{
    <script>
        var dataTable;
        function loadData() {
            var accountSubId = 1;
            dataTable = $('#tbx').DataTable({
                paging: true,
                searching: false,
                "language": {
                    "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                    "search": "بحث"
                },
                ajax: {
                    url: '/BankAccounts/LoadData',
                    dataSrc: ''
                },
                columnDefs: [
                    {
                        "targets": [0, 3],
                        "className": "d-none",
                    },
                ],
                columns: [
                    {
                        "data": null,
                        "render": function (data) {
                            return `<i class="d-none getAccountSubId">${data.Id}</i>`;
                        }
                    },
                    {
                        "title": "الحساب",
                        "data": null,
                        "width": "90%",
                        "render": function (data) {
                            return `<i class="name">${data.Name}</i>`;
                        }
                    },
                    {
                        "title": "الشيكات",
                        "data": null,
                        "width": "10%",
                        "orderable": false,
                        "render": function (data) {
                            var bankId = parseInt(data.BankId);
                            if (bankId > 0) {
                                return '<a href="#"><i class="bi bi-cash check fs-3" style="color:green;"></i></a>';
                            }
                            else {
                                return '<a href="#"><i class="bi bi-cash check fs-3" style="color:red;"></i></a>';
                            }
                        }
                    },
                    {
                        "data": null,
                        "render": function (data) {
                            return `<i class="d-none bankId">${data.BankId}</i>`;
                        }
                    },
                    //{
                    //    "data": null,
                    //    "render": function (data) {
                    //        return `<i class="hidden AccTreeId">${data.AccTreeId}</i>`;
                    //    }
                    //}
                ]
            });
        }

        $(function () {
            loadData();

            select2list(".currency", "/BankAccounts/GetCurrencyType", "عملة الحساب البنكي");
            select2list(".account-type", "/BankAccounts/GetBankAccountType", "نوع الحساب البنكي");

        });
        //End Document Ready

        function save() {
            console.log($(".open-date").val());
            var ob = {
                "BankAccountTypeId": $("select[name='account-type']").val(),
                "Number": $("input[name='number']").val(),
                "OpenDate": $(".open-date").val(),
                "CurrencyTypeId": $("select[name='currency']").val(),
                "IBan": $('#iban').val(),
                "AccName": $('#name').val(),
                "BankLabel": $('#bankLabel').val(),
                "accParentName": "البنوك",
                "AccId": $('#AccId').text(),
                "Id": $('#Id').text(),
                "FirstSignature": $('#firstSignature').val(),
                "SecondSignature": $('#secondSignature').val(),
                "AccountSubId": $('#AccountSubId').text(),
                "AccCategoryId": "1",//Category Id for Banks = 1
            };
            console.clear();
            console.log(ob);
            var url = '';
            if ($('.btnSave').text() == 'حفظ') {
                url = '/BankAccounts/Create';
            } else {
                url = '/BankAccounts/Update';
            }
            $.ajax({
                url: url,
                type: "POST",
                data: JSON.stringify(ob),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                error: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                    
                }
            });
        };

        $('#addForm').on('submit', function (e) {
            e.preventDefault();
            save();
        });

        $("#tbx").on('click', '.name', function () {
            // get the current row
            var currentRow = $(this).closest("tr");
            //get AccountSubId which is hidden value
            var AccountSubId = currentRow.find("td:eq(0)").text();
            var name = currentRow.find("td:eq(1)").text();
            var AccTreeId = currentRow.find("td:eq(1)").text();

            $('#AccountSubId').text(AccountSubId);
            $('#name').val(name);
            $('#Id').text('');
            $('#AccId').text(AccTreeId);
            $('#open-date').val(null);
            console.clear();
            console.log(AccountSubId);

            $.ajax({
                url: '/BankAccounts/getBankData?accountSubId=' + AccountSubId,
                type: "GET",
                data: null,
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                success: function (data) {
                    $('.btnSave').removeClass('d-none');
                    $('.btnGetBankTransactions').removeClass('d-none');
                    $('#Id').text(data['Id']);
                    $('#name').val(name);
                    $('#number').val(data['Number']);
                    $('#bankLabel').val(data['BankLabel']);
                    $('#firstSignature').val(data['FirstSignature']);
                    $('#secondSignature').val(data['SecondSignature']);
                    $('#AccId').text(data['AccTreeId']);

                    // أنشئ خيار جديد واضفه
                    var option = new Option(data['BankAccountType'], data['BankAccountTypeId'], true, true);
                    $('#account-type').append(option).trigger('change');

                    // أنشئ خيار جديد واضفه
                    var option = new Option(data['CurrencyType'], data['CurrencyTypeId'], true, true);
                    $('#currency').append(option).trigger('change');

                    //$('#currency').val(data['CurrencyTypeId']);
                    $('#account-type').val(data['BankAccountTypeId']);
                    //var openDate = moment(data['OpenDate']).format("DD/MM/YYYY");
                    var openDate = data['OpenDate'];
                    $('#open-date').val(openDate);
                    $('#iban').val(data['IBan']);

                    $('.btnSave').text('تعديل');
                    $('.btnSave').removeClass('btn-primary').addClass('btn-warning');
                }
            });

            //loadTransactionData(AccountSubId);
        });

        $("#tbx").on('click', '.check', function () {
            // get the current row
            var currentRow = $(this).closest("tr");

            var BankId = currentRow.find("td:eq(3)").text();
            if (BankId > 0) {
                window.open('/BankAccounts/Check?Id=' + BankId, '_blank');
            } else {
                toastr['error']('يجب إدخال بيانات البنك أولا', 'خطأ');
            }
        });

        $('.btnGetBankTransactions').on('click', function (e) {
            e.preventDefault();
            var Id = $('#AccountSubId').text();
            window.open('/BankAccounts/BankTransactions/' + Id, '_blank');
        });

    </script>
}