@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section content{
    <!-- Content Header (Page header) -->

    <section class="d-flex flex-row justify-content-between align-items-center my-3">
        <h3>
            شيكات بنك /
            <span id="bankName">@ViewBag.bankName</span>
            <span class="hidden" id="bankId">@ViewBag.bankId</span>
        </h3>

        <ol class="breadcrumb">
            <li>
                <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-house-fill"></i>
                    النظام المحاسبي >
                </a>
            </li>
            <li class="breadcrumb-item active">
                دليل البنوك
            </li>
        </ol>
    </section>


    <section class="content">
        <div class="row">
            <div class="col-12">

                <div class="card border-0">

                    <div class="card-header bg-transparent border-0">
                        <button type="button"
                                class="btn btn-primary float-start btn-add"
                                data-bs-toggle="modal"
                                data-bs-target="#add-modal">

                            <i class="bi bi-plus-square"></i>
                            إضافة

                        </button>
                    </div>

                    <div class="card-body">

                        <table id="tbx"
                               class="table table-bordered table-hover"
                               style="width:100%">
                        </table>

                    </div>

                </div>

            </div>
        </div>
    </section>

    <div class="example-modal">

        <div class="modal fade"
             id="add-modal"
             tabindex="-1"
             aria-labelledby="add-modal-title"
             aria-hidden="true"
             data-bs-backdrop="static">

            <div class="modal-dialog  modal-dialog-scrollable modal-xl ">
                <div class="modal-content">

                    <!-- Modal Header -->
                    <div class="border-0 d-flex justify-content-between align-items-center m-3">
                        <h5 class="modal-title" id="add-modal-title">
                            إضافة شيك جديد
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body">

                        <form method="post" id="add-form">

                            <div class="card border-0">
                                <div class="card-body">

                                    <div class="row g-3">

                                        <!-- Book Number -->
                                        <div class="col-lg-4">
                                            <div class="form-group">
                                                <label for="BooKNumber"
                                                       class="form-label">
                                                    رقم الدفتر
                                                </label>

                                                <div class="input-group">
                                                    <span class="input-group-text">
                                                        <i class="bi bi-sort-numeric-down"></i>
                                                    </span>

                                                    <input type="number"
                                                           class="form-control BooKNumber"
                                                           name="BooKNumber"
                                                           id="BooKNumber"
                                                           placeholder="رقم الدفتر"
                                                           autocomplete="off" />
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Start From Number -->
                                        <div class="col-lg-4">
                                            <div class="form-group">
                                                <label for="StartFromNumber"
                                                       class="form-label">
                                                    يبدأ بالرقم
                                                </label>

                                                <div class="input-group">
                                                    <span class="input-group-text">
                                                        <i class="bi bi-sort-numeric-down"></i>
                                                    </span>

                                                    <input type="number"
                                                           class="form-control StartFromNumber"
                                                           name="StartFromNumber"
                                                           id="StartFromNumber"
                                                           placeholder="يبدأ بالرقم"
                                                           autocomplete="off" />
                                                </div>
                                            </div>
                                        </div>

                                        <!-- End To Number -->
                                        <div class="col-lg-4">
                                            <div class="form-group">
                                                <label for="EndToNumber"
                                                       class="form-label">
                                                    ينتهي بالرقم
                                                </label>

                                                <div class="input-group">
                                                    <span class="input-group-text">
                                                        <i class="bi bi-sort-numeric-down"></i>
                                                    </span>

                                                    <input type="number"
                                                           class="form-control EndToNumber"
                                                           name="EndToNumber"
                                                           id="EndToNumber"
                                                           placeholder="ينتهي بالرقم"
                                                           autocomplete="off" />
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Actions -->
                                        <div class="col-12">

                                            <div class="d-flex justify-content-between align-items-center">

                                                <div class="d-flex gap-2">
                                                    <button type="button"
                                                            class="btn btn-secondary"
                                                            data-bs-dismiss="modal">
                                                        رجوع
                                                    </button>

                                                    <button type="button"
                                                            onclick="save()"
                                                            class="btn btn-primary save">
                                                        حفظ
                                                    </button>
                                                </div>

                                                <div class="d-flex align-items-center gap-2">

                                                    <input type="checkbox"
                                                           class="form-check-input"
                                                           id="IsFinished"
                                                           value="1" />

                                                    <label class="form-check-label"
                                                           for="IsFinished">
                                                        مكتمل
                                                    </label>

                                                    <label id="CheckId"
                                                           class="d-none">
                                                    </label>

                                                </div>

                                            </div>

                                        </div>

                                    </div>
                                </div>
                            </div>

                        </form>

                    </div>

                </div>
            </div>
        </div>
    </div>

}

@section scripts{

    <script>
        var dataTable;
        $(function () {
            function loadData() {
                var bankId = $('#bankId').text();
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    ajax: {
                        url: '/BankAccounts/LoadCheckData/' + bankId,
                        dataSrc: ''
                    },
                    columns: [
                        {
                            "title": "# ",
                            "data": "Id"
                        },
                        {
                            "title": "رقم الدفتر",
                            "data": "BooKNumber"
                        },
                        {
                            "title": "يبدأ من الرقم",
                            "data": "StartFromNumber"
                        },
                        {
                            "title": "ينتهي في الرقم",
                            "data": "EndToNumber"
                        },
                        {
                            "title": "الحالة",
                            "data": "IsFinished",
                            "render": function (data) {
                                if (data != 'منتهي')
                                    return '<span class="success">غير منتهي</span>';
                                else
                                    return '<span class="error">منتهي</span>';
                            }
                        },
                        {
                            "title": "<i class='bi bi-cog'></i>",
                            "data": "Id",
                            "width": "10%",
                            "orderable": false,
                            "render": function (data) {
                                return '<div class="btn-opreation">'
                                             + '<button class="btn btn-success openEditModal"><i class="bi bi-pencil-square"></i></button> '
                                             + '<button class="btn btn-danger btncheck " onClick="Delete(' + data + ')"><i class="bi bi-trash"></i></button> '
                                     + '</div> ';

                            }
                        }
                    ]

                });
            }
            loadData();

        });//End Document Ready

        //Open Edit Modal
        $("#tbx").on('click', '.openEditModal', function () {
            // get the current row
            var currentRow = $(this).closest("tr");
            console.clear();
            console.log();

            $('#CheckId').text(currentRow.find("td:eq(0)").text());
            $('#BooKNumber').val(currentRow.find("td:eq(1)").text());
            $('#StartFromNumber').val(currentRow.find("td:eq(2)").text()); // get current row st 2TD value
            $('#EndToNumber').val(currentRow.find("td:eq(3)").text()); // get current row st 2TD value
            $('#IsFinished').val(currentRow.find("td:eq(4)").text());
            $('#add-modal').modal('show');
        });

        $('#add-form').on('submit', function (e) {
            e.preventDefault();
            save();
            this.reset();
        });

        function edit() {
            var IsFinished = false;

            if ($('.IsFinished').is(':checked')) {
                IsFinished = true;
            } else {
                IsFinished = false;
            }


            var ob = {
                "Id": $('#ed-id').val(),
                "Name": $('#ed-name').val(),
                "StructureCount": $('#edstructureCount').val(),
                "IsFinished": IsFinished
            };

            $.ajax({
                url: "@Url.Action("Edit", "Departments")",
                type: "POST",
                data: JSON.stringify(ob),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                    $('#edit-modal').modal('hide');
                    dataTable.ajax.reload();


                }
            });
        };

        $('#edit-form').on('submit', function (e) {
            e.preventDefault();
            edit();
            this.reset();
        });

        function save() {
            var IsFinished = 0;

            if ($('.IsFinished').is(':checked')) {
                IsFinished = 1;
            } else {
                IsFinished = 0;
            }

            var ob = {
                "Id": $('#CheckId').text(),
                "BankAccountId": $('#bankId').text(),
                "BooKNumber": $('.BooKNumber').val(),
                "StartFromNumber": $('.StartFromNumber').val(),
                "EndToNumber": $('.EndToNumber').val(),
                "IsFinished": IsFinished,
            };

            $.ajax({
                url: "@Url.Action("CreateOrUpdate", "BankAccounts")",
                type: "POST",
                data: JSON.stringify(ob),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    //toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    toastr[response.Status](response.Message, response.Title);

                    $('#add-modal').modal('hide');
                    //$('select').val(null).trigger('change');
                    dataTable.ajax.reload();
                }
            });
        }

        function Delete(Id) {
            $.ajax({
                url: "/BankAccounts/DeleteCheck/" + Id,
                type: "GET",
                data: null,
                contentType: "application/json charset=utf-8",
                error: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    toastr[response.Status](response.Message, response.Title);

                    $('#add-modal').modal('hide');
                    //$('select').val(null).trigger('change');
                    dataTable.ajax.reload();
                }
            });
        }
    </script>

}