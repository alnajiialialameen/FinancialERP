@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .displaying {
        display: none;
    }

    .ui-datepicker .ui-datepicker-next:hover {
        cursor: pointer;
    }
</style>

@section content{
    <!-- Content Header (Page header) -->

    <section class="d-flex flex-row justify-content-between align-items-center my-3">
        <h3>
            قيود البنوك
        </h3>

        <ol class="breadcrumb">
            <li>
                <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-house-fill"></i>
                    النظام المحاسبي >
                </a>
            </li>
            <li class="breadcrumb-item active">
                قيود البنوك 
            </li>
        </ol>
    </section>


    <section class="content">
        <div class="row">
            <div class="col-12">

                <div class="card border-0">

                    <label class="d-none" id="accountSubId">
                        @ViewBag.accountSubId
                    </label>

                    <div class="card-body">

                        @*<button class="btn btn-primary float-start"
                                     data-bs-toggle="modal"
                                     data-bs-target="#add-modal">
                                إضافة قيد
                            </button>*@

                        <h3 class="mb-3">
                            العمليات المحاسبية علي البنك / @ViewBag.AccName
                        </h3>

                        <div class="container-fluid px-0">

                            <table id="tbx"
                                   class="table table-bordered table-sm table-hover"
                                   style="width:100%">

                                <tfoot>
                                    <tr>
                                        <th colspan="2" class="text-end">
                                            إجمالي المدين:
                                        </th>

                                        <th colspan="3" class="text-end"
                                            id="totalDebitAmount">
                                        </th>

                                        <th colspan="3" class="text-end">
                                            إجمالي الدائن:
                                        </th>

                                        <th colspan="3" class="text-end"
                                            id="totalCreditAmount">
                                        </th>
                                    </tr>
                                </tfoot>

                            </table>

                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>


    <div class="example-modal">
        <div class="modal fade in" id="add-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:80% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة قيد جديد</h4>
                    </div>
                    <div class="modal-body">
                        <!-- Input addon -->

                        <form id="add-form">
                            <div class="row">
                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <label for="addAccName">اسم الحساب</label>
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="fa fa-book"></i>
                                            </div>
                                            <select class="form-control list addAccName" name="addAccName" id="addAccName" style="width:100%"></select>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <div class="flex">
                                            <label for="debitAmount">المبلغ المدين</label>
                                            <strong id="AmountCurrencyDecimalText" class="AmountCurrencyDecimalText"></strong>
                                        </div>
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="fa  fa-book"></i>
                                            </div>
                                            <input class="form-control debitAmount" type="text" name="debitAmount" id="debitAmount" placeholder="المبلغ مدين" autocomplete="off" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <div class="flex"><label for="creditAmount">المبلغ الدائن</label><strong id="AmountCurrencyDecimalTextCr" class="AmountCurrencyDecimalTextCr"></strong></div>
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="fa  fa-book"></i>
                                            </div>
                                            <input class="form-control creditAmount" type="text" name="creditAmount" id="creditAmount" placeholder="المبلغ" autocomplete="off" />
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-lg-12">
                                    <button type="submit" class="btn btn-info btn-block" onclick="addToTable()">ترحيل</button>
                                </div>
                            </div>

                        </form>

                        <br />

                        <div class="row">
                            <div class="col-lg-12">
                                <table id="example1" class="table table-bordered table-striped virtualTable">
                                    <thead>
                                        <tr>
                                            <th style="text-align:center ;width:150px;">#</th>
                                            <th style="text-align:center ;width:750px;">اسم الحساب</th>
                                            <th style="text-align:center ;width:750px;">مدين</th>
                                            <th style="text-align:center ;width:750px;">دائن</th>
                                            <th style="text-align:center;"><i class="fa fa-cogs"></i></th>
                                        </tr>
                                    </thead>
                                    <tbody class="myTbody"></tbody>
                                    <tfoot class="myTFoot" style="background-color: #000000; color: #ffffff; text-align: center;"></tfoot>
                                </table>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12 ">
                                <div class="pull-left">
                                    <button type="button" class="btn btn-default " data-dismiss="modal">رجوع</button>
                                    <button type="submit" id="btnSave" class="btn btn-primary">مراجعة القيد</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>

    <div class="example-modal">
        <div class="modal fade in" id="add-statement-modal" data-backdrop="static">
            <div class="modal-dialog" style="width:60% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة عملية جديدة</h4>
                    </div>
                    <div class="modal-body">
                        <form id="add-statement-form">
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="transactionDate"> تاريخ القيد</label>
                                        <div class="input-group">
                                            <span class="input-group-addon">
                                                <i class="fa fa-calendar-alt"></i>
                                            </span>
                                            <input type="text" class="form-control calendar transactionDate" id="transactionDate" name="transactionDate" placeholder="تاريخ القيد" autocomplete="off">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="addCurrencyType">العملة</label>
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="fa fa-money-bill-alt"></i>
                                            </div>
                                            <select class="form-control list addCurrencyType" name="addCurrencyType" id="addCurrencyType" style="width:100%"></select>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="documentType">نوع السند</label>
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="fa fa-key"></i>
                                            </div>
                                            @*<select class="form-control list documentType" name="documentType" id="documentType" style="width:100%"></select>*@
                                            <select class="form-control list documentType" name="documentType" id="documentType" style="width:100%"></select>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label for="recipient">اسم المستلم</label>
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="fa fa-user"></i>
                                            </div>
                                            @*<input type="text" class="form-control recipient" name="recipient" id="recipient" placeholder="اسم المستلم" style="width:100%" />*@
                                            <select class="form-control list recipient" name="recipient" id="recipient" style="width:100%"></select>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label for="statement">البيان</label>
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="fa fa-book"></i>
                                            </div>
                                            <textarea class="form-control statement" id="statement" name="statement"> @ViewBag.Note </textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <button type="submit" class="btn btn-success btnCreate" style="width: 100%;">حفظ</button>
                            </div>
                        </form>
                        <hr />
                        <div class="row">
                            <table class="table table-bordered table-striped table-hover">
                                <thead style="background-color:#808080">
                                    <tr class="text-center">
                                        <td>مدين</td>
                                        <td>دائن</td>
                                        <td>الحساب</td>
                                    </tr>
                                </thead>
                                <tbody class="presntTBody"></tbody>
                            </table>
                        </div>

                    </div><!-- /.modal-content -->
                </div><!-- /.modal-dialog -->
            </div><!-- /.modal -->
        </div>
    </div>

}

@section scripts{
    <script>
        var myId = 0;
        var dataTable;
        var creditAmountObj;
        var debitAmountObj;

        $(document).ready(function () {
            var accountSubId = $('#accountSubId').text();
            function loadData() {
                dataTable = $('#tbx').DataTable({
                    "language": {
                        "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                        "search": "بحث"
                    },
                    "columnDefs": [
                        {
                            "targets": 0,
                            "className": "text-center",
                        },
                    ],
                    ajax: {
                        url: '/BankAccounts/GetAllBankTransactionByBankId?accountSubId=' + accountSubId,
                        dataSrc: ''
                    },
                    columns: [
                        {
                            "title": "",
                            "data": "transactionId",
                            //"orderable": false,
                            "render": function (data) {
                                return '<a class="btn btn-info btnDetails" data-toggle="modal" data-target="#details-modal"><i class="bi bi-info fs-3"></i></a>';
                            }
                        },
                        {
                            "title": "# ",
                            "data": "transactionId"
                        },
                        {
                            "title": "البيان",
                            "data": "note"
                        },
                        {
                            "title": "نوع القيد",
                            "data": "DocumentType"
                        },
                        {
                            "title": "المدين",
                            "data": "Debit",
                            "render": function (data, type, row) {
                                return formatNumber(data);
                            }
                        },
                        {
                            "title": "الدائن",
                            "data": "Credit",
                            "render": function (data, type, row) {
                                return formatNumber(data);
                            }
                        },
                        {
                            "title": "العملة",
                            "data": "Currency"
                        },
                        {
                            "title": "سعر الصرف",
                            "data": "ExchangeRate",
                            "render": function (data, type, row) {
                                return formatNumber(data);
                            }
                        },
                        {
                            "title": "الحالة",
                            "data": "IsDeleted",
                            "render": function (data, type, row) {
                                if (!data)
                                    return `<h5 class="text-success fs-3">غير ملغي</h5>`;
                                else
                                    return `<h5 class="text-danger">ملغي</h5>`;
                            }
                        },
                        {
                            "title": "تاريخ القيد",
                            "data": "transactionDateStr",
                            "width": "10%"
                        },
                        {
                            "title": "رقم الشيك",
                            "data": "CheckNo",
                            "width": "10%",
                            "render": function (data, type, row) {
                                if (data !== "No Check")
                                    return `<h5 class="text-success fs-3">${data}</h5>`;
                                else
                                    return `<h5 class="text-danger">${data}</h5>`;
                            }
                        }
                    ],

                    //"footerCallback": function (row, data, start, end, display) {
                    //    var api = this.api();

                    //    // دالة لتحويل النصوص لأرقام
                    //    var parseToFloat = function (value) {
                    //        return typeof value === 'string'
                    //            ? parseFloat(value.replace(/,/g, '')) || 0
                    //            : typeof value === 'number'
                    //                ? value
                    //                : 0;
                    //    };

                    //    let totalDebitAmount = 0;
                    //    let totalCreditAmount = 0;

                    //    // نجيب بيانات الصفحة الحالية فقط
                    //    const pageRows = api.rows({ page: 'current' }).data();

                    //    // نحسب فقط للصفوف غير الملغاة
                    //    pageRows.each(function (row) {
                    //        if (!row.IsDeleted) {
                    //            totalCreditAmount += parseToFloat(row.Credit);
                    //            totalDebitAmount += parseToFloat(row.Debit);
                    //        }
                    //    });

                    //    // نعرض المجموع في فوتر العمود الرابع (index = 4)
                    //    $(api.column(9).footer()).html(formatNumber(totalCreditAmount));
                    //    $(api.column(4).footer()).html(formatNumber(totalDebitAmount));
                    //}




                    "footerCallback": function (row, data, start, end, display) {

                        const api = this.api();

                        const parseToFloat = function (value) {
                            if (typeof value === 'string') {
                                return parseFloat(value.replace(/,/g, '')) || 0;
                            }

                            return typeof value === 'number' ? value : 0;
                        };

                        let totalDebitAmount = 0;
                        let totalCreditAmount = 0;

                        // بيانات الصفحة الحالية
                        api.rows({ page: 'current' }).data().each(function (row) {

                            if (row.IsDeleted === false || row.IsDeleted === 0) {

                                totalDebitAmount += parseToFloat(row.Debit);
                                totalCreditAmount += parseToFloat(row.Credit);

                            }

                        });

                        // تحديث الـ Footer باستخدام IDs مباشرة
                        $('#totalDebitAmount').html(formatNumber(totalDebitAmount));
                        $('#totalCreditAmount').html(formatNumber(totalCreditAmount));

                    }

                });

            }
            loadData();

        });

    </script>
}