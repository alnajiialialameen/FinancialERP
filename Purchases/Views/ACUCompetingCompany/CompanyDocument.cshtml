        function AddCompetingCompany() {
            var OrderId = $('#OrderId').text();
            window.location.href = "/ACUCommitteFormations/AllEmployees/" + OrderId;
        }

        function UpdateCompetingCompany() {
            var EmployeeId = $('#EmployeeId').text();
            var Id = $('#Id').text();
            var CommitteeJobId = $('#CommitteeJobId').val();

            obj = {
                "EmployeeId": EmployeeId,
                "CommitteeJobId": CommitteeJobId,
                "Id": Id,
            };

            console.clear();
            console.log(obj);

            $.ajax({
                "type": "POST",
                "url": '/ACUCommitteFormations/UpdateMember',
                "dataType": "json",
                "traditional": true,
                "data": JSON.stringify(obj),
                "contentType": "application/json  charset=utf-8",
                "error": function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                "success": function (response) {
                    toastr[response.Status](response.Message, response.Title);
                    dataTable.ajax.reload();
                    $('#myModal').modal('toggle');
                }
            });

