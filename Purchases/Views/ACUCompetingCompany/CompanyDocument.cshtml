        function Save() {
            var btnText = $('.btnSave').text();
            var Title = $('#Titles').val();
            var Note = $('#Notes').val();
            var ImagePath = $('#ImagePath').val();
            var CompetingCompanyId = $('#CompanyId').text();
            var Id = $('#DocumentId').text();
            var ACUCompetingCompanyDocumentId = $('#ACUCompetingCompanyDocumentId').text();

            obj = {
                "Title": Title,
                "Note": Note,
                "ImagePath": ImagePath,
                "CompetingCompanyId": CompetingCompanyId,
                "Id": ACUCompetingCompanyDocumentId
            };

            //debugger;
            var fileUpload = $("#ImagePath").get(0);
            var files = fileUpload.files;

            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);
            }

            // Adding one more key to FormData object
            fileData.append("Title", $('#Titles').val());
            fileData.append("Id", $('#DocumentId').text());
            fileData.append("Note", $('#Notes').val());
            fileData.append("CompetingCompanyId", CompetingCompanyId);
            fileData.append("Id", ACUCompetingCompanyDocumentId);
           

            console.clear();
            console.log(obj);
            var url= '';
            if (btnText == 'حفظ')
            {
                url = '/ACUCompetingCompany/AddDocument';
            }else{
                url = '/ACUCompetingCompany/UpdateDocument';
            }

            console.clear();
            console.log(url);
            $.ajax({
                "type": "POST",
                "url": url,
                //"dataType": "json",
                "traditional": true,
                "contentType": false, // Not to set any content header
                "processData": false,
                //"data": JSON.stringify(obj),
                "data": fileData,
                //"contentType": "application/json  charset=utf-8",
                "error": function (response) {
                    toastr[response.Status](response.Message, response.Title);
                    $('#myModal').modal('toggle');
                    $('#tbx').DataTable().ajax.reload();
                },
                "success": function (response) {
                    $('#myModal').modal('toggle');
                    //$('#tbx').DataTable().ajax.reload();
                    window.location.reload();
                    toastr[response.Status](response.Message, response.Title);
                }

        });
        }


