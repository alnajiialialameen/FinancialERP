@model PagedList.IPagedList<Purchases.Models.ViewModal.CompanyDocumentViewModel>

@using PagedList.Mvc;
@using Purchases.Models;

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    Entities db = new Entities();
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    @section content{
        <div>
            <div class="content-wrapper">
                <label class="hidden" id="CompanyId">@ViewBag.CompanyId</label>
                <label class="hidden" id="OrderId">@ViewBag.OrderId</label>
                <label class="hidden" id="ACUCommitteFormationId">@ViewBag.ACUCommitteFormationId</label>
                <label id="EmployeeId" class="hidden">EmployeeId</label>
                <!-- Content Header (Page header) -->
                <section class="content-header">
                    <h1>
                        مستندات شركة/ @ViewBag.CompanyName
                    </h1>
                    <ol class="breadcrumb">
                        <li><a href="#"><i class="fa fa-dashboard"></i> Home</a></li>
                        <li><a href="#">Examples</a></li>
                        <li class="active">User profile</li>
                    </ol>
                </section>
                
                <section class="content-header">
                    @*<div class="row ml-4">*@
                        <button class="btn btn-primary btnAdd pull-left" data-toggle="modal" data-target="#myModal"> مستند جديد <i class="fa fa-plus square"></i></button>
                    @*</div>*@
                </section>
                <br /><br />
                <!-- Main content -->
                <section class="content">
                    <div class="row">
                        <div class="col-md-3">
                            <!-- About Me Box -->
                            <div class="box box-primary">
                                <div class="box-header with-border">
                                    <h3 class="box-title">تفاصيل الشركة</h3>
                                </div>
                                <!-- /.box-header -->
                                <div class="box-body">
                                    <strong><i class="fa fa-dice-four margin-r-5"></i> اسم الشركة</strong>
                                   
                                    <p class="text-muted">
                                        @ViewBag.CompanyName
                                    </p>
                                    <hr>
                                    <strong><i class="fa fa-id-card margin-r-5"></i> الترخيص</strong>

                                    <p class="text-muted">@ViewBag.LicenseNumber</p>
                                    <hr>
                                    <strong><i class="fa fa-map-marker margin-r-5"></i> العنوان</strong>

                                    <p class="text-muted">@ViewBag.Address</p>
                                    <hr>
                                    <strong><i class="fa fa-envelope margin-r-5"></i> الايميل</strong>

                                    <p class="text-muted">@ViewBag.Email</p>
                                    <hr>
                                    <strong><i class="fa fa-phone margin-r-5"></i> أرقام التلفونات</strong>
                                    <p>
                                        <span class="text-muted">@ViewBag.Phones </span>
                                    </p>
                                    <hr>
                                    <strong><i class="fa fa-info margin-r-5"></i> ملحوظات</strong>

                                    <p class="text-muted">@ViewBag.Status</p>
                                </div>
                                <!-- /.box-body -->
                            </div>
                            <!-- /.box -->
                            
                        </div>
                        <!-- /.col -->
                        <div class="col-md-9">

                            <div class="row">
                                @foreach (var item in Model.ToList())
                                { 
                                    <div class="col-lg-4">
                                        <div class="box box-primary">
                                            <div class="box-body box-profile">
                                                @*<h3 class="profile-username text-center" id="OrderDescription">هنا العنوان</h3>*@
                                                <h5 class="profile-username text-center" style="margin-bottom:15px;" id="Title">@item.Title</h5>
                                                <h5 class="profile-username text-center hidden" id="ACUCompetingCompanyDocumentId">@item.Id</h5>

                                                <center>
                                                    <a href="../../@item.ImagePath" target="_blank"><img src="~/Uploads/pdf1.png" height="150" width="150" /></a>
                                                </center>

                                                <p class="text-muted text-center note" style="margin-top:15px; white-space:nowrap; overflow:hidden; text-overflow: ellipsis;" id="Note">@item.Note</p>
                                                <style>
                                                    .note:hover {
                                                     white-space:initial !important; 
                                                     overflow:auto; 
                                                     text-overflow: initial;
                                                    }
                                                </style>
                                                <div class="profile-username">
                                                    <div class="col-4">
                                                        
                                                    </div>
                                                    <div class="col-4">
                                                        <a href="#" class="btn btn-warning btn-block col-md-3" onclick="getDocumentForUpdate(@item.Id)"><b>تعديل</b></a>
                                                    </div>
                                                    <div class="col-4">
                                                        <a href="#" class="btn btn-danger btn-block col-md-3 pull-left" onclick="DeleteDocument(@item.Id, @item.CompetingCompanyId)"><b>حذف</b></a>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- /.box-body -->
                                        </div>
                                    </div>
                                    <!-- /.col -->
                                }
                            </div>
                            <hr style="border-top: 1px solid #948484;" />


                            صفحة  @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) من  @Model.PageCount  (عدد كل العناصر @ViewBag.ItemCount)

                            <div id="contentPager">
                                @Html.PagedListPager(Model, page => Url.Action("CompanyDocument", new { Id = ViewBag.CompanyId, page = page }))
                            </div>

                            <br />
                        </div>

                        <!-- /.row -->
                    </div>

                </section>
                <!-- /.content -->
            </div>
        </div>


        <div class="modal fade in" id="myModal" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog" style="width:50% !important">
                <div class="modal-content">
                    <form method="post" id="add-form">
                        <div class="modal-header .no-border">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title"> إضافة مستند جديدة</h4>
                            <label class="hidden" id="DocumentId"></label>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-lg-12">

                                    <div class="row">
                                        <div class="col-lg-6">
                                            <div class="form-group">
                                                <label for="name"> عنوان المستند </label>
                                                <input class="form-control" id="Titles" onkeyup="return validateText(this.value, 'Titles');" placeholder="اسم المستند" />
                                            </div>
                                        </div>

                                        <div class="col-lg-6">
                                            <div class="form-group">
                                                <label for="name">اختار المستند</label>
                                                @*<input class="form-control" id="Name" onkeyup="return validateText(this.value, 'Name');" name="Name" placeholder="اسم المستند" />*@
                                                <input type="file" id="ImagePath" name="ImagePath" accept="application/pdf">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <label for="name"> الملحوظات </label>
                                                <textarea class="form-control" id="Notes" placeholder="الملحوظات" rows="4"></textarea>
                                            </div>
                                        </div>
                                    </div>

                                    @*<div class="row">
                                        <div class="col-3">
                                            <input type="checkbox" id="status" value="1" />
                                            <label>مفعلة</label>
                                        </div>
                                    </div>*@
                                </div>
                            </div><!-- /.row (main row) -->

                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary btnSave pull-right">حفظ</button>
                            <button class="btn btn-danger btnCancel" data-dismiss="modal">إلغاء</button>
                        </div>
                    </form>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div>
        <!-- /.modal -->

    }

