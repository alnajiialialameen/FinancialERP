                                <div style="margin-right: 40px;">
                                    <img src="~/Temp/Image/Tree4.png" height="50" />
                                </div>
                                <div id="Refresh-Tree">
                                    @Html.Partial("_Tree")
                                </div>
                                <div>
                                </div>

                                <label id="FinancialCycleId" class="hidden">@ViewBag.FinancialCycleId</label>

                                <table id="dataTable" class="table table-bordered table-sm table-hover" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>الرقم </th>
                                            <th>الحساب</th>
                                            <th>تحت حساب</th>
                                            <th> الحساب الاب</th>
                                            <th>العمليات</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div><!-- /.box-body -->
                        </div><!-- /.box -->
                    </div><!-- /.col -->
                </div><!-- /.row -->
            </div>
        </section>
    </div>

    <div class="example-modal">
        <div class="modal fade" id="add-modal">
            <div class="modal-dialog" style="width:80% !important">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> إضافة حساب جديد</h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-12">
                                <form method="post" id="add-form">
                                    <div class="box-body">
                                        <div class="row">
                                            <div class="col-lg-12 our-title">
                                                <span id="addAccParentName" class="addAccParentName">الحساب الاب</span>
                                                <span id="addAccParent" class="addAccParent hidden"></span>
                                            </div>
                                            <div class="col-lg-12">
                                                <div class="col-lg-6">
                                                    <div class="form-group">
                                                        <label for="addAccName">  اسم الحساب</label>
                                                        <div class="input-group">
                                                            <div class="input-group-addon">
                                                                <i class="fa fa-book"></i>
                                                            </div>
                                                            <input class="form-control addAccName" name="addAccName" id="addAccName" placeholder="اسم الحساب" autocomplete="off" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6">
                                                    <div class="form-group">
                                                        <label for="addAccFinal">الحساب الختامي</label>
                                                        <div class="input-group">
                                                            <div class="input-group-addon">
                                                                <i class="fa  fa-book"></i>
                                                            </div>
                                                            <select class="form-control list addAccFinal" name="addAccFinal" id="addAccFinal" style="width:100%"></select>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-12">
                                                <div class="col-lg-6">
                                                    <div class="form-group">
                                                        <label for="addAccNature">  طبيعة الحساب</label>
                                                        <div class="input-group">
                                                            <span class="input-group-addon"><i class="fa fa-cash-register"></i></span>
                                                            <select id="addAccNature" name="addAccNature" class="form-control list addAccNature" placeholder="تحت بتد " style="width:100%"></select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6">
                                                    <div class="form-group">
                                                        <label for="addAccType">   نوع الحساب</label>
                                                        <div class="input-group">
                                                            <div class="input-group-addon">
                                                                <i class="fa  fa-book"></i>
                                                            </div>
                                                            <select class="form-control list addAccType" name="addAccType" id="addAccType" style="width:100%"></select>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-12">
                                                <div class="col-lg-6 hidden" id="AddAccSubDiv">
                                                    <div class="form-group">
                                                        <label for="addAccSub"> تصنيف الحساب الفرعي</label>
                                                        <div class="input-group">
                                                            <div class="input-group-addon">
                                                                <i class="fa fa-book"></i>
                                                            </div>
                                                            <select class="form-control list addAccSub" name="addAccSub" id="addAccSub" style="width:100%"></select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6">
                                                </div>
                                            </div>
                                            <div class="col-lg-12">
                                                <button id="btnAddToTable" class="btn btn-primary btn-block" onclick="event.preventDefault(); addToTable();">ترحيل</button>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <table id="example1" class="table table-bordered table-striped virtualTable">
                                                <thead>
                                                    <tr>
                                                        <th style="text-align:center ;width:750px;">اسم الحساب</th>
                                                        <th style="text-align:center ;width:750px;">الحساب الختامي </th>
                                                        <th style="text-align:center ;width:750px;"> نوع الحساب</th>
                                                        <th style="text-align:center ;width:750px;"> طبيعة الحساب</th>
                                                        <th style="text-align:center ;width:750px;">  ت.الحساب الفرعي</th>
                                                        <th style="text-align:center;"><i class="fa fa-cogs"></i></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="myTbody" class="myTbody"></tbody>
                                                <tfoot>
                                                </tfoot>
                                            </table>
                                        </div>
                                        <div class="row">
                                            <div class="col-lg-12 ">
                                                <div class="pull-left">
                                                    <button type="button" id="btnDismiss" class="btn btn-default " data-dismiss="modal">رجوع</button>
                                                    <button type="submit" id="btnSave" class="btn btn-primary save" onclick="saveVirtual()">حفظ</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>







    <div class="example-modal">
        <div class="modal fade in" id="edit-modal">
            <div class="modal-dialog" style="width:80% !important">
                <div class="modal-content">
                    <div class="modal-header .no-border">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" name="btnDismiss"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"> تعديل الحساب الاب</h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="box .no-border">
                                    <!-- /.box-header -->
                                    <div class="box-body">
                                        <!-- Input addon -->
                                        <div class="row">
                                            <div class="col-lg-12 our-title">
                                                <label class="text-danger h3">العام المالي الحالي : </label><label class="text-success h3">@ViewBag.Year</label>
                                                <label id="AccId" class="hidden"></label>
                                            </div>
                                            <div class="col-lg-6">
                                                <div class="form-group">
                                                    <label for="edAccName">  اسم الحساب</label>
                                                    <div class="input-group">
                                                        <div class="input-group-addon">
                                                            <i class="fa fa-book"></i>
                                                        </div>
                                                        <input class="form-control edAccName" disabled name="edAccName" id="edAccName" placeholder="اسم الحساب" autocomplete="off" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-6">
                                                <div class="form-group">
                                                    <label for="edAccParentNameOld"> اسم الحساب الاب</label>
                                                    <div class="input-group">
                                                        <div class="input-group-addon">
                                                            <i class="fa fa-book"></i>
                                                        </div>
                                                        <input class="form-control edAccParentNameOld" disabled name="edAccParentNameOld" id="edAccParentNameOld" placeholder="اسم الحساب" autocomplete="off" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-6">
                                                <div class="form-group">
                                                    <span> اسم الحساب الاب الجديد</span>
                                                    <div class="input-group">
                                                        <div class="input-group-addon">
                                                            <i class="fa fa-book"></i>
                                                        </div>
                                                        <select class="form-control list edAccParentName" id="edAccParentName" style="width:100%"></select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-lg-12 ">
                                                <div class="pull-left">
                                                    <button id="btnUpdate" class="btn btn-warning update" onclick="Update()">تعديل</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- /.box-body -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>

}


@section scripts{

    <script>
        $('#htmltree').jstree();

        var myId = 0;
        var dataTable;
        $(document).ready(function () {
            // جعل الضغط على span يفتح أو يغلق النود
            $('.tree').on('click', 'span', function (e) {
                var nodeId = $(this).closest('li').attr('id');
                var tree = $('.tree').jstree(true);
                tree.toggle_node(nodeId);
            });

            $('.tree').on('click', '.add-btn', function () {
                $('#add-modal').modal('show');
                // Get the text of the clicked node
                //// نجيب العنصر الأقرب لي الزر فقط
                //var nodeText = $(this).closest('li').find('.accName').text().trim();

                var nodeText = $(this).siblings('.accName').text().trim();

                $('.addAccParentName').text("الحساب الاب - " + nodeText);
                $('#addAccParent').text(nodeText);
            });

            dataTable = $("#dataTable").DataTable({
                "processing": true,
                // "serverSide": true,
                "ajax": {
                    "url": "/AccountTree/LoadData",
                    "type": "GET",
                    "datatype": "json",
                },
                "columns": [
                    {
                        "data": "Id",
                        "orderable": false,
                        "render": function (data) {
                            return '<button class="btn btn-info btnDetails" onclick="Detail(' + data + ')"><i class="fa fa-info"></i></button>';
                        }
                    },
                    { "data": "Id", "autowidth": true },
                    { "data": "AccName", "autowidth": true },
                    { "data": "AccParentName", "autowidth": true },
                    { "data": "GetParentNameList", "autowidth": true },
                    //{
                    //    "data": "Id", "width": "200px", "render": function (data) {
                    //        return '<button class="btn btn-danger transfer btn-dataTable" onclick="Delete(' + data + ')">  حذف </button> ' +
                    //            '<button class="btn btn-warning update transfer btn-dataTable" >تعديل</button> <button class="btn btn-default transfer btn-dataTable" onclick="Active(' + data
                    //            + ')">  تفعيل </button> ';
                    // }
                    //}

                    {
                        "data": null,
                        "width": "200px",
                        "render": function (data, type, row) {

                            var toggleButton = row.IsActive
                                ? ' <button class="btn btn-success transfer btn-dataTable" onclick="toggleActive(' + row.Id + ', false)"> مفعل </button>'
                                : ' <button class="btn btn-default transfer btn-dataTable" onclick="toggleActive(' + row.Id + ', true)"> غير مفعل </button>';

                            return '<button class="btn btn-danger transfer btn-dataTable" onclick="Delete(' + row.Id + ')"> حذف </button> ' +
                                '<button class="btn btn-warning update transfer btn-dataTable" >تعديل</button>' +
                                toggleButton;
                        }
                    }






                ],
                "rowCallback": function (row, data) {
                    if (!data.IsActive) {
                        $(row).css('background-color', '#FFC107'); // أصفر غامق                   
                    }
                },
                "language": {
                    "sProcessing": "جارٍ التحميل...",
                    "sLengthMenu": "أظهر _MENU_ مدخلات",
                    "sZeroRecords": "لم يعثر على أية سجلات",
                    "sInfo": "إظهار _START_ إلى _END_ من أصل _TOTAL_ مدخل",
                    "sInfoEmpty": "يعرض 0 إلى 0 من أصل 0 سجل",
                    "sInfoFiltered": "(منتقاة من مجموع _MAX_ مُدخل)",
                    "sInfoPostFix": "",
                    "sSearch": "ابحث:",
                    "sUrl": "",
                    "oPaginate": {
                        "sFirst": "الأول",
                        "sPrevious": "السابق",
                        "sNext": "التالي",
                        "sLast": "الأخير",
                    }
                }
            });

             



            select2list("#edAccParentName", "/AccountTree/GetAccountNoneSub", "اسم الحساب الاب");
            select2list("#addAccType", "/AccountTree/GetAccountType", "نوع الحساب ");
            select2list("#addAccNature", "/AccountTree/GetAccountNature", "  طبيعة الحساب ");
            select2list("#addAccFinal", "/AccountTree/GetAccountFinal", "  الحساب الختامي ");
            select2list("#addAccSub", "/AccountTree/GetAccountSubCategory", " تصنيف الحساب الفرعي ");

            //دي دالة ذر الحذف في الجدول الصغير
            $('.table-striped').on('click', '.btn-warning', function () {
                $(this).closest('tr').remove();

            });
        });

        // دالة فتح شاشة تفاصيل الحساب
        function Detail(Id) {
            window.open("/AccountTree/Detail/" + Id, "_blank");
        }

        //دالة فتح حقول الحساب الفرعي
        $('#addAccType').on('change', function (e) {
            var AccType = $(this).val();
            switch (AccType) {
                case "1":
                    $('#AddAccSubDiv').addClass('hidden');
                    break;
                case "2":
                    $('#AddAccSubDiv').removeClass('hidden');

                    setTimeout(function () {
                        select2list(".addAccSub", "/AccountTree/GetAccountSubCategory", " تصنيف الحساب الفرعي ");
                    }, 100);

                    break;
            }
        });

        //دي دالة ذر الحفظ
        //دي دالة الحفظ في الجدول ال في داتابيز
        function saveVirtual() {

            var data = [];

            var addAccParent = $('#addAccParent').text();
            var addAccParentName = $('.addAccParentName').text();

            $(".virtualTable tbody tr").each(function (index) {
                name = $(this).find('.name').text();
                final = $(this).find('.finalVal').text();
                type = $(this).find('.typeVal').text();
                nature = $(this).find('.natureVal').text();
                subCat = $(this).find('.subCatVal').text();

                data.push({
                    AccName: name,
                    AccParent: addAccParent,
                    AccTypeId: type,
                    AccNatureId: nature,
                    AccFinalId: final,
                    AccSubCategory: subCat
                });

            });
            console.clear();
            console.log(data);
            console.log(addAccParent);

            $.ajax({
                url: "/AccountTree/Create?accParentName=" + addAccParent,
                type: "POST",
                data: JSON.stringify(data),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    if (response.Status == "warning") {
                        toastr[response.Status](response.Message, response.Title);
                    } else {
                        toastr[response.Status](response.Message, response.Title);
                        window.location.reload();
                    }
                }
            });
        }

        // دي ما شغالة و بالتالي الدالة ال داخلها برضو ما شغالة
        $("#btnAddNode").click(function () {
            fillTreeName();
        });

        //-------------------------------------------------Start Add------------------------------------------------------------------------------------------------------------
        $('#add-form').bootstrapValidator({
            onSuccess: function (e) {
                saveVirtual();
                e.preventDefault();

            },
            submitButtons: 'button[type="submit"]',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok success-feedback-icons',
                invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                validating: 'fa fa-refresh fa-spin success-feedback-icons'
            },
            fields: {
                addAccName: {
                    validators: {
                        notEmpty: {
                            message: 'يجب الا يكون حقل اسم الادراة  فارغ'
                        }
                    }
                }

            }
        });
        //-------------------------------------------------End Add------------------------------------------------------------------------------------------------------------

        //-----------------------------------------------------------------Start Edit---------------------------------------------------------------

        //Open Edit Modal

        function getData(id) {
            fillTreeNameUpdate();

            $("#edit-modal").modal('show');

            $.ajax({
                type: "GET",
                url: "/AccountTree/GetDataForUpdate/" + id,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response != null) {
                        $('#edId').val(response.Id);
                        $('#edAccName').val(response.AccName);
                        $('#edAccCode').val(response.AccCode);
                        $('#edAccParent').val(response.AccParent);
                        $("#edAccParent").attr("disabled", "disabled");
                    } else {
                        alert("Something went wrong");
                    }
                },
                failure: function (response) {
                    //alert(response.responseText);
                },
                error: function (response) {
                    //alert(response.responseText);
                }
            });
        }

        //Validation And Save Edit Data
        $('#edit-form').bootstrapValidator({
            onSuccess: function (e) {
                edit();
                e.preventDefault();
            },
            submitButtons: 'button[type="submit"]',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok success-feedback-icons',
                invalid: 'glyphicon glyphicon-remove error-feedback-icons',
                validating: 'fa fa-refresh fa-spin success-feedback-icons'
            },
            fields: {
                edAccName: {
                    validators: {
                        notEmpty: {
                            message: 'يجب الا يكون حقل اسم الادارة  فارغ'
                        }
                    }
                }
            }
        });

        function edit() {
            var ob = {
                "Id": $('#edId').val(),
                "AccCode": $('#edAccCode').val(),
                "AccName": $('#edAccName').val(),
                "AccParent": $('#edAccParent').val()
            }

            $.ajax({
                url: "@Url.Action("Edit", "AccountTree")",
                type: "POST",
                data: JSON.stringify(ob),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                    dataTable.ajax.reload();
                    Refresh();
                    $('#edit-form').bootstrapValidator('resetForm', true);
                    $('#edit-modal').modal('hide');
                }
            });
        };

        function Refresh(id) {
            $("#AjaxLoader").show();

            $.get("/AccountTree/GetTreeParial", { id: id }, function (nn) {

                $("#Refresh-Tree").html(nn);
            });
        }

        function fillTreeName() {
            $('#addAccParent').empty();

            $.ajax({
                url: "/AccountTree/LoadTree",
                type: "GET",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    if (result) {
                        var x;
                        var html = "";
                        $.each(result, function (key, item) {
                            html += "<option value='" + item.Id + "'>" + item.AccName + "</option>";
                        });
                        $('#addAccParent').append(html);
                    }
                },
                error: function (errormessage) {
                    alert(errormessage.responseText);
                }

            });
        };

        function fillTreeNameUpdate() {
            $(document).ready(function () {
                $('#edAccParent').empty();
                $.ajax({
                    url: "/AccountTree/LoadTreeUpdate",
                    type: "GET",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    success: function (result) {
                        if (result) {
                            var x;
                            var html = "";
                            $.each(result, function (key, item) {
                                html += "<option value='" + item.Id + "'>" + item.AccName + "</option>";
                            });
                            $('#edAccParent').append(html);
                        }
                    },
                    error: function (errormessage) {
                        alert(errormessage.responseText);
                    }
                });
            });
        }

        //=========================================Cusrom Tree====================================================================//

        function Delete(id) {
            swal({
                title: "هل انت متاكد ",
                text: " OK تقوم بحذف العنصر! عند الضعط علي",
                icon: "warning",
                buttons: true,
                dangerMode: true,
            })
                .then((willDelete) => {
                    if (willDelete) {
                        $.get("/AccountTree/Delete", { id: id }, function (res) {
                            if (res) {
                                if (res.message != null && res.message === "Used") {
                                    //   toastr[response.Status](response.MessageText, response.Title);
                                    toastr.error("لايمكن حذف هذا العنصر ", "تعذر الحذف");
                                }

                                if (res.message != null && res.message === "Delete") {
                                    toastr.success("تم الحذف الحساب ", "الحذف");
                                    Refresh();
                                    /// toastr[response.Status](response.MessageText, response.Title);
                                }
                                dataTable.ajax.reload();
                            }
                        });
                    }
                });
        }

        function addToTable() {

            //هنا لازم ندخل اسم الحساب
            var addAccName = $('.addAccName').val();
            var addAccFinal = $('#select2-addAccFinal-container').text();
            var addAccType = $('#select2-addAccType-container').text();
            var addAccNature = $('#select2-addAccNature-container').text();
            var addAccSubCat = $('#select2-addAccSub-container').text();

            /**/
            var addAccFinalVal = $('.addAccFinal').val();
            var addAccTypeVal = $('.addAccType').val();
            var addAccNatureVal = $('.addAccNature').val();
            var addAccSubCatVal = $('.addAccSub').val();

            if (addAccTypeVal == 1) {
                addAccSubCat = '';
                addAccSubCatVal = '';
            }

            if (addAccName.trim() != "" & addAccFinalVal != null & addAccTypeVal != null & addAccNatureVal != null) {
                //var y = $('#addAccName').text();
                if ((addAccTypeVal == 2 & addAccSubCatVal != null) | addAccTypeVal == 1) {
                    var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                                    + "<td class='name'>" + addAccName + "</td>"
                                    + "<td class='nameVal hidden'>" + addAccName + "</td>"
                                    + "<td class='final'>" + addAccFinal + "</td>"
                                    + "<td class='finalVal hidden'>" + addAccFinalVal + "</td>"
                                    + "<td class='type'>" + addAccType + "</td>"
                                    + "<td class='typeVal hidden'>" + addAccTypeVal + "</td>"
                                    + "<td class='nature'>" + addAccNature + "</td>"
                                    + "<td class='natureVal hidden'>" + addAccNatureVal + "</td>"
                                    + "<td class='subCat'>" + addAccSubCat + "</td>"
                                    + "<td class='subCatVal hidden'>" + addAccSubCatVal + "</td>"
                                    + '<td  class="employeeName" > <button id="delete"onclick="return deletes()" class="btn btn-warning transfer ">حذف<i class=" transfer-fa fa  fa-edit"></i></button>' + "</td>"
                                    + "</tr>";
                    $('.myTbody').append(rows);
                    $('.addAccName').val('');
                    $('.list').text(null).trigger('change');
                    $('.list').val(null).trigger('change');
                } else {
                    toastr["error"]("يجب ادخال اسم الحساب الفرعي", "خطأ");
                }
            } else {
                toastr["error"]("يجب ادخال اسم الحساب", "خطأ");
            }
        }




        $('#dataTable').on('click', '.update', function () {

            var currentRow = $(this).closest("tr");
            var data = $('#dataTable').DataTable().row(currentRow).data();
            var AccName = data['AccName'];
            var AccParentNameOld = data['AccParentName'];
            var AccId = data['Id'];

            $('#AccId').text(AccId);
            $('#edAccParentNameOld').val(AccParentNameOld);
            $('#edAccName').val(AccName);
            $('#edit-modal').show();
        });

        $('.close').on('click', function () {
            $('#edit-modal').hide();
        });

        function Update() {
            var AccId = $('#AccId').text();
            var FinancialCycleId = $('#FinancialCycleId').text();
            var AccParentId = $('#edAccParentName').val();

            console.clear();
            console.log(AccId);
            console.log(FinancialCycleId);
            console.log(AccParentId);

            $.post('/AccountTree/UpdateAccTreeFinancialCycle', { Id: AccId, FinancialCycleId: FinancialCycleId, AccParentId: AccParentId }, function (response) {
                dataTable.ajax.reload();
                toastr[response.Status](response.Message, response.Title);
                $('#add-modal').hide();
            });
        }





        function toggleActive(id, status) {

            swal({
                title: "هل أنت متأكد؟",
                text: status ? "سيتم تفعيل العنصر" : "سيتم إلغاء تفعيل العنصر",
                icon: "warning",
                buttons: true,
                dangerMode: false,
            })
                .then((confirm) => {

                    if (confirm) {

                        $.get("/AccountTree/Active", { id: id, IsActive: status }, function (res) {

                            if (res.Status === "success") {
                                toastr.success(res.Message, "تم");
                            }
                            else {
                                toastr.error(res.Message, "خطأ");
                            }

                            dataTable.ajax.reload(null, false);
                        });
                    }
                });
        }










    </script>
}