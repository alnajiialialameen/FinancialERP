                function addToTable() {

                        //هنا لازم ندخل اسم الحساب
                        var addAccName = $('.addAccName').val();
                        var addAccFinal = $('#select2-addAccFinal-container').text();
                        var addAccType = $('#select2-addAccType-container').text();
                        var addAccNature = $('#select2-addAccNature-container').text();
                        var addAccSubCat = $('#select2-addAccSubCategory-container').text();

                    /**/
                    var addAccFinalVal = $('.addAccFinal').val();
                    var addAccTypeVal = $('.addAccType').val();
                    var addAccNatureVal = $('.addAccNature').val();
                    var addAccSubCatVal = $('.addAccSubCategory').val();

                    if(addAccTypeVal == 1){
                        addAccSubCat = '';
                        addAccSubCatVal = '';
                    }

                    if (addAccName.trim() != "" & addAccFinalVal != null & addAccTypeVal != null & addAccNatureVal != null) {
                    //var y = $('#addAccName').text();
                        if ((addAccTypeVal == 2 & addAccSubCatVal != null) | addAccTypeVal == 1) {
                            var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
