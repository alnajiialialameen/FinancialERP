            //                if (res) {
            //                    if (res.message != null && res.message === "Used") {
            //                        //   toastr[response.Status](response.MessageText, response.Title);
            //                        toastr.error("لايمكن حذف هذا العنصر ", "تعذر الحذف");
            //                    }

            //                    if (res.message != null && res.message === "Delete") {
            //                        toastr.success("تم الحذف الحساب ", "الحذف");
            //                        Refresh();
            //                        /// toastr[response.Status](response.MessageText, response.Title);
            //                    }
            //                    dataTable.ajax.reload();
