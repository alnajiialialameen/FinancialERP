                    var ob = {
                        "Id": $('#edId').val(),
                        "AccCode": $('#edAccCode').val(),
                        "AccName": $('#edAccName').val(),
                        "AccParent": $('#edAccParent').val(),
                        //"StructureCount": $('#edstructureCount').val()
                    };
