@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using Purchases.Models;
@{
    Entities db = new Entities();
    AccountTree Select = new AccountTree();
    List<AccountTree> Model = db.AccountTrees.ToList();
}
<style>
    .add-btn {
    }
</style>
@section content{
    <!-- Content Wrapper. Contains page content -->
    <!-- Content Header -->
    <section class="content-header py-3">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h4 class="mb-0">الشجرة المحاسبية</h4>
                </div>

                <div class="col-sm-6">
                    <ol class="breadcrumb mb-0 justify-content-sm-end">
                        <li class="breadcrumb-item">

                            <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                                <i class="bi bi-house-fill"></i>
                                النظام المحاسبي >
                            </a>
                        </li>
                        <li class="breadcrumb-item active">
                            الشجره المحاسبية
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">

                        <div class="container-fluid mt-4">
                            <div class="mb-3" style="margin-right: 40px;">
                                <img src="~/Temp/Image/Tree4.png" height="50" />
                            </div>

                            <div id="Refresh-Tree">
                                @Html.Partial("_Tree")
                            </div>

                            <label id="FinancialCycleId" class="d-none">
                                @ViewBag.FinancialCycleId
                            </label>

                            <div class="table-responsive">
                                <table id="dataTable"
                                       class="table table-bordered table-sm table-hover w-100">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>الرقم</th>
                                            <th>الحساب</th>
                                            <th>تحت حساب</th>
                                            <th>الحساب الأب</th>
                                            <th>العمليات</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- Add Account Modal -->
    <div class="modal fade" id="add-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-xl">
            <div class="modal-content">

                <div class="border-0 d-flex justify-content-between align-items-center m-3">
                    <h5 class="modal-title">إضافة حساب جديد</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">

                    <form method="post" id="add-form">

                        <div class="row">

                            <div class="col-12 our-title mb-3 text-center text-bold fs-3 text-danger">
                                <span id="addAccParentName" class="addAccParentName">
                                    الحساب الأب
                                </span>

                                <span id="addAccParent"
                                      class="addAccParent d-none">
                                </span>
                            </div>

                            <!-- Account Name & Final Account -->
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label for="addAccName" class="form-label">
                                        اسم الحساب
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-book"></i>
                                        </span>

                                        <input class="form-control addAccName"
                                               name="addAccName"
                                               id="addAccName"
                                               placeholder="اسم الحساب"
                                               autocomplete="off" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label for="addAccFinal" class="form-label">
                                        الحساب الختامي
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-book"></i>
                                        </span>

                                        <select class="form-select list addAccFinal"
                                                name="addAccFinal"
                                                id="addAccFinal"
                                                style="width:100%">
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Account Nature & Type -->
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label for="addAccNature" class="form-label">
                                        طبيعة الحساب
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-cash-stack"></i>
                                        </span>

                                        <select id="addAccNature"
                                                name="addAccNature"
                                                class="form-select list addAccNature"
                                                style="width:100%">
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label for="addAccType" class="form-label">
                                        نوع الحساب
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-book"></i>
                                        </span>

                                        <select class="form-select list addAccType"
                                                name="addAccType"
                                                id="addAccType"
                                                style="width:100%">
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Sub Account -->
                            <div class="col-lg-6 d-none" id="AddAccSubDiv">
                                <div class="mb-3">
                                    <label for="addAccSub" class="form-label">
                                        تصنيف الحساب الفرعي
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-book"></i>
                                        </span>

                                        <select class="form-select list addAccSub"
                                                name="addAccSub"
                                                id="addAccSub"
                                                style="width:100%">
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Add To Table -->
                            <div class="col-12 mb-3">
                                <button type="button"
                                        id="btnAddToTable"
                                        class="btn btn-primary w-100"
                                        onclick="event.preventDefault(); addToTable();">
                                    ترحيل
                                </button>
                            </div>

                        </div>

                        <!-- Virtual Table -->
                        <div class="table-responsive mb-3">
                            <table id="example1"
                                   class="table table-bordered table-striped virtualTable">
                                <thead>
                                    <tr>
                                        <th class="text-center">اسم الحساب</th>
                                        <th class="text-center">الحساب الختامي</th>
                                        <th class="text-center">نوع الحساب</th>
                                        <th class="text-center">طبيعة الحساب</th>
                                        <th class="text-center">ت. الحساب الفرعي</th>
                                        <th class="text-center">
                                            <i class="bi bi-gear"></i>
                                        </th>
                                    </tr>
                                </thead>

                                <tbody id="myTbody" class="myTbody"></tbody>

                                <tfoot></tfoot>
                            </table>
                        </div>

                        <!-- Footer Actions -->
                        <div class="d-flex justify-content-start gap-2">

                            <button type="button"
                                    id="btnDismiss"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                رجوع
                            </button>

                            <button type="submit"
                                    id="btnSave"
                                    class="btn btn-primary save"
                                    onclick="saveVirtual()">
                                حفظ
                            </button>

                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>


    <!-- Edit Account Modal -->
    <div class="modal fade" id="edit-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-xl">
            <div class="modal-content">

                <div class="border-0 d-flex justify-content-between align-items-center m-3">
                    <h5 class="modal-title">تعديل الحساب الأب</h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                            name="btnDismiss">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="card border-0">
                        <div class="card-body">

                            <div class="row">

                                <div class="col-12 our-title mb-3">
                                    <label class="text-danger h3">
                                        العام المالي الحالي :
                                    </label>

                                    <label class="text-success h3">
                                        @ViewBag.Year
                                    </label>

                                    <label id="AccId" class="d-none"></label>
                                </div>

                                <!-- Account Name -->
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        <label for="edAccName" class="form-label">
                                            اسم الحساب
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-book"></i>
                                            </span>

                                            <input class="form-control edAccName"
                                                   disabled
                                                   name="edAccName"
                                                   id="edAccName"
                                                   placeholder="اسم الحساب"
                                                   autocomplete="off" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Old Parent -->
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        <label for="edAccParentNameOld" class="form-label">
                                            اسم الحساب الأب
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-book"></i>
                                            </span>

                                            <input class="form-control edAccParentNameOld"
                                                   disabled
                                                   name="edAccParentNameOld"
                                                   id="edAccParentNameOld"
                                                   placeholder="اسم الحساب"
                                                   autocomplete="off" />
                                        </div>
                                    </div>
                                </div>

                                <!-- New Parent -->
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        <label for="edAccParentName" class="form-label">
                                            اسم الحساب الأب الجديد
                                        </label>

                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-book"></i>
                                            </span>

                                            <select class="form-select list edAccParentName"
                                                    id="edAccParentName"
                                                    style="width:100%">
                                            </select>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="d-flex justify-content-start mt-3">
                                <button type="button"
                                        id="btnUpdate"
                                        class="btn btn-warning update"
                                        onclick="Update()">
                                    تعديل
                                </button>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

}


@section scripts{

    <script>
        $('#htmltree').jstree();

        var myId = 0;
        var dataTable;
        $(document).ready(function () {
            // جعل الضغط على span يفتح أو يغلق النود
            $('.tree').on('click', 'span', function (e) {
                var nodeId = $(this).closest('li').attr('id');
                var tree = $('.tree').jstree(true);
                tree.toggle_node(nodeId);
            });

            $('.tree').on('click', '.add-btn', function () {
                $('#add-modal').modal('show');
                // Get the text of the clicked node
                //// نجيب العنصر الأقرب لي الزر فقط
                //var nodeText = $(this).closest('li').find('.accName').text().trim();

                var nodeText = $(this).siblings('.accName').text().trim();

                $('.addAccParentName').text("الحساب الاب - " + nodeText);
                $('#addAccParent').text(nodeText);
            });

            dataTable = $("#dataTable").DataTable({
                "processing": true,
                // "serverSide": true,
                "ajax": {
                    "url": "/AccountTree/LoadData",
                    "type": "GET",
                    "datatype": "json",
                },
                "columns": [
                    {
                        "data": "Id",
                        "orderable": false,
                        "render": function (data) {
                            return '<button class="btn btn-info btnDetails" onclick="Detail(' + data + ')"><i class="bi bi-info fs-4"></i></button>';
                        }
                    },
                    { "data": "Id", "autowidth": true },
                    { "data": "AccName", "autowidth": true },
                    { "data": "AccParentName", "autowidth": true },
                    { "data": "GetParentNameList", "autowidth": true },
                    //{
                    //    "data": "Id", "width": "200px", "render": function (data) {
                    //        return '<button class="btn btn-danger transfer btn-dataTable" onclick="Delete(' + data + ')">  حذف </button> ' +
                    //            '<button class="btn btn-warning update transfer btn-dataTable" >تعديل</button> <button class="btn btn-default transfer btn-dataTable" onclick="Active(' + data
                    //            + ')">  تفعيل </button> ';
                    // }
                    //}

                    {
                        "data": null,
                        "width": "200px",
                        "render": function (data, type, row) {

                            var toggleButton = row.IsActive
                                ? ' <button class="btn btn-success transfer btn-dataTable" onclick="toggleActive(' + row.Id + ', false)"> <i class="bi bi-lock fs-4"></i>  </button>'
                                : ' <button class="btn btn-info transfer btn-dataTable" onclick="toggleActive(' + row.Id + ', true)"> <i class="bi bi-unlock fs-4"></i>  </button>';

                            return '<button class="btn btn-danger transfer btn-dataTable" onclick="Delete(' + row.Id + ')"> <i class="bi bi-trash fs-4"></i> </button> ' +
                                '<button class="btn btn-warning update transfer btn-dataTable" > <i class="bi bi-pencil-square fs-4"></i></button>' +
                                toggleButton;
                        }
                    }






                ],
                "rowCallback": function (row, data) {
                    if (!data.IsActive) {
                        $(row).css('background-color', '#FFC107'); // أصفر غامق
                    }
                },
                "language": {
                    "sProcessing": "جارٍ التحميل...",
                    "sLengthMenu": "أظهر _MENU_ مدخلات",
                    "sZeroRecords": "لم يعثر على أية سجلات",
                    "sInfo": "إظهار _START_ إلى _END_ من أصل _TOTAL_ مدخل",
                    "sInfoEmpty": "يعرض 0 إلى 0 من أصل 0 سجل",
                    "sInfoFiltered": "(منتقاة من مجموع _MAX_ مُدخل)",
                    "sInfoPostFix": "",
                    "sSearch": "ابحث:",
                    "sUrl": "",
                    "oPaginate": {
                        "sFirst": "الأول",
                        "sPrevious": "السابق",
                        "sNext": "التالي",
                        "sLast": "الأخير",
                    }
                }
            });

            select2list("#edAccParentName", "/AccountTree/GetAccountNoneSub", "اسم الحساب الاب", "#edit-modal");
            select2list("#addAccType", "/AccountTree/GetAccountType", "نوع الحساب ", "#add-modal");
            select2list("#addAccNature", "/AccountTree/GetAccountNature", "  طبيعة الحساب ", "#add-modal");
            select2list("#addAccFinal", "/AccountTree/GetAccountFinal", "  الحساب الختامي ", "#add-modal");
            select2list("#addAccSub", "/AccountTree/GetAccountSubCategory", " تصنيف الحساب الفرعي ", "#add-modal");

            //دي دالة ذر الحذف في الجدول الصغير
            $('.table-striped').on('click', '.btn-warning', function () {
                $(this).closest('tr').remove();

            });
        });

        // دالة فتح شاشة تفاصيل الحساب
        function Detail(Id) {
            window.open("/AccountTree/Detail/" + Id, "_blank");
        }

        //دالة فتح حقول الحساب الفرعي
        $('#addAccType').on('change', function (e) {
            var AccType = $(this).val();
            switch (AccType) {
                case "1":
                    $('#AddAccSubDiv').addClass('d-none');
                    break;
                case "2":
                    $('#AddAccSubDiv').removeClass('d-none');

                    setTimeout(function () {
                        select2list(".addAccSub", "/AccountTree/GetAccountSubCategory", " تصنيف الحساب الفرعي ", "#add-modal");
                    }, 100);

                    break;
            }
        });

        //دي دالة ذر الحفظ
        //دي دالة الحفظ في الجدول ال في داتابيز
        function saveVirtual() {

            var data = [];

            var addAccParent = $('#addAccParent').text();
            var addAccParentName = $('.addAccParentName').text();

            $(".virtualTable tbody tr").each(function (index) {
                name = $(this).find('.name').text();
                final = $(this).find('.finalVal').text();
                type = $(this).find('.typeVal').text();
                nature = $(this).find('.natureVal').text();
                subCat = $(this).find('.subCatVal').text();

                data.push({
                    AccName: name,
                    AccParent: addAccParent,
                    AccTypeId: type,
                    AccNatureId: nature,
                    AccFinalId: final,
                    AccSubCategory: subCat
                });

            });
            console.clear();
            console.log(data);
            console.log(addAccParent);

            $.ajax({
                url: "/AccountTree/Create?accParentName=" + addAccParent,
                type: "POST",
                data: JSON.stringify(data),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    if (response.Status == "warning") {
                        toastr[response.Status](response.Message, response.Title);
                    } else {
                        toastr[response.Status](response.Message, response.Title);
                        window.location.reload();
                    }
                }
            });
        }

        // دي ما شغالة و بالتالي الدالة ال داخلها برضو ما شغالة
        $("#btnAddNode").click(function () {
            fillTreeName();
        });

        //-----------------------------------------------------------------Start Edit---------------------------------------------------------------

        //Open Edit Modal

        function getData(id) {
            fillTreeNameUpdate();

            $("#edit-modal").modal('show');

            $.ajax({
                type: "GET",
                url: "/AccountTree/GetDataForUpdate/" + id,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response != null) {
                        $('#edId').val(response.Id);
                        $('#edAccName').val(response.AccName);
                        $('#edAccCode').val(response.AccCode);
                        $('#edAccParent').val(response.AccParent);
                        $("#edAccParent").attr("disabled", "disabled");
                    } else {
                        alert("Something went wrong");
                    }
                },
                failure: function (response) {
                    //alert(response.responseText);
                },
                error: function (response) {
                    //alert(response.responseText);
                }
            });
        }

        function edit() {
            var ob = {
                "Id": $('#edId').val(),
                "AccCode": $('#edAccCode').val(),
                "AccName": $('#edAccName').val(),
                "AccParent": $('#edAccParent').val()
            }

            $.ajax({
                url: "@Url.Action("Edit", "AccountTree")",
                type: "POST",
                data: JSON.stringify(ob),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                    dataTable.ajax.reload();
                    Refresh();
                    //$('#edit-form').bootstrapValidator('resetForm', true);
                    $('#edit-modal').modal('hide');
                }
            });
        };

        function Refresh(id) {
            $("#AjaxLoader").show();

            $.get("/AccountTree/GetTreeParial", { id: id }, function (nn) {

                $("#Refresh-Tree").html(nn);
            });
        }

        function fillTreeName() {
            $('#addAccParent').empty();

            $.ajax({
                url: "/AccountTree/LoadTree",
                type: "GET",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    if (result) {
                        var x;
                        var html = "";
                        $.each(result, function (key, item) {
                            html += "<option value='" + item.Id + "'>" + item.AccName + "</option>";
                        });
                        $('#addAccParent').append(html);
                    }
                },
                error: function (errormessage) {
                    alert(errormessage.responseText);
                }

            });
        };

        function fillTreeNameUpdate() {
            $(document).ready(function () {
                $('#edAccParent').empty();
                $.ajax({
                    url: "/AccountTree/LoadTreeUpdate",
                    type: "GET",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    success: function (result) {
                        if (result) {
                            var x;
                            var html = "";
                            $.each(result, function (key, item) {
                                html += "<option value='" + item.Id + "'>" + item.AccName + "</option>";
                            });
                            $('#edAccParent').append(html);
                        }
                    },
                    error: function (errormessage) {
                        alert(errormessage.responseText);
                    }
                });
            });
        }

        //=========================================Cusrom Tree====================================================================//

        function Delete(id) {
            Swal.fire({
                title: "هل أنت متأكد؟",
                text: "عند الضغط على OK سيتم حذف العنصر!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "OK",
                cancelButtonText: "إلغاء",
                confirmButtonColor: "#d33",
                cancelButtonColor: "#6c757d"
            }).then((result) => {

                if (result.isConfirmed) {

                    $.get("/AccountTree/Delete", { id: id }, function (res) {

                        if (res) {

                            if (res.message === "Used") {
                                toastr.error("لا يمكن حذف هذا العنصر", "تعذر الحذف");
                            }

                            if (res.message === "Delete") {
                                toastr.success("تم حذف الحساب", "الحذف");

                                Refresh();
                            }

                            dataTable.ajax.reload();
                        }
                    });
                }
            });

