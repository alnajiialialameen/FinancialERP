                    "data": "Id", "width": "150px", "render": function (data) {
                        return '<button class="btn btn-info transfer btn-dataTable" onclick="Detail(' + data + ')">تفاصيل</button> ' +
                            '<button class="btn btn-danger transfer btn-dataTable" onclick="Delete(' + data + ')">حذف</button> ';
                    }
                },

            ],
            "language": {
                              "sProcessing": "جارٍ التحميل...",
