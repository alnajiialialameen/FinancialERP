@model Purchases.Models.ViewModel.AccountTreeVM
@using Purchases.Models;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    Entities db = new Entities();
    AccountTree Select = new AccountTree();
}

@section content{

    <!-- Content Header -->

    <section class="d-flex flex-row justify-content-between align-items-center my-3">
        <h3>
            تفاصيل الحساب / @Model.AccName
        </h3>

        <ol class="breadcrumb">
            <li>
                <a class="text-decoration-none text-black" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-house-fill"></i>
                    النظام المحاسبي >
                </a>
            </li>
            <li class="breadcrumb-item active">
                الشجره المحاسبية
            </li>
        </ol>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">

                <!-- Left Side -->
                <div class="col-12 col-lg-8">

                    <!-- Statistics -->
                    <div class="card mb-3">
                        <div class="card-body">

                            <h4 class="me-3">إحصائيات</h4>

                            <div class="row">
                                <div class="col-12 col-md-6">
                                    <br />

                                    <label class="text-center text-warning">
                                        عدد الصفوف (دائن)
                                    </label>
                                    <br /><br />

                                    <label class="text-center text-info">
                                        عدد الصفوف (مدين)
                                    </label>
                                    <br /><br />

                                    <label class="text-center text-success">
                                        إجمالي عدد الصفوف
                                    </label>
                                    <br /><br />
                                </div>

                                <div class="col-12 col-md-6">
                                    <br />

                                    <label class="text-center text-info">
                                        إجمالي المبلغ (دائن)
                                    </label>
                                    <br /><br />

                                    <label class="text-center text-warning">
                                        إجمالي المبلغ (مدين)
                                    </label>
                                    <br /><br />

                                    <label class="text-center text-info">
                                        الرصيد الحالي
                                    </label>
                                    <br /><br />
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Last Transactions -->
                    <div class="card mb-3">
                        <div class="card-body">

                            <h4 class="me-3">آخر 5 حركات للحساب</h4>

                            <div class="table-responsive mt-4">
                                <table id="myTbx"
                                       class="table table-bordered table-hover table-sm w-100">

                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>تاريخ القيد</th>
                                            <th>نوع القيد</th>
                                            <th>العملة</th>
                                            <th>سعر الصرف</th>
                                            <th>المبلغ</th>
                                        </tr>
                                    </thead>

                                    <tbody class="tbx">
                                    </tbody>

                                </table>
                            </div>

                        </div>
                    </div>

                </div>

                <!-- Right Side -->
                <div class="col-12 col-lg-4">

                    <div class="card mb-3">
                        <div class="card-body">

                            <fieldset class="border rounded p-3">
                                <legend class="float-none w-auto px-2 fs-6">
                                    بيانات الحساب
                                </legend>

                                <table class="table table-sm table-borderless mb-0">
                                    <tbody>

                                        <tr>
                                            <td>رقم الحساب</td>
                                            <td>
                                                <label class="trans">
                                                    @*@ViewData.Eval("accTreeId")*@
                                                    @Model.Id
                                                </label>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>اسم الحساب</td>
                                            <td>
                                                <label class="trans">
                                                    @ViewData.Eval("accName")
                                                </label>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>المستوى في الشجرة</td>
                                            <td>
                                                <label class="trans">
                                                    @ViewData.Eval("accLevel")
                                                </label>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>الحساب الأب</td>
                                            <td>
                                                <label class="trans">
                                                    @ViewData.Eval("accParent")
                                                </label>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>كود الحساب</td>
                                            <td>
                                                <label class="trans">
                                                    @ViewData.Eval("accCode")
                                                </label>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>نوع الحساب</td>
                                            <td>
                                                <label class="trans">
                                                    @ViewData.Eval("accType")
                                                </label>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>طبيعة الحساب</td>
                                            <td>
                                                <label class="trans">
                                                    @ViewData.Eval("accNature")
                                                </label>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>الحساب الختامي</td>
                                            <td>
                                                <label class="trans">
                                                    @ViewData.Eval("accFinal")
                                                </label>
                                            </td>
                                        </tr>

                                    </tbody>
                                </table>

                            </fieldset>

                        </div>
                    </div>

                </div>

            </div>

            <!-- Floating Buttons -->
            <div class="buttons">

                <div class="justify-content">
                    <a href="/Reports/printAccountStatement/@Model.Id"
                       target="_blank"
                       class="float one">
                        <i class="bi bi-printer-fill my-float"
                           title="طباعة كشف حساب"
                           style="font-size:20px"></i>
                    </a>
                </div>

                <div class="justify-content">
                    <a href="/Reports/printLedger/@Model.Id"
                       target="_blank"
                       class="float two">
                        <i class="bi bi-receipt my-float"
                           title="طباعة دفتر الأستاذ"
                           style="font-size:20px"></i>
                    </a>
                </div>

                <div class="justify-content-start">
                    <a href="/Reports/printData/@Model.Id"
                       target="_blank"
                       class="float third">
                        <i class="bi bi-wallet my-float"
                           title="طباعة قيد اليومية"
                           style="font-size:20px"></i>
                    </a>
                </div>

                <div class="justify-content-start">
                    <a href="/AccountTree/index"
                       target="_blank"
                       class="float exit"
                       style="bottom:50px">
                        <i class="bi bi-x-circle my-float"
                           title="رجوع إلى شجرة الحسابات"
                           style="font-size:20px"></i>
                    </a>
                </div>

            </div>

        </div>
    </section>

}