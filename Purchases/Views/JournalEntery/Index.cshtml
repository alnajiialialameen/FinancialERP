@using Purchases.Models;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

@{
    Entities db = new Entities();
    AccountTree Select = new AccountTree();
    List<AccountTree> Model = db.AccountTrees.ToList();
}

@section content{
<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
    <div class="grad"></div>
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>
            قيود اليومية
        </h1>
        <ol class="breadcrumb">
            <li><a href="#"><i class="fa fa-home"></i> النظام المحاسبي</a></li>
            <li class="active">  قيود اليومية</li>
        </ol>
    </section>

    <section class="content">
        <div class="row">
            <div class="col-xs-12">
                <div class="box">
                    <!-- /.box-header -->
                    <div class="box-body">
                            <div class="container" style="margin-top:30px;">
                                <button class="btn btn-primary" style="float:left" data-toggle="modal" data-target="#add-modal"> إضافة قيد</button>
                                <table id="tbx" class="table table-bordered table-sm table-hover" style="width:100%">
                                </table>
                            </div><!-- /.box-body -->
                    </div><!-- /.box -->
                </div><!-- /.col -->
            </div><!-- /.row -->
         </div>
    </section>

</div><!-- /.content-wrapper -->

<div class="example-modal">
    <div class="modal fade in" id="add-modal" data-backdrop="static">
        <div class="modal-dialog" style="width:80% !important">
            <div class="modal-content">
                <div class="modal-header .no-border">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title"> إضافة قيد جديد</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-lg-12">
                                    <!-- Input addon -->
                                    <div class="row">
                                        <form id="add-form">
                                            <div class="col-lg-12">
                                                <div class="col-lg-4">
                                                    <div class="form-group">
                                                        <label for="name">اسم الحساب</label>
                                                        <div class="input-group">
                                                            <div class="input-group-addon">
                                                                <i class="fa fa-book"></i>
                                                            </div>
                                                            <select class="form-control list addAccName" name="addAccName" id="addAccName" style="width:100%"></select>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-lg-4">
                                                    <div class="form-group">
                                                        <label for="name">المبلغ</label>
                                                        <div class="input-group">
                                                            <div class="input-group-addon">
                                                                <i class="fa  fa-book"></i>
                                                            </div>
                                                            <input class="form-control amount" type="number" name="amount" id="amount" placeholder="المبلغ" autocomplete="off" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-lg-4">
                                                    <div class="form-group">
                                                        <label for="name">النوع</label>
                                                        <div style="justify-content:space-around; display:flex;">
                                                            <label><input type="radio" style="margin-left: 10px;" name="IsCredit" id="IsCredit" value="1" checked />دائن</label>
                                                            <label><input type="radio" style="margin-left: 10px;" name="IsCredit" id="IsCredit" value="0" />مدين</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-12">
                                                <button class="btn btn-info btn-block m-4" onclick="addToTable()">ترحيل</button>
                                            </div>
                                        </form>
                                    </div>
                                    
                                    <br />

                                    <div class="row">
                                      <div class="col-lg-12">
                                          <table id="example1" class="table table-bordered table-striped virtualTable">
                                              <thead>
                                                  <tr>
                                                      <th style="text-align:center ;width:150px;">#</th>
                                                      <th style="text-align:center ;width:750px;">اسم الحساب</th>
                                                      <th style="text-align:center ;width:750px;">المبلغ</th>
                                                      <th style="text-align:center ;width:750px;">النوع</th>
                                                      <th style="text-align:center;"><i class="fa fa-cogs"></i></th>
                                                  </tr>
                                              </thead>
                                              <tbody class="myTbody"></tbody>
                                          </table>
                                      </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-lg-12 ">
                                            <div class="pull-left">
                                                <button type="button" class="btn btn-default " data-dismiss="modal">رجوع</button>
                                                <button type="submit" id="btnSave" class="btn btn-primary">مراجعة القيد</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div><!-- /.row (main row) -->

                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal -->
</div>

<div class="example-modal">
    <div class="modal fade in" id="add-statement-modal" data-backdrop="static">
        <div class="modal-dialog" style="width:40% !important">
            <div class="modal-content">
                <div class="modal-header .no-border">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title"> إضافة قيد جديد</h4>
                </div>
                <div class="modal-body">
                    <form id="add-statement-form">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label for="orderdate">البيان</label>
                                    <textarea id="statement" class="form-control" rows="3" placeholder="ادخل البيان"></textarea>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label for="journalDate"> تاريخ القيد</label>
                                    <div class="input-group">
                                        <span class="input-group-addon">
                                            <i class="fa fa-calendar-alt"></i>
                                        </span>
                                        <input type="text" class="form-control  calendar journalDate" id="journalDate" name="journalDate" placeholder="تاريخ القيد" autocomplete="off">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <button type="submit" class="btn btn-success btnCreate">حفظ</button>
                        </div>
                    </form>
                        <hr />
                        <div class="row">
                            <table class="table table-bordered table-striped table-hover">
                                <thead style="background-color:#808080">
                                    <tr class="text-center">
                                        <td>مدين</td>
                                        <td>دائن</td>
                                        <td>الحساب</td>
                                    </tr>
                                </thead>
                                <tbody class="presntTBody"></tbody>
                            </table>
                        </div>
                        
            </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>
</div>

}

@section scripts{
    
<script>
    var myId = 0;
    var dataTable;

    $(document).ready(function () {

        function loadData() {
            dataTable = $('#tbx').DataTable({
                "language": {
                    "lengthMenu": "عرض _MENU_ سجل في الصفحة",
                    "search": "بحث"
                },
                ajax: {
                    url: '/JournalEntery/LoadData',
                    dataSrc: ''
                },
                columns: [
                    {
                        "title": "# ",
                        "data": "Id"
                    },
                    {
                        "title": "  مدين  ",
                        "data": "TotalDebitAmount"
                    },
                    {
                        "title": " دائن   ",
                        "data": "TotalDebitAmount"
                    },
                    {
                        "title": " البيان   ",
                        "data": "Statement"
                    },
                     {
                        "title": "  التاريخ  ",
                        "data": "JournalDate"
                    }
                    //{
                    //    "title": "<i class='fa fa-cog'></i>",
                    //    "data": null,
                    //    "width": "30%",
                    //    "orderable": false,
                    //    "render": function (data) {
                    //        return '<div class="btn-opreation">'
                    //                     + '<button class="btn btn-success transfer openEditModal">تعديل <i class=" transfer-fa fa  fa-edit"></i></button> '
                    //                                                      + '<button class="btn btn-success transfer openAditModal">  إضافة عنصر جديد <i class=" transfer-fa fa  fa-edit"></i></button> '
                    //            + '</div> '

                    //        ;

                    //    }
                    //}


                ]

            });

        }
        loadData();

        function select2list(selector, url, placeholder) {
            $(selector).select2({
                language: { inputTooShort: function () { return 'ادخل حرف واحد علي الاقل'; } },
                ajax: {
                    url: url,
                    dataType: 'json',
                    delay: 100,
                    data: function (params) {
                        return {
                            q: params.term,
                            page: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data,
                            pagination: {
                                more: ((data.total_count) > (params.page * 20))
                            }
                        };
                    },
                    cache: true
                },
                placeholder: placeholder,
                minimumInputLength: 1,
            });

        };
        select2list("#addAccName", "/JournalEntery/getAccTrees", "اسم الحساب");

    });

    //-------------------------------------------------Start Validator ------------------------------------------------------------------------------------------------------------

    $('#add-form').bootstrapValidator({
        onSuccess: function (e) {
            //save();
            e.preventDefault();

        },
        submitButtons: 'button[type="submit"]',
        feedbackIcons: {
            valid: 'glyphicon glyphicon-ok success-feedback-icons',
            invalid: 'glyphicon glyphicon-remove error-feedback-icons',
            validating: 'fa fa-refresh fa-spin success-feedback-icons'
        },
        fields: {
            addAccName: {
                validators: {
                    notEmpty: {
                        message: 'يجب الا يكون حقل اسم الحساب  فارغ'
                    }
                }
            },
            amount: {
                validators: {
                    notEmpty: {
                        message: 'يجب الا يكون حقل المبلغ فارغ'
                    }
                }
            }

        }
    });
    $('#add-statement-form').bootstrapValidator({
        onSuccess: function (e) {
            saveNew();
            e.preventDefault();
        },
        submitButtons: 'button[type="submit"]',
        feedbackIcons: {
            valid: 'glyphicon glyphicon-ok success-feedback-icons',
            invalid: 'glyphicon glyphicon-remove error-feedback-icons',
            validating: 'fa fa-refresh fa-spin success-feedback-icons'
        },
        fields: {
            journalDate: {
                validators: {
                    notEmpty: {
                        message: 'يجب الا يكون حقل اسم تاريخ القيد  فارغ'
                    }
                }
            },
            statement: {
                validators: {
                    notEmpty: {
                        message: 'يجب الا يكون حقل البيان  فارغ'
                    }
                }
            },
        }
    });

    //-------------------------------------------------End Validator ------------------------------------------------------------------------------------------------------------

    var rptList = [];

    function addToTable() {
        //هنا لازم ندخل اسم الحساب
        var addAccName = $('#select2-addAccName-container').text();
        var addAccNameId = $('.addAccName').val();
        var Amount = $('#amount').val();
        var IsCredit = $('input[name="IsCredit"]:checked').val();
        var IsCreditText = '';

        if (IsCredit == 1) {
            IsCreditText = "Credit";
        } else {
            IsCreditText = "Debit";
        }

        console.clear();
        console.log(addAccName);
        console.log(addAccNameId);
        console.log(Amount);
        console.log(IsCredit);


        var isFound = false;

        if (addAccName.trim() != "" & addAccNameId != null & Amount != null & IsCredit != null) {
            $('.myTbody tr').each(function () {
                var id = $(this).find('td:eq(0)').text();
                console.log(id);
                if (id == addAccNameId) {
                    //break here if found
                    isFound = true;
                    console.log(isFound);
                    return false;
                }
            });

            if (!isFound) {
                var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                                + "<td class='id'>" + addAccNameId + "</td>"
                                + "<td class='name'>" + addAccName + "</td>"
                                + "<td class='Amount'>" + Amount + "</td>"
                                + "<td class='IsCredit hidden'>" + IsCredit + "</td>"
                                + "<td class='IsCredit'>" + IsCreditText + "</td>"
                                + '<td  class="employeeName" > <button id="delete" class="btn btn-warning transfer ">حذف<i class=" transfer-fa fa  fa-trash"></i></button>' + "</td>"
                            + "</tr>";
                $('.myTbody').append(rows);
                $('.addAccName').val('');
                $('.amount').val('');
                $('.list').text(null).trigger('change');
                $('.list').val(null).trigger('change');
                isFound = false;

                if (IsCredit == 1) {
                    IsCreditText = "Credit";
                    rptList.push({
                        "addAccName": addAccName,
                        "accTrreId": addAccNameId,
                        "amount": Amount,
                        "CreditAmount": Amount,
                        "DebitAmount": 0,
                        "isCredit": "true",
                    });
                } else {
                    rptList.push({
                        "addAccName": addAccName,
                        "accTrreId": addAccNameId,
                        "Amount": Amount,
                        "CreditAmount": 0,
                        "DebitAmount": Amount,
                        "IsCredit": "false",
                    });
                    IsCreditText = "Debit";
                }
            }
            else {
                toastr["error"]("هذاالحساب موجود في القائمة", "خطأ");
            }
        } else {
            toastr["error"]("الرجاء ادخال جميع البيانات", "خطأ");
        }
    }

    $('#btnSave').click(function () {
        console.clear();
        console.log(rptList);

        var totalDebitAmount = 0;
        var totalCreditAmount = 0;

        $.each(rptList, function (index, value) {
            totalDebitAmount += parseInt(value.DebitAmount);
            totalCreditAmount += parseInt(value.CreditAmount);

            console.log(totalDebitAmount);
            console.log(totalCreditAmount);
        });

        if (totalDebitAmount == totalCreditAmount) {
            rptList.forEach(function (row) {
                var rows = "<tr id='row' style='font-size: 16px;text-align:center;'>"
                                    + "<td class='id'>" + row['DebitAmount'] + "</td>"
                                    + "<td class='name'>" + row['CreditAmount'] + "</td>"
                                    + "<td class='Amount'>" + row['addAccName'] + "</td>"
                            + '</tr>';

                $('.presntTBody').append(rows);
                $('#add-statement-modal').modal('show');
            });
        } else {
            toastr["error"]("الرجاء مساواة الطرفين ", "خطأ");
        }
    });

    function saveNew() {
        var statement = $('#statement').val();
        var journalDate = moment($('#journalDate').val(), "DD/MM/YYYY").format("MM/DD/yyyy");

        if (statement != null & journalDate != null) {
            //هنا اضفنا حقل البيان والتاريخ لي مصفوفة موجودة مسبقا بها بيانات
            rptList = rptList.map(v => Object.assign(v, { "statement": statement, "journalDate": journalDate }));

            $.ajax({
                url: "/JournalEntery/Create",
                type: "POST",
                data: JSON.stringify(rptList),
                contentType: "application/json charset=utf-8",
                dataType: "json",
                error: function (response) {
                    toastr[response.Status](response.Message, response.Title);
                },
                success: function (response) {
                    if (response.Status == "warning") {
                        toastr[response.Status](response.Message, response.Title);
                    } else {
                        toastr[response.Status](response.Message, response.Title);
                        //$('.list').val(null).trigger('change');
                        $('#add-modal').modal("hide");
                        $('#add-statement-modal').modal("hide");
                        $(".presntTBody").empty();
                        window.location.reload();
                    }
                }
            });

        } else {
            toastr["error"]("الرجاء ادخال جميع البيانات", "خطأ");
        }
    }
</script>
}