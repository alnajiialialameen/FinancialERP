@model IEnumerable<Purchases.Models.ViewModal.JournalEnteryViewMode>

@{
    ViewBag.Title = "PrintInvoice";
    //Layout = "~/Views/Shared/_LayoutPrint.cshtml";
}

<style>

     /*////////////////////////////////////////////////////Cupps/////////////////////////////////////////////*/
       .invoiceCupps {
            padding:10px;
            font-family:Arial;
        }
       .invoiceCupps .invoice-Cupps-header {
            border:2px solid #808080;
            border-radius:5px;
            padding:16px;
            margin-bottom:10px;
        }
        
       .invoiceCupps .invoice-Cupps-header .text-word {           
           float:none;
        }
        .invoiceCupps .invoice-Cupps-header .text-word h6 {
            font-size:21px;
            font-weight:bolder;
        }
        .invoiceCupps .invoice-Cupps-header .image-R {
            float:right;
            margin-right:30px;
            margin-top:-90px;       
        }
        .invoiceCupps .invoice-Cupps-header .image-L {
            float:left;
            margin-top:-10px;           
        }

        .invoiceCupps .invoice-Cupps-Body {
            clear:both;
        }

        .invoiceCupps .invoice-Cupps-Body .h-mr {
            margin-right:20px;
            font-size:21px;
        }

        .invoiceCupps .invoice-Cupps-details th {
            background-color:#ebefef
        }

        .invoiceCupps .invoice-Cupps-details table {
            min-width:100%;
            text-align:right;
        }

        .invoiceCupps .invoice-Cupps-details table,th,td {
            border:1px solid #282a2c; 
            padding:.5rem;
            font-size:18px; 
            text-align:center;      
        }

        .invoiceCupps .invoice-Cupps-details .footer {
            background-color:#ebefef;
            font-weight:600;  
        }

</style>

<section class="invoiceCupps">
    <div class="invoice-Cupps-header">
        <div class="image-L">
            <img src="~/Temp/Image/WhiteLogo.png" height="100" />
        </div>

        <div class="text-center text-word">
            <h6>شركة مطارات السودان المحدودة</h6>
            <h6>الادارة العامة للشؤون المالية والمحاسبية</h6>
            <h6>إدارة الحسابات</h6>
        </div>

        <div>
            <img src="~/Temp/Image/WhiteLogo.png" class="image-R" height="100" />
        </div>
    </div>

    <div class="invoice-Cupps-Body" dir="rtl">
        <h4 class="text-center"><u> قيود اليومية</u></h4>
        <div class="arline-header">
            <div class="row">
                <div class="col-md-12">
                    <label class="h-mr">التاريخ: @ViewBag.SelectedDate</label>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center invoice-Cupps-details" dir="rtl" style="width:100%;margin-bottom:40px;">
        <table class="cupps-table-header" >
           <thead>
               <tr>
                   <th>
                       المدين
                   </th>

                   <th>
                       الدائن
                   </th>

                   <th>
                       البيان
                   </th>

                   <th>
                       رقم القيد
                   </th>
               </tr>

           </thead>
            <tbody>
               @{
                   foreach (var item1 in Model.Select(x => new { x.journalEnteryId, x.statement }).Distinct().ToList())
                   {
                       foreach (var item in Model.Where(x=>x.journalEnteryId == item1.journalEnteryId))
                       {
                        <tr >
                            @{
                                if (Convert.ToBoolean(item.isCredit))
                                {
                                    <td>0</td>
                                    <td>@item.amount</td>
                                    <td class="text-right" style="padding-right:20px;">من حــ/ @item.accName</td>
                                }
                                else
                                {
                                    <td>@item.amount</td>
                                    <td>0</td>
                                    <td class="text-right"  style="padding-right:60px;">الي حــ/ @item.accName</td>
                                }
                            }
                            
                            <td>@item.journalEnteryId</td>
                        </tr>
                                }
                                <tr>
                                    <td colspan="4">
                                        @item1.statement
                                    </td>
                                </tr>
                                }
            }

                <tr class="footer">
                    <th colspan="2">  Total :</th>

                    @*<th class="numberFormat">@ViewBag.SumPax</th>
                    <th class="numberFormat">@ViewBag.SumTR</th>
                    <th></th>*@

                    <th class="numberFormat">@ViewBag.SumFuelFees</th>

                    <th class="numberFormat">@ViewBag.SumFuelFeesSDG</th>
                </tr>

                @*<tr class="footer">
                    <th colspan="7">  Tax :</th>

                    <th class="numberFormat">@ViewBag.TaxDollar</th>

                    <th class="numberFormat">@ViewBag.TaxSDG</th>
                </tr>

                <tr class="footer">
                    <th colspan="7">  Grand Total :</th>

                    <th class="numberFormat">@ViewBag.GrandTotalDollar</th>

                    <th class="numberFormat">@ViewBag.GrandTotalSDG</th>
                </tr>*@

            </tbody>
        </table>

    </div>

</section>

<script src="~/Temp/plugins/jquery/jquery.min.js"></script>

@section scripts{

    <script>

        window.addEventListener("load", window.print());

           $('.numberFormat').each(function () {
               var item = $(this).text();

               var N = round(item, 2);
               /// var N = item.toFixed(2);


               var num = Number(N).toLocaleString();
               $(this).text(num);
           });



           function round(value, exp) {
               if (typeof exp === 'undefined' || +exp === 0)
                   return Math.round(value);

               value = +value;
               exp = +exp;

               if (isNaN(value) || !(typeof exp === 'number' && exp % 1 === 0))
                   return NaN;

               // Shift
               value = value.toString().split('e');
               value = Math.round(+(value[0] + 'e' + (value[1] ? (+value[1] + exp) : exp)));

               // Shift back
               value = value.toString().split('e');
               return +(value[0] + 'e' + (value[1] ? (+value[1] - exp) : -exp));
           }


    </script>

}